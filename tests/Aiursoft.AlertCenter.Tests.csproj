<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aiursoft.AlertCenter.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="JunitXml.TestLogger" Version="8.1.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.60.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\Aiursoft.AlertCenter\Aiursoft.AlertCenter.csproj" />
    <ProjectReference Include="..\src\Aiursoft.AlertCenter.Client\Aiursoft.AlertCenter.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../src/Aiursoft.AlertCenter/wwwroot/scripts/file-upload.js" TargetPath="wwwroot/scripts/file-upload.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../src/Aiursoft.AlertCenter/wwwroot/scripts/notice-dialog.js" TargetPath="wwwroot/scripts/notice-dialog.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../src/Aiursoft.AlertCenter/wwwroot/scripts/uploader.js" TargetPath="wwwroot/scripts/uploader.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../src/Aiursoft.AlertCenter/wwwroot/styles/uploader.css" TargetPath="wwwroot/styles/uploader.css" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
