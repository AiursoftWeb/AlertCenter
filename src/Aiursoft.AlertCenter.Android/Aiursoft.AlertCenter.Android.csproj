<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <AssemblyName>Aiursoft.AlertCenter.Android</AssemblyName>
    <RootNamespace>Aiursoft.AlertCenter.Android</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationId>com.aiursoft.alertcenter</ApplicationId>
    <ApplicationTitle>Aiursoft AlertCenter</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.8.0" />
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.14.0.6" />
    <ProjectReference Include="..\Aiursoft.AlertCenter.SDK\Aiursoft.AlertCenter.SDK.csproj" />
  </ItemGroup>
</Project>
