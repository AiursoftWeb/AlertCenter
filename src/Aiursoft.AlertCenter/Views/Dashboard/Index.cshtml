@using Aiursoft.WebTools
@model Aiursoft.AlertCenter.Models.DashboardViewModels.IndexViewModel
@using Aiursoft.AlertCenter.Entities

@section styles {
    <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" />
}

@{
    var deliverySuccessRate = Model.TotalDeliveries > 0
        ? (int)Math.Round((double)Model.SuccessfulDeliveries / Model.TotalDeliveries * 100)
        : 100;
    var endpoint = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}/api/v1/incidents";

    string IncidentStatusText(string status) => status switch
    {
        Incident.New => @Localizer["Unmitigated"].Value,
        Incident.Mitigated => @Localizer["Mitigated"].Value,
        Incident.Resolved => @Localizer["Resolved"].Value,
        _ => status
    };
}

<!-- Cockpit Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="ac-status-dot dot-success ac-pulse"></span>
            <h1 class="h3 mb-0">@Localizer["Monitoring Dashboard"]</h1>
        </div>
        <p class="text-muted mb-0">@Localizer["AlertCenter Alerting & Operations Center · Global Status & Closed-Loop Tracking"]</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="badge bg-body-secondary text-body border px-3 py-2">
            <i class="align-middle me-1" data-lucide="clock"></i><span id="local-clock" aria-label="@Localizer["Local time"]"><span data-utc-time="@DateTime.UtcNow.ToHtmlDateTime()"></span></span>
        </span>
        <a asp-controller="Applications" asp-action="GettingStarted" class="btn btn-outline-primary">
            <i class="align-middle me-1" data-lucide="book-open"></i>@Localizer["Integration Guide"]
        </a>
        <a asp-controller="Applications" asp-action="Applications" class="btn btn-primary">
            <i class="align-middle me-1" data-lucide="plus"></i>@Localizer["Applications"]
        </a>
    </div>
</div>

<!-- KPI Metrics Grid -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card ac-stat-card h-100 mb-0">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-muted small fw-medium">@Localizer["Applications"]</span>
                    <div class="ac-stat-icon icon-primary">
                        <i data-lucide="app-window"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline justify-content-between">
                    <h2 class="h1 mb-0 fw-bold">@Model.TotalApplications</h2>
                    <a asp-controller="Applications" asp-action="Applications" class="small text-primary text-decoration-none">@Localizer["Manage applications"] <i class="align-middle" data-lucide="chevron-right"></i></a>
                </div>
                <div class="mt-2 text-muted small">
                    <span>@Localizer["Dedicated API Key Authentication"]</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card ac-stat-card h-100 mb-0">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-muted small fw-medium">@Localizer["Total incidents"]</span>
                    <div class="ac-stat-icon icon-indigo">
                        <i data-lucide="bell"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline justify-content-between">
                    <h2 class="h1 mb-0 fw-bold">@Model.TotalIncidents</h2>
                    <a asp-controller="Incidents" asp-action="Index" class="small text-primary text-decoration-none">@Localizer["All records"] <i class="align-middle" data-lucide="chevron-right"></i></a>
                </div>
                <div class="mt-2 text-muted small">
                    <span class="fw-semibold" style="color: var(--ac-sev0);">@Model.Sev0Count</span> @Localizer["Critical ·"] <span class="text-danger fw-semibold">@Model.Sev1Count</span> @Localizer["Major ·"] <span class="text-warning fw-semibold">@Model.Sev2Count</span> @Localizer["Error"]
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card ac-stat-card h-100 mb-0">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-muted small fw-medium">@Localizer["Ongoing Incident"]</span>
                    <div class="ac-stat-icon @(Model.ActiveIncidents > 0 ? "icon-danger" : "icon-success")">
                        <i data-lucide="@(Model.ActiveIncidents > 0 ? "siren" : "shield-check")"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline justify-content-between">
                    <h2 class="h1 mb-0 fw-bold @(Model.ActiveIncidents > 0 ? "text-danger" : "text-success")">@Model.ActiveIncidents</h2>
                    <a asp-controller="Incidents" asp-action="Index" class="small text-primary text-decoration-none">@Localizer["Incident response"] <i class="align-middle" data-lucide="chevron-right"></i></a>
                </div>
                <div class="mt-2 text-muted small">
                    @if (Model.ActiveIncidents > 0)
                    {
                        <span class="text-danger"><i class="align-middle me-1" data-lucide="alert-triangle"></i>@Localizer["Requires Immediate Action"]</span>
                    }
                    else
                    {
                        <span class="text-success"><i class="align-middle me-1" data-lucide="check-circle-2"></i>@Localizer["No unresolved incidents currently"]</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card ac-stat-card h-100 mb-0">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-muted small fw-medium">@Localizer["Push Success Rate"]</span>
                    <div class="ac-stat-icon icon-success">
                        <i data-lucide="send"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline justify-content-between">
                    <h2 class="h1 mb-0 fw-bold">@(Model.TotalDeliveries > 0 ? $"{deliverySuccessRate}%" : "100%")</h2>
                    <a asp-controller="Push" asp-action="Records" class="small text-primary text-decoration-none">@Localizer["Delivery Records"] <i class="align-middle" data-lucide="chevron-right"></i></a>
                </div>
                <div class="mt-2 text-muted small">
                    <span>@Model.ChannelsCount @Localizer["available channels · "]@Model.TotalDeliveries @Localizer[" deliveries"]</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Severity Quick Filter Pills -->
<div class="card mb-4">
    <div class="card-body py-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small fw-semibold text-uppercase me-2"><i class="align-middle me-1" data-lucide="layers"></i>@Localizer["Severity pivot:"]</span>
                <a asp-controller="Incidents" asp-action="Index" class="btn btn-sm btn-outline-secondary">@Localizer["All "] (@Model.TotalIncidents)</a>
                <a asp-controller="Incidents" asp-action="Index" asp-route-level="sev0" class="btn btn-sm ac-badge-sev0">
                    <span class="ac-status-dot dot-deadly"></span>sev0 @Localizer["Critical"] (@Model.Sev0Count)
                </a>
                <a asp-controller="Incidents" asp-action="Index" asp-route-level="sev1" class="btn btn-sm ac-badge-sev1">
                    <span class="ac-status-dot dot-danger"></span>sev1 @Localizer["Major"] (@Model.Sev1Count)
                </a>
                <a asp-controller="Incidents" asp-action="Index" asp-route-level="sev2" class="btn btn-sm ac-badge-sev2">
                    <span class="ac-status-dot dot-warning"></span>sev2 @Localizer["Error "] (@Model.Sev2Count)
                </a>
                <a asp-controller="Incidents" asp-action="Index" asp-route-level="sev3" class="btn btn-sm ac-badge-sev3">
                    <span class="ac-status-dot dot-warning"></span>sev3 @Localizer["Warning "] (@Model.Sev3Count)
                </a>
                <a asp-controller="Incidents" asp-action="Index" asp-route-level="sev4" class="btn btn-sm ac-badge-sev4">
                    <span class="ac-status-dot dot-info"></span>sev4 @Localizer["Info "] (@Model.Sev4Count)
                </a>
            </div>
            @if (Model.UnreadNotifications > 0)
            {
                <a asp-controller="Push" asp-action="Inbox" class="badge bg-primary text-decoration-none py-2 px-3">
                    <i class="align-middle me-1" data-lucide="bell"></i>@Model.UnreadNotifications @Localizer[" unread in-site notifications"]
                </a>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Recent Incidents & Incidents -->
    <div class="col-lg-8">
        @if (Model.RecentIncidents.Count > 0)
        {
            <div class="card border-danger mb-4">
                <div class="card-header bg-danger-subtle d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="align-middle text-danger" data-lucide="alert-triangle"></i>
                        <h2 class="card-title text-danger mb-0">@Localizer["Ongoing Incident Requires Response"]</h2>
                    </div>
                    <a asp-controller="Incidents" asp-action="Index" class="btn btn-sm btn-danger">@Localizer["View all incidents"]</a>
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var incident in Model.RecentIncidents)
                    {
                        <a asp-controller="Incidents" asp-action="Details" asp-route-id="@incident.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3 py-3">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-danger">@IncidentStatusText(incident.Status)</span>
                                    <span class="badge bg-secondary-subtle text-secondary">@(incident.IsAcknowledged ? @Localizer["Acknowledged"].Value : @Localizer["Not acknowledged"].Value)</span>
                                    <strong class="text-break">@incident.Title</strong>
                                </div>
                                <small class="text-muted">@Localizer["Source"]: @incident.Application.Name</small>
                            </div>
                            <span class="text-muted small text-nowrap"><span data-utc-time="@incident.ReceivedAtUtc.ToHtmlDateTime()"></span></span>
                        </a>
                    }
                </div>
            </div>
        }

        <!-- Recent Incidents Stream -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="card-title mb-0">@Localizer["Latest incidents"]</h2>
                    <small class="text-muted">@Localizer["Recently created incidents"]</small>
                </div>
                <a asp-controller="Incidents" asp-action="Index" class="btn btn-sm btn-outline-primary">
                    @Localizer["View all incidents"] <i class="align-middle" data-lucide="arrow-right"></i>
                </a>
            </div>
            @if (Model.LatestIncidents.Count == 0)
            {
                <div class="card-body ac-empty-state">
                    <div class="ac-empty-icon">
                        <i data-lucide="bell-off"></i>
                    </div>
                    <h3 class="h5">@Localizer["No incidents yet"]</h3>
                    <p class="text-muted mb-4">@Localizer["Create the first incident via the API or SDK. It will appear here."]</p>
                    <a asp-controller="Applications" asp-action="GettingStarted" class="btn btn-primary">
                        <i class="align-middle me-1" data-lucide="rocket"></i>@Localizer["Quick Start Integration"]
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-3" style="width: 90px;">@Localizer["Severity"]</th>
                                <th>@Localizer["Incident title"]</th>
                                <th>@Localizer["Source application"]</th>
                                <th>@Localizer["Linked Incident"]</th>
                                <th class="text-end pe-3">@Localizer["Time"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var message in Model.LatestIncidents)
                            {
                                var rowClass = message.Level switch
                                {
                                    "sev0" => "ac-row-sev0",
                                    "sev1" => "ac-row-sev1",
                                    "sev2" => "ac-row-sev2",
                                    "sev3" => "ac-row-sev3",
                                    _ => "ac-row-sev4"
                                };
                                var badgeClass = message.Level switch
                                {
                                    "sev0" => "ac-badge-sev0",
                                    "sev1" => "ac-badge-sev1",
                                    "sev2" => "ac-badge-sev2",
                                    "sev3" => "ac-badge-sev3",
                                    _ => "ac-badge-sev4"
                                };
                                <tr class="@rowClass">
                                    <td class="ps-3">
                                        <span class="badge @badgeClass text-uppercase">@message.Level</span>
                                    </td>
                                    <td>
                                        <a asp-controller="Incidents" asp-action="Details" asp-route-id="@message.Id" class="fw-semibold text-decoration-none d-block text-break">
                                            @message.Title
                                        </a>
                                        @if (!string.IsNullOrWhiteSpace(message.Content))
                                        {
                                            <small class="text-muted text-truncate d-block" style="max-width: 24rem;">@message.Content</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="text-muted">@message.Application.Name</span>
                                    </td>
                                    <td>
                                            <a asp-controller="Incidents" asp-action="Details" asp-route-id="@message.Id" class="badge bg-warning-subtle text-warning-emphasis text-decoration-none">
                                                <i class="align-middle me-1" data-lucide="siren"></i>@IncidentStatusText(message.Status)
                                            </a>
                                            <span class="badge bg-secondary-subtle text-secondary">@(message.IsAcknowledged ? @Localizer["Acknowledged"].Value : @Localizer["Not acknowledged"].Value)</span>
                                    </td>
                                    <td class="text-end pe-3 text-muted small text-nowrap">
                                        <span data-utc-time="@message.ReceivedAtUtc.ToHtmlDateTime()"></span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Right Column: Quick Start & Workflows -->
    <div class="col-lg-4">
        <!-- Quick Report cURL Snippet -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="card-title mb-0"><i class="align-middle me-2" data-lucide="terminal"></i>@Localizer["Quick Report Example"]</h2>
                <span class="badge bg-secondary-subtle text-secondary">HTTP POST</span>
            </div>
            <div class="card-body pt-0">
                <p class="small text-muted mb-2">@Localizer["Use Bearer authentication to report test incidents:"]</p>
                <div class="ac-code-container mb-3">
                    <div class="ac-code-header">
                        <span>cURL</span>
                        <button type="button" class="ac-copy-btn" id="copy-dashboard-curl">
                            <i class="align-middle" data-lucide="copy"></i>@Localizer["Copy"]
                        </button>
                    </div>
                    <pre class="ac-code-pre" id="dashboard-curl-code"><code>curl -X POST '@endpoint' \
  -H 'Authorization: Bearer &lt;YOUR_API_KEY&gt;' \
  -H 'Content-Type: application/json' \
  -d '{"reportId":"@Guid.NewGuid()","title":"Service health check failed","level":"sev2","occurredAtUtc":"@DateTime.UtcNow.ToString("O")"}'</code></pre>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted">@Localizer["Supports .NET SDK / Go / Webhook"]</small>
                    <a asp-controller="Applications" asp-action="GettingStarted" class="btn btn-sm btn-outline-primary">@Localizer["Detailed Integration Documentation"]</a>
                </div>
            </div>
        </div>

        <!-- System Routing & Destinations -->
        <div class="card mb-4">
            <div class="card-header">
                <h2 class="card-title mb-0"><i class="align-middle me-2" data-lucide="route"></i>@Localizer["Notification Push Center"]</h2>
            </div>
            <div class="card-body pt-0">
                <div class="d-flex align-items-center gap-3 mb-3 p-3 bg-body-tertiary rounded">
                    <div class="ac-stat-icon icon-success">
                        <i data-lucide="webhook"></i>
                    </div>
                    <div class="flex-grow-1">
                        <strong class="d-block">@Localizer["Webhook Auto-Scheduling"]</strong>
                        <small class="text-muted">@Localizer["Supports custom request headers and JSON templates"]</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3 mb-3 p-3 bg-body-tertiary rounded">
                    <div class="ac-stat-icon icon-primary">
                        <i data-lucide="inbox"></i>
                    </div>
                    <div class="flex-grow-1">
                        <strong class="d-block">@Localizer["In-app notification Inbox"]</strong>
                        <small class="text-muted">@Localizer["Directly engage responsible parties and user groups for collaborative handling"]</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3 mb-3 p-3 bg-body-tertiary rounded">
                    <div class="ac-stat-icon icon-warning">
                        <i data-lucide="mail"></i>
                    </div>
                    <div class="flex-grow-1">
                        <strong class="d-block">@Localizer["SMTP Email Channel"]</strong>
                        <small class="text-muted">@Localizer["Batch dispatch to on-call groups and key emails"]</small>
                    </div>
                </div>
                <a asp-controller="Push" asp-action="Index" class="btn btn-outline-secondary w-100">
                    <i class="align-middle me-1" data-lucide="sliders"></i>@Localizer["Configure Push Channel"]
                </a>
            </div>
        </div>

        <!-- 4-Step Process -->
        <div class="card">
            <div class="card-header">
                <h2 class="card-title mb-0"><i class="align-middle me-2" data-lucide="workflow"></i>@Localizer["Ops Response Closure"]</h2>
            </div>
            <div class="card-body pt-0">
                <ol class="list-unstyled mb-0">
                    <li class="d-flex gap-3 mb-3">
                        <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 24px; height: 24px;">1</span>
                        <div><strong>@Localizer["Create Application and Get Key"]</strong><p class="text-muted small mb-0">@Localizer["Issue dedicated credentials in “Integrated Apps.”"]</p></div>
                    </li>
                    <li class="d-flex gap-3 mb-3">
                        <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 24px; height: 24px;">2</span>
                        <div><strong>@Localizer["Linked Push Channel"]</strong><p class="text-muted small mb-0">@Localizer["Route by Sev0-Sev4 in the app’s push settings."]</p></div>
                    </li>
                    <li class="d-flex gap-3 mb-3">
                        <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 24px; height: 24px;">3</span>
                        <div><strong>@Localizer["Automatic message delivery and troubleshooting"]</strong><p class="text-muted small mb-0">@Localizer["The center delivers notifications asynchronously, supporting record tracing and retries."]</p></div>
                    </li>
                    <li class="d-flex gap-3">
                        <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 24px; height: 24px;">4</span>
                        <div><strong>@Localizer["Incident triggering and collaborative resolution"]</strong><p class="text-muted small mb-0">@Localizer["Report details, handling history, and resolution status."]</p></div>
                    </li>
                </ol>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/scripts/dashboard.js" asp-append-version="true" defer></script>
}
