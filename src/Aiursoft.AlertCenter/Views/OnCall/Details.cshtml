@model Aiursoft.AlertCenter.Models.OnCallViewModel
@{
    var group = Model.Groups.Single(item => item.Id == Model.SelectedGroupId);
    var rule = group.Rule;
}
@section styles {
    <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" />
}
@section scripts {
    <script src="~/scripts/oncall-gantt.js" asp-append-version="true"></script>
    <script src="~/scripts/oncall-schedule.js" asp-append-version="true"></script>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <h1 class="h3 mb-1">@group.Name · @Localizer["On-call schedule"]</h1>
        <p class="text-muted mb-0">@group.TimeZoneId · @Localizer["Three shifts per day, supporting multiple members per shift. Actual shifts are stored under the team."]</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Schedule" class="btn btn-outline-secondary">@Localizer["Back to Schedule List"]</a>
        <a asp-action="GroupDetails" asp-route-id="@group.Id" class="btn btn-outline-primary">@Localizer["View team"]</a>
        @if (Model.CanManageOnCall)
        {
            <a asp-action="GroupEdit" asp-route-id="@group.Id" class="btn btn-primary">@Localizer["Edit team"]</a>
        }
    </div>
</div>
<div class="card mb-4">
    <div class="card-header"><h2 class="card-title mb-0">@Localizer["Team configuration"]</h2></div>
    <div class="card-body">
        <p>@Localizer["Per shift "]@(rule?.ShiftHours ?? 8) @Localizer["hours · Weekly min "]@Model.ScheduleMinimumStaff @Localizer["people · Shortest rest this week "]@Model.ScheduleRestHours @Localizer["hours · Anchor "]@group.AnchorUtc.ToString("yyyy-MM-dd HH:mm") UTC</p>
        @if (rule != null)
        {
            <p>@Localizer["Rule template:"]<a asp-action="Details" asp-route-id="@rule.Id">@rule.Name</a> · @Localizer["Minimum template cooldown "]@rule.RestHours @Localizer["hours · Shift min "]@rule.MinimumStaff @Localizer["people, target "]@(rule.TargetStaff?.ToString() ?? @Localizer["Auto-assign"].Value) @Localizer["people · Time-slot rotation: "]@(rule.BalanceShiftTimes ? @Localizer["Balance early, middle, and late shifts as evenly as possible"].Value : @Localizer["Close, prioritize fixed time slots"].Value)</p>
        }
        else
        {
            <p class="text-muted">@Localizer["No rule template bound, manual scheduling available; new shifts default to min rest "]@(rule?.RestHours ?? 16) @Localizer["hours."]</p>
        }
        <p class="small text-muted">@Localizer["Modifying templates, re-binding templates, or adding/removing members will not regenerate saved shifts. After removing a member, upcoming assignments are cleared; empty shifts must be filled manually."]</p>
        <h3 class="h6">@Localizer["Rotate Members"]</h3>
        @if (group.Members.Count == 0)
        {
            <p class="text-muted mb-0">@Localizer["No team members. Please edit the team to add members before manually filling empty shifts."]</p>
        }
        else
        {
            <ol class="mb-0">
                @foreach (var member in group.Members.OrderBy(item => item.RotationOrder))
                {
                    <li>@member.User.DisplayName (@(member.User.UserName ?? member.UserId))</li>
                }
            </ol>
        }
    </div>
</div>
@if (group.Members.Any(member => Model.OtherGroupMemberships.Any(other => other.UserId == member.UserId)))
{
    <div id="oncall-shared-members" class="alert alert-warning" role="alert">
        <div class="alert-icon">
            <i class="align-middle" data-lucide="users" aria-hidden="true"></i>
        </div>
        <div class="alert-message">
            <h2 class="h6">@Localizer["Cross-on-call-group members require manual scheduling"]</h2>
            <p>@Localizer["The following employees belong to multiple on-call groups; automatic preview and scheduling will skip them. Saved arrangements remain unchanged; manual scheduling and cross-group conflict validation are still available."]</p>
            <ul class="mb-0">
                @foreach (var member in group.Members.OrderBy(item => item.RotationOrder))
                {
                    var others = Model.OtherGroupMemberships.Where(other => other.UserId == member.UserId).ToList();
                    if (others.Count == 0) { continue; }
                    <li>
                        <strong>@member.User.DisplayName</strong> · @Localizer["Other teams: "]
                        @foreach (var other in others)
                        {
                            <a asp-action="ScheduleDetails" asp-route-id="@other.GroupId" class="alert-link me-2">@other.Group.Name</a>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
}
<div class="card">
    <div class="card-header"><h2 class="card-title mb-0">@Localizer["7-Day On-Call Schedule"]</h2></div>
    <div class="card-body">
        @if (Model.StaffingWarnings.Count > 0)
        {
            <div class="alert alert-warning" role="alert">
                <div class="alert-message">
                    <details open>
                        <summary class="fw-semibold">@Localizer["Insufficient staff warning (manual save allowed, except for empty shifts)"]</summary>
                        <ul class="mt-2 mb-0">@foreach (var warning in Model.StaffingWarnings) { <li>@warning</li> }</ul>
                    </details>
                </div>
            </div>
        }
        @if (Model.PreviewError != null)
        {
            <div class="alert alert-warning" role="alert">
                <div class="alert-message text-break">@Model.PreviewError</div>
            </div>
        }
        @if (Model.WeekStartUtc != default)
        {
            var staffNames = Model.PreviewUsers.ToDictionary(user => user.Id, user => user.DisplayName);
            var totalHours = Model.Preview.DistinctBy(shift => shift.StartsAtUtc).Sum(shift => (shift.EndsAtUtc - shift.StartsAtUtc).TotalHours);
            var zone = TimeZoneInfo.FindSystemTimeZoneById(group.TimeZoneId);
            var now = DateTime.UtcNow;
            var currentShift = Model.Preview.FirstOrDefault(shift => shift.StartsAtUtc <= now && now < shift.EndsAtUtc);
            var firstShift = Model.Preview.FirstOrDefault();
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                @if (Model.WeekStartUtc > group.AnchorUtc)
                {
                    <a asp-action="ScheduleDetails" asp-route-id="@group.Id" asp-route-startUtc="@Model.WeekStartUtc.AddDays(-7).ToString("O")" class="btn btn-outline-secondary btn-sm">@Localizer["Previous Week"]</a>
                }
                <a asp-action="ScheduleDetails" asp-route-id="@group.Id" class="btn btn-outline-secondary btn-sm">@Localizer["Current Week"]</a>
                @if (Model.WeekStartUtc < DateTime.MaxValue.AddDays(-35))
                {
                    <a asp-action="ScheduleDetails" asp-route-id="@group.Id" asp-route-startUtc="@Model.WeekStartUtc.AddDays(7).ToString("O")" class="btn btn-outline-secondary btn-sm">@Localizer["Next Week"]</a>
                }
                <span id="oncall-save-state" class="badge @(Model.ScheduleSaved ? "bg-success" : "bg-secondary")">@(Model.ScheduleSaved ? @Localizer["Saved"].Value : Model.CanGenerateSchedule ? @Localizer["Unsaved · Auto-suggested"].Value : @Localizer["Unsaved · Manual schedule"].Value)</span>
            </div>
            @if (firstShift != null)
            {
                <div class="alert alert-primary" role="status">
                    <div class="alert-icon">
                        <i class="align-middle" data-lucide="clock" aria-hidden="true"></i>
                    </div>
                    <div class="alert-message d-flex flex-wrap align-items-center gap-2">
                        @if (currentShift != null)
                        {
                            <span class="badge bg-primary">@Localizer["Current On-Call"]</span>
                            <strong class="text-break">@string.Join("、", Model.Preview.Where(shift => shift.StartsAtUtc == currentShift.StartsAtUtc).Select(shift => staffNames.GetValueOrDefault(shift.UserId, @Localizer["Employee deleted"].Value)))</strong>
                            <span>@Localizer["This shift ends at "]@TimeZoneInfo.ConvertTimeFromUtc(currentShift.EndsAtUtc, zone).ToString("MM-dd HH:mm")</span>
                        }
                        else
                        {
                            <span class="badge bg-primary">@(firstShift.StartsAtUtc > now ? @Localizer["Starting soon"].Value : @Localizer["This week's schedule"].Value)</span>
                            <strong class="text-break">@staffNames.GetValueOrDefault(firstShift.UserId, @Localizer["Employee deleted"].Value)</strong>
                            <span>@Localizer["First class at "]@TimeZoneInfo.ConvertTimeFromUtc(firstShift.StartsAtUtc, zone).ToString("MM-dd HH:mm") @Localizer["Start"]</span>
                        }
                        <span class="small">（@group.TimeZoneId，@Localizer["Status is based on page load time)"]</span>
                    </div>
                </div>
            }
            else
            {
                <p class="text-muted">@Localizer["No shifts are currently assigned this week. You can add personnel manually."]</p>
            }
            <div class="row g-3 mb-3">
                <div class="col-sm-4"><div class="card border h-100 mb-0"><div class="card-body py-3"><div class="text-muted small">@Localizer["Shift covered"]</div><strong class="fs-4" data-oncall-stat="shifts">@Model.Preview.Select(shift => shift.StartsAtUtc).Distinct().Count()</strong></div></div></div>
                <div class="col-sm-4"><div class="card border h-100 mb-0"><div class="card-body py-3"><div class="text-muted small">@Localizer["Participating employees"]</div><strong class="fs-4" data-oncall-stat="staff">@Model.Preview.Select(shift => shift.UserId).Distinct().Count()</strong></div></div></div>
                <div class="col-sm-4"><div class="card border h-100 mb-0"><div class="card-body py-3"><div class="text-muted small">@Localizer["Override duration"]</div><strong class="fs-4" data-oncall-stat="hours">@totalHours.ToString("0") @Localizer["hours"]</strong></div></div></div>
            </div>
            @if (Model.CanManageOnCall)
            {
                @await Html.PartialAsync("_ScheduleEditor", Model)
            }
            @await Html.PartialAsync("_PreviewGantt", Model)
        }
        else
        {
            <p class="text-muted mb-0">@Localizer["No valid scheduling weeks. Please check the team's scheduling start point."]</p>
        }
    </div>
</div>
