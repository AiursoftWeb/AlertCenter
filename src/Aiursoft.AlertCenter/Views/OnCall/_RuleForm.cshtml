@model Aiursoft.AlertCenter.Models.OnCallViewModel
@inject IHtmlLocalizerFactory OnCallLocalizerFactory
@{ var viewLocalizer = OnCallLocalizerFactory.Create("Views.OnCall._RuleForm", typeof(Aiursoft.AlertCenter.Startup).Assembly.GetName().Name!); }
<form asp-action="SaveRule" method="post" data-action-feedback id="oncall-template-form">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <input asp-for="RuleInput.Id" type="hidden" />
    <div class="row g-3 mb-3">
        <div class="col-md-6"><label asp-for="RuleInput.Name" class="form-label">@viewLocalizer["Template name"]</label><input asp-for="RuleInput.Name" class="form-control" maxlength="100" required /></div>
        <div class="col-md-6">
            <label asp-for="RuleInput.SplitMode" class="form-label">@viewLocalizer["Split mode"]</label>
            <select asp-for="RuleInput.SplitMode" class="form-select"><option value="fixed">@viewLocalizer["Fixed duration"]</option><option value="weekly">@viewLocalizer["Weekly handover points"]</option></select>
        </div>
        <div class="col-md-4" id="oncall-fixed-duration">
            <label asp-for="RuleInput.ShiftMinutes" class="form-label">@viewLocalizer["Shift duration (minutes)"]</label>
            <input asp-for="RuleInput.ShiftMinutes" value="@(Model.RuleInput.ShiftMinutes ?? Model.RuleInput.ShiftHours * 60)" type="number" min="1" class="form-control" required />
        </div>
        <div class="col-md-4"><label asp-for="RuleInput.StaffPerShift" class="form-label">@viewLocalizer["Staff per shift"]</label><input asp-for="RuleInput.StaffPerShift" value="@(Model.RuleInput.StaffPerShift ?? 1)" type="number" min="1" max="200" class="form-control" required /></div>
        <div class="col-md-4">
            <label asp-for="RuleInput.SwapAlternateRounds" class="form-label">@viewLocalizer["Rotation strategy"]</label>
            <select asp-for="RuleInput.SwapAlternateRounds" class="form-select"><option value="false">@viewLocalizer["Pure queue"]</option><option value="true">@viewLocalizer["Swap adjacent members on alternate rounds for even-sized teams"]</option></select>
        </div>
    </div>
    <div id="oncall-weekly-points" class="mb-3">
        <div id="oncall-handover-points">
            @foreach (var point in Model.RuleInput.HandoverPoints ?? [])
            {
                <div class="d-flex flex-wrap gap-2 mb-2" data-handover-point>
                    <select class="form-select w-auto" data-point-day aria-label="@viewLocalizer["Day of week"]">@foreach (var day in Enum.GetValues<DayOfWeek>()) { <option value="@((int)day)" selected="@(day == point.DayOfWeek)">@viewLocalizer[day.ToString()]</option> }</select>
                    <input type="time" class="form-control w-auto" data-point-time value="@(TimeOnly.MinValue.AddMinutes(point.MinuteOfDay).ToString("HH:mm"))" aria-label="@viewLocalizer["Handover time"]" required />
                    <button type="button" class="btn btn-outline-danger" data-remove-point>@viewLocalizer["Remove"]</button>
                </div>
            }
        </div>
        <button type="button" id="oncall-add-point" class="btn btn-outline-primary">@viewLocalizer["Add handover point"]</button>
    </div>
    <template id="oncall-point-template">
        <div class="d-flex flex-wrap gap-2 mb-2" data-handover-point>
            <select class="form-select w-auto" data-point-day aria-label="@viewLocalizer["Day of week"]">@foreach (var day in Enum.GetValues<DayOfWeek>()) { <option value="@((int)day)">@viewLocalizer[day.ToString()]</option> }</select>
            <input type="time" class="form-control w-auto" data-point-time value="22:00" aria-label="@viewLocalizer["Handover time"]" required />
            <button type="button" class="btn btn-outline-danger" data-remove-point>@viewLocalizer["Remove"]</button>
        </div>
    </template>
    <button type="button" id="oncall-eight-hour-preset" class="btn btn-outline-secondary mb-3">@viewLocalizer["8-hour three-shift preset"]</button>
    <p class="small text-muted">@viewLocalizer["Define how shifts are split and rotated for teams' automatic extension and one-click generation. Changing a template does not affect scheduled shifts."]</p>
    <button type="submit" class="btn btn-primary">@viewLocalizer["Save template"]</button>
    <a asp-action="Index" class="btn btn-outline-secondary ms-2">@viewLocalizer["Cancel"]</a>
</form>
