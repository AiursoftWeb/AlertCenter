@model Aiursoft.AlertCenter.Models.OnCallViewModel

<form asp-action="SaveRule" method="post" data-action-feedback>
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <input asp-for="RuleInput.Id" type="hidden" />
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="RuleInput.Name" class="form-label">@Localizer["Template name"]</label>
            <input asp-for="RuleInput.Name" class="form-control" maxlength="100" required />
        </div>
        <div class="col-md-3">
            <label asp-for="RuleInput.ShiftHours" class="form-label">@Localizer["Shift duration (hours)"]</label>
            <input asp-for="RuleInput.ShiftHours" type="number" value="8" class="form-control" readonly />
            <div class="form-text">@Localizer["Fixed three shifts per day, at least one person per shift; multiple people per shift allowed."]</div>
        </div>
        <div class="col-md-3">
            <label asp-for="RuleInput.RestHours" class="form-label">@Localizer["Minimum Rest (Hours)"]</label>
            <input asp-for="RuleInput.RestHours" type="number" min="0" max="168" class="form-control" required />
        </div>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label asp-for="RuleInput.MinimumStaff" class="form-label">@Localizer["Minimum staff per shift"]</label>
            <input asp-for="RuleInput.MinimumStaff" type="number" min="1" max="200" class="form-control" required />
            <div class="form-text">@Localizer["Auto-generation must meet requirements; insufficient manual staffing triggers a warning only, while empty shifts cannot be saved."]</div>
        </div>
        <div class="col-md-4">
            <label asp-for="RuleInput.TargetStaff" class="form-label">@Localizer["Target staff per shift"]</label>
            <input asp-for="RuleInput.TargetStaff" type="number" min="1" max="200" class="form-control" />
            <div class="form-text">@Localizer["Cannot be lower than the minimum headcount; satisfy as much as possible when overrides and breaks allow. Leave blank for automatic assignment."]</div>
        </div>
        <div class="col-md-4">
            <label asp-for="RuleInput.BalanceShiftTimes" class="form-label">@Localizer["Rotation Preference"]</label>
            <select asp-for="RuleInput.BalanceShiftTimes" class="form-select">
                <option value="false">@Localizer["Fixed time slots take priority"]</option>
                <option value="true">@Localizer["Balance early, middle, and late shifts as evenly as possible"]</option>
            </select>
        </div>
    </div>
    <p class="small text-muted">@Localizer["Coverage and rest are prioritized; redundancy may decrease during swaps. Rotation is not allowed for teams of three with at least 16 hours of rest. Scheduling is based on actual 8-hour continuous shifts; local time may change during daylight saving time transitions."]</p>
    <p class="small text-muted">@Localizer["This is a rule template available for sharing across multiple teams. Members, rotation order, and schedule start points are managed by the team. Modifying the template will not regenerate any saved shifts."]</p>
    <button type="submit" class="btn btn-primary">@Localizer["Save template"]</button>
    <a asp-action="Index" class="btn btn-outline-secondary ms-2">@Localizer["Cancel"]</a>
</form>
