@model Aiursoft.AlertCenter.Models.OnCallViewModel
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">@Localizer["Create Team"]</h1>
    <a asp-action="Groups" class="btn btn-outline-secondary">@Localizer["Back to Team List"]</a>
</div>
<p class="text-muted">@Localizer["Manage team settings and the people available for on-call scheduling."]</p>
<div class="card"><div class="card-body"><partial name="_GroupForm" model="Model" /></div></div>

@section scripts {
    <script src="~/scripts/oncall-group-form.js" asp-append-version="true"></script>
    <script src="~/scripts/oncall-member-search.js" asp-append-version="true"></script>
}
