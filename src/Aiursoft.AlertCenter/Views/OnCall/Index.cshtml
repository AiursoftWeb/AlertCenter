@model Aiursoft.AlertCenter.Models.OnCallViewModel

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">自动排班规则</h1>
        <p class="text-muted mb-0">选择规则查看未来七天的自动排班预览。规则不会发布班次或影响告警路由。</p>
    </div>
    @if (Model.IsAdministrator && Model.Groups.Count > 0)
    {
        <a asp-action="Create" class="btn btn-primary">创建规则</a>
    }
</div>

@if (Model.IsAdministrator)
{
    <div class="card mb-4">
        <div class="card-header"><h2 class="card-title mb-0">创建团队</h2></div>
        <div class="card-body">
            <form asp-action="CreateGroup" method="post" class="row g-3">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="col-md-5">
                    <label asp-for="GroupInput.Name" class="form-label">团队名称</label>
                    <input asp-for="GroupInput.Name" class="form-control" maxlength="100" required />
                </div>
                <div class="col-md-5">
                    <label asp-for="GroupInput.TimeZoneId" class="form-label">时区</label>
                    <select asp-for="GroupInput.TimeZoneId" asp-items="Model.TimeZones" class="form-select" required></select>
                    <div class="form-text">选择团队所在时区；排班锚点仍以 UTC 保存。</div>
                </div>
                <div class="col-md-2 align-self-end"><button type="submit" class="btn btn-primary">创建团队</button></div>
            </form>
        </div>
    </div>

}

<div class="card">
    <div class="card-header"><h2 class="card-title mb-0">已保存规则</h2></div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>团队</th><th>规则</th><th>班次 / 休息</th><th>成员数</th><th>操作</th></tr></thead>
            <tbody>
                @foreach (var rule in Model.Rules)
                {
                    <tr>
                        <td>@rule.Group.Name (@rule.Group.TimeZoneId)</td>
                        <td>@rule.Name</td>
                        <td>@rule.ShiftHours / @rule.RestHours 小时</td>
                        <td>@rule.Members.Count</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@rule.Id" class="btn btn-sm btn-outline-primary">查看排班</a>
                            @if (Model.IsAdministrator)
                            {
                                <a asp-action="Edit" asp-route-id="@rule.Id" class="btn btn-sm btn-outline-secondary">编辑</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Rules.Count == 0)
    {
        <div class="card-body text-muted">目前没有已保存的规则。请先创建团队和规则。</div>
    }
</div>
