@model Aiursoft.AlertCenter.Models.OnCallViewModel
@using Aiursoft.AlertCenter.Entities
@{
    ViewData["Title"] = "请假与交接";
    var group = Model.Group;
    var zone = group == null ? TimeZoneInfo.Utc : TimeZoneInfo.FindSystemTimeZoneById(group.TimeZoneId);
    DateTime Local(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(utc, zone);
}
@section styles { <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" /> }
<partial name="_AdminNavigation" model="Model" />
@if (group != null)
{
    <section class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent"><h2 class="h5 mb-0">代提交请假</h2></div>
        <div class="card-body">
            <form asp-action="RequestLeave" method="post" class="row g-3 align-items-end">
                <input type="hidden" name="groupId" value="@group.Id" />
                <div class="col-lg-3"><label for="leave-user" class="form-label">请假工程师</label><select id="leave-user" name="userId" class="form-select" required><option value="">选择成员</option>@foreach (var member in Model.Members) { <option value="@member.UserId">@member.User.DisplayName</option> }</select></div>
                <div class="col-lg-2 col-sm-6"><label for="leave-start" class="form-label">开始 (@group.TimeZoneId)</label><input id="leave-start" name="startsAtLocal" type="datetime-local" class="form-control" required /></div>
                <div class="col-lg-2 col-sm-6"><label for="leave-end" class="form-label">结束 (@group.TimeZoneId)</label><input id="leave-end" name="endsAtLocal" type="datetime-local" class="form-control" required /></div>
                <div class="col-lg-3"><label for="leave-reason" class="form-label">原因</label><input id="leave-reason" name="reason" maxlength="1000" class="form-control" required /></div>
                <div class="col-lg-2"><button class="btn btn-primary w-100">提交申请</button></div>
            </form>
            <p class="small text-muted mt-3 mb-0">批准前，请先在 <a asp-action="Schedule" asp-route-id="@group.Id">排班与覆盖</a> 为请假时段内的本人班次安排完整代班。</p>
        </div>
    </section>
    <div class="row g-4">
        <div class="col-lg-6"><section class="card shadow-sm border-0 h-100">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">待审批请假</h2><span class="badge bg-secondary-subtle text-secondary">@Model.PendingLeaveCount 待审批</span></div>
            <div class="card-body">
                @if (Model.LeaveRequests.Count == 0) { <p class="text-muted">暂无待审批请假申请。</p> }
                @foreach (var leave in Model.LeaveRequests)
                {
                    <div class="border-bottom py-3">
                        <div class="d-flex justify-content-between gap-2"><strong>@(leave.User?.DisplayName ?? "未知")</strong><span class="badge bg-secondary-subtle text-secondary">@leave.Status</span></div>
                        <div class="small text-muted">@Local(leave.StartsAtUtc).ToString("MM-dd HH:mm") – @Local(leave.EndsAtUtc).ToString("MM-dd HH:mm") · @leave.Reason</div>
                        @if (leave.Status == OnCallLeaveRequest.Pending)
                        {
                            <form asp-action="ReviewLeave" method="post" class="d-flex gap-2 mt-2"><input type="hidden" name="id" value="@leave.Id" /><button name="approve" value="true" class="btn btn-sm btn-success">批准</button><button name="approve" value="false" class="btn btn-sm btn-outline-danger">拒绝</button></form>
                        }
                    </div>
                }
            </div>
        </section></div>
        <div class="col-lg-6"><section class="card shadow-sm border-0 h-100">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">待确认交接</h2><span class="badge bg-secondary-subtle text-secondary">@Model.PendingHandoverCount 待确认</span></div>
            <div class="card-body">
                <p class="small text-muted">成员可在值班概览中对本人班次申请交接；接班人确认后将生成 <a asp-action="Debts" asp-route-id="@group.Id">补班债务</a>。</p>
                @if (Model.HandoverRequests.Count == 0) { <p class="text-muted">暂无待确认的交接申请。</p> }
                @foreach (var handover in Model.HandoverRequests)
                {
                    <div class="border-bottom py-3">
                        <div class="d-flex justify-content-between gap-2"><strong>@(handover.RequestedByUser?.DisplayName ?? "未知") → @(handover.ReceivingUser?.DisplayName ?? "未知")</strong><span class="badge bg-secondary-subtle text-secondary">@handover.Status</span></div>
                        <div class="small text-muted">@Local(handover.StartsAtUtc).ToString("MM-dd HH:mm") – @Local(handover.EndsAtUtc).ToString("MM-dd HH:mm")</div>
                        @if (!string.IsNullOrWhiteSpace(handover.Note)) { <div class="small text-muted">说明：@handover.Note</div> }
                        @if (handover.Status == OnCallHandoverRequest.Pending)
                        {
                            <form asp-action="ReviewHandover" method="post" class="d-flex gap-2 mt-2"><input type="hidden" name="id" value="@handover.Id" /><button name="confirm" value="true" class="btn btn-sm btn-success">确认接班</button><button name="confirm" value="false" class="btn btn-sm btn-outline-danger">拒绝</button></form>
                        }
                    </div>
                }
            </div>
        </section></div>
    </div>
}
