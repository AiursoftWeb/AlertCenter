@model Aiursoft.AlertCenter.Models.OnCallViewModel
@{
    ViewData["Title"] = "补班债务";
    var group = Model.Group;
    var zone = group == null ? TimeZoneInfo.Utc : TimeZoneInfo.FindSystemTimeZoneById(group.TimeZoneId);
    DateTime Local(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(utc, zone);
    string GetInitial(string? name) => string.IsNullOrWhiteSpace(name) ? "?" : name[..1].ToUpperInvariant();
}
@section styles {
    <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" />
}
<partial name="_AdminNavigation" model="Model" />

@if (group != null)
{
    <section class="card shadow-sm border-0">
        <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0 d-flex align-items-center gap-2">
                <i data-lucide="scale" class="text-primary" style="width: 18px; height: 18px;"></i>
                <span>补班债务</span>
            </h2>
            <span class="badge @(Model.UnsettledDebtCount > 0 ? "bg-danger text-white" : "bg-secondary-subtle text-secondary") border font-monospace">
                @Model.UnsettledDebtCount 待偿还
            </span>
        </div>
        <div class="card-body p-4">
            <div class="p-3 bg-light rounded-3 border mb-4 small text-muted">
                <div class="d-flex align-items-center gap-1.5 fw-medium text-body mb-1">
                    <i data-lucide="info" class="text-primary" style="width: 15px; height: 15px;"></i>
                    <span>补班债务机制说明</span>
                </div>
                <p class="mb-0">确认交接或安排临时覆盖后产生补班债务。欠班工程师在同一值班组承担足够时长的代班后，可使用对应覆盖记录偿还。</p>
            </div>

            @if (Model.CoverageDebts.Count == 0)
            {
                <div class="p-5 text-center text-muted">
                    <div class="ac-empty-icon mb-2">
                        <i data-lucide="check-check" style="width: 28px; height: 28px;"></i>
                    </div>
                    <p class="mb-0">暂无待偿还补班债务。</p>
                </div>
            }
            @foreach (var debt in Model.CoverageDebts)
            {
                var eligible = Model.SettlementOverrides.Where(item => item.CoveringUserId == debt.OwingUserId && (item.EndsAtUtc - item.StartsAtUtc).TotalMinutes >= debt.DurationMinutes).ToList();
                <div class="card border mb-3 shadow-none">
                    <div class="card-body p-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2 pb-2 border-bottom">
                            <div class="d-flex align-items-center gap-2">
                                <span class="ac-app-avatar" style="width: 28px; height: 28px; font-size: 0.75rem;">@GetInitial(debt.OwingUser?.DisplayName)</span>
                                <strong>@(debt.OwingUser?.DisplayName ?? "未知")</strong>
                                <span class="text-muted small">欠</span>
                                <span class="ac-app-avatar" style="width: 28px; height: 28px; font-size: 0.75rem;">@GetInitial(debt.CoveringUser?.DisplayName)</span>
                                <strong>@(debt.CoveringUser?.DisplayName ?? "未知")</strong>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-light text-muted border font-monospace">@debt.DurationMinutes 分钟 (@(Math.Round(debt.DurationMinutes / 60.0, 1))h)</span>
                                <span class="badge @(debt.SettledAtUtc.HasValue ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") d-inline-flex align-items-center gap-1">
                                    @if (debt.SettledAtUtc.HasValue)
                                    {
                                        <i data-lucide="check-check" style="width: 12px; height: 12px;"></i>
                                        <span>已偿还</span>
                                    }
                                    else
                                    {
                                        <i data-lucide="clock-alert" style="width: 12px; height: 12px;"></i>
                                        <span>待偿还</span>
                                    }
                                </span>
                            </div>
                        </div>

                        <div class="text-muted small mb-2">
                            <span>@debt.DurationMinutes 分钟</span>
                        </div>

                        @if (!debt.SettledAtUtc.HasValue)
                        {
                            <form asp-action="SettleDebt" method="post" class="row g-2 align-items-end p-2 bg-light rounded border mt-2">
                                <input type="hidden" name="debtId" value="@debt.Id" />
                                <div class="col-md-9">
                                    <label class="form-label small fw-medium text-muted mb-1" for="settlement-@debt.Id">欠班人承担的代班 (@group.TimeZoneId)</label>
                                    <select id="settlement-@debt.Id" name="settlementOverrideId" class="form-select form-select-sm" required>
                                        <option value="">选择足够时长的代班记录</option>
                                        @foreach (var item in eligible)
                                        {
                                            <option value="@item.Id">@Local(item.StartsAtUtc).ToString("MM-dd HH:mm") – @Local(item.EndsAtUtc).ToString("MM-dd HH:mm") · @item.Reason</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <button class="btn btn-sm btn-outline-primary w-100 d-inline-flex align-items-center justify-content-center gap-1" disabled="@(eligible.Count == 0)">
                                        <i data-lucide="check" style="width: 13px; height: 13px;"></i>
                                        <span>偿还债务</span>
                                    </button>
                                </div>
                            </form>
                            @if (eligible.Count == 0)
                            {
                                <p class="small text-muted mt-2 mb-0">暂无足够时长的代班记录。可在 <a asp-action="Schedule" asp-route-id="@group.Id" class="fw-semibold">排班与覆盖</a> 安排代班。</p>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </section>
}
