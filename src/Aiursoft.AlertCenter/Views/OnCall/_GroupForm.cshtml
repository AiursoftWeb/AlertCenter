@model Aiursoft.AlertCenter.Models.OnCallViewModel

<form asp-action="@(Model.SelectedGroupId.HasValue ? "UpdateGroup" : "CreateGroup")" method="post" id="oncall-group-form" data-search-url="@Url.Action("SearchUsers", "OnCall")">
    @if (Model.SelectedGroupId.HasValue)
    {
        <input type="hidden" name="id" value="@Model.SelectedGroupId" />
    }
    <input asp-for="GroupInput.Version" type="hidden" />
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="GroupInput.Name" class="form-label">团队名称</label>
            <input asp-for="GroupInput.Name" class="form-control" maxlength="100" required />
        </div>
        <div class="col-md-6">
            <label asp-for="GroupInput.TimeZoneId" class="form-label">时区</label>
            <select asp-for="GroupInput.TimeZoneId" asp-items="Model.TimeZones" class="form-select" required></select>
            <div class="form-text">可输入时区名称、城市或 UTC 偏移搜索。排班锚点仍以 UTC 保存，显示时使用团队时区。</div>
        </div>
        <div class="col-md-6">
            <label asp-for="GroupInput.RuleId" class="form-label">排班规则模板</label>
            <select asp-for="GroupInput.RuleId" class="form-select">
                <option value="">不绑定模板（手动排班）</option>
                @foreach (var rule in Model.Rules)
                {
                    <option value="@rule.Id">@rule.Name</option>
                }
            </select>
            <div class="form-text">多个团队可共用同一模板。切换或修改模板不会重新生成已保存的班次。</div>
        </div>
        <div class="col-md-6">
            <label for="anchor-utc" class="form-label">排班起点（UTC）</label>
            @if (Model.GroupHasSavedSchedule)
            {
                <input type="hidden" name="GroupInput.AnchorUtc" value="@Model.GroupInput.AnchorUtc?.ToString("O")" />
                <input id="anchor-utc" type="datetime-local" class="form-control" readonly value="@Model.GroupInput.AnchorUtc?.ToString("yyyy-MM-ddTHH:mm")" />
            }
            else
            {
                <input id="anchor-utc" name="GroupInput.AnchorUtc" type="datetime-local" class="form-control" required value="@Model.GroupInput.AnchorUtc?.ToString("yyyy-MM-ddTHH:mm")" />
            }
            <div class="form-text">按 UTC 填写，不会根据团队时区自动换算。保存过班次后，排班起点不可更改。</div>
        </div>
    </div>
    <h3 class="h6">轮换成员</h3>
    <p class="text-muted small">输入姓名/账号后查找，或直接选择角色自动分页列出该角色全部员工；翻页不会清除已选成员。下方成员顺序即轮换顺序。</p>
    <p class="text-muted small">成员可随时增减；移除成员仅清除尚未开始的班次安排，已开始和历史班次保留。由此产生的空班需手动补充人员。</p>
    <div class="row g-2 mb-2">
        <div class="col-md-5">
            <label for="oncall-user-search" class="form-label">搜索员工</label>
            <input id="oncall-user-search" type="search" maxlength="100" class="form-control" placeholder="姓名或账号" autocomplete="off" />
        </div>
        <div class="col-md-5">
            <label for="oncall-role" class="form-label">按角色浏览全部员工</label>
            <select id="oncall-role" class="form-select">
                <option value="">全部角色</option>
                @foreach (var role in Model.Roles)
                {
                    <option value="@role.Value">@role.Text</option>
                }
            </select>
        </div>
        <div class="col-md-2 align-self-end"><button id="oncall-search-button" type="button" class="btn btn-outline-primary w-100">查找</button></div>
    </div>
    <div id="oncall-search-status" class="small text-muted mb-2" role="status">输入关键词查找，或选角色立即浏览该角色全部员工。</div>
    <div id="oncall-search-results" class="list-group mb-2"></div>
    <div class="d-flex gap-2 mb-3">
        <button type="button" id="oncall-prev" class="btn btn-sm btn-outline-secondary" disabled>上一页</button>
        <span id="oncall-page" class="small align-self-center"></span>
        <button type="button" id="oncall-next" class="btn btn-sm btn-outline-secondary" disabled>下一页</button>
    </div>
    <h4 class="h6">已选成员（可为空，最多 200 人）</h4>
    <ol id="oncall-selected" class="list-group list-group-numbered mb-3">
        @foreach (var userId in Model.GroupInput.UserIds)
        {
            var user = Model.SelectedUsers.FirstOrDefault(item => item.Id == userId);
            <li class="list-group-item d-flex justify-content-between align-items-center" data-user-id="@userId" data-name="@(user?.DisplayName ?? "已删除的员工")" data-username="@(user?.UserName ?? userId)">
                <input type="hidden" name="GroupInput.UserIds" value="@userId" class="oncall-member-id" />
                <span>@(user?.DisplayName ?? "已删除的员工") (@(user?.UserName ?? userId))</span>
                <button type="button" class="btn btn-sm btn-outline-danger oncall-remove">移除</button>
            </li>
        }
    </ol>
    <button type="submit" class="btn btn-primary">保存团队</button>
    <a asp-action="Groups" class="btn btn-outline-secondary ms-2">取消</a>
</form>
