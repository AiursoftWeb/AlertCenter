@model Aiursoft.AlertCenter.Models.OnCallViewModel
@{
    ViewData["Title"] = "值班组配置";
    var group = Model.Group;
    var groupForm = Model.GroupForm;
}
@section styles {
    <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" />
}
<partial name="_AdminNavigation" model="Model" />

<div class="row g-4">
    <div class="col-lg-5">
        <section class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent border-bottom py-3">
                <h2 class="h5 mb-0 d-flex align-items-center gap-2">
                    <i data-lucide="plus-circle" class="text-primary" style="width: 18px; height: 18px;"></i>
                    <span>新建值班组</span>
                </h2>
            </div>
            <div class="card-body p-4">
                <form asp-action="SaveGroup" method="post" class="vstack gap-3">
                    @if (!Model.EditingGroupForm && !ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger small mb-1" role="alert"></div>
                    }
                    <div>
                        <label for="create-group-name" class="form-label small fw-medium mb-1">名称</label>
                        <input id="create-group-name" name="GroupForm.Name" value="@(Model.EditingGroupForm ? "" : groupForm.Name)" required maxlength="100" class="form-control" placeholder="例如：生产值班" />
                        @if (!Model.EditingGroupForm) { <span asp-validation-for="GroupForm.Name" class="text-danger small d-block mt-1"></span> }
                    </div>
                    <div>
                        <label for="create-time-zone" class="form-label small fw-medium mb-1">时区</label>
                        <select name="GroupForm.TimeZoneId" id="create-time-zone" class="form-select js-time-zone" required aria-describedby="create-time-zone-help">
                            @foreach (var zone in Model.TimeZones)
                            {
                                <option value="@zone.Id" selected="@(!Model.EditingGroupForm && groupForm.TimeZoneId == zone.Id)">@zone.DisplayName (@zone.Id)</option>
                            }
                        </select>
                        <small id="create-time-zone-help" class="text-muted d-block mt-1" style="font-size: 0.75rem;">可按城市或时区 ID 搜索。</small>
                        @if (!Model.EditingGroupForm) { <span asp-validation-for="GroupForm.TimeZoneId" class="text-danger small d-block mt-1"></span> }
                    </div>
                    <div class="pt-2">
                        <button class="btn btn-primary d-inline-flex align-items-center gap-1.5">
                            <i data-lucide="plus" style="width: 15px; height: 15px;"></i>
                            <span>创建值班组</span>
                        </button>
                    </div>
                </form>
            </div>
        </section>
    </div>
    <div class="col-lg-7">
        @if (group == null)
        {
            <div class="card ac-empty-state shadow-sm border-0">
                <div class="ac-empty-icon mb-3">
                    <i data-lucide="calendar-plus" style="width: 32px; height: 32px;"></i>
                </div>
                <h2 class="h5 fw-bold">选择或创建值班组</h2>
                <p class="text-muted mb-0">值班组是成员、模板与已发布排班的边界。</p>
            </div>
        }
        else
        {
            <section class="card shadow-sm border-0">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h2 class="h5 mb-0 d-flex align-items-center gap-2">
                        <i data-lucide="sliders" class="text-primary" style="width: 18px; height: 18px;"></i>
                        <span>编辑 @group.Name</span>
                    </h2>
                </div>
                <div class="card-body p-4">
                    <form asp-action="SaveGroup" method="post" class="vstack gap-3">
                        <input type="hidden" name="GroupForm.Id" value="@group.Id" />
                        @if (Model.EditingGroupForm && !ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="All" class="alert alert-danger small mb-1" role="alert"></div>
                        }
                        <div>
                            <label for="edit-group-name" class="form-label small fw-medium mb-1">名称</label>
                            <input id="edit-group-name" name="GroupForm.Name" value="@(Model.EditingGroupForm ? groupForm.Name : group.Name)" required maxlength="100" class="form-control" />
                            @if (Model.EditingGroupForm) { <span asp-validation-for="GroupForm.Name" class="text-danger small d-block mt-1"></span> }
                        </div>
                        <div>
                            <label for="edit-time-zone" class="form-label small fw-medium mb-1">时区</label>
                            <select name="GroupForm.TimeZoneId" id="edit-time-zone" class="form-select js-time-zone" required aria-describedby="edit-time-zone-help">
                                @foreach (var zone in Model.TimeZones)
                                {
                                    <option value="@zone.Id" selected="@((Model.EditingGroupForm ? groupForm.TimeZoneId : group.TimeZoneId) == zone.Id)">@zone.DisplayName (@zone.Id)</option>
                                }
                            </select>
                            <small id="edit-time-zone-help" class="text-muted d-block mt-1">更改时区不会改变已发布班次的 UTC 时间。</small>
                            @if (Model.EditingGroupForm) { <span asp-validation-for="GroupForm.TimeZoneId" class="text-danger small d-block mt-1"></span> }
                        </div>
                        <div class="pt-2">
                            <button class="btn btn-primary align-self-start d-inline-flex align-items-center gap-1.5">
                                <i data-lucide="save" style="width: 15px; height: 15px;"></i>
                                <span>保存配置</span>
                            </button>
                        </div>
                    </form>
                </div>
            </section>
        }
    </div>
</div>

@section scripts {
    <script>
        document.querySelectorAll('.js-time-zone').forEach(select => {
            if (window.jQuery?.fn.select2) window.jQuery(select).select2({ width: '100%', placeholder: '搜索城市或时区' });
        });
    </script>
}
