@model Aiursoft.AlertCenter.Models.OnCallViewModel
@{
    ViewData["Title"] = "值班组配置";
    var group = Model.Group;
    var groupForm = Model.GroupForm;
}
@section styles { <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" /> }
<partial name="_AdminNavigation" model="Model" />
<div class="row g-4">
    <div class="col-lg-5">
        <section class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent"><h2 class="h5 mb-0">新建值班组</h2></div>
            <div class="card-body">
                <form asp-action="SaveGroup" method="post" class="vstack gap-3">
                    @if (!Model.EditingGroupForm && !ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger small" role="alert"></div>
                    }
                    <div>
                        <label for="create-group-name" class="form-label">名称</label>
                        <input id="create-group-name" name="GroupForm.Name" value="@(Model.EditingGroupForm ? "" : groupForm.Name)" required maxlength="100" class="form-control" placeholder="例如：生产值班" />
                        @if (!Model.EditingGroupForm) { <span asp-validation-for="GroupForm.Name" class="text-danger small"></span> }
                    </div>
                    <div>
                        <label for="create-time-zone" class="form-label">时区</label>
                        <select name="GroupForm.TimeZoneId" id="create-time-zone" class="form-select js-time-zone" required>
                            @foreach (var zone in Model.TimeZones)
                            {
                                <option value="@zone.Id" selected="@(!Model.EditingGroupForm && groupForm.TimeZoneId == zone.Id)">@zone.DisplayName (@zone.Id)</option>
                            }
                        </select>
                        @if (!Model.EditingGroupForm) { <span asp-validation-for="GroupForm.TimeZoneId" class="text-danger small"></span> }
                    </div>
                    <button class="btn btn-primary">创建值班组</button>
                </form>
            </div>
        </section>
    </div>
    <div class="col-lg-7">
        @if (group == null)
        {
            <div class="card ac-empty-state shadow-sm border-0"><h2 class="h5">选择或创建值班组</h2><p class="text-muted mb-0">值班组是成员、模板与已发布排班的边界。</p></div>
        }
        else
        {
            <section class="card shadow-sm border-0">
                <div class="card-header bg-transparent"><h2 class="h5 mb-0">编辑 @group.Name</h2></div>
                <div class="card-body">
                    <form asp-action="SaveGroup" method="post" class="vstack gap-3">
                        <input type="hidden" name="GroupForm.Id" value="@group.Id" />
                        @if (Model.EditingGroupForm && !ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="All" class="alert alert-danger small" role="alert"></div>
                        }
                        <div>
                            <label for="edit-group-name" class="form-label">名称</label>
                            <input id="edit-group-name" name="GroupForm.Name" value="@(Model.EditingGroupForm ? groupForm.Name : group.Name)" required maxlength="100" class="form-control" />
                            @if (Model.EditingGroupForm) { <span asp-validation-for="GroupForm.Name" class="text-danger small"></span> }
                        </div>
                        <div>
                            <label for="edit-time-zone" class="form-label">时区</label>
                            <select name="GroupForm.TimeZoneId" id="edit-time-zone" class="form-select js-time-zone" required>
                                @foreach (var zone in Model.TimeZones)
                                {
                                    <option value="@zone.Id" selected="@((Model.EditingGroupForm ? groupForm.TimeZoneId : group.TimeZoneId) == zone.Id)">@zone.DisplayName (@zone.Id)</option>
                                }
                            </select>
                            <small class="text-muted">更改时区不会改变已发布班次的 UTC 时间。</small>
                            @if (Model.EditingGroupForm) { <span asp-validation-for="GroupForm.TimeZoneId" class="text-danger small d-block"></span> }
                        </div>
                        <button class="btn btn-primary align-self-start">保存配置</button>
                    </form>
                </div>
            </section>
        }
    </div>
</div>
@section scripts {
    <script>
        document.querySelectorAll('.js-time-zone').forEach(select => {
            if (window.jQuery?.fn.select2) window.jQuery(select).select2({ width: '100%', placeholder: '搜索城市或时区' });
        });
    </script>
}
