@model Aiursoft.AlertCenter.Models.OnCallViewModel
@using Aiursoft.AlertCenter.Entities
@{
    ViewData["Title"] = "管理值班";
    var group = Model.Group;
    var timeZone = group == null ? TimeZoneInfo.Utc : TimeZoneInfo.FindSystemTimeZoneById(group.TimeZoneId);
    DateTime Local(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(utc, timeZone);
    var groupForm = Model.GroupForm;
    var pendingHandovers = Model.HandoverRequests.Count(item => item.Status == OnCallHandoverRequest.Pending);
    var pendingLeaves = Model.LeaveRequests.Count(item => item.Status == OnCallLeaveRequest.Pending);
    var totalPending = pendingHandovers + pendingLeaves;
    var unsettledDebts = Model.CoverageDebts.Count(item => !item.SettledAtUtc.HasValue);
    string GetInitial(string? name) => string.IsNullOrWhiteSpace(name) ? "?" : name[..1].ToUpperInvariant();
}
@section styles {
    <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" />
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h1 class="h3 mb-0">管理值班</h1>
            @if (group != null)
            {
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 fs-6 fw-normal d-inline-flex align-items-center gap-1">
                    <i data-lucide="shield-check" style="width: 14px; height: 14px;"></i>
                    <span>@group.Name</span>
                </span>
            }
        </div>
        <p class="text-muted mb-0 small">配置值班组、轮转模板、发布日程，以及处理请假、交接和补班。</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" asp-route-groupId="@group?.Id" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1.5">
            <i class="align-middle me-1" data-lucide="arrow-left" style="width: 14px; height: 14px;"></i>
            <span>返回值班概览</span>
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.OperationError))
{
    <div class="alert alert-danger d-flex align-items-start gap-3 mb-4 shadow-sm border-0 border-start border-danger border-4" role="alert">
        <i data-lucide="circle-alert" class="flex-shrink-0 text-danger mt-1" style="width: 20px; height: 20px;" aria-hidden="true"></i>
        <div>
            <strong class="d-block mb-1">操作未完成</strong>
            <div class="small">@Model.OperationError</div>
        </div>
    </div>
}

@if (group != null)
{
    <!-- Group Quick Metrics Cockpit -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card ac-stat-card h-100 mb-0 shadow-sm border-0">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="ac-stat-icon icon-primary">
                        <i data-lucide="radio-tower" style="width: 22px; height: 22px;"></i>
                    </div>
                    <div class="overflow-hidden">
                        <span class="text-muted small d-block text-truncate">当前当班工程师 (OCE)</span>
                        <strong class="fs-5 text-truncate d-block">@(Model.CurrentEngineer?.DisplayName ?? "暂无当班")</strong>
                        <div class="small mt-0.5">
                            @if (Model.CurrentEngineer != null)
                            {
                                @if (Model.CurrentEngineer.IsOverride)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-1.5 py-0.5">临时代班覆盖中</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-1.5 py-0.5">正常当班中</span>
                                }
                            }
                            else
                            {
                                <span class="text-danger small">需检查已发布排班</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card ac-stat-card h-100 mb-0 shadow-sm border-0">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="ac-stat-icon icon-indigo">
                        <i data-lucide="globe" style="width: 22px; height: 22px;"></i>
                    </div>
                    <div class="overflow-hidden">
                        <span class="text-muted small d-block text-truncate">基准时区</span>
                        <strong class="fs-5 text-truncate d-block font-monospace">@group.TimeZoneId</strong>
                        <div class="text-muted small mt-0.5 text-truncate font-monospace">
                            本地 @Local(DateTime.UtcNow).ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card ac-stat-card h-100 mb-0 shadow-sm border-0">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="ac-stat-icon icon-success">
                        <i data-lucide="users" style="width: 22px; height: 22px;"></i>
                    </div>
                    <div class="overflow-hidden">
                        <span class="text-muted small d-block text-truncate">团队与轮转</span>
                        <strong class="fs-5 text-truncate d-block">@Model.Members.Count 位成员</strong>
                        <div class="text-muted small mt-0.5 text-truncate">
                            已配置 @Model.Templates.Count 个每日轮转模板
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card ac-stat-card h-100 mb-0 shadow-sm border-0">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="ac-stat-icon @(totalPending > 0 ? "icon-danger" : "icon-warning")">
                        <i data-lucide="git-pull-request" style="width: 22px; height: 22px;"></i>
                    </div>
                    <div class="overflow-hidden">
                        <span class="text-muted small d-block text-truncate">待审工单与债务</span>
                        <strong class="fs-5 text-truncate d-block">
                            @if (totalPending > 0)
                            {
                                <span class="text-danger">@totalPending 笔待审</span>
                            }
                            else
                            {
                                <span>0 笔待审</span>
                            }
                        </strong>
                        <div class="text-muted small mt-0.5 text-truncate">
                            @unsettledDebts 笔待偿还补班债务
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="row g-4">
    <!-- Left Column: Groups Directory & Creation -->
    <div class="col-xl-3">
        <section class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
                <h2 class="card-title h6 mb-0 d-flex align-items-center gap-2">
                    <i data-lucide="layers" style="width: 15px; height: 15px;" class="text-primary"></i>
                    <span>值班组</span>
                </h2>
                <span class="badge bg-secondary-subtle text-secondary rounded-pill">@Model.Groups.Count</span>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var item in Model.Groups)
                {
                    <a asp-action="Manage" asp-route-id="@item.Id" class="list-group-item list-group-item-action ac-group-list-item @(group?.Id == item.Id ? "active" : "") d-flex justify-content-between align-items-center py-2.5 px-3">
                        <div class="overflow-hidden">
                            <strong class="d-block text-truncate @(group?.Id == item.Id ? "text-primary" : "")">@item.Name</strong>
                            <small class="text-muted d-flex align-items-center gap-1 mt-0.5 font-monospace">
                                <i data-lucide="globe" style="width: 11px; height: 11px;"></i>
                                <span class="text-truncate">@item.TimeZoneId</span>
                            </small>
                        </div>
                        @if (group?.Id == item.Id)
                        {
                            <span class="badge bg-primary text-white rounded-pill px-2 py-0.5 small flex-shrink-0">当前</span>
                        }
                    </a>
                }
            </div>
            <div class="card-body border-top p-3 bg-light">
                <form asp-action="SaveGroup" method="post" class="vstack gap-2">
                    <div class="d-flex align-items-center gap-1.5 mb-1 text-primary">
                        <i data-lucide="plus-circle" style="width: 14px; height: 14px;"></i>
                        <span class="fw-bold small text-uppercase">新建值班组</span>
                    </div>
                    @if (!Model.EditingGroupForm && !ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger small mb-1" role="alert"></div>
                    }
                    <label for="create-group-name" class="form-label small fw-medium mb-0">新值班组</label>
                    <input id="create-group-name" name="GroupForm.Name" value="@(Model.EditingGroupForm ? "" : groupForm.Name)" required maxlength="100" class="form-control form-control-sm" placeholder="例如：生产值班" />
                    @if (!Model.EditingGroupForm) { <span asp-validation-for="GroupForm.Name" class="text-danger small"></span> }
                    
                    <label for="create-time-zone" class="form-label small fw-medium mb-0 mt-1">时区</label>
                    <select name="GroupForm.TimeZoneId" id="create-time-zone" class="form-select form-select-sm js-time-zone" required aria-describedby="create-time-zone-help">
                        @foreach (var zone in Model.TimeZones)
                        {
                            <option value="@zone.Id" selected="@(!Model.EditingGroupForm && groupForm.TimeZoneId == zone.Id)">@zone.DisplayName (@zone.Id)</option>
                        }
                    </select>
                    <small id="create-time-zone-help" class="text-muted" style="font-size: 0.75rem;">可按城市或时区 ID 搜索。</small>
                    @if (!Model.EditingGroupForm) { <span asp-validation-for="GroupForm.TimeZoneId" class="text-danger small"></span> }
                    
                    <button class="btn btn-sm btn-primary w-100 d-inline-flex align-items-center justify-content-center gap-1.5 mt-2">
                        <i data-lucide="plus" style="width: 14px; height: 14px;"></i>
                        <span>创建值班组</span>
                    </button>
                </form>
            </div>
        </section>
    </div>

    <!-- Right Column: Tabs & Main Workspace -->
    <div class="col-xl-9">
        @if (group == null)
        {
            <div class="card ac-empty-state shadow-sm border-0">
                <div class="ac-empty-icon mb-3">
                    <i data-lucide="calendar-plus" style="width: 32px; height: 32px;"></i>
                </div>
                <h2 class="h5 fw-bold">创建或选择值班组</h2>
                <p class="text-muted mb-0">值班组是成员、模板与已发布排班的边界。</p>
            </div>
        }
        else
        {
            <div class="alert alert-info small d-flex align-items-center gap-2 mb-4 border-0 shadow-sm" role="alert">
                <i class="align-middle me-1 text-info flex-shrink-0" data-lucide="info" style="width: 18px; height: 18px;"></i>
                <div>此组使用 <strong>@group.TimeZoneId</strong>。界面输入和展示采用本地时间，系统以 UTC 保存并校验。</div>
            </div>

            <!-- Modern Navigation Tabs -->
            <ul class="nav ac-nav-tabs mb-4" id="onCallTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(!Model.EditingGroupForm ? "active" : "") d-flex align-items-center gap-2" id="tab-schedule-btn" data-bs-toggle="tab" data-bs-target="#pane-schedule" type="button" role="tab" aria-controls="pane-schedule" aria-selected="@(!Model.EditingGroupForm ? "true" : "false")">
                        <i data-lucide="calendar-check" style="width: 16px; height: 16px;"></i>
                        <span>排班与发布</span>
                        <span class="badge bg-secondary-subtle text-secondary rounded-pill">@Model.Shifts.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link d-flex align-items-center gap-2" id="tab-templates-btn" data-bs-toggle="tab" data-bs-target="#pane-templates" type="button" role="tab" aria-controls="pane-templates" aria-selected="false">
                        <i data-lucide="repeat" style="width: 16px; height: 16px;"></i>
                        <span>轮转模板</span>
                        <span class="badge bg-secondary-subtle text-secondary rounded-pill">@Model.Templates.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link d-flex align-items-center gap-2" id="tab-members-btn" data-bs-toggle="tab" data-bs-target="#pane-members" type="button" role="tab" aria-controls="pane-members" aria-selected="false">
                        <i data-lucide="users" style="width: 16px; height: 16px;"></i>
                        <span>成员管理</span>
                        <span class="badge bg-secondary-subtle text-secondary rounded-pill">@Model.Members.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link d-flex align-items-center gap-2" id="tab-requests-btn" data-bs-toggle="tab" data-bs-target="#pane-requests" type="button" role="tab" aria-controls="pane-requests" aria-selected="false">
                        <i data-lucide="git-pull-request" style="width: 16px; height: 16px;"></i>
                        <span>请假、交接与补班</span>
                        @if (totalPending > 0)
                        {
                            <span class="badge bg-danger text-white rounded-pill">@totalPending 待审</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill">@unsettledDebts 债务</span>
                        }
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(Model.EditingGroupForm ? "active" : "") d-flex align-items-center gap-2" id="tab-settings-btn" data-bs-toggle="tab" data-bs-target="#pane-settings" type="button" role="tab" aria-controls="pane-settings" aria-selected="@(Model.EditingGroupForm ? "true" : "false")">
                        <i data-lucide="settings" style="width: 16px; height: 16px;"></i>
                        <span>组配置</span>
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="onCallTabContent">
                <!-- Tab 1: 排班与发布 -->
                <div class="tab-pane fade @(!Model.EditingGroupForm ? "show active" : "")" id="pane-schedule" role="tabpanel" aria-labelledby="tab-schedule-btn">
                    <!-- Publish Schedule Card -->
                    <section class="card shadow-sm border-0 mb-4">
                        <div class="card-header bg-transparent border-bottom py-3">
                            <h2 class="card-title h5 mb-0 d-flex align-items-center gap-2">
                                <i data-lucide="calendar-plus" class="text-primary" style="width: 18px; height: 18px;"></i>
                                <span>发布日程</span>
                            </h2>
                        </div>
                        <div class="card-body p-4">
                            <form asp-action="Publish" method="post" class="row g-3 align-items-end">
                                <input type="hidden" name="groupId" value="@group.Id" />
                                <div class="col-sm-6 col-md-4">
                                    <label for="publish-start-date" class="form-label small fw-medium text-muted mb-1">开始日期</label>
                                    <input id="publish-start-date" name="startDate" type="date" value="@Local(DateTime.UtcNow).ToString("yyyy-MM-dd")" class="form-control" required />
                                </div>
                                <div class="col-sm-6 col-md-4">
                                    <label for="publish-end-date" class="form-label small fw-medium text-muted mb-1">结束日期</label>
                                    <input id="publish-end-date" name="endDate" type="date" value="@Local(DateTime.UtcNow).AddDays(6).ToString("yyyy-MM-dd")" class="form-control" required />
                                </div>
                                <div class="col-md-4">
                                    <button class="btn btn-primary w-100 d-inline-flex align-items-center justify-content-center gap-1.5" style="height: 38px;">
                                        <i data-lucide="send" style="width: 15px; height: 15px;"></i>
                                        <span>生成并发布日常轮转</span>
                                    </button>
                                </div>
                                <div class="col-12 mt-2">
                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                        <span class="small text-muted">快捷日期跨度：</span>
                                        <button type="button" class="btn btn-sm btn-light border py-0 px-2 small" onclick="setPublishRange(7)">未来 7 天</button>
                                        <button type="button" class="btn btn-sm btn-light border py-0 px-2 small" onclick="setPublishRange(14)">未来 14 天</button>
                                        <button type="button" class="btn btn-sm btn-light border py-0 px-2 small" onclick="setPublishRange(30)">未来 30 天</button>
                                    </div>
                                </div>
                            </form>
                            <div class="p-3 bg-light rounded-3 border mt-3 small text-muted">
                                <div class="d-flex align-items-center gap-1.5 fw-medium text-body mb-1">
                                    <i data-lucide="shield-check" class="text-success" style="width: 15px; height: 15px;"></i>
                                    <span>发布合规校验</span>
                                </div>
                                <p class="small text-muted mb-0">发布前检查连续覆盖、班次重叠、最长 8 小时及每位工程师至少 16 小时连续休息。</p>
                            </div>
                        </div>
                    </section>

                    <!-- Future Shifts & Overrides Table -->
                    <section class="card shadow-sm border-0">
                        <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
                            <h2 class="card-title h5 mb-0 d-flex align-items-center gap-2">
                                <i data-lucide="calendar-range" class="text-primary" style="width: 18px; height: 18px;"></i>
                                <span>未来已发布班次与临时覆盖</span>
                            </h2>
                            <span class="badge bg-secondary-subtle text-secondary border">未来 14 天 (@Model.Shifts.Count 个班次)</span>
                        </div>
                        <div class="card-body p-0">
                            @if (Model.Shifts.Count == 0)
                            {
                                <div class="p-5 text-center text-muted">
                                    <div class="ac-empty-icon mb-2">
                                        <i data-lucide="calendar-off" style="width: 28px; height: 28px;"></i>
                                    </div>
                                    <p class="mb-0">未来 14 天暂无已发布班次。</p>
                                    <small class="text-muted">请先配置轮转模板，并在上方选择日期范围后点击生成并发布。</small>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0 card-table">
                                        <thead class="table-light">
                                            <tr>
                                                <th>工程师</th>
                                                <th>本地时段</th>
                                                <th>临时覆盖</th>
                                                <th class="text-end"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var shift in Model.Shifts)
                                            {
                                                var overrideItem = Model.Overrides.SingleOrDefault(item => item.OriginalShiftId == shift.Id);
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="ac-app-avatar" style="width: 32px; height: 32px; font-size: 0.8rem;">@GetInitial(shift.User?.DisplayName)</span>
                                                            <div>
                                                                <strong class="d-block">@(shift.User?.DisplayName ?? "未知")</strong>
                                                                <small class="text-muted font-monospace">@(shift.User?.Email ?? "未配置邮箱")</small>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="ac-time-chip">
                                                            <i data-lucide="clock" style="width: 12px; height: 12px;" class="text-muted"></i>
                                                            <code>@Local(shift.StartsAtUtc).ToString("MM-dd HH:mm") – @Local(shift.EndsAtUtc).ToString("MM-dd HH:mm")</code>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        @if (overrideItem != null)
                                                        {
                                                            <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle d-inline-flex align-items-center gap-1">
                                                                    <i data-lucide="replace" style="width: 12px; height: 12px;"></i>
                                                                    <span>@overrideItem.CoveringUser.DisplayName</span>
                                                                </span>
                                                                <span class="small text-muted">· @overrideItem.Reason</span>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted small">无</span>
                                                        }
                                                    </td>
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" type="button" data-bs-toggle="collapse" data-bs-target="#override-@shift.Id" aria-expanded="false">
                                                            <i data-lucide="user-plus" style="width: 13px; height: 13px;"></i>
                                                            <span>安排代班</span>
                                                        </button>
                                                    </td>
                                                </tr>
                                                <tr class="collapse" id="override-@shift.Id">
                                                    <td colspan="4" class="p-3 bg-light">
                                                        <div class="card border mb-0 shadow-none">
                                                            <div class="card-body p-3">
                                                                <div class="small fw-bold text-muted mb-2 d-flex align-items-center gap-1">
                                                                    <i data-lucide="corner-down-right" style="width: 14px; height: 14px;"></i>
                                                                    <span>为 @(shift.User?.DisplayName ?? "该工程师") 的班次安排临时覆盖代班</span>
                                                                </div>
                                                                <form asp-action="CreateOverride" method="post" class="row g-2 align-items-end">
                                                                    <input type="hidden" name="originalShiftId" value="@shift.Id" />
                                                                    <div class="col-md-3">
                                                                        <label class="form-label small fw-medium text-muted mb-1">代班工程师</label>
                                                                        <select name="coveringUserId" class="form-select form-select-sm" required>
                                                                            <option value="">代班工程师</option>
                                                                            @foreach (var member in Model.Members)
                                                                            {
                                                                                <option value="@member.UserId">@member.User.DisplayName</option>
                                                                            }
                                                                        </select>
                                                                    </div>
                                                                    <div class="col-md-3 col-sm-6">
                                                                        <label class="form-label small fw-medium text-muted mb-1">开始时间 (@group.TimeZoneId)</label>
                                                                        <input name="startsAtLocal" type="datetime-local" value="@Local(shift.StartsAtUtc).ToString("yyyy-MM-ddTHH:mm")" class="form-control form-control-sm" required />
                                                                    </div>
                                                                    <div class="col-md-3 col-sm-6">
                                                                        <label class="form-label small fw-medium text-muted mb-1">结束时间 (@group.TimeZoneId)</label>
                                                                        <input name="endsAtLocal" type="datetime-local" value="@Local(shift.EndsAtUtc).ToString("yyyy-MM-ddTHH:mm")" class="form-control form-control-sm" required />
                                                                    </div>
                                                                    <div class="col-md-2">
                                                                        <label class="form-label small fw-medium text-muted mb-1">代班原因</label>
                                                                        <input name="reason" maxlength="1000" class="form-control form-control-sm" placeholder="代班原因" required />
                                                                    </div>
                                                                    <div class="col-md-1">
                                                                        <button class="btn btn-sm btn-primary w-100">保存</button>
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </section>
                </div>

                <!-- Tab 2: 轮转模板 -->
                <div class="tab-pane fade" id="pane-templates" role="tabpanel" aria-labelledby="tab-templates-btn">
                    <section class="card shadow-sm border-0 mb-4">
                        <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
                            <div>
                                <h2 class="card-title h5 mb-0 d-flex align-items-center gap-2">
                                    <i data-lucide="repeat" class="text-primary" style="width: 18px; height: 18px;"></i>
                                    <span>轮转模板</span>
                                </h2>
                                <small class="text-muted">定义每日轮转时段与轮转工程师顺序。所有模板时长加总须完整覆盖本地 24 小时（1440分钟）。</small>
                            </div>
                            <button class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1" type="button" data-bs-toggle="collapse" data-bs-target="#newTemplateCollapse" aria-expanded="false">
                                <i data-lucide="plus" style="width: 14px; height: 14px;"></i>
                                <span>新建模板</span>
                            </button>
                        </div>
                        
                        <!-- Collapsible Template Form -->
                        <div class="collapse @(Model.Templates.Count == 0 ? "show" : "") border-bottom" id="newTemplateCollapse">
                            <div class="card-body p-4 bg-light">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                    <h6 class="fw-bold mb-0 text-primary d-flex align-items-center gap-1.5">
                                        <i data-lucide="calendar-plus" style="width: 16px; height: 16px;"></i>
                                        <span>配置轮转模板</span>
                                    </h6>
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="small text-muted me-1">常用班次预设：</span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="setTemplatePreset('早班', 0, 480)">早班 (00:00 - 08:00)</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="setTemplatePreset('中班', 480, 480)">中班 (08:00 - 16:00)</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="setTemplatePreset('晚班', 960, 480)">晚班 (16:00 - 24:00)</button>
                                    </div>
                                </div>
                                <form asp-action="SaveTemplate" method="post" class="row g-3">
                                    <input type="hidden" name="groupId" value="@group.Id" />
                                    <div class="col-md-3">
                                        <label for="template-name" class="form-label small fw-medium mb-1">模板名称</label>
                                        <input id="template-name" name="name" maxlength="100" required class="form-control" placeholder="早班" />
                                    </div>
                                    <div class="col-md-2">
                                        <label for="template-start-minute" class="form-label small fw-medium mb-1">开始分钟</label>
                                        <input id="template-start-minute" name="startMinuteOfDay" type="number" min="0" max="1439" value="0" required class="form-control" oninput="updateTimeHint()" />
                                        <small id="start-minute-hint" class="text-muted d-block mt-1 font-monospace">00:00 = 0</small>
                                    </div>
                                    <div class="col-md-2">
                                        <label for="template-duration-minute" class="form-label small fw-medium mb-1">时长（分钟）</label>
                                        <input id="template-duration-minute" name="durationMinutes" type="number" min="1" max="480" value="480" required class="form-control" oninput="updateTimeHint()" />
                                        <small id="duration-minute-hint" class="text-muted d-block mt-1 font-monospace">480 分钟 (8 小时)</small>
                                    </div>
                                    <div class="col-md-4">
                                        <label for="template-user-ids" class="form-label small fw-medium mb-1">轮转成员</label>
                                        <select id="template-user-ids" name="userIds" multiple required class="form-select" size="3">
                                            @foreach (var member in Model.Members)
                                            {
                                                <option value="@member.UserId">@member.User.DisplayName</option>
                                            }
                                        </select>
                                        <small class="text-muted d-block mt-1">按住 Ctrl/Cmd 可多选。按选择顺序自动轮转。</small>
                                    </div>
                                    <div class="col-md-1 d-flex align-items-end">
                                        <button class="btn btn-primary w-100 d-inline-flex align-items-center justify-content-center gap-1" style="height: 38px;">
                                            <span>保存</span>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <div class="card-body p-0">
                            @if (Model.Templates.Count == 0)
                            {
                                <div class="p-5 text-center text-muted">
                                    <div class="ac-empty-icon mb-2">
                                        <i data-lucide="layers" style="width: 28px; height: 28px;"></i>
                                    </div>
                                    <p class="mb-1">尚无模板。使用覆盖完整本地一天的模板后才能发布日常轮转。</p>
                                    <small class="text-muted">请点击上方“新建模板”或使用快速预设（早班、中班、晚班）创建覆盖 24 小时的轮转体系。</small>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0 card-table">
                                        <thead class="table-light">
                                            <tr>
                                                <th>模板</th>
                                                <th>本地时段</th>
                                                <th>轮转顺序</th>
                                                <th class="text-end"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var template in Model.Templates)
                                            {
                                                var members = Model.TemplateMembers.Where(item => item.TemplateId == template.Id).OrderBy(item => item.RotationOrder).ToList();
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="ac-app-avatar" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                                                <i data-lucide="clock" style="width: 14px; height: 14px;"></i>
                                                            </div>
                                                            <strong class="text-primary">@template.Name</strong>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="ac-time-chip">
                                                            <code>@TimeOnly.FromTimeSpan(TimeSpan.FromMinutes(template.StartMinuteOfDay)).ToString("HH:mm") + @template.DurationMinutes 分钟</code>
                                                        </span>
                                                        <span class="badge bg-light text-muted border ms-1">@Math.Round(template.DurationMinutes / 60.0, 1) 小时</span>
                                                    </td>
                                                    <td>
                                                        @if (members.Count == 0)
                                                        {
                                                            <span class="text-muted small">未配置轮转工程师</span>
                                                        }
                                                        else
                                                        {
                                                            <div class="ac-rotation-flow">
                                                                @for (int i = 0; i < members.Count; i++)
                                                                {
                                                                    <span class="ac-rotation-member">
                                                                        <span class="ac-app-avatar" style="width: 20px; height: 20px; font-size: 0.65rem;">@GetInitial(members[i].User.DisplayName)</span>
                                                                        <span>@members[i].User.DisplayName</span>
                                                                    </span>
                                                                    @if (i < members.Count - 1)
                                                                    {
                                                                        <span class="ac-rotation-arrow"><i data-lucide="arrow-right" style="width: 12px; height: 12px;"></i></span>
                                                                    }
                                                                }
                                                            </div>
                                                        }
                                                    </td>
                                                    <td class="text-end">
                                                        <form asp-action="DeleteTemplate" method="post" class="d-inline" onsubmit="return confirm('确定要删除此轮转模板吗？');">
                                                            <input type="hidden" name="id" value="@template.Id" />
                                                            <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1">
                                                                <i data-lucide="trash-2" style="width: 13px; height: 13px;"></i>
                                                                <span>删除</span>
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </section>
                </div>

                <!-- Tab 3: 成员管理 -->
                <div class="tab-pane fade" id="pane-members" role="tabpanel" aria-labelledby="tab-members-btn">
                    <section class="card shadow-sm border-0 mb-4">
                        <div class="card-header bg-transparent border-bottom py-3">
                            <h2 class="card-title h5 mb-0 d-flex align-items-center gap-2">
                                <i data-lucide="user-plus" class="text-primary" style="width: 18px; height: 18px;"></i>
                                <span>添加成员</span>
                            </h2>
                        </div>
                        <div class="card-body p-4">
                            <form asp-action="AddMember" method="post" class="row g-2 align-items-center">
                                <input type="hidden" name="groupId" value="@group.Id" />
                                <div class="col-sm-8 col-md-9">
                                    <select name="userId" class="form-select" required>
                                        <option value="">选择用户</option>
                                        @foreach (var user in Model.Users)
                                        {
                                            <option value="@user.Value">@user.Text</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-sm-4 col-md-3">
                                    <button class="btn btn-primary w-100 d-inline-flex align-items-center justify-content-center gap-1.5">
                                        <i data-lucide="user-plus" style="width: 15px; height: 15px;"></i>
                                        <span>添加</span>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </section>

                    <section class="card shadow-sm border-0">
                        <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
                            <h2 class="card-title h5 mb-0 d-flex align-items-center gap-2">
                                <i data-lucide="users" class="text-primary" style="width: 18px; height: 18px;"></i>
                                <span>成员</span>
                            </h2>
                            <span class="badge bg-secondary-subtle text-secondary border">共 @Model.Members.Count 位成员</span>
                        </div>
                        <div class="card-body p-0">
                            @if (Model.Members.Count == 0)
                            {
                                <div class="p-5 text-center text-muted">
                                    <div class="ac-empty-icon mb-2">
                                        <i data-lucide="users" style="width: 28px; height: 28px;"></i>
                                    </div>
                                    <p class="mb-0">此值班组暂无成员。请在上方选择用户添加。</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0 card-table">
                                        <thead class="table-light">
                                            <tr>
                                                <th>工程师</th>
                                                <th>电子邮箱</th>
                                                <th>参与轮转模板</th>
                                                <th class="text-end">操作</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var member in Model.Members)
                                            {
                                                var assignedTemplates = Model.TemplateMembers
                                                    .Where(t => t.UserId == member.UserId)
                                                    .Select(t => t.Template?.Name ?? "未命名模板")
                                                    .Distinct()
                                                    .ToList();
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="ac-app-avatar" style="width: 32px; height: 32px; font-size: 0.8rem;">@GetInitial(member.User?.DisplayName)</span>
                                                            <strong>@(member.User?.DisplayName ?? "未知")</strong>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="text-muted font-monospace small">@(member.User?.Email ?? "未配置邮箱")</span>
                                                    </td>
                                                    <td>
                                                        @if (assignedTemplates.Count > 0)
                                                        {
                                                            <div class="d-flex flex-wrap gap-1">
                                                                @foreach (var tName in assignedTemplates)
                                                                {
                                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">@tName</span>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted small">未参与轮转</span>
                                                        }
                                                    </td>
                                                    <td class="text-end">
                                                        <form asp-action="RemoveMember" method="post" class="d-inline" onsubmit="return confirm('确定要将该成员从值班组移除吗？');">
                                                            <input type="hidden" name="groupId" value="@group.Id" />
                                                            <input type="hidden" name="userId" value="@member.UserId" />
                                                            <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1">
                                                                <i data-lucide="user-minus" style="width: 13px; height: 13px;"></i>
                                                                <span>移除</span>
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </section>
                </div>

                <!-- Tab 4: 请假、交接与补班 -->
                <div class="tab-pane fade" id="pane-requests" role="tabpanel" aria-labelledby="tab-requests-btn">
                    <div class="row g-4">
                        <!-- Leave Requests Section -->
                        <div class="col-lg-6">
                            <section class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
                                    <h2 class="card-title h5 mb-0 d-flex align-items-center gap-2">
                                        <i data-lucide="calendar-x-2" class="text-primary" style="width: 18px; height: 18px;"></i>
                                        <span>请假</span>
                                    </h2>
                                    <button class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" type="button" data-bs-toggle="collapse" data-bs-target="#collapseRequestLeave" aria-expanded="false">
                                        <i data-lucide="plus" style="width: 13px; height: 13px;"></i>
                                        <span>代提交请假</span>
                                    </button>
                                </div>
                                <div class="card-body p-4">
                                    <div class="collapse mb-3 p-3 bg-light rounded-3 border" id="collapseRequestLeave">
                                        <div class="small fw-bold text-muted mb-2">代员工提交请假申请</div>
                                        <form asp-action="RequestLeave" method="post" class="row g-2">
                                            <input type="hidden" name="groupId" value="@group.Id" />
                                            <div class="col-12">
                                                <select name="userId" class="form-select form-select-sm" required>
                                                    <option value="">请假工程师</option>
                                                    @foreach (var member in Model.Members)
                                                    {
                                                        <option value="@member.UserId">@member.User.DisplayName</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small fw-medium text-muted mb-1">开始时间 (@group.TimeZoneId)</label>
                                                <input name="startsAtLocal" type="datetime-local" class="form-control form-control-sm" required />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small fw-medium text-muted mb-1">结束时间 (@group.TimeZoneId)</label>
                                                <input name="endsAtLocal" type="datetime-local" class="form-control form-control-sm" required />
                                            </div>
                                            <div class="col-9">
                                                <input name="reason" maxlength="1000" class="form-control form-control-sm" placeholder="请假原因" required />
                                            </div>
                                            <div class="col-3">
                                                <button class="btn btn-sm btn-primary w-100">提交</button>
                                            </div>
                                        </form>
                                    </div>

                                    @if (Model.LeaveRequests.Count == 0)
                                    {
                                        <div class="p-4 text-center text-muted">
                                            <p class="mb-0">暂无请假申请记录。</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="list-group list-group-flush">
                                            @foreach (var leave in Model.LeaveRequests)
                                            {
                                                <div class="list-group-item px-0 py-3">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="ac-app-avatar" style="width: 24px; height: 24px; font-size: 0.7rem;">@GetInitial(leave.User?.DisplayName)</span>
                                                            <strong>@(leave.User?.DisplayName ?? "未知")</strong>
                                                        </div>
                                                        @if (leave.Status == OnCallLeaveRequest.Pending)
                                                        {
                                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">@leave.Status</span>
                                                        }
                                                        else if (leave.Status == OnCallLeaveRequest.Approved)
                                                        {
                                                            <span class="badge bg-success-subtle text-success border border-success-subtle">@leave.Status</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary-subtle text-secondary border">@leave.Status</span>
                                                        }
                                                    </div>
                                                    <div class="small text-muted mt-1">
                                                        <i data-lucide="calendar" style="width: 12px; height: 12px;" class="me-1"></i>
                                                        @Local(leave.StartsAtUtc).ToString("MM-dd HH:mm") – @Local(leave.EndsAtUtc).ToString("MM-dd HH:mm") · @leave.Reason
                                                    </div>
                                                    @if (leave.Status == OnCallLeaveRequest.Pending)
                                                    {
                                                        <form asp-action="ReviewLeave" method="post" class="mt-2.5 d-flex gap-2">
                                                            <input type="hidden" name="id" value="@leave.Id" />
                                                            <button name="approve" value="true" class="btn btn-sm btn-success d-inline-flex align-items-center gap-1">
                                                                <i data-lucide="check" style="width: 13px; height: 13px;"></i>
                                                                <span>批准</span>
                                                            </button>
                                                            <button name="approve" value="false" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1">
                                                                <i data-lucide="x" style="width: 13px; height: 13px;"></i>
                                                                <span>拒绝</span>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </section>
                        </div>

                        <!-- Handover & Coverage Debt Section -->
                        <div class="col-lg-6">
                            <section class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-transparent border-bottom py-3">
                                    <h2 class="card-title h5 mb-0 d-flex align-items-center gap-2">
                                        <i data-lucide="arrow-left-right" class="text-primary" style="width: 18px; height: 18px;"></i>
                                        <span>交接与补班债务</span>
                                    </h2>
                                </div>
                                <div class="card-body p-4">
                                    <p class="small text-muted mb-3">成员可在值班概览中对本人班次提交交接；接班人确认后自动建立补班债务。</p>

                                    <h6 class="fw-bold text-muted small text-uppercase mb-2 d-flex align-items-center gap-1">
                                        <i data-lucide="repeat" style="width: 14px; height: 14px;"></i>
                                        <span>交接申请记录</span>
                                    </h6>
                                    @if (Model.HandoverRequests.Count == 0)
                                    {
                                        <div class="p-3 bg-light rounded text-center text-muted small mb-4">
                                            暂无交接申请。
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="list-group list-group-flush mb-4">
                                            @foreach (var handover in Model.HandoverRequests)
                                            {
                                                <div class="list-group-item px-0 py-2.5">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <div class="fw-bold">@(handover.RequestedByUser?.DisplayName ?? "未知") → @(handover.ReceivingUser?.DisplayName ?? "未知")</div>
                                                        <span class="badge bg-secondary-subtle text-secondary border">@handover.Status</span>
                                                    </div>
                                                    <div class="small text-muted">
                                                        <i data-lucide="clock" style="width: 12px; height: 12px;" class="me-1"></i>
                                                        @Local(handover.StartsAtUtc).ToString("MM-dd HH:mm") – @Local(handover.EndsAtUtc).ToString("MM-dd HH:mm")
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(handover.Note))
                                                    {
                                                        <div class="small text-muted mt-0.5">说明：@handover.Note</div>
                                                    }
                                                    @if (handover.Status == OnCallHandoverRequest.Pending)
                                                    {
                                                        <form asp-action="ReviewHandover" method="post" class="mt-2 d-flex gap-2">
                                                            <input type="hidden" name="id" value="@handover.Id" />
                                                            <button name="confirm" value="true" class="btn btn-sm btn-success d-inline-flex align-items-center gap-1">
                                                                <i data-lucide="check" style="width: 13px; height: 13px;"></i>
                                                                <span>确认接班</span>
                                                            </button>
                                                            <button name="confirm" value="false" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1">
                                                                <i data-lucide="x" style="width: 13px; height: 13px;"></i>
                                                                <span>拒绝</span>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }

                                    <hr class="my-4" />

                                    <h3 class="h6 fw-bold mb-2 d-flex align-items-center gap-1.5">
                                        <i data-lucide="scale" style="width: 16px; height: 16px;" class="text-primary"></i>
                                        <span>补班债务</span>
                                    </h3>
                                    @if (Model.CoverageDebts.Count == 0)
                                    {
                                        <div class="p-3 bg-light rounded text-center text-muted small">
                                            暂无补班债务记录。
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="list-group list-group-flush">
                                            @foreach (var debt in Model.CoverageDebts)
                                            {
                                                <div class="list-group-item px-0 py-3">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <strong>@(debt.OwingUser?.DisplayName ?? "未知") 欠 @(debt.CoveringUser?.DisplayName ?? "未知")</strong>
                                                        </div>
                                                        @if (debt.SettledAtUtc.HasValue)
                                                        {
                                                            <span class="badge bg-success-subtle text-success border border-success-subtle d-inline-flex align-items-center gap-1">
                                                                <i data-lucide="check-check" style="width: 11px; height: 11px;"></i>
                                                                <span>已偿还</span>
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle d-inline-flex align-items-center gap-1">
                                                                <i data-lucide="clock" style="width: 11px; height: 11px;"></i>
                                                                <span>待偿还</span>
                                                            </span>
                                                        }
                                                    </div>
                                                    <div class="small text-muted">
                                                        @debt.DurationMinutes 分钟 · @(debt.SettledAtUtc.HasValue ? "已偿还" : "待偿还")
                                                    </div>
                                                    @if (!debt.SettledAtUtc.HasValue)
                                                    {
                                                        <form asp-action="SettleDebt" method="post" class="input-group input-group-sm mt-2">
                                                            <input type="hidden" name="debtId" value="@debt.Id" />
                                                            <select name="settlementOverrideId" class="form-select" required>
                                                                <option value="">选择欠班人承担的代班</option>
                                                                @foreach (var item in Model.Overrides.Where(item => item.CoveringUserId == debt.OwingUserId))
                                                                {
                                                                    <option value="@item.Id">@Local(item.StartsAtUtc).ToString("MM-dd HH:mm") · @item.Reason</option>
                                                                }
                                                            </select>
                                                            <button class="btn btn-outline-primary d-inline-flex align-items-center gap-1">
                                                                <i data-lucide="check" style="width: 13px; height: 13px;"></i>
                                                                <span>偿还</span>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </section>
                        </div>
                    </div>
                </div>

                <!-- Tab 5: 组配置 -->
                <div class="tab-pane fade @(Model.EditingGroupForm ? "show active" : "")" id="pane-settings" role="tabpanel" aria-labelledby="tab-settings-btn">
                    <section class="card shadow-sm border-0">
                        <div class="card-header bg-transparent border-bottom py-3">
                            <h2 class="card-title h6 mb-0 d-flex align-items-center gap-2">
                                <i data-lucide="sliders" class="text-primary" style="width: 18px; height: 18px;"></i>
                                <span>组配置</span>
                            </h2>
                        </div>
                        <div class="card-body p-4" style="max-width: 650px;">
                            <form asp-action="SaveGroup" method="post" class="vstack gap-3">
                                <input type="hidden" name="GroupForm.Id" value="@group.Id" />
                                @if (Model.EditingGroupForm && !ViewData.ModelState.IsValid)
                                {
                                    <div asp-validation-summary="All" class="alert alert-danger small mb-1" role="alert"></div>
                                }
                                <div>
                                    <label for="edit-group-name" class="form-label small fw-medium mb-1">名称</label>
                                    <input id="edit-group-name" name="GroupForm.Name" required maxlength="100" value="@(Model.EditingGroupForm ? groupForm.Name : group.Name)" class="form-control" />
                                    @if (Model.EditingGroupForm) { <span asp-validation-for="GroupForm.Name" class="text-danger small d-block mt-1"></span> }
                                </div>
                                <div>
                                    <label for="edit-time-zone" class="form-label small fw-medium mb-1">时区</label>
                                    <select id="edit-time-zone" name="GroupForm.TimeZoneId" class="form-select js-time-zone" required aria-describedby="edit-time-zone-help">
                                        @foreach (var zone in Model.TimeZones)
                                        {
                                            <option value="@zone.Id" selected="@((Model.EditingGroupForm ? groupForm.TimeZoneId : group.TimeZoneId) == zone.Id)">@zone.DisplayName (@zone.Id)</option>
                                        }
                                    </select>
                                    <small id="edit-time-zone-help" class="text-muted d-block mt-1">更改时区不会改变已发布班次的 UTC 时间。</small>
                                    @if (Model.EditingGroupForm) { <span asp-validation-for="GroupForm.TimeZoneId" class="text-danger small d-block mt-1"></span> }
                                </div>
                                <div class="pt-2">
                                    <button class="btn btn-primary d-inline-flex align-items-center gap-1.5">
                                        <i data-lucide="save" style="width: 15px; height: 15px;"></i>
                                        <span>保存配置</span>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </section>
                </div>
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        function initTimeZones() {
            document.querySelectorAll('.js-time-zone').forEach(select => {
                if (window.jQuery?.fn.select2) {
                    window.jQuery(select).select2({ width: '100%', placeholder: '搜索城市或时区' });
                }
            });
        }
        initTimeZones();

        // Re-initialize icons and select2 when switching tabs
        document.querySelectorAll('#onCallTabs button[data-bs-toggle="tab"]').forEach(tabTriggerEl => {
            tabTriggerEl.addEventListener('shown.bs.tab', event => {
                initTimeZones();
                if (window.lucide) {
                    window.lucide.createIcons();
                }
                const targetId = event.target.getAttribute('data-bs-target');
                if (targetId) {
                    history.replaceState(null, null, targetId);
                }
            });
        });

        // Restore tab from URL hash if provided
        if (window.location.hash) {
            const activeTabTrigger = document.querySelector(`#onCallTabs button[data-bs-target="${window.location.hash}"]`);
            if (activeTabTrigger) {
                bootstrap.Tab.getOrCreateInstance(activeTabTrigger).show();
            }
        }

        // Helper functions for template presets
        function setTemplatePreset(name, startMinute, duration) {
            const nameInput = document.getElementById('template-name');
            const startInput = document.getElementById('template-start-minute');
            const durationInput = document.getElementById('template-duration-minute');
            if (nameInput) nameInput.value = name;
            if (startInput) startInput.value = startMinute;
            if (durationInput) durationInput.value = duration;
            updateTimeHint();
        }

        function updateTimeHint() {
            const startInput = document.getElementById('template-start-minute');
            const durationInput = document.getElementById('template-duration-minute');
            const startHint = document.getElementById('start-minute-hint');
            const durationHint = document.getElementById('duration-minute-hint');
            if (startInput && startHint) {
                const val = parseInt(startInput.value) || 0;
                const hours = Math.floor(val / 60) % 24;
                const mins = val % 60;
                startHint.textContent = `${String(hours).padStart(2, '0')}:${String(mins).padStart(2, '0')} (${val} 分钟)`;
            }
            if (durationInput && durationHint) {
                const val = parseInt(durationInput.value) || 0;
                durationHint.textContent = `${val} 分钟 (${(val / 60).toFixed(1)} 小时)`;
            }
        }

        // Helper function for quick publish range
        function setPublishRange(days) {
            const startInput = document.getElementById('publish-start-date');
            const endInput = document.getElementById('publish-end-date');
            if (startInput && endInput) {
                const startDate = new Date(startInput.value || new Date());
                const endDate = new Date(startDate.getTime() + (days - 1) * 86400000);
                const format = d => d.toISOString().split('T')[0];
                endInput.value = format(endDate);
            }
        }
    </script>
}
