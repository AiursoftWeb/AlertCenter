@using System.Globalization
@model Aiursoft.AlertCenter.Models.OnCallViewModel
@section scripts {
    <script src="~/scripts/oncall-group-delete.js" asp-append-version="true"></script>
    <script src="~/scripts/oncall-group-reset.js" asp-append-version="true"></script>
}
<vc:current-on-call group-id="@Model.SelectedGroupId"></vc:current-on-call>
@{
    var group = Model.Groups.Single(item => item.Id == Model.SelectedGroupId);
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <h1 class="h3 mb-1">@group.Name</h1>
        <p class="text-muted mb-0">@Localizer["Time zone: "]@group.TimeZoneId · @group.Members.Count @Localizer[" members"]</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Groups" class="btn btn-outline-secondary">@Localizer["Back to Team List"]</a>
        <a asp-action="ScheduleDetails" asp-route-id="@group.Id" class="btn btn-outline-primary">@Localizer["View on-call schedule"]</a>
        @if (Model.CanManageOnCall)
        {
            <a asp-action="GroupEdit" asp-route-id="@group.Id" class="btn btn-primary">@Localizer["Edit team"]</a>
        }
    </div>
</div>
@if (TempData["OnCallGroupSuccess"] is string message)
{
    <div class="alert alert-success alert-dismissible" role="status">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer["Close"]"></button>
        <div class="alert-message">@message</div>
    </div>
}
@if (TempData["OnCallGroupWarning"] is string warning)
{
    <div class="alert alert-warning" role="status"><div class="alert-message">@warning</div></div>
}
@await Html.PartialAsync("_OnCallWarnings", Model.UpcomingIssues)
<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5">@Localizer["Next: assign people to shifts"]</h2>
        <p>@Localizer["The member list says who can be scheduled. The saved schedule says who is on duty and receives incident emails. CC recipients receive a copy independently of group membership."]</p>
        <a asp-action="ScheduleDetails" asp-route-id="@group.Id" class="btn btn-primary">@Localizer["Open schedule"]</a>
        @if (Model.CanManageOnCall)
        {
            <a asp-action="GroupEdit" asp-route-id="@group.Id" asp-fragment="group-members" class="btn btn-outline-secondary">@Localizer["Manage members"]</a>
        }
    </div>
</div>
<div class="card mb-4">
    <div class="card-header"><h2 class="card-title mb-0">@Localizer["Team configuration"]</h2></div>
    <div class="card-body">
        <p>@Localizer["Scheduling start point: "]@TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(group.AnchorUtc, DateTimeKind.Utc), TimeZoneInfo.FindSystemTimeZoneById(group.TimeZoneId)).ToString("yyyy-MM-dd HH:mm", CultureInfo.CurrentCulture) @group.TimeZoneId</p>
        @if (group.Rule != null)
        {
            <p>@Localizer["Template:"]<a asp-action="Details" asp-route-id="@group.Rule.Id">@group.Rule.Name</a> · @Localizer["Staff per shift"]: @group.Rule.StaffPerShift</p>
        }
        else
        {
            <p class="text-muted">@Localizer["Template not bound; manual scheduling is still available."]</p>
        }
        <p class="small text-muted">@Localizer["Templates can be shared by multiple teams; modifying or switching templates will not regenerate saved shifts."]</p>
        @if (Model.CanManageOnCall)
        {
            <h3 class="h6">@Localizer["On-call email CC"]</h3>
            @if (string.IsNullOrWhiteSpace(group.EmailCcRecipients))
            {
                <p class="text-muted">@Localizer["CC address not configured."]</p>
            }
            else
            {
                <ul class="mb-2">
                    @foreach (var recipient in group.EmailCcRecipients.Split('\n'))
                    {
                        <li class="text-break">@recipient</li>
                    }
                </ul>
            }
            <p class="small text-muted">@Localizer["On-call emails are automatically sent to the user mailboxes (To) of all On-Call Engineers (OCEs) in the currently saved shift. CC only uses team mailboxes or mailing list addresses explicitly configured by the administrator; it does not automatically CC all team members. Custom push channels configured in the application will still deliver additional notifications."]</p>
        }
    </div>
</div>
<div class="card mb-4" id="group-rotation-queue">
    <div class="card-header"><h2 class="card-title mb-0">@Localizer["On-call members (rotation queue)"]</h2></div>
    <div class="card-body">
        <p class="small text-muted">@Localizer["The first person in the queue is on call first. Existing shifts are not reordered."]</p>
        @if (group.Members.Count == 0)
        {
            <p class="text-muted mb-0">@Localizer["No team members."]</p>
        }
        else
        {
            <ol class="mb-0">
                @foreach (var member in group.Members.OrderBy(item => item.RotationOrder))
                {
                    <li class="text-break">@member.User.DisplayName (@(member.User.UserName ?? member.UserId))</li>
                }
            </ol>
        }
    </div>
</div>
<div class="card mb-4" id="group-fallback-recipients">
    <div class="card-header"><h2 class="card-title mb-0">@Localizer["Fallback recipients"]</h2></div>
    <div class="card-body">
        <p class="small text-muted">@Localizer["Receive alerts when nobody is on call; do not participate in the rotation."]</p>
        @if (group.FallbackRecipients.Count == 0)
        {
            <div class="alert alert-warning mb-0" role="status"><div class="alert-message">@Localizer["No fallback recipients configured. Alerts cannot be delivered when nobody is on call."]</div></div>
        }
        else
        {
            <ul class="mb-0">
                @foreach (var recipient in group.FallbackRecipients.OrderBy(item => item.User.DisplayName, StringComparer.CurrentCulture))
                {
                    <li class="text-break">@recipient.User.DisplayName (@(recipient.User.UserName ?? recipient.UserId))</li>
                }
            </ul>
        }
    </div>
</div>
@if (Model.CanManageOnCall)
{
    var regenerateUnavailable = group.Rule == null
        ? Localizer["Bind a scheduling template before regenerating shifts."]
        : group.Members.Count < group.Rule.StaffPerShift
            ? Localizer["Regeneration requires at least {0} rotation queue members.", group.Rule.StaffPerShift]
            : null;
    <div class="card mb-4" id="group-reset-schedule">
        <div class="card-header"><h2 class="card-title mb-0">@Localizer["Reset saved schedule"]</h2></div>
        <div class="card-body">
            <p>@Localizer["Preview changes before resetting the saved schedule. Only future shifts are affected; ongoing and completed shifts are kept."]</p>
            <p class="text-muted">@Localizer["Time zone: "]@group.TimeZoneId</p>
            <form id="group-reset-form" asp-action="ResetSchedule" method="post" data-version="@group.ScheduleVersion"
                  data-failed="@Localizer["Unable to reset the schedule. Refresh the page and try again."]"
                  data-time-zone="@group.TimeZoneId" data-no-range="@Localizer["Not applicable"]">
                <input type="hidden" name="id" value="@group.Id" />
                @if (group.AutoExtend)
                {
                    <div class="alert alert-warning" role="alert"><div class="alert-message">@Localizer["Automatic extension is enabled. After clearing future shifts, shifts will be regenerated from the current template within about one minute."]</div></div>
                }
                <div class="form-check mb-3">
                    <input type="checkbox" class="form-check-input" id="group-reset-include-manual" name="includeManual" />
                    <label class="form-check-label" for="group-reset-include-manual">@Localizer["Also delete manually scheduled shifts"]</label>
                </div>
                <div class="alert alert-danger" role="alert" id="group-reset-errors" hidden><div class="alert-message"></div></div>
                <div role="status" aria-live="polite">
                    <dl class="mb-3" id="group-reset-summary" hidden>
                        <dt>@Localizer["Shifts to delete"]</dt><dd data-result="deletedCount"></dd>
                        <dt>@Localizer["Shifts to generate"]</dt><dd data-result="generatedCount"></dd>
                        <dt>@Localizer["Start"]</dt><dd data-result="startUtc"></dd>
                        <dt>@Localizer["End"]</dt><dd data-result="endUtc"></dd>
                    </dl>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-danger" id="group-reset-clear" disabled>@Localizer["Clear future shifts"]</button>
                    <button type="button" class="btn btn-outline-primary" id="group-reset-regenerate" disabled
                            data-unavailable="@(regenerateUnavailable != null ? "true" : null)"
                            aria-describedby="@(regenerateUnavailable != null ? "group-reset-regenerate-reason" : null)">@Localizer["Regenerate schedule"]</button>
                    <button type="button" class="btn btn-danger" id="group-reset-confirm" disabled hidden
                            data-clear="@Localizer["Confirm clearing future shifts"]"
                            data-regenerate="@Localizer["Confirm schedule regeneration"]"></button>
                </div>
                @if (regenerateUnavailable != null)
                {
                    <p class="form-text mb-0" id="group-reset-regenerate-reason">@regenerateUnavailable</p>
                }
            </form>
        </div>
    </div>
    if (Model.BoundApplications.Count > 0)
    {
        <div class="alert alert-info" role="alert">
            <div class="alert-message">
                @Localizer["This team is bound to an integrated app. Please reassign or unbind the app's on-call group before deleting the team."]
                <ul class="mb-0">
                    @foreach (var application in Model.BoundApplications)
                    {
                        <li><a asp-controller="Applications" asp-action="OnCall" asp-route-id="@application.Id">@application.Name</a></li>
                    }
                </ul>
            </div>
        </div>
    }
    else
    {
        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#delete-oncall-group">@Localizer["Delete team"]</button>
        <div class="modal fade" id="delete-oncall-group" tabindex="-1" aria-labelledby="delete-oncall-group-title" aria-describedby="delete-oncall-group-description" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form asp-action="DeleteGroup" method="post" data-action-feedback class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="delete-oncall-group-title">@Localizer["Delete on-call team"]</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
                    </div>
                    <div class="modal-body">
                        <p>@Localizer["Confirm team deletion"] <strong class="text-break">@group.Name</strong>？</p>
                        <div class="alert alert-warning mb-0" id="delete-oncall-group-description" role="alert">
                            <div class="alert-message">
                                <p>@Localizer["Will delete {0} future shifts and {1} historical shifts. Existing incidents retain their on-call records.", Model.FutureShiftCount, Model.HistoricalShiftCount]</p>
                                @Localizer["Future shifts include any ongoing shifts. Templates and incident delivery records are retained. This action is irreversible."]
                            </div>
                        </div>
                        <label for="delete-team-name" class="form-label mt-3">@Localizer["Enter the exact team name to confirm deletion."]</label>
                        <input id="delete-team-name" name="confirmationName" class="form-control" required autocomplete="off" data-team-name="@group.Name" data-mismatch="@Localizer["The team name does not match."]" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                        <input type="hidden" name="id" value="@group.Id" />
                        <button type="submit" class="btn btn-danger">@Localizer["Confirm team deletion"]</button>
                    </div>
                </form>
            </div>
        </div>
    }
}
