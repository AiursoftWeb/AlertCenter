@model Aiursoft.AlertCenter.Models.OnCallViewModel
@{
    var group = Model.Groups.Single(item => item.Id == Model.SelectedGroupId);
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <h1 class="h3 mb-1">@group.Name</h1>
        <p class="text-muted mb-0">时区：@group.TimeZoneId · @group.Members.Count 名成员</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Groups" class="btn btn-outline-secondary">返回团队列表</a>
        <a asp-action="ScheduleDetails" asp-route-id="@group.Id" class="btn btn-outline-primary">查看值班排班</a>
        @if (Model.IsAdministrator)
        {
            <a asp-action="GroupEdit" asp-route-id="@group.Id" class="btn btn-primary">编辑团队</a>
        }
    </div>
</div>
@if (TempData["OnCallGroupSuccess"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}
<div class="card mb-4">
    <div class="card-header"><h2 class="card-title mb-0">团队配置</h2></div>
    <div class="card-body">
        <p>排班起点：@group.AnchorUtc.ToString("yyyy-MM-dd HH:mm") UTC</p>
        @if (group.Rule != null)
        {
            <p>规则模板：<a asp-action="Details" asp-route-id="@group.Rule.Id">@group.Rule.Name</a> · 每班 @group.Rule.ShiftHours 小时 · 最短休息 @group.Rule.RestHours 小时</p>
        }
        else
        {
            <p class="text-muted">未绑定规则模板，仍可手动编辑排班。</p>
        }
        <p class="small text-muted">模板可由多个团队共用；修改或切换模板不会重新生成已保存班次。</p>
        @if (Model.IsAdministrator)
        {
            <h3 class="h6">值班邮件抄送（CC）</h3>
            @if (string.IsNullOrWhiteSpace(group.EmailCcRecipients))
            {
                <p class="text-muted">未配置抄送地址。</p>
            }
            else
            {
                <ul class="mb-2">
                    @foreach (var recipient in group.EmailCcRecipients.Split('\n'))
                    {
                        <li class="text-break">@recipient</li>
                    }
                </ul>
            }
            <p class="small text-muted">值班邮件会自动发送至当前已保存班次中所有值班工程师（OCE）的用户邮箱（To）。CC 仅使用管理员显式配置的团队邮箱或邮件组地址，不会自动抄送全部团队成员。应用配置的自定义推送渠道仍会额外投递。</p>
        }
        <h3 class="h6">轮换成员（按顺序）</h3>
        @if (group.Members.Count == 0)
        {
            <p class="text-muted mb-0">暂无团队成员。</p>
        }
        else
        {
            <ol class="mb-0">
                @foreach (var member in group.Members.OrderBy(item => item.RotationOrder))
                {
                    <li>@(member.User?.DisplayName ?? "已删除的员工") (@(member.User?.UserName ?? member.UserId))</li>
                }
            </ol>
        }
    </div>
</div>
@if (Model.IsAdministrator)
{
    if (Model.GroupHasSavedSchedule)
    {
        <div class="alert alert-info">该团队已有保存的班次，不能删除，以保留排班历史。</div>
    }
    else if (Model.GroupHasBoundApplications)
    {
        <div class="alert alert-info">该团队已绑定接入应用，请先更换或解除应用的值班组绑定，再删除团队。</div>
    }
    else
    {
        <form asp-action="DeleteGroup" method="post" data-action-feedback onsubmit="return confirm('确定删除该团队？规则模板不会被删除，此操作无法恢复。');">
            <input type="hidden" name="id" value="@group.Id" />
            <button type="submit" class="btn btn-outline-danger">删除团队</button>
        </form>
    }
}
