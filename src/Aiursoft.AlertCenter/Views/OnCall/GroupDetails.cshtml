@model Aiursoft.AlertCenter.Models.OnCallViewModel
@{
    var group = Model.Groups.Single(item => item.Id == Model.SelectedGroupId);
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <h1 class="h3 mb-1">@group.Name</h1>
        <p class="text-muted mb-0">@Localizer["Time zone: "]@group.TimeZoneId · @group.Members.Count @Localizer[" members"]</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Groups" class="btn btn-outline-secondary">@Localizer["Back to Team List"]</a>
        <a asp-action="ScheduleDetails" asp-route-id="@group.Id" class="btn btn-outline-primary">@Localizer["View on-call schedule"]</a>
        @if (Model.CanManageOnCall)
        {
            <a asp-action="GroupEdit" asp-route-id="@group.Id" class="btn btn-primary">@Localizer["Edit team"]</a>
        }
    </div>
</div>
@if (TempData["OnCallGroupSuccess"] is string message)
{
    <div class="alert alert-success alert-dismissible" role="status">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer["Close"]"></button>
        <div class="alert-message">@message</div>
    </div>
}
<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5">@Localizer["Next: assign people to shifts"]</h2>
        <p>@Localizer["The member list says who can be scheduled. The saved schedule says who is on duty and receives incident emails. CC recipients receive a copy independently of group membership."]</p>
        <a asp-action="ScheduleDetails" asp-route-id="@group.Id" class="btn btn-primary">@Localizer["Open schedule"]</a>
        @if (Model.CanManageOnCall)
        {
            <a asp-action="GroupEdit" asp-route-id="@group.Id" asp-fragment="group-members" class="btn btn-outline-secondary">@Localizer["Manage members"]</a>
        }
    </div>
</div>
<div class="card mb-4">
    <div class="card-header"><h2 class="card-title mb-0">@Localizer["Team configuration"]</h2></div>
    <div class="card-body">
        <p>@Localizer["Scheduling start point: "]@group.AnchorUtc.ToString("yyyy-MM-dd HH:mm") UTC</p>
        @if (group.Rule != null)
        {
            <p>@Localizer["Rule template:"]<a asp-action="Details" asp-route-id="@group.Rule.Id">@group.Rule.Name</a> · @Localizer["Per shift "]@group.Rule.ShiftHours @Localizer["hours · Min rest "]@group.Rule.RestHours @Localizer["hours"]</p>
        }
        else
        {
            <p class="text-muted">@Localizer["Rule template not bound; manual scheduling is still available."]</p>
        }
        <p class="small text-muted">@Localizer["Templates can be shared by multiple teams; modifying or switching templates will not regenerate saved shifts."]</p>
        @if (Model.CanManageOnCall)
        {
            <h3 class="h6">@Localizer["On-call email CC"]</h3>
            @if (string.IsNullOrWhiteSpace(group.EmailCcRecipients))
            {
                <p class="text-muted">@Localizer["CC address not configured."]</p>
            }
            else
            {
                <ul class="mb-2">
                    @foreach (var recipient in group.EmailCcRecipients.Split('\n'))
                    {
                        <li class="text-break">@recipient</li>
                    }
                </ul>
            }
            <p class="small text-muted">@Localizer["On-call emails are automatically sent to the user mailboxes (To) of all On-Call Engineers (OCEs) in the currently saved shift. CC only uses team mailboxes or mailing list addresses explicitly configured by the administrator; it does not automatically CC all team members. Custom push channels configured in the application will still deliver additional notifications."]</p>
        }
        <h3 class="h6">@Localizer["Members available for scheduling (rotation order)"]</h3>
        @if (group.Members.Count == 0)
        {
            <p class="text-muted mb-0">@Localizer["No team members."]</p>
        }
        else
        {
            <ol class="mb-0">
                @foreach (var member in group.Members.OrderBy(item => item.RotationOrder))
                {
                    <li>@member.User.DisplayName (@(member.User.UserName ?? member.UserId))</li>
                }
            </ol>
        }
    </div>
</div>
@if (Model.CanManageOnCall)
{
    if (Model.GroupHasSavedSchedule)
    {
        <div class="alert alert-info" role="alert">
            <div class="alert-message">@Localizer["This team has saved shifts and cannot be deleted to preserve scheduling history."]</div>
        </div>
    }
    else if (Model.GroupHasBoundApplications)
    {
        <div class="alert alert-info" role="alert">
            <div class="alert-message">@Localizer["This team is bound to an integrated app. Please reassign or unbind the app's on-call group before deleting the team."]</div>
        </div>
    }
    else
    {
        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#delete-oncall-group">@Localizer["Delete team"]</button>
        <div class="modal fade" id="delete-oncall-group" tabindex="-1" aria-labelledby="delete-oncall-group-title" aria-describedby="delete-oncall-group-description" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form asp-action="DeleteGroup" method="post" data-action-feedback class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="delete-oncall-group-title">@Localizer["Delete on-call team"]</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
                    </div>
                    <div class="modal-body">
                        <p>@Localizer["Confirm team deletion"] <strong class="text-break">@group.Name</strong>？</p>
                        <div class="alert alert-warning mb-0" id="delete-oncall-group-description" role="alert">
                            <div class="alert-message">@Localizer["Rule templates cannot be deleted. Only teams with no saved shifts and no bound applications can be deleted. This action is irreversible."]</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                        <input type="hidden" name="id" value="@group.Id" />
                        <button type="submit" class="btn btn-danger">@Localizer["Confirm team deletion"]</button>
                    </div>
                </form>
            </div>
        </div>
    }
}
