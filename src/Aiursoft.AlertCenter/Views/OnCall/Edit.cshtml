@model Aiursoft.AlertCenter.Models.OnCallViewModel
@inject IHtmlLocalizerFactory OnCallLocalizerFactory
@{ var viewLocalizer = OnCallLocalizerFactory.Create("Views.OnCall.Edit", typeof(Aiursoft.AlertCenter.Startup).Assembly.GetName().Name!); }
@section scripts {
    <script src="~/scripts/oncall-template.js" asp-append-version="true"></script>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@viewLocalizer["Edit scheduling rules"]</h1>
    <a asp-action="Details" asp-route-id="@Model.RuleInput.Id" class="btn btn-outline-secondary">@viewLocalizer["Back to Rule Details"]</a>
</div>
<div class="card">
    <div class="card-body">
        <partial name="_RuleForm" model="Model" />
    </div>
</div>
