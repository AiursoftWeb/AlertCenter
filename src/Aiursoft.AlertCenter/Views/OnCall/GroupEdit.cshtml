@model Aiursoft.AlertCenter.Models.OnCallViewModel
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Localizer["Edit team"]</h1>
    <a asp-action="GroupDetails" asp-route-id="@Model.SelectedGroupId" class="btn btn-outline-secondary">@Localizer["Back to Team Details"]</a>
</div>
<div class="card"><div class="card-body"><partial name="_GroupForm" model="Model" /></div></div>

@section scripts {
    <script src="~/scripts/oncall-group-form.js" asp-append-version="true"></script>
    <script src="~/scripts/oncall-member-search.js" asp-append-version="true"></script>
}
