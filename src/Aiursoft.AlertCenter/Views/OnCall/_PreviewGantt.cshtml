@using System.Globalization
@inject IHtmlLocalizerFactory OnCallLocalizerFactory
@{ var viewLocalizer = OnCallLocalizerFactory.Create("Views.OnCall._PreviewGantt", typeof(Aiursoft.AlertCenter.Startup).Assembly.GetName().Name!); }
@model Aiursoft.AlertCenter.Models.OnCallViewModel
@{
    var group = Model.Groups.Single(item => item.Id == Model.SelectedGroupId);
    var zone = TimeZoneInfo.FindSystemTimeZoneById(group.TimeZoneId);
    var start = Model.WeekStartUtc;
    var end = Model.WeekEndUtc;
    var duration = (end - start).TotalHours;
    var now = DateTime.UtcNow;
    var today = DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(now, zone));
    var staffNames = Model.PreviewUsers.ToDictionary(user => user.Id, user => user.DisplayName);
    var memberOrder = group.Members.ToDictionary(member => member.UserId, member => member.RotationOrder);
    var rows = Model.PreviewUsers.OrderBy(user => memberOrder.GetValueOrDefault(user.Id, int.MaxValue)).ToList();
    var selectedShift = Model.Preview.FirstOrDefault(shift => shift.StartsAtUtc <= now && now < shift.EndsAtUtc) ?? Model.Preview.FirstOrDefault();
    var selectedStart = selectedShift == null ? "" : TimeZoneInfo.ConvertTime(new DateTimeOffset(selectedShift.StartsAtUtc), zone).ToString("yyyy-MM-dd HH:mm zzz");
    var selectedEnd = selectedShift == null ? "" : TimeZoneInfo.ConvertTime(new DateTimeOffset(selectedShift.EndsAtUtc), zone).ToString("yyyy-MM-dd HH:mm zzz");
    var adjacent = Model.AdjacentShifts.Where(shift => shift.EndsAtUtc > start.AddHours(-36) && shift.StartsAtUtc < end.AddHours(36))
        .SelectMany(shift => shift.Members.Select(member => new Aiursoft.AlertCenter.Services.GeneratedOnCallShift(member.UserId,
            DateTime.SpecifyKind(shift.StartsAtUtc, DateTimeKind.Utc), DateTime.SpecifyKind(shift.EndsAtUtc, DateTimeKind.Utc)))).ToList();
    var contextDays = new[] { (Edge: "previous", Start: start.AddHours(-36)), (Edge: "next", Start: end) }
        .Select(context => new
        {
            context.Edge,
            context.Start,
            Days = Aiursoft.AlertCenter.Models.OnCallPreviewTimeline.Build(
                [new Aiursoft.AlertCenter.Services.GeneratedOnCallShift(string.Empty, context.Start, context.Start.AddHours(36))], zone)
        }).ToList();
    string Percent(double hours) => (hours / duration * 100).ToString("0.######", CultureInfo.InvariantCulture) + "%";
    string Position(DateTime time) => Percent((time - start).TotalHours);
    string LocalTime(DateTime time) => TimeZoneInfo.ConvertTimeFromUtc(time, zone).ToString("yyyy-MM-dd HH:mm");
}
<div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
    <h3 class="h6 mb-0">@viewLocalizer["Employee on-call timeline"]</h3>
    <span class="small text-muted">@LocalTime(start) → @LocalTime(end) · @group.TimeZoneId</span>
</div>
<p id="oncall-gantt-help" class="small text-muted mb-2">
    @if (Model.CanManageOnCall)
    {
        @viewLocalizer["Drag a shift to move its person or time; drag its edges to resize. Changes remain drafts until saved."]
    }
    else
    {
        @viewLocalizer["Select a shift to see its details. Scroll horizontally to see the full week."]
    }
</p>
<details class="small text-muted mb-3">
    <summary>@(Model.CanManageOnCall ? viewLocalizer["How to adjust the schedule"].Value : viewLocalizer["How to read this timeline"].Value)</summary>
    @if (Model.CanManageOnCall)
    {
        <ul class="mt-2 mb-2">
            <li>@viewLocalizer["Drag the body of a shift to change its time or person. Drag the left or right edge to adjust its start or end. Drag a handover to change both adjoining shifts."]</li>
            <li>@viewLocalizer["Drop a shift onto another assigned shift to exchange their members."]</li>
            <li>@viewLocalizer["Drag Swap full week to another member, or select the button then select the target member row, to exchange their schedules across the visible range."]</li>
            <li>@viewLocalizer["Drag across a blank member row to create a shift. Times snap to 30 minutes; hold Alt for minute precision. On touch screens, hold before dragging; scroll horizontally using the time axis or chart background."]</li>
            <li>@viewLocalizer["Focus a shift: Left/Right moves time, Up/Down changes person. Shift + Left/Right adjusts the end; Shift + Up/Down adjusts the start. Enter opens exact editing, Delete removes, and Escape cancels."]</li>
            <li>@viewLocalizer["Use Precise editing / bulk operations for exact times, zero or multiple members, moving a selected shift, swapping members, or copying a range. Undo, redo and reset include copied drafts. Save publishes your changes."]</li>
        </ul>
    }
    else
    {
        <p class="mt-2">@viewLocalizer["This timeline is read-only."]</p>
    }
    <p class="mb-0">@viewLocalizer["Adjacent weeks and other teams are read-only. Warning markers include gaps, overlaps and team reminders; select a marker for details. Statistics count only time within the visible range and merge overlapping assignments for each person."]</p>
</details>
<div class="ac-gantt-frame">
<button type="button" class="btn btn-sm btn-outline-secondary ac-gantt-edge-toggle" data-oncall-edge="previous" aria-expanded="false" aria-controls="oncall-gantt">@viewLocalizer["Expand previous 36 hours"]</button>
<div id="oncall-gantt" class="ac-gantt-scroll border rounded" data-duration="@duration.ToString(CultureInfo.InvariantCulture)" role="region" aria-label="@viewLocalizer["7-Day On-Call Gantt Chart"]" aria-describedby="oncall-gantt-help" tabindex="0">
    <div class="ac-gantt">
        <div class="ac-gantt-grid" aria-hidden="true">
            @foreach (var context in contextDays)
            {
                @foreach (var day in context.Days)
                {
                    var dayStart = day.Segments[0].StartsAtUtc;
                    var dayEnd = day.Segments[^1].EndsAtUtc;
                    <div class="ac-gantt-day ac-gantt-adjacent" data-edge="@context.Edge" hidden style="left: @Position(dayStart); width: @Percent((dayEnd - dayStart).TotalHours)"></div>
                }
                @for (var tick = context.Start; tick < context.Start.AddHours(36); tick = tick.AddHours(6))
                {
                    <div class="ac-gantt-grid-tick" data-edge="@context.Edge" hidden style="left: @Position(tick)"></div>
                }
            }
            @foreach (var day in Model.PreviewDays.Where(day => day.Segments.Count > 0))
            {
                var dayStart = day.Segments[0].StartsAtUtc;
                var dayEnd = day.Segments[^1].EndsAtUtc;
                <div class="ac-gantt-day @(day.Date == today ? "bg-primary-subtle" : "")" style="left: @Position(dayStart); width: @Percent((dayEnd - dayStart).TotalHours)"></div>
            }
            @for (var tick = start; tick < end; tick = tick.AddHours(6))
            {
                <div class="ac-gantt-grid-tick" style="left: @Position(tick)"></div>
            }
            @if (start <= now && now < end)
            {
                <div class="ac-gantt-now" style="left: @Position(now)"><span>@viewLocalizer["Now"]</span></div>
            }
        </div>
        <div class="ac-gantt-row">
            <div class="ac-gantt-name fw-semibold">@viewLocalizer["On-call staff"]<span class="small text-muted d-block">@viewLocalizer["Shift / Total Duration"]</span></div>
            <div class="ac-gantt-axis">
                @foreach (var context in contextDays)
                {
                    @foreach (var day in context.Days)
                    {
                        var dayStart = day.Segments[0].StartsAtUtc;
                        var dayEnd = day.Segments[^1].EndsAtUtc;
                        <div class="ac-gantt-date ac-gantt-adjacent" data-edge="@context.Edge" hidden style="left: @Position(dayStart); width: @Percent((dayEnd - dayStart).TotalHours)"
                             title="@(context.Edge == "previous" ? @viewLocalizer["36 hours before this week (read-only)"].Value : @viewLocalizer["36 hours after this week (read-only)"].Value) · @LocalTime(context.Start) → @LocalTime(context.Start.AddHours(36))">
                            <strong>@day.Date.ToString("MM/dd")</strong>
                            <span class="small d-block">@day.Date.ToString("ddd", CultureInfo.CurrentUICulture) · @viewLocalizer["Read-only"]</span>
                        </div>
                    }
                    @for (var tick = context.Start; tick < context.Start.AddHours(36); tick = tick.AddHours(6))
                    {
                        <span class="ac-gantt-tick small text-muted" data-edge="@context.Edge" hidden style="left: @Position(tick)">@TimeZoneInfo.ConvertTimeFromUtc(tick, zone).ToString("HH:mm")</span>
                    }
                }
                @foreach (var day in Model.PreviewDays.Where(day => day.Segments.Count > 0))
                {
                    var dayStart = day.Segments[0].StartsAtUtc;
                    var dayEnd = day.Segments[^1].EndsAtUtc;
                    <div class="ac-gantt-date" style="left: @Position(dayStart); width: @Percent((dayEnd - dayStart).TotalHours)" title="@day.Date.ToString("yyyy-MM-dd")">
                        <strong>@day.Date.ToString("MM/dd")</strong>
                        <span class="small text-muted">@(day.Date == today ? @viewLocalizer["Today"].Value : day.Date.ToString("ddd", CultureInfo.CurrentUICulture))</span>
                    </div>
                }
                @for (var tick = start; tick < end; tick = tick.AddHours(6))
                {
                    <span class="ac-gantt-tick small text-muted" style="left: @Position(tick)">@TimeZoneInfo.ConvertTimeFromUtc(tick, zone).ToString("HH:mm")</span>
                }
            </div>
        </div>
        <div class="ac-gantt-row ac-gantt-warning-row">
            <div class="ac-gantt-name">@viewLocalizer["Schedule reminders"]</div>
            <div class="ac-gantt-lane" id="oncall-warning-lane">
                @foreach (var warning in Aiursoft.AlertCenter.Models.OnCallWarningTimeline.Build(Model.TimelineWarnings, start, end))
                {
                    var summary = string.Join("\n", warning.Messages);
                    var localStart = TimeZoneInfo.ConvertTime(new DateTimeOffset(DateTime.SpecifyKind(warning.StartsAtUtc, DateTimeKind.Utc)), zone).ToString("yyyy-MM-dd HH:mm zzz");
                    var localEnd = TimeZoneInfo.ConvertTime(new DateTimeOffset(DateTime.SpecifyKind(warning.EndsAtUtc, DateTimeKind.Utc)), zone).ToString("yyyy-MM-dd HH:mm zzz");
                    var details = $"{summary} · {localStart} → {localEnd} · {group.TimeZoneId}";
                    <button type="button" class="ac-gantt-shift ac-gantt-warning bg-warning text-dark"
                            style="left: @Position(warning.StartsAtUtc); width: @Percent((warning.EndsAtUtc - warning.StartsAtUtc).TotalHours)"
                            data-summary="@summary" data-start="@localStart" data-end="@localEnd" data-readonly="true"
                            title="@details" aria-label="@details" aria-describedby="oncall-shift-detail">
                        <span class="badge bg-dark ac-gantt-warning-count" aria-hidden="true">@warning.Messages.Count</span><span class="ac-gantt-warning-text" aria-hidden="true">@summary</span>
                    </button>
                }
            </div>
        </div>
        @if (Model.CanManageOnCall)
        {
            <div class="ac-gantt-row">
                <div class="ac-gantt-name">@viewLocalizer["Handovers"]</div>
                <div id="oncall-handover-lane" class="ac-gantt-lane"></div>
            </div>
            <div id="oncall-unassigned-row" class="ac-gantt-row" role="group" aria-label="@viewLocalizer["Unassigned"]" data-user-id="" data-name="@viewLocalizer["Unassigned"]" data-color="0">
                <div class="ac-gantt-name">
                    <strong>@viewLocalizer["Unassigned"]</strong>
                    <span class="small text-muted d-block ac-gantt-hours"></span>
                </div>
                <div class="ac-gantt-lane"></div>
            </div>
        }
        @for (var index = 0; index < rows.Count; index++)
        {
            var user = rows[index];
            var shifts = Model.Preview.Where(shift => shift.UserId == user.Id).ToList();
            var name = user.DisplayName;
            var departed = !memberOrder.ContainsKey(user.Id);
            var covered = start;
            var hours = 0.0;
            foreach (var shift in shifts.OrderBy(shift => shift.StartsAtUtc))
            {
                var left = shift.StartsAtUtc > covered ? shift.StartsAtUtc : covered;
                var right = shift.EndsAtUtc < end ? shift.EndsAtUtc : end;
                hours += Math.Max(0, (right - left).TotalHours);
                if (right > covered) covered = right;
            }
            <div class="ac-gantt-row" role="group" aria-label="@(string.Format(@viewLocalizer["{0}'s on-call shifts"].Value, name))" data-user-id="@user.Id" data-name="@name" data-color="@(index % 4)" data-departed="@(departed ? "true" : "false")">
                <div class="ac-gantt-name">
                    <div class="d-flex align-items-center gap-2">
                        <span class="ac-oncall-dot ac-oncall-color-@(index % 4)" aria-hidden="true"></span>
                        <strong>@name</strong>
                        @if (departed)
                        {
                            <span class="badge bg-secondary">@viewLocalizer["Departed"]</span>
                        }
                    </div>
                    <span class="small text-muted ac-gantt-hours">@(string.Format(@viewLocalizer["{0} shifts / {1:0.##} hours"].Value, shifts.Count, hours))</span>
                    @if (Model.CanManageOnCall && !departed)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary ac-gantt-week mt-2" data-week-user="@user.Id"
                                aria-label="@string.Format(viewLocalizer["Swap full-week shifts with {0}"].Value, name)">
                            @viewLocalizer["Swap full week"]
                        </button>
                    }
                </div>
                <div class="ac-gantt-lane">
                    @foreach (var shift in Model.Preview.Where(shift => shift.UserId == user.Id))
                    {
                        var isCurrent = Model.ScheduleSaved && shift.StartsAtUtc <= now && now < shift.EndsAtUtc;
                        var localStart = TimeZoneInfo.ConvertTime(new DateTimeOffset(shift.StartsAtUtc), zone);
                        var localEnd = TimeZoneInfo.ConvertTime(new DateTimeOffset(shift.EndsAtUtc), zone);
                        var shiftHours = (shift.EndsAtUtc - shift.StartsAtUtc).TotalHours;
                        var clippedStart = shift.StartsAtUtc < start ? start : shift.StartsAtUtc;
                        var clippedEnd = shift.EndsAtUtc > end ? end : shift.EndsAtUtc;
                        var details = string.Format(@viewLocalizer["{0}{1} · {2:yyyy-MM-dd HH:mm zzz} → {3:yyyy-MM-dd HH:mm zzz} · {4:0.##} hours · {5}"].Value, name, departed ? @viewLocalizer[" · Departed"].Value : "", localStart, localEnd, shiftHours, group.TimeZoneId);
                        <button type="button" class="ac-gantt-shift ac-oncall-color-@(index % 4) @(isCurrent ? "ac-gantt-current" : "")"
                                style="left: @Position(clippedStart); width: @Percent((clippedEnd - clippedStart).TotalHours)"
                                data-summary="@name@(departed ? @viewLocalizer[" · Departed"].Value : "") · @shiftHours.ToString("0.##") @viewLocalizer["hours"] · @group.TimeZoneId@(isCurrent ? @viewLocalizer[" · On call"].Value : "")"
                                data-start="@localStart.ToString("yyyy-MM-dd HH:mm zzz")" data-end="@localEnd.ToString("yyyy-MM-dd HH:mm zzz")"
                                data-readonly="true" data-draft-shift="true"
                                aria-label="@details@(isCurrent ? @viewLocalizer[" · On call"].Value : "")" title="@details" aria-describedby="oncall-shift-detail">
                            <span class="ac-gantt-time" aria-hidden="true">@viewLocalizer["From "]@localStart.ToString("HH:mm")</span>
                            <span class="ac-gantt-time ac-gantt-time-end" aria-hidden="true">@viewLocalizer["Until "]@localEnd.ToString("HH:mm")</span>
                        </button>
                    }
                    @foreach (var shift in adjacent.Where(shift => shift.UserId == user.Id))
                    {
                        var edge = shift.StartsAtUtc < start ? "previous" : "next";
                        var clippedStart = shift.StartsAtUtc < start.AddHours(-36) ? start.AddHours(-36) : shift.StartsAtUtc;
                        var clippedEnd = shift.EndsAtUtc > end.AddHours(36) ? end.AddHours(36) : shift.EndsAtUtc;
                        var localStart = TimeZoneInfo.ConvertTime(new DateTimeOffset(shift.StartsAtUtc), zone);
                        var localEnd = TimeZoneInfo.ConvertTime(new DateTimeOffset(shift.EndsAtUtc), zone);
                        var details = string.Format(@viewLocalizer["{0}{1} · {2} · Adjacent week (read-only) · {3}"].Value, name, departed ? @viewLocalizer[" · Departed"].Value : "", group.Name, group.TimeZoneId);
                        <button type="button" class="ac-gantt-shift ac-gantt-adjacent" data-readonly="true" data-group-id="@group.Id" data-edge="@edge" hidden="hidden"
                                style="left: @Position(clippedStart); width: @Percent((clippedEnd - clippedStart).TotalHours)"
                                data-summary="@details" data-start="@localStart.ToString("yyyy-MM-dd HH:mm zzz")" data-end="@localEnd.ToString("yyyy-MM-dd HH:mm zzz")"
                                aria-label="@details · @localStart.ToString("yyyy-MM-dd HH:mm zzz") → @localEnd.ToString("yyyy-MM-dd HH:mm zzz")"
                                title="@details · @localStart.ToString("yyyy-MM-dd HH:mm zzz") → @localEnd.ToString("yyyy-MM-dd HH:mm zzz")" aria-describedby="oncall-shift-detail">
                            <span class="ac-gantt-time">@(string.Format(@viewLocalizer["{0} (Read-only)"].Value, group.Name))</span>
                            <span class="ac-gantt-time" aria-hidden="true">@viewLocalizer["From "]@localStart.ToString("HH:mm")</span>
                            <span class="ac-gantt-time ac-gantt-time-end" aria-hidden="true">@viewLocalizer["Until "]@localEnd.ToString("HH:mm")</span>
                        </button>
                    }
                    @foreach (var shift in Model.OtherGroupShifts.Where(shift => shift.Members.Any(member => member.UserId == user.Id) &&
                        shift.StartsAtUtc < end.AddHours(36) && shift.EndsAtUtc > start.AddHours(-36)))
                    {
                        var localStart = TimeZoneInfo.ConvertTime(new DateTimeOffset(DateTime.SpecifyKind(shift.StartsAtUtc, DateTimeKind.Utc)), zone);
                        var localEnd = TimeZoneInfo.ConvertTime(new DateTimeOffset(DateTime.SpecifyKind(shift.EndsAtUtc, DateTimeKind.Utc)), zone);
                        var details = string.Format(@viewLocalizer["{0} · {1} · Other Team (Read-only) · {2}"].Value, name, shift.Group.Name, group.TimeZoneId);
                        @foreach (var region in new[] { "previous", "current", "next" })
                        {
                            var regionStart = region == "previous" ? start.AddHours(-36) : region == "next" ? end : start;
                            var regionEnd = region == "previous" ? start : region == "next" ? end.AddHours(36) : end;
                            var clippedStart = shift.StartsAtUtc > regionStart ? shift.StartsAtUtc : regionStart;
                            var clippedEnd = shift.EndsAtUtc < regionEnd ? shift.EndsAtUtc : regionEnd;
                            if (clippedEnd <= clippedStart) { continue; }
                            var edge = region == "current" ? null : region;
                            <button type="button" class="ac-gantt-shift ac-gantt-external" data-readonly="true" data-group-id="@shift.GroupId"
                                    data-edge="@edge" hidden="@(edge != null)" style="left: @Position(clippedStart); width: @Percent((clippedEnd - clippedStart).TotalHours)"
                                    data-summary="@details" data-start="@localStart.ToString("yyyy-MM-dd HH:mm zzz")" data-end="@localEnd.ToString("yyyy-MM-dd HH:mm zzz")"
                                    aria-label="@details · @localStart.ToString("yyyy-MM-dd HH:mm zzz") → @localEnd.ToString("yyyy-MM-dd HH:mm zzz")"
                                    title="@details · @localStart.ToString("yyyy-MM-dd HH:mm zzz") → @localEnd.ToString("yyyy-MM-dd HH:mm zzz")" aria-describedby="oncall-shift-detail">
                                <span class="ac-gantt-time">@(string.Format(@viewLocalizer["{0} (Read-only)"].Value, shift.Group.Name))</span>
                                <span class="ac-gantt-time" aria-hidden="true">@viewLocalizer["From "]@localStart.ToString("HH:mm")</span>
                                <span class="ac-gantt-time ac-gantt-time-end" aria-hidden="true">@viewLocalizer["Until "]@localEnd.ToString("HH:mm")</span>
                            </button>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>
<button type="button" class="btn btn-sm btn-outline-secondary ac-gantt-edge-toggle" data-oncall-edge="next" aria-expanded="false" aria-controls="oncall-gantt">@viewLocalizer["Expand next 36 hours"]</button>
</div>
<div class="border rounded bg-body-tertiary p-3 mt-2" id="oncall-shift-detail" role="status" aria-live="polite" aria-atomic="true">
    <div id="oncall-shift-summary" class="small fw-semibold mb-3">
        @if (selectedShift != null)
        {
            <span>@staffNames.GetValueOrDefault(selectedShift.UserId, @viewLocalizer["Employee deleted"].Value)@(!memberOrder.ContainsKey(selectedShift.UserId) ? @viewLocalizer[" · Departed"].Value : "") · @((selectedShift.EndsAtUtc - selectedShift.StartsAtUtc).TotalHours.ToString("0.##")) @viewLocalizer["hours · "]@group.TimeZoneId@(Model.ScheduleSaved && selectedShift.StartsAtUtc <= now && now < selectedShift.EndsAtUtc ? @viewLocalizer[" · On duty"].Value : "")</span>
        }
        else
        {
            <span>@viewLocalizer["No assigned shifts."]</span>
        }
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            <div class="small text-muted mb-1">@viewLocalizer["Start Time"]</div>
            <strong id="oncall-shift-start" class="ac-gantt-detail-time">@selectedStart</strong>
        </div>
        <div class="col-md-6">
            <div class="small text-muted mb-1">@viewLocalizer["End time"]</div>
            <strong id="oncall-shift-end" class="ac-gantt-detail-time">@selectedEnd</strong>
        </div>
    </div>
</div>
