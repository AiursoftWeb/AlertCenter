@using System.Globalization
@model Aiursoft.AlertCenter.Models.OnCallViewModel
@{
    var group = Model.Groups.Single(item => item.Id == Model.SelectedGroupId);
    var zone = TimeZoneInfo.FindSystemTimeZoneById(group.TimeZoneId);
    var start = Model.WeekStartUtc;
    var end = start.AddDays(7);
    var duration = (end - start).TotalHours;
    var now = DateTime.UtcNow;
    var today = DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(now, zone));
    var staffNames = Model.PreviewUsers.ToDictionary(user => user.Id, user => user.DisplayName);
    var memberOrder = group.Members.ToDictionary(member => member.UserId, member => member.RotationOrder);
    var rows = Model.PreviewUsers.OrderBy(user => memberOrder.GetValueOrDefault(user.Id, int.MaxValue)).ToList();
    var selectedShift = Model.Preview.FirstOrDefault(shift => shift.StartsAtUtc <= now && now < shift.EndsAtUtc) ?? Model.Preview.FirstOrDefault();
    var selectedStart = selectedShift == null ? "" : TimeZoneInfo.ConvertTime(new DateTimeOffset(selectedShift.StartsAtUtc), zone).ToString("yyyy-MM-dd HH:mm zzz");
    var selectedEnd = selectedShift == null ? "" : TimeZoneInfo.ConvertTime(new DateTimeOffset(selectedShift.EndsAtUtc), zone).ToString("yyyy-MM-dd HH:mm zzz");
    var adjacent = Model.AdjacentShifts.Where(shift => shift.EndsAtUtc > start.AddHours(-36) && shift.StartsAtUtc < end.AddHours(36))
        .SelectMany(shift => shift.Members.Select(member => new Aiursoft.AlertCenter.Services.GeneratedOnCallShift(member.UserId,
            DateTime.SpecifyKind(shift.StartsAtUtc, DateTimeKind.Utc), DateTime.SpecifyKind(shift.EndsAtUtc, DateTimeKind.Utc), shift.RestHours))).ToList();
    string Percent(double hours) => (hours / duration * 100).ToString("0.######", CultureInfo.InvariantCulture) + "%";
    string Position(DateTime time) => Percent((time - start).TotalHours);
    string LocalTime(DateTime time) => TimeZoneInfo.ConvertTimeFromUtc(time, zone).ToString("yyyy-MM-dd HH:mm");
}
<div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
    <h3 class="h6 mb-0">员工值班时间轴</h3>
    <span class="small text-muted">@LocalTime(start) → @LocalTime(end) · @group.TimeZoneId</span>
</div>
<p id="oncall-gantt-help" class="small text-muted">横向滚动查看完整排班；悬停、聚焦或点击色块查看班次详情。红线表示页面加载时的当前时间。左右竖向按钮分别展开本周起点前、终点后各 36 小时（实际 UTC 时长，含夏令时切换），默认折叠。两侧灰色班次仅供查看，不可编辑，也不计入本周统计；需要调整时请切换到对应周。其他团队的已保存班次在独立灰色行显示团队及时间，使用当前团队时区，仅供查看。</p>
<div class="ac-gantt-frame">
<button type="button" class="btn btn-sm btn-outline-secondary ac-gantt-edge-toggle" data-oncall-edge="previous" aria-expanded="false" aria-controls="oncall-gantt">展开前 36 小时</button>
<div id="oncall-gantt" class="ac-gantt-scroll border rounded" role="region" aria-label="七天值班甘特图" aria-describedby="oncall-gantt-help" tabindex="0">
    <div class="ac-gantt">
        <div class="ac-gantt-grid" aria-hidden="true">
            <div class="ac-gantt-day ac-gantt-adjacent" data-edge="previous" hidden style="left: @Percent(-36); width: @Percent(36)"></div>
            <div class="ac-gantt-day ac-gantt-adjacent" data-edge="next" hidden style="left: @Percent(168); width: @Percent(36)"></div>
            @foreach (var day in Model.PreviewDays.Where(day => day.Segments.Count > 0))
            {
                var dayStart = day.Segments[0].StartsAtUtc;
                var dayEnd = day.Segments[^1].EndsAtUtc;
                <div class="ac-gantt-day @(day.Date == today ? "bg-primary-subtle" : "")" style="left: @Position(dayStart); width: @Percent((dayEnd - dayStart).TotalHours)"></div>
            }
            @for (var tick = start; tick < end; tick = tick.AddHours(6))
            {
                <div class="ac-gantt-grid-tick" style="left: @Position(tick)"></div>
            }
            @if (start <= now && now < end)
            {
                <div class="ac-gantt-now" style="left: @Position(now)"><span>现在</span></div>
            }
        </div>
        <div class="ac-gantt-row">
            <div class="ac-gantt-name fw-semibold">值班员工<span class="small text-muted d-block">班次 / 总时长</span></div>
            <div class="ac-gantt-axis">
                @foreach (var edge in new[] { "previous", "next" })
                {
                    var edgeStart = edge == "previous" ? start.AddHours(-36) : end;
                    <div class="ac-gantt-date ac-gantt-adjacent" data-edge="@edge" hidden style="left: @Position(edgeStart); width: @Percent(36)">
                        <strong>@(edge == "previous" ? "本周前 36 小时（只读）" : "本周后 36 小时（只读）")</strong>
                        <span class="small d-block">@LocalTime(edgeStart) → @LocalTime(edgeStart.AddHours(36))</span>
                    </div>
                }
                @foreach (var day in Model.PreviewDays.Where(day => day.Segments.Count > 0))
                {
                    var dayStart = day.Segments[0].StartsAtUtc;
                    var dayEnd = day.Segments[^1].EndsAtUtc;
                    <div class="ac-gantt-date" style="left: @Position(dayStart); width: @Percent((dayEnd - dayStart).TotalHours)" title="@day.Date.ToString("yyyy-MM-dd")">
                        <strong>@day.Date.ToString("MM/dd")</strong>
                        <span class="small text-muted">@(day.Date == today ? "今天" : day.Date.ToString("ddd", CultureInfo.GetCultureInfo("zh-CN")))</span>
                    </div>
                }
                @for (var tick = start; tick < end; tick = tick.AddHours(6))
                {
                    <span class="ac-gantt-tick small text-muted" style="left: @Position(tick)">@TimeZoneInfo.ConvertTimeFromUtc(tick, zone).ToString("HH:mm")</span>
                }
            </div>
        </div>
        @for (var index = 0; index < rows.Count; index++)
        {
            var user = rows[index];
            var shifts = Model.Preview.Where(shift => shift.UserId == user.Id).ToList();
            var name = user.DisplayName;
            var departed = !memberOrder.ContainsKey(user.Id);
            var hours = shifts.Sum(shift => (shift.EndsAtUtc - shift.StartsAtUtc).TotalHours);
            <div class="ac-gantt-row" role="group" aria-label="@name 的值班班次" data-user-id="@user.Id" data-name="@name" data-color="@(index % 4)" data-departed="@(departed ? "true" : "false")">
                <div class="ac-gantt-name">
                    <div class="d-flex align-items-center gap-2">
                        <span class="ac-oncall-dot ac-oncall-color-@(index % 4)" aria-hidden="true"></span>
                        <strong>@name</strong>
                        @if (departed)
                        {
                            <span class="badge bg-secondary">已退出</span>
                        }
                    </div>
                    <span class="small text-muted ac-gantt-hours">@shifts.Count 班 / @hours.ToString("0.##") 小时</span>
                    @if (Model.IsAdministrator && !departed)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm mt-1 ac-gantt-week" aria-label="交换 @name 的整周班次" title="拖到另一位工程师交换整周，也可点击后选择目标员工">交换整周</button>
                    }
                </div>
                <div class="ac-gantt-user-lanes">
                    <div class="ac-gantt-lane">
                        @if (Model.IsAdministrator && !departed)
                        {
                            @for (var slot = 0; slot < 21; slot++)
                            {
                                <button type="button" class="ac-gantt-cell" data-slot="@(slot + 21)" style="left: @Percent(slot * 8); width: @Percent(8)"
                                        aria-label="@name · @LocalTime(start.AddHours(slot * 8)) · 移动选中班次到此处" tabindex="-1"></button>
                            }
                        }
                        @foreach (var shift in Model.Preview.Where(shift => shift.UserId == user.Id))
                        {
                            var isCurrent = shift.StartsAtUtc <= now && now < shift.EndsAtUtc;
                            var localStart = TimeZoneInfo.ConvertTime(new DateTimeOffset(shift.StartsAtUtc), zone);
                            var localEnd = TimeZoneInfo.ConvertTime(new DateTimeOffset(shift.EndsAtUtc), zone);
                            var shiftHours = (shift.EndsAtUtc - shift.StartsAtUtc).TotalHours;
                            var details = $"{name}{(departed ? " · 已退出" : "")} · {localStart:yyyy-MM-dd HH:mm zzz} → {localEnd:yyyy-MM-dd HH:mm zzz} · {shiftHours:0.##} 小时 · {group.TimeZoneId}";
                            <button type="button" class="ac-gantt-shift ac-oncall-color-@(index % 4) @(isCurrent ? "ac-gantt-current" : "")"
                                    style="left: @Position(shift.StartsAtUtc); width: @Percent(shiftHours)"
                                    data-summary="@name@(departed ? " · 已退出" : "") · @shiftHours.ToString("0.##") 小时 · @group.TimeZoneId@(isCurrent ? " · 值班中" : "")"
                                    data-start="@localStart.ToString("yyyy-MM-dd HH:mm zzz")" data-end="@localEnd.ToString("yyyy-MM-dd HH:mm zzz")"
                                    data-slot="@((int)((shift.StartsAtUtc - Model.WeekStartUtc).TotalHours / 8) + 21)"
                                    aria-label="@details@(isCurrent ? " · 值班中" : "")" title="@details" aria-describedby="oncall-shift-detail">
                                <span class="ac-gantt-time" aria-hidden="true">起 @localStart.ToString("HH:mm")</span>
                                <span class="ac-gantt-time ac-gantt-time-end" aria-hidden="true">止 @localEnd.ToString("HH:mm")</span>
                            </button>
                        }
                        @foreach (var shift in adjacent.Where(shift => shift.UserId == user.Id))
                        {
                            var edge = shift.StartsAtUtc < start ? "previous" : "next";
                            var clippedStart = shift.StartsAtUtc < start.AddHours(-36) ? start.AddHours(-36) : shift.StartsAtUtc;
                            var clippedEnd = shift.EndsAtUtc > end.AddHours(36) ? end.AddHours(36) : shift.EndsAtUtc;
                            var localStart = TimeZoneInfo.ConvertTime(new DateTimeOffset(shift.StartsAtUtc), zone);
                            var localEnd = TimeZoneInfo.ConvertTime(new DateTimeOffset(shift.EndsAtUtc), zone);
                            var details = $"{name}{(departed ? " · 已退出" : "")} · {group.Name} · 相邻周（只读） · {group.TimeZoneId}";
                            <button type="button" class="ac-gantt-shift ac-gantt-adjacent" data-readonly="true" data-edge="@edge" hidden="hidden"
                                    style="left: @Position(clippedStart); width: @Percent((clippedEnd - clippedStart).TotalHours)"
                                    data-summary="@details" data-start="@localStart.ToString("yyyy-MM-dd HH:mm zzz")" data-end="@localEnd.ToString("yyyy-MM-dd HH:mm zzz")"
                                    aria-label="@details · @localStart.ToString("yyyy-MM-dd HH:mm zzz") → @localEnd.ToString("yyyy-MM-dd HH:mm zzz")"
                                    title="@details · @localStart.ToString("yyyy-MM-dd HH:mm zzz") → @localEnd.ToString("yyyy-MM-dd HH:mm zzz")" aria-describedby="oncall-shift-detail">
                                <span class="ac-gantt-time" aria-hidden="true">起 @localStart.ToString("HH:mm")</span>
                                <span class="ac-gantt-time ac-gantt-time-end" aria-hidden="true">止 @localEnd.ToString("HH:mm")</span>
                            </button>
                        }
                    </div>
                    @foreach (var otherTeam in Model.OtherGroupShifts.Where(shift => shift.Members.Any(member => member.UserId == user.Id) &&
                        shift.StartsAtUtc < end.AddHours(36) && shift.EndsAtUtc > start.AddHours(-36)).GroupBy(shift => shift.GroupId))
                    {
                        <div class="ac-gantt-lane ac-gantt-external-lane" data-readonly="true" aria-label="@otherTeam.First().Group.Name 的排班（只读）">
                            @foreach (var shift in otherTeam)
                            {
                                var localStart = TimeZoneInfo.ConvertTime(new DateTimeOffset(DateTime.SpecifyKind(shift.StartsAtUtc, DateTimeKind.Utc)), zone);
                                var localEnd = TimeZoneInfo.ConvertTime(new DateTimeOffset(DateTime.SpecifyKind(shift.EndsAtUtc, DateTimeKind.Utc)), zone);
                                var details = $"{name} · {shift.Group.Name} · 其他团队（只读） · {group.TimeZoneId}";
                                @foreach (var region in new[] { "previous", "current", "next" })
                                {
                                    var regionStart = region == "previous" ? start.AddHours(-36) : region == "next" ? end : start;
                                    var regionEnd = region == "previous" ? start : region == "next" ? end.AddHours(36) : end;
                                    var clippedStart = shift.StartsAtUtc > regionStart ? shift.StartsAtUtc : regionStart;
                                    var clippedEnd = shift.EndsAtUtc < regionEnd ? shift.EndsAtUtc : regionEnd;
                                    if (clippedEnd <= clippedStart) { continue; }
                                    var edge = region == "current" ? null : region;
                                    <button type="button" class="ac-gantt-shift ac-gantt-external" data-readonly="true" data-group-id="@shift.GroupId"
                                            data-edge="@edge" hidden="@(edge != null)" style="left: @Position(clippedStart); width: @Percent((clippedEnd - clippedStart).TotalHours)"
                                            data-summary="@details" data-start="@localStart.ToString("yyyy-MM-dd HH:mm zzz")" data-end="@localEnd.ToString("yyyy-MM-dd HH:mm zzz")"
                                            aria-label="@details · @localStart.ToString("yyyy-MM-dd HH:mm zzz") → @localEnd.ToString("yyyy-MM-dd HH:mm zzz")"
                                            title="@details · @localStart.ToString("yyyy-MM-dd HH:mm zzz") → @localEnd.ToString("yyyy-MM-dd HH:mm zzz")" aria-describedby="oncall-shift-detail">
                                        <span class="ac-gantt-time">@shift.Group.Name（只读）</span>
                                        <span class="ac-gantt-time" aria-hidden="true">起 @localStart.ToString("HH:mm")</span>
                                        <span class="ac-gantt-time ac-gantt-time-end" aria-hidden="true">止 @localEnd.ToString("HH:mm")</span>
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
<button type="button" class="btn btn-sm btn-outline-secondary ac-gantt-edge-toggle" data-oncall-edge="next" aria-expanded="false" aria-controls="oncall-gantt">展开后 36 小时</button>
</div>
<div class="border rounded bg-body-tertiary p-3 mt-2" id="oncall-shift-detail" role="status" aria-live="polite" aria-atomic="true">
    <div id="oncall-shift-summary" class="small fw-semibold mb-3">
        @if (selectedShift != null)
        {
            <span>@staffNames.GetValueOrDefault(selectedShift.UserId, "已删除的员工")@(!memberOrder.ContainsKey(selectedShift.UserId) ? " · 已退出" : "") · @((selectedShift.EndsAtUtc - selectedShift.StartsAtUtc).TotalHours.ToString("0.##")) 小时 · @group.TimeZoneId@(selectedShift.StartsAtUtc <= now && now < selectedShift.EndsAtUtc ? " · 值班中" : "")</span>
        }
        else
        {
            <span>暂无已分配的班次。</span>
        }
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            <div class="small text-muted mb-1">开始时间</div>
            <strong id="oncall-shift-start" class="ac-gantt-detail-time">@selectedStart</strong>
        </div>
        <div class="col-md-6">
            <div class="small text-muted mb-1">结束时间</div>
            <strong id="oncall-shift-end" class="ac-gantt-detail-time">@selectedEnd</strong>
        </div>
    </div>
</div>
