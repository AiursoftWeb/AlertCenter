@model Aiursoft.AlertCenter.Models.OnCallViewModel

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">@Localizer["Team management"]</h1>
        <p class="text-muted mb-0">@Localizer["Manage team members, rotation order, timezone, and scheduling start point. You can bind a shared rule template, but actual shifts are saved by the team."]</p>
    </div>
    @if (Model.CanManageOnCall)
    {
        <a asp-action="GroupCreate" class="btn btn-primary">@Localizer["Create Team"]</a>
    }
</div>
@if (TempData["OnCallGroupSuccess"] is string message)
{
    <div class="alert alert-success alert-dismissible" role="status">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer["Close"]"></button>
        <div class="alert-message">@message</div>
    </div>
}
<div class="card">
    <div class="card-header"><h2 class="card-title mb-0">@Localizer["Team saved"]</h2></div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>@Localizer["Team"]</th><th>@Localizer["Time Zone"]</th><th>@Localizer["Member Count"]</th><th>@Localizer["Rule template"]</th><th>@Localizer["Action"]</th></tr></thead>
            <tbody>
                @foreach (var group in Model.Groups)
                {
                    <tr>
                        <td>@group.Name</td>
                        <td>@group.TimeZoneId</td>
                        <td>@group.Members.Count</td>
                        <td>@(group.Rule?.Name ?? @Localizer["Unbound"].Value)</td>
                        <td>
                            <a asp-action="GroupDetails" asp-route-id="@group.Id" class="btn btn-sm btn-outline-primary">@Localizer["View team"]</a>
                            <a asp-action="ScheduleDetails" asp-route-id="@group.Id" class="btn btn-sm btn-outline-secondary">@Localizer["View schedule"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Groups.Count == 0)
    {
        <div class="card-body text-muted">@Localizer["No teams available. Please create a team first."]</div>
    }
</div>
