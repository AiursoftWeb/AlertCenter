@using System.Text.Json
@model Aiursoft.AlertCenter.Models.OnCallViewModel
@{
    var group = Model.Groups.Single(item => item.Id == Model.SelectedGroupId);
    var zone = TimeZoneInfo.FindSystemTimeZoneById(group.TimeZoneId);
    var memberIds = group.Members.Select(member => member.UserId).ToHashSet();
    var weeks = Enumerable.Range(-1, 3).Select(offset =>
    {
        var start = Model.WeekStartUtc.AddDays(offset * 7);
        var saved = Model.AdjacentShifts.Where(shift => shift.StartsAtUtc >= start && shift.StartsAtUtc < start.AddDays(7)).ToList();
        return new
        {
            startUtc = start,
            saved = offset == 0 ? Model.ScheduleSaved : saved.Count > 0,
            restHours = offset == 0 ? Model.ScheduleRestHours : saved.FirstOrDefault()?.RestHours ?? group.Rule?.RestHours ?? 16,
            minimumStaff = offset == 0 ? Model.ScheduleMinimumStaff : saved.FirstOrDefault()?.MinimumStaff ?? group.Rule?.MinimumStaff ?? 1,
            available = start >= group.AnchorUtc && start <= DateTime.MaxValue.AddDays(-28)
        };
    }).ToList();
    var slots = Enumerable.Range(0, 63).Select(index =>
    {
        var start = Model.WeekStartUtc.AddHours((index - 21) * 8);
        return new
        {
            startsAtUtc = start,
            localStart = TimeZoneInfo.ConvertTime(new DateTimeOffset(start), zone).ToString("yyyy-MM-dd HH:mm zzz"),
            localEnd = TimeZoneInfo.ConvertTime(new DateTimeOffset(start.AddHours(8)), zone).ToString("yyyy-MM-dd HH:mm zzz"),
            userIds = index is >= 21 and < 42
                ? Model.Preview.Where(shift => shift.StartsAtUtc == start).Select(shift => shift.UserId).ToArray()
                : Model.AdjacentShifts.Where(shift => shift.StartsAtUtc == start).SelectMany(shift => shift.Members.Select(member => member.UserId)).ToArray()
        };
    }).ToList();
}
<div id="oncall-schedule" class="my-3" data-group-id="@group.Id" data-group-name="@group.Name" data-version="@group.ScheduleVersion" data-rest-hours="@Model.ScheduleRestHours" data-minimum-staff="@Model.ScheduleMinimumStaff" data-zone="@group.TimeZoneId"
     data-start="@Model.WeekStartUtc.ToString("O")" data-slots="@JsonSerializer.Serialize(slots)" data-weeks="@JsonSerializer.Serialize(weeks)"
     data-generate-url="@Url.Action("GenerateSchedule")" data-save-url="@Url.Action("SaveSchedule")">
    @Html.AntiForgeryToken()
    <div class="btn-group mb-2" role="group" aria-label="@Localizer["Scheduling Operation Mode"]">
        <button type="button" class="btn btn-outline-primary active" data-schedule-mode="move" aria-pressed="true">@Localizer["Move / Swap"]</button>
        <button type="button" class="btn btn-outline-primary" data-schedule-mode="add" aria-pressed="false">@Localizer["Add shift"]</button>
        <button type="button" class="btn btn-outline-danger" data-schedule-mode="remove" aria-pressed="false">@Localizer["Delete shift"]</button>
    </div>
    <p id="oncall-mode-help" class="small mb-2" role="status">@Localizer["Currently in Mobile/Swap mode. Switch the mode above before adding or removing shifts."]</p>
    <p class="small mb-2">@Localizer["Drag a color block to another shift to swap personnel, or to an empty slot to move the shift; drag 'Swap Entire Week' to exchange two people's weekly schedules. You can also click to select, then click the target; press Esc to cancel. Changes display immediately and can be saved in bulk after multiple adjustments."]</p>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <button id="oncall-save-schedule" type="button" class="btn btn-primary">@Localizer["Save schedule adjustments"]</button>
        @if (weeks[2].available)
        {
            <button id="oncall-copy-next" type="button" class="btn btn-outline-primary">@Localizer["Copy Current Week to Next Week"]</button>
        }
        <button id="oncall-undo-schedule" type="button" class="btn btn-outline-secondary">@Localizer["Undo last step"]</button>
        <button id="oncall-reset-schedule" type="button" class="btn btn-outline-secondary">@Localizer["Reset All"]</button>
        <span id="oncall-edit-count" class="small text-muted" role="status"></span>
    </div>
    <p id="oncall-drag-status" class="small text-primary mb-2" role="status" aria-live="polite"></p>
    <p class="small text-muted mb-2">@Localizer["Copy the current week's draft to the next week. If the next week already has shifts or modifications, confirmation is required before copying; saving is still required after copying. Vertical buttons on the sides can expand the 36 hours before and after the current week; gray areas are read-only. Charts and forms on this page only edit the current week; to adjust adjacent weeks, switch to the corresponding week. The next week's draft after copying is also previewed in read-only mode. Changes to the current week and copies are saved, undone, and restored uniformly; collapsing does not lose drafts."]</p>
    <p class="small text-muted mb-2">@Localizer["Red alerts indicate empty shifts, insufficient rest, or below minimum headcount, but do not block further adjustments. Saving is allowed even if below minimum headcount, but empty shifts and insufficient rest cannot be saved. Validation is applied uniformly across the modified week, adjacent weeks, and other teams upon saving. If any week fails validation, nothing is saved. Departed members can only retain their original shifts; new shifts cannot be added or copied."]</p>
    <details id="oncall-draft-validation" class="text-danger small mb-2" hidden>
        <summary id="oncall-draft-summary" role="status" aria-live="polite"></summary>
        <ul id="oncall-draft-errors" class="mt-2"></ul>
    </details>
    @if (Model.CanGenerateSchedule && !Model.ScheduleSaved)
    {
        <p class="small text-muted">@Localizer["Auto-suggestions have not been saved. Adjacent schedules will be re-validated upon generation; existing saved arrangements will not be overwritten."]</p>
        <button id="oncall-generate" type="button" class="btn btn-primary">@Localizer["Generate and save this week's schedule"]</button>
    }
        <details id="oncall-editor">
            <summary class="fw-semibold my-3">@Localizer["Add or remove personnel by shift"]</summary>
            <p class="small text-muted">@Localizer["Select time slots to add or remove on-shift personnel; the chart will update synchronously. You can also use this form for keyboard navigation. Cross-group members can be selected manually; gray read-only shifts from other teams will not be modified, and cross-group overlaps and breaks are still validated upon saving."]</p>
            <label for="oncall-edit-slot" class="form-label">@Localizer["Select Shift"]</label>
            <select id="oncall-edit-slot" class="form-select mb-3">
                @foreach (var index in Enumerable.Range(21, 21))
                {
                    var local = TimeZoneInfo.ConvertTimeFromUtc(slots[index].startsAtUtc, zone);
                    var localEnd = TimeZoneInfo.ConvertTimeFromUtc(slots[index].startsAtUtc.AddHours(8), zone);
                    <option value="@index" selected="@(index == 21)">@local.ToString("MM-dd HH:mm") → @localEnd.ToString("MM-dd HH:mm") (@group.TimeZoneId)</option>
                }
            </select>
            <fieldset>
                <legend class="h6">@Localizer["On-call personnel (multiple allowed, at least one)"]</legend>
                <div class="row g-2 mb-3">
                    @foreach (var user in Model.PreviewUsers)
                    {
                        var departed = !memberIds.Contains(user.Id);
                        <div class="col-sm-6 col-lg-4">
                            <label class="d-flex align-items-center gap-2 border rounded p-2">
                                <input type="checkbox" class="form-check-input m-0 oncall-edit-member" value="@user.Id" data-departed="@(departed ? "true" : "false")" disabled="@departed" />
                                <span>@user.DisplayName (@user.UserName)@(departed ? @Localizer[" · Departed"].Value : "")</span>
                            </label>
                        </div>
                    }
                </div>
            </fieldset>
        </details>
    <ul id="oncall-schedule-errors" class="text-danger mt-3" role="alert"></ul>
</div>
<div class="modal fade" id="oncall-copy-confirm" tabindex="-1" aria-labelledby="oncall-copy-title" aria-describedby="oncall-copy-description" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="oncall-copy-title">@Localizer["Replace next week's draft?"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Cancel"]"></button>
            </div>
            <div class="modal-body" id="oncall-copy-description">@Localizer["Next week already has a saved schedule or unsaved changes. Copying will replace the full 21 shifts of next week with the current draft of this week. You can still undo after confirmation; changes are only written when you click Save."]</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel, keep next week"]</button>
                <button type="button" class="btn btn-primary" id="oncall-copy-apply">@Localizer["Confirm draft replacement"]</button>
            </div>
        </div>
    </div>
</div>
