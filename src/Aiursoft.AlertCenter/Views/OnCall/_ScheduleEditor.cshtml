@using System.Text.Json
@inject IHtmlLocalizerFactory OnCallLocalizerFactory
@{ var viewLocalizer = OnCallLocalizerFactory.Create("Views.OnCall._ScheduleEditor", typeof(Aiursoft.AlertCenter.Startup).Assembly.GetName().Name!); }
@model Aiursoft.AlertCenter.Models.OnCallViewModel
@{
    var group = Model.Groups.Single(item => item.Id == Model.SelectedGroupId);
    var slots = Model.ScheduleSaved
        ? Model.SavedShifts.Select(shift => new { id = (Guid?)shift.Id, startsAtUtc = DateTime.SpecifyKind(shift.StartsAtUtc, DateTimeKind.Utc), endsAtUtc = DateTime.SpecifyKind(shift.EndsAtUtc, DateTimeKind.Utc), userIds = shift.Members.Select(member => member.UserId).ToArray() })
        : Model.Preview.GroupBy(shift => new { shift.StartsAtUtc, shift.EndsAtUtc }).Select(batch => new { id = (Guid?)null, startsAtUtc = batch.Key.StartsAtUtc, endsAtUtc = batch.Key.EndsAtUtc, userIds = batch.Select(shift => shift.UserId).ToArray() });
    var members = Model.PreviewUsers.Select(user => new { id = user.Id, name = user.DisplayName, departed = group.Members.All(member => member.UserId != user.Id) });
}
<div id="oncall-schedule" class="mb-3" data-group-id="@group.Id" data-group-name="@group.Name" data-version="@group.ScheduleVersion" data-zone="@group.TimeZoneId"
     data-start="@Model.WeekStartUtc.ToString("O")" data-end="@Model.WeekEndUtc.ToString("O")" data-slots="@JsonSerializer.Serialize(slots)" data-members="@JsonSerializer.Serialize(members)"
     data-preview-url="@Url.Action("PreviewSchedule")" data-get-url="@Url.Action("GetSchedule")" data-generate-url="@Url.Action("GenerateSchedule")" data-save-url="@Url.Action("SaveSchedule")">
    @Html.AntiForgeryToken()
    <p class="small text-muted">@viewLocalizer["Enter times in the team time zone. During daylight saving transitions, skipped times are invalid and repeated times use standard time."]</p>
    <div id="oncall-editor" class="table-responsive">
        <table class="table align-middle"><thead><tr><th>@viewLocalizer["Start"]</th><th>@viewLocalizer["End"]</th><th>@viewLocalizer["On-call personnel"]</th><th>@viewLocalizer["Actions"]</th></tr></thead><tbody id="oncall-shift-rows"></tbody></table>
    </div>
    <div class="d-flex flex-wrap gap-2 mb-3">
        <button id="oncall-add-shift" type="button" class="btn btn-outline-primary">@viewLocalizer["Add shift"]</button>
        <button id="oncall-save-schedule" type="button" class="btn btn-primary">@viewLocalizer["Save schedule adjustments"]</button>
        <button id="oncall-reset-schedule" type="button" class="btn btn-outline-secondary">@viewLocalizer["Reset draft"]</button>
    </div>
    <details class="border rounded p-3">
        <summary>@viewLocalizer["Copy or generate into a time range"]</summary>
        <p class="small text-muted mt-2">@viewLocalizer["Copy repeats the visible draft across the destination range, clipping at its boundaries. Existing intersecting shifts are replaced in full."]</p>
        <div class="row g-2 mb-2">
            <div class="col-sm-6"><label for="oncall-range-start" class="form-label">@viewLocalizer["Start"]</label><input id="oncall-range-start" type="datetime-local" class="form-control" /></div>
            <div class="col-sm-6"><label for="oncall-range-end" class="form-label">@viewLocalizer["End"]</label><input id="oncall-range-end" type="datetime-local" class="form-control" /></div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button id="oncall-copy-range" type="button" class="btn btn-outline-primary">@viewLocalizer["Copy to time range"]</button>
            @if (Model.CanGenerateSchedule)
            {
                <button id="oncall-generate" type="button" class="btn btn-outline-warning">@viewLocalizer["Generate from template"]</button>
            }
        </div>
        <div id="oncall-replace-confirm" class="mt-3" hidden>
            <p>@viewLocalizer["The following shifts will be replaced. Confirm to write the new schedule."]</p>
            <ul id="oncall-replaced-shifts" class="text-break"></ul>
            <button id="oncall-replace-apply" type="button" class="btn btn-danger">@viewLocalizer["Confirm replacement"]</button>
            <button id="oncall-replace-cancel" type="button" class="btn btn-outline-secondary">@viewLocalizer["Cancel"]</button>
        </div>
    </details>
    <ul id="oncall-schedule-errors" class="text-danger mt-2" role="alert"></ul>
    <ul id="oncall-schedule-warnings" class="text-warning-emphasis mt-2" role="status" aria-live="polite"></ul>
</div>
