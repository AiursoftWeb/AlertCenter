@model Aiursoft.AlertCenter.Models.OnCallViewModel
@{
    ViewData["Title"] = "排班与覆盖";
    var group = Model.Group;
    var zone = group == null ? TimeZoneInfo.Utc : TimeZoneInfo.FindSystemTimeZoneById(group.TimeZoneId);
    DateTime Local(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(utc, zone);
    string GetInitial(string? name) => string.IsNullOrWhiteSpace(name) ? "?" : name[..1].ToUpperInvariant();
}
@section styles {
    <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" />
}
<partial name="_AdminNavigation" model="Model" />

@if (group != null)
{
    <!-- Publish Daily Schedule Section -->
    <section class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent border-bottom py-3">
            <h2 class="h5 mb-0 d-flex align-items-center gap-2">
                <i data-lucide="calendar-plus" class="text-primary" style="width: 18px; height: 18px;"></i>
                <span>发布日程</span>
            </h2>
        </div>
        <div class="card-body p-4">
            <form asp-action="Publish" method="post" class="row g-3 align-items-end">
                <input type="hidden" name="groupId" value="@group.Id" />
                <div class="col-sm-6 col-md-4">
                    <label for="publish-start" class="form-label small fw-medium text-muted mb-1">开始日期 (@group.TimeZoneId)</label>
                    <input id="publish-start" name="startDate" type="date" value="@Model.SuggestedPublishDate.ToString("yyyy-MM-dd")" class="form-control" required />
                </div>
                <div class="col-sm-6 col-md-4">
                    <label for="publish-end" class="form-label small fw-medium text-muted mb-1">结束日期 (@group.TimeZoneId)</label>
                    <input id="publish-end" name="endDate" type="date" value="@Model.SuggestedPublishDate.AddDays(6).ToString("yyyy-MM-dd")" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-primary w-100 d-inline-flex align-items-center justify-content-center gap-1.5" style="height: 38px;">
                        <i data-lucide="send" style="width: 15px; height: 15px;"></i>
                        <span>生成并发布日常轮转</span>
                    </button>
                </div>
                <div class="col-12 mt-1">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="small text-muted">快捷日期跨度：</span>
                        <button type="button" class="btn btn-sm btn-light border py-0 px-2 small" onclick="setPublishRange(7)">未来 7 天</button>
                        <button type="button" class="btn btn-sm btn-light border py-0 px-2 small" onclick="setPublishRange(14)">未来 14 天</button>
                        <button type="button" class="btn btn-sm btn-light border py-0 px-2 small" onclick="setPublishRange(30)">未来 30 天</button>
                    </div>
                </div>
            </form>
            <div class="p-3 bg-light rounded-3 border mt-3 small text-muted">
                <div class="d-flex align-items-center gap-1.5 fw-medium text-body mb-1">
                    <i data-lucide="shield-check" class="text-success" style="width: 15px; height: 15px;"></i>
                    <span>排班发布须知</span>
                </div>
                <p class="small text-muted mb-0">先配置覆盖本地全天的 <a asp-action="Templates" asp-route-id="@group.Id" class="fw-semibold">轮转模板</a>。发布前校验连续覆盖、班次重叠、最长 8 小时及至少 16 小时连续休息。</p>
            </div>
        </div>
    </section>

    <!-- Published Shifts & Overrides Section -->
    <section class="card shadow-sm border-0">
        <div class="card-header bg-transparent border-bottom py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 class="h5 mb-0 d-flex align-items-center gap-2">
                <i data-lucide="calendar-range" class="text-primary" style="width: 18px; height: 18px;"></i>
                <span>已发布班次与临时覆盖</span>
            </h2>
            <span class="badge bg-secondary-subtle text-secondary border font-monospace">
                @Local(Model.DisplayStartUtc).ToString("yyyy-MM-dd") – @Local(Model.DisplayEndUtc).AddDays(-1).ToString("yyyy-MM-dd") · @Model.Shifts.Count 个班次
            </span>
        </div>
        <div class="card-body p-4">
            <!-- Date Filter Form -->
            <form asp-action="Schedule" method="get" class="d-flex flex-wrap align-items-end gap-2 mb-4 p-3 bg-light rounded-3 border">
                <input type="hidden" name="id" value="@group.Id" />
                <div class="d-flex align-items-center gap-2">
                    <label for="schedule-start" class="form-label small fw-medium text-muted mb-0 text-nowrap">
                        <i data-lucide="calendar" style="width: 14px; height: 14px;" class="me-1"></i>
                        <span>起始日期（展示连续14天）</span>
                    </label>
                    <input id="schedule-start" name="date" type="date" value="@Local(Model.DisplayStartUtc).ToString("yyyy-MM-dd")" class="form-control form-control-sm" style="width: 160px;" required />
                </div>
                <button class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
                    <i data-lucide="search" style="width: 13px; height: 13px;"></i>
                    <span>查看班次</span>
                </button>
            </form>

            @if (Model.Shifts.Count == 0)
            {
                <div class="p-5 text-center text-muted">
                    <div class="ac-empty-icon mb-2">
                        <i data-lucide="calendar-off" style="width: 28px; height: 28px;"></i>
                    </div>
                    <p class="mb-0">此日期范围暂无已发布班次。可以选择其他日期，或先配置模板并发布日程。</p>
                </div>
            }
            else
            {
                @foreach (var shift in Model.Shifts)
                {
                    var overrides = Model.Overrides.Where(item => item.OriginalShiftId == shift.Id).OrderBy(item => item.StartsAtUtc).ToList();
                    var nextStart = shift.StartsAtUtc;
                    var nextEnd = shift.EndsAtUtc;
                    foreach (var item in overrides)
                    {
                        if (item.StartsAtUtc > nextStart)
                        {
                            nextEnd = item.StartsAtUtc;
                            break;
                        }
                        if (item.EndsAtUtc > nextStart) nextStart = item.EndsAtUtc;
                    }
                    var isFullyCovered = nextStart >= shift.EndsAtUtc;

                    <div class="card border mb-3 shadow-none">
                        <div class="card-body p-3">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2 pb-2 border-bottom">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="ac-app-avatar" style="width: 32px; height: 32px; font-size: 0.8rem;">@GetInitial(shift.User?.DisplayName)</span>
                                    <div>
                                        <strong>@(shift.User?.DisplayName ?? "未知")</strong>
                                        <small class="text-muted font-monospace ms-1">@(shift.User?.Email ?? "未配置邮箱")</small>
                                    </div>
                                    @if (isFullyCovered)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle ms-1">已完全代班</span>
                                    }
                                    else if (overrides.Count > 0)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle ms-1">部分代班</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle ms-1">正常当班</span>
                                    }
                                </div>
                                <div class="d-flex align-items-center gap-1.5">
                                    <span class="ac-time-chip">
                                        <i data-lucide="clock" style="width: 12px; height: 12px;" class="text-muted"></i>
                                        <code>@Local(shift.StartsAtUtc).ToString("MM-dd HH:mm") – @Local(shift.EndsAtUtc).ToString("MM-dd HH:mm")</code>
                                    </span>
                                    <span class="badge bg-light text-muted border">@((int)(shift.EndsAtUtc - shift.StartsAtUtc).TotalHours)h</span>
                                </div>
                            </div>

                            @if (overrides.Count == 0)
                            {
                                <p class="small text-muted mb-2">暂无代班覆盖</p>
                            }
                            else
                            {
                                <div class="mb-3">
                                    <span class="small fw-semibold text-muted d-block mb-1">代班覆盖记录：</span>
                                    <div class="d-flex flex-column gap-1">
                                        @foreach (var item in overrides)
                                        {
                                            <div class="small d-flex align-items-center gap-2 p-2 bg-light rounded border">
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle d-inline-flex align-items-center gap-1">
                                                    <i data-lucide="replace" style="width: 12px; height: 12px;"></i>
                                                    <span>@item.CoveringUser.DisplayName</span>
                                                </span>
                                                <span class="font-monospace text-muted">@Local(item.StartsAtUtc).ToString("MM-dd HH:mm") – @Local(item.EndsAtUtc).ToString("MM-dd HH:mm")</span>
                                                <span class="text-muted">· @item.Reason</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <p class="small text-muted mb-2" style="font-size: 0.775rem;">可对同一班次分段安排多位代班；时间须位于尚未覆盖的时段内。</p>

                            @if (isFullyCovered)
                            {
                                <div class="alert alert-success py-2 px-3 small mb-0 d-flex align-items-center gap-1.5" role="alert">
                                    <i data-lucide="check-circle-2" style="width: 14px; height: 14px;" class="text-success flex-shrink-0"></i>
                                    <span>此班次已全部安排代班。</span>
                                </div>
                            }
                            else
                            {
                                <form asp-action="CreateOverride" method="post" class="row g-2 align-items-end p-2 bg-light rounded border">
                                    <input type="hidden" name="originalShiftId" value="@shift.Id" />
                                    <div class="col-lg-3">
                                        <label class="form-label small fw-medium text-muted mb-1" for="cover-@shift.Id">代班工程师</label>
                                        <select id="cover-@shift.Id" name="coveringUserId" class="form-select form-select-sm" required>
                                            <option value="">选择成员</option>
                                            @foreach (var member in Model.Members)
                                            {
                                                <option value="@member.UserId">@member.User.DisplayName</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-lg-2 col-sm-6">
                                        <label class="form-label small fw-medium text-muted mb-1" for="start-@shift.Id">开始 (@group.TimeZoneId)</label>
                                        <input id="start-@shift.Id" name="startsAtLocal" type="datetime-local" value="@Local(nextStart).ToString("yyyy-MM-ddTHH:mm")" class="form-control form-control-sm" required />
                                    </div>
                                    <div class="col-lg-2 col-sm-6">
                                        <label class="form-label small fw-medium text-muted mb-1" for="end-@shift.Id">结束 (@group.TimeZoneId)</label>
                                        <input id="end-@shift.Id" name="endsAtLocal" type="datetime-local" value="@Local(nextEnd).ToString("yyyy-MM-ddTHH:mm")" class="form-control form-control-sm" required />
                                    </div>
                                    <div class="col-lg-3">
                                        <label class="form-label small fw-medium text-muted mb-1" for="reason-@shift.Id">代班原因</label>
                                        <input id="reason-@shift.Id" name="reason" maxlength="1000" class="form-control form-control-sm" placeholder="说明代班原因" required />
                                    </div>
                                    <div class="col-lg-2">
                                        <button class="btn btn-sm btn-outline-primary w-100 d-inline-flex align-items-center justify-content-center gap-1">
                                            <i data-lucide="user-plus" style="width: 13px; height: 13px;"></i>
                                            <span>安排代班</span>
                                        </button>
                                    </div>
                                </form>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </section>
}

@section scripts {
    <script>
        function setPublishRange(days) {
            const startInput = document.getElementById('publish-start');
            const endInput = document.getElementById('publish-end');
            if (startInput && endInput) {
                const startDate = new Date(startInput.value || new Date());
                const endDate = new Date(startDate.getTime() + (days - 1) * 86400000);
                const format = d => d.toISOString().split('T')[0];
                endInput.value = format(endDate);
            }
        }
    </script>
}
