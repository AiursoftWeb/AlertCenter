@model Aiursoft.AlertCenter.Models.ApplicationsViewModel

@section styles {
    <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" />
}

@{
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}";
    var endpoint = $"{baseUrl}/api/v1/incidents";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Developer Integration Guide"]</h1>
        <p class="text-muted mb-0">@Localizer["From app creation and key authentication to the first incident report, establish a stable system incident channel in 4 steps."]</p>
    </div>
    <a asp-action="Applications" class="btn btn-primary">
        <i class="align-middle me-1" data-lucide="app-window" aria-hidden="true"></i>@Localizer["Manage integrated applications"]
    </a>
</div>

<!-- Step 1 Card -->
<div class="card mb-4">
    <div class="card-header d-flex align-items-center gap-3">
        <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.9rem;">1</span>
        <h2 class="card-title mb-0">@Localizer["Create Integration App and Get API Key"]</h2>
    </div>
    <div class="card-body pt-0">
        <p class="mb-2">@Localizer["Open API Key Management for an application to create named keys with query, create and resolve permissions."] <code>&lt;applicationId&gt;.&lt;keyId&gt;.&lt;secret&gt;</code> @Localizer["Each key belongs to an application. The server verifies the secret hash and the permission required by each operation."]</p>
        <div class="alert alert-warning small mb-3" role="alert">
            <div class="alert-icon">
                <i class="align-middle" data-lucide="shield-alert" aria-hidden="true"></i>
            </div>
            <div class="alert-message text-break">
                <strong>@Localizer["Leak Prevention Notice"]</strong>@Localizer[": The API Key is displayed only once upon successful creation. Please configure it immediately in production environment variables (e.g.,"] <code>ALERTCENTER_API_KEY</code>@Localizer[") or Key Management Service (KMS). Hardcoding into frontend, logs, or code repositories is strictly prohibited."]
            </div>
        </div>
        <a asp-action="Applications" class="btn btn-sm btn-outline-primary">
            <i class="align-middle me-1" data-lucide="plus"></i>@Localizer["Go to create an app and get credentials "]&rarr;
        </a>
    </div>
</div>

<!-- Step 2 Card: Multi-language Code Snippets -->
<div class="card mb-4">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-3">
            <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.9rem;">2</span>
            <h2 class="card-title mb-0">@Localizer["Send the first incident message"]</h2>
        </div>
        <!-- Language Switcher Tabs -->
        <ul class="nav nav-pills card-header-pills" id="code-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active py-1 px-3" id="tab-curl" data-bs-toggle="pill" data-bs-target="#panel-curl" type="button" role="tab">cURL</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link py-1 px-3" id="tab-dotnet" data-bs-toggle="pill" data-bs-target="#panel-dotnet" type="button" role="tab">.NET C# SDK</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link py-1 px-3" id="tab-python" data-bs-toggle="pill" data-bs-target="#panel-python" type="button" role="tab">Python</button>
            </li>
        </ul>
    </div>
    <div class="card-body pt-0">
        <p class="text-muted small mb-3">@Localizer["In the sample code,"] <code>YOUR_API_KEY</code> @Localizer["Replace with the application key generated in the previous step to send a test directly."]</p>

        <div id="code-copy-feedback" role="status" aria-live="polite" aria-atomic="true"></div>
        <div class="tab-content" id="code-tab-content">
            <!-- cURL Tab -->
            <div class="tab-pane fade show active" id="panel-curl" role="tabpanel">
                <div class="ac-code-container">
                    <div class="ac-code-header">
                        <span>bash / zsh</span>
                        <button type="button" class="ac-copy-btn" data-copy-target="code-curl" data-copy-feedback="code-copy-feedback">
                            <i class="align-middle" data-lucide="copy" aria-hidden="true"></i>@Localizer["Copy Code"]
                        </button>
                    </div>
                    <pre class="ac-code-pre" id="code-curl"><code>curl -i '@endpoint' \
  -H 'Authorization: Bearer YOUR_API_KEY' \
  -H 'Content-Type: application/json' \
  --data '{
    "reportId": "@Guid.NewGuid()",
    "title": "Order payment response timeout",
    "content": "Third-party channel did not return transaction status within 5000ms; entering polling fallback process.",
    "level": "sev1",
    "occurredAtUtc": "@DateTime.UtcNow.ToString("O")",
    "context": {
      "orderId": "ORD-202609-8839",
      "channel": "alipay",
      "retryCount": 3
    }
  }'</code></pre>
                </div>
            </div>

            <!-- .NET Tab -->
            <div class="tab-pane fade" id="panel-dotnet" role="tabpanel">
                <div class="ac-code-container">
                    <div class="ac-code-header">
                        <span>C# (.NET 10)</span>
                        <button type="button" class="ac-copy-btn" data-copy-target="code-dotnet" data-copy-feedback="code-copy-feedback">
                            <i class="align-middle" data-lucide="copy" aria-hidden="true"></i>@Localizer["Copy Code"]
                        </button>
                    </div>
                    <pre class="ac-code-pre" id="code-dotnet"><code>// dotnet add package Aiursoft.AlertCenter.SDK
using Aiursoft.AlertCenter.SDK;
using Aiursoft.AlertCenter.SDK.Models;

builder.Services.AddAlertCenterSdk(
    "@baseUrl",
    builder.Configuration["AlertCenter:ApiKey"]!);

public class OrderService(AlertCenterApiClient incidents)
{
    public Task&lt;CreateIncidentResponse&gt; ReportTimeoutAsync(Guid reportId, DateTimeOffset occurredAtUtc)
    {
        return incidents.CreateIncidentAsync(new CreateIncidentRequest
        {
            ReportId = reportId,
            Title = "Order payment timed out",
            Content = "The payment provider did not respond within 5 seconds.",
            Level = "sev1",
            OccurredAtUtc = occurredAtUtc
        });
    }
}</code></pre>
                </div>
            </div>

            <!-- Python Tab -->
            <div class="tab-pane fade" id="panel-python" role="tabpanel">
                <div class="ac-code-container">
                    <div class="ac-code-header">
                        <span>Python 3.10+ (requests)</span>
                        <button type="button" class="ac-copy-btn" data-copy-target="code-python" data-copy-feedback="code-copy-feedback">
                            <i class="align-middle" data-lucide="copy" aria-hidden="true"></i>@Localizer["Copy Code"]
                        </button>
                    </div>
                    <pre class="ac-code-pre" id="code-python"><code>import uuid
from datetime import datetime, timezone
import requests

payload = {
    "reportId": str(uuid.uuid4()),
    "title": "Celery task queue backlog is severe",
    "content": "The number of tasks in the pending queue exceeds 10,000, and the execution rate is below expectations.",
    "level": "sev2",
    "occurredAtUtc": datetime.now(timezone.utc).isoformat(),
    "context": {
        "queueName": "high_priority",
        "pendingTasks": 12450
    }
}

response = requests.post(
    "@endpoint",
    json=payload,
    headers={"Authorization": "Bearer YOUR_API_KEY"}
)
print(response.status_code, response.json())</code></pre>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Step 3 Card: API Parameters Specification -->
<div class="card mb-4">
    <div class="card-header d-flex align-items-center gap-3">
        <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.9rem;">3</span>
        <h2 class="card-title mb-0">@Localizer["HTTP Reporting Request Field Specification"]</h2>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4">@Localizer["Field Name"]</th>
                    <th>@Localizer["Type"]</th>
                    <th>@Localizer["Required"]</th>
                    <th>@Localizer["Rules & constraints"]</th>
                    <th class="pe-4">@Localizer["Description"]</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="ps-4"><code>reportId</code></td>
                    <td><span class="badge bg-secondary-subtle text-secondary font-monospace">UUID / GUID</span></td>
                    <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle">@Localizer["Required"]</span></td>
                    <td>@Localizer["Standard UUID format"]</td>
                    <td class="pe-4">@Localizer["The client's globally unique report ID. The center uses"] <code>(ApplicationId, ReportId)</code> @Localizer["Ensure strict concurrent idempotency; use the same ID for retries."]</td>
                </tr>
                <tr>
                    <td class="ps-4"><code>title</code></td>
                    <td><span class="badge bg-secondary-subtle text-secondary font-monospace">String</span></td>
                    <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle">@Localizer["Required"]</span></td>
                    <td>@Localizer["1 to 200 characters"]</td>
                    <td class="pe-4">@Localizer["Incident summary title. Briefly describe the fault, e.g., “Order payment channel response timeout.”"]</td>
                </tr>
                <tr>
                    <td class="ps-4"><code>content</code></td>
                    <td><span class="badge bg-secondary-subtle text-secondary font-monospace">String</span></td>
                    <td><span class="badge bg-secondary-subtle text-secondary">@Localizer["Optional"]</span></td>
                    <td>@Localizer["Max 4,000 characters"]</td>
                    <td class="pe-4">@Localizer["Incident body details. Supports troubleshooting guides, exception stacks, or diagnostic summaries. The presentation layer automatically escapes HTML to prevent XSS injection."]</td>
                </tr>
                <tr>
                    <td class="ps-4"><code>level</code></td>
                    <td><span class="badge bg-secondary-subtle text-secondary font-monospace">String</span></td>
                    <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle">@Localizer["Required"]</span></td>
                    <td><code>sev0</code>, <code>sev1</code>, <code>sev2</code>, <code>sev3</code>, <code>sev4</code></td>
                    <td class="pe-4">@Localizer["Severity:"]<code>sev0</code>@Localizer["(Critical, highest priority),"]<code>sev1</code>@Localizer["(Major),"]<code>sev2</code>@Localizer["(Error),"]<code>sev3</code>@Localizer["(Warning),"]<code>sev4</code>@Localizer["(General Information). The Center routes and pushes based on this level."]</td>
                </tr>

                <tr>
                    <td class="ps-4"><code>occurredAtUtc</code></td>
                    <td><span class="badge bg-secondary-subtle text-secondary font-monospace">ISO 8601</span></td>
                    <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle">@Localizer["Required"]</span></td>
                    <td>@Localizer["With timezone offset or Z identifier"]</td>
                    <td class="pe-4">@Localizer["Actual business occurrence time, e.g.,"] <code>2026-09-17T08:30:00Z</code>@Localizer[". The center can use this field to estimate reporting and delivery network latency."]</td>
                </tr>
                <tr>
                    <td class="ps-4"><code>context</code></td>
                    <td><span class="badge bg-secondary-subtle text-secondary font-monospace">Object</span></td>
                    <td><span class="badge bg-secondary-subtle text-secondary">@Localizer["Optional"]</span></td>
                    <td>@Localizer["JSON object; entire request max 64 KiB"]</td>
                    <td class="pe-4">@Localizer["Structured business context. It is recommended to include"] <code>traceId</code>, <code>userId</code>, <code>orderId</code> @Localizer["or environment variables, facilitating one-click location and troubleshooting on the detail page."]</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Step 4 Card: Status & Best Practices -->
<div class="card">
    <div class="card-header d-flex align-items-center gap-3">
        <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.9rem;">4</span>
        <h2 class="card-title mb-0">@Localizer["HTTP Response Status Codes and Best Engineering Practices"]</h2>
    </div>
    <div class="card-body pt-0">
        <p>@Localizer["Responses use AiurProtocol with Code, Message, and ProtocolVersion. Validation failures include an Items array. The SDK returns a typed receipt or throws an AiurProtocol exception."]</p>
        <p>@Localizer["The SDK sends each report once. If a network failure leaves the outcome uncertain, retry the same request with the same ReportId and occurrence time."]</p>
        <div class="row g-3 mb-4">
            <div class="col-md-6 col-lg-3">
                <div class="p-3 bg-body-tertiary rounded h-100">
                    <strong class="d-block text-success mb-1">201 Created</strong>
                    <p class="small text-muted mb-0">@Localizer["Initial save successful. Returns the generated primary key ID,"]<code>Code: 2, Duplicate: false</code>@Localizer[". Push scheduling triggered asynchronously."]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="p-3 bg-body-tertiary rounded h-100">
                    <strong class="d-block text-info mb-1">@Localizer["202 Accepted (Idempotent)"]</strong>
                    <p class="small text-muted mb-0">@Localizer["Duplicate report with the same ReportId,"]<code>Code: 1, Duplicate: true</code>@Localizer[". Retain the first record and do not trigger duplicate pushes."]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="p-3 bg-body-tertiary rounded h-100">
                    <strong class="d-block text-warning mb-1">@Localizer["401 Authentication failed"]</strong>
                    <p class="small text-muted mb-0">@Localizer["Bearer credentials are missing, keys do not match, or the application is disabled. Please check application settings."]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="p-3 bg-body-tertiary rounded h-100">
                    <strong class="d-block text-danger mb-1">@Localizer["400 / 413 Parameter error"]</strong>
                    <p class="small text-muted mb-0">@Localizer["Required fields are missing, the level format is invalid, or the request body exceeds the 64 KiB limit."]</p>
                </div>
            </div>
        </div>

        <div class="alert alert-info small mb-4" role="alert">
            <div class="alert-icon">
                <i class="align-middle" data-lucide="gauge" aria-hidden="true"></i>
            </div>
            <div class="alert-message">
                @Localizer["Every new report ID creates an independent incident. Reuse the same report ID only when retrying the same request. Rate-limit reports at the source."]
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Incidents" asp-action="Index" class="btn btn-primary">
                <i class="align-middle me-1" data-lucide="list"></i>@Localizer["View incidents"]
            </a>
            <a asp-controller="Push" asp-action="Index" class="btn btn-outline-primary">
                <i class="align-middle me-1" data-lucide="sliders"></i>@Localizer["Configure Push Center Channel"]
            </a>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/scripts/clipboard.js" asp-append-version="true"></script>
}
