@model Aiursoft.AlertCenter.Models.ApplicationAccessViewModel
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">@Localizer["Manage Sharing"]: @Model.Application.Name</h1>
    <a asp-action="Applications" class="btn btn-outline-secondary">@Localizer["Back to Applications"]</a>
</div>
<p>@Localizer["Owner"]: @(Model.Application.Owner?.DisplayName ?? Localizer["Unassigned"].Value)</p>
<div class="alert alert-info" role="alert"><div class="alert-icon"><i data-lucide="info" aria-hidden="true"></i></div><div class="alert-message">@Localizer["The owner has all permissions. Direct user grants and role grants are combined. On-call assignments do not grant access."]</div></div>
<div class="card mb-4">
    <div class="card-header"><h5 class="card-title mb-0">@Localizer["Add or Update Share"]</h5></div>
    <div class="card-body">
        <form asp-action="SaveAccess" method="post">
            <input type="hidden" name="ApplicationId" value="@Model.Application.Id" />
            <p class="text-muted">@Localizer["Select either a user or a role. Saving replaces that recipient's permissions."]</p>
            <div class="row g-3 mb-3">
                <div class="col-md-6"><label for="share-user" class="form-label">@Localizer["User"]</label><select id="share-user" name="UserId" asp-items="Model.Users" class="form-select"><option value="">@Localizer["Select user..."]</option></select></div>
                <div class="col-md-6"><label for="share-role" class="form-label">@Localizer["Role"]</label><select id="share-role" name="RoleId" asp-items="Model.Roles" class="form-select"><option value="">@Localizer["Select role..."]</option></select></div>
            </div>
            <div class="form-check mb-2"><input id="CanViewIncidents" name="CanViewIncidents" value="true" type="checkbox" class="form-check-input" /><label for="CanViewIncidents" class="form-check-label">@Localizer["View incidents"]</label></div>
            <div class="form-check mb-2"><input id="CanCreateIncidents" name="CanCreateIncidents" value="true" type="checkbox" class="form-check-input" /><label for="CanCreateIncidents" class="form-check-label">@Localizer["Create incidents"]</label></div>
            <div class="form-check mb-2"><input id="CanUpdateIncidents" name="CanUpdateIncidents" value="true" type="checkbox" class="form-check-input" /><label for="CanUpdateIncidents" class="form-check-label">@Localizer["Update incidents and status"]</label></div>
            <div class="form-check mb-2"><input id="CanManageApiKeys" name="CanManageApiKeys" value="true" type="checkbox" class="form-check-input" /><label for="CanManageApiKeys" class="form-check-label">@Localizer["Manage API keys"]</label></div>
            <div class="form-check mb-2"><input id="CanDeleteIncidents" name="CanDeleteIncidents" value="true" type="checkbox" class="form-check-input" /><label for="CanDeleteIncidents" class="form-check-label">@Localizer["Permanently delete incidents"]</label></div>
            <div class="form-check mb-2"><input id="CanManageApplication" name="CanManageApplication" value="true" type="checkbox" class="form-check-input" /><label for="CanManageApplication" class="form-check-label">@Localizer["Manage application and sharing"]</label></div>
            <button class="btn btn-primary mt-3" type="submit">@Localizer["Save permissions"]</button>
        </form>
    </div>
</div>
<div class="card">
    <div class="card-header"><h5 class="card-title mb-0">@Localizer["Shared With"]</h5></div>
    <div class="card-body"><div class="table-responsive"><table class="table table-hover align-middle">
        <thead><tr><th>@Localizer["User or Role"]</th><th>@Localizer["Permissions"]</th><th>@Localizer["Actions"]</th></tr></thead>
        <tbody>
        @foreach (var access in Model.UserAccesses)
        {
            <tr><td>@access.User.DisplayName <span class="badge bg-secondary">@Localizer["User"]</span></td><td>
                @if (access.CanViewIncidents) { <span class="badge bg-primary me-1">@Localizer["View incidents"]</span> }
                @if (access.CanCreateIncidents) { <span class="badge bg-primary me-1">@Localizer["Create incidents"]</span> }
                @if (access.CanUpdateIncidents) { <span class="badge bg-primary me-1">@Localizer["Update incidents and status"]</span> }
                @if (access.CanManageApiKeys) { <span class="badge bg-primary me-1">@Localizer["Manage API keys"]</span> }
                @if (access.CanDeleteIncidents) { <span class="badge bg-primary me-1">@Localizer["Permanently delete incidents"]</span> }
                @if (access.CanManageApplication) { <span class="badge bg-primary me-1">@Localizer["Manage application and sharing"]</span> }
            </td><td><form asp-action="RemoveAccess" method="post"><input type="hidden" name="id" value="@Model.Application.Id" /><input type="hidden" name="userId" value="@access.UserId" /><button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Remove"]</button></form></td></tr>
        }
        @foreach (var access in Model.RoleAccesses)
        {
            <tr><td>@access.Role.Name <span class="badge bg-secondary">@Localizer["Role"]</span></td><td>
                @if (access.CanViewIncidents) { <span class="badge bg-primary me-1">@Localizer["View incidents"]</span> }
                @if (access.CanCreateIncidents) { <span class="badge bg-primary me-1">@Localizer["Create incidents"]</span> }
                @if (access.CanUpdateIncidents) { <span class="badge bg-primary me-1">@Localizer["Update incidents and status"]</span> }
                @if (access.CanManageApiKeys) { <span class="badge bg-primary me-1">@Localizer["Manage API keys"]</span> }
                @if (access.CanDeleteIncidents) { <span class="badge bg-primary me-1">@Localizer["Permanently delete incidents"]</span> }
                @if (access.CanManageApplication) { <span class="badge bg-primary me-1">@Localizer["Manage application and sharing"]</span> }
            </td><td><form asp-action="RemoveAccess" method="post"><input type="hidden" name="id" value="@Model.Application.Id" /><input type="hidden" name="roleId" value="@access.RoleId" /><button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Remove"]</button></form></td></tr>
        }
        </tbody>
    </table></div></div>
</div>
@if (Model.IsOwner)
{
    <div class="card mt-4"><div class="card-header"><h5 class="card-title mb-0">@Localizer["Transfer Ownership"]</h5></div><div class="card-body">
        <p>@Localizer["Transferring ownership gives the selected user all permissions. You will lose owner privileges."]</p>
        <form asp-action="TransferOwnership" method="post"><input type="hidden" name="id" value="@Model.Application.Id" /><label for="new-owner" class="form-label">@Localizer["New owner"]</label><select id="new-owner" name="ownerId" asp-items="Model.Users" class="form-select mb-3" required><option value="">@Localizer["Select user..."]</option></select><button type="submit" class="btn btn-warning">@Localizer["Transfer Ownership"]</button></form>
    </div></div>
}
