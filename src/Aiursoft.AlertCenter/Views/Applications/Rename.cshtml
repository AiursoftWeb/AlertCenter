@model Aiursoft.AlertCenter.Models.RenameApplicationViewModel

<h1 class="h3 mb-4">@Localizer["Rename application"]</h1>
<div class="card">
    <div class="card-body">
        <form asp-action="Rename" method="post" data-action-feedback>
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label">@Localizer["Application name"]</label>
                <input asp-for="Name" class="form-control" required maxlength="100" autofocus />
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
                <a asp-action="Applications" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
            </div>
        </form>
    </div>
</div>
