@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/styles/site.css" />
    <link rel="stylesheet" href="~/styles/marketing.css" />
}

<vc:marketing-navbar></vc:marketing-navbar>

<main class="alert-center-home">
    <section class="landing-intro text-bg-dark pt-5 pt-lg-6 pb-5 pb-lg-7">
        <div class="landing-intro-content container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <div class="d-flex flex-wrap gap-2 mb-4">
                        <span class="badge badge-subtle-primary p-2"><i data-lucide="shield-check" class="align-middle me-1"></i>企业级告警</span>
                        <span class="badge badge-subtle-primary p-2"><i data-lucide="send" class="align-middle me-1"></i>多渠道推送</span>
                        <span class="badge badge-subtle-primary p-2"><i data-lucide="container" class="align-middle me-1"></i>私有化部署</span>
                    </div>
                    <h1 id="main-slogan" class="display-3 fw-bold text-white mb-4">让每一条关键告警<br /><span class="text-primary">及时抵达正确的人。</span></h1>
                    <p class="lead text-white-50 mb-4">AlertCenter 为业务系统集中接收、分级管理和可靠投递告警。用一个 API 接入所有服务，让团队始终掌握生产环境的真实状态。</p>
                    <div class="d-flex flex-wrap gap-3">
                        <a asp-controller="Alerts" asp-action="GettingStarted" class="btn btn-primary btn-lg btn-pill"><i data-lucide="rocket" class="align-middle me-1"></i>开始接入</a>
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-light btn-lg btn-pill"><i data-lucide="layout-dashboard" class="align-middle me-1"></i>进入控制台</a>
                    </div>
                    <div class="d-flex flex-wrap gap-4 mt-5 text-white-50 small">
                        <span><i data-lucide="check-circle-2" class="align-middle text-success me-1"></i>告警持久化存储</span>
                        <span><i data-lucide="check-circle-2" class="align-middle text-success me-1"></i>按严重级别路由</span>
                        <span><i data-lucide="check-circle-2" class="align-middle text-success me-1"></i>开源且可自托管</span>
                    </div>
                </div>
                <div class="col-lg-6 d-none d-lg-block">
                    <div class="alert-center-preview card border-0 shadow-lg">
                        <div class="card-header d-flex align-items-center justify-content-between px-4 py-3">
                            <div class="d-flex align-items-center gap-2"><span class="alert-center-status-dot"></span><span class="fw-semibold">实时告警流</span></div>
                            <span class="badge bg-success-subtle text-success">系统正常</span>
                        </div>
                        <div class="card-body p-3">
                            <div class="alert-center-message alert-center-message-critical"><div class="alert-center-message-icon"><i data-lucide="siren"></i></div><div class="flex-grow-1"><div class="d-flex justify-content-between gap-3"><strong>支付服务响应超时</strong><span>刚刚</span></div><p class="mb-0">订单服务 · trace-7e9a</p></div></div>
                            <div class="alert-center-message alert-center-message-warning"><div class="alert-center-message-icon"><i data-lucide="triangle-alert"></i></div><div class="flex-grow-1"><div class="d-flex justify-content-between gap-3"><strong>队列积压接近阈值</strong><span>2 分钟前</span></div><p class="mb-0">消息中心 · 8,420 pending</p></div></div>
                            <div class="alert-center-message alert-center-message-info"><div class="alert-center-message-icon"><i data-lucide="circle-check-big"></i></div><div class="flex-grow-1"><div class="d-flex justify-content-between gap-3"><strong>数据库备份完成</strong><span>8 分钟前</span></div><p class="mb-0">基础设施 · backup-2026-09-14</p></div></div>
                        </div>
                        <div class="card-footer bg-transparent text-center py-3"><span class="text-muted small">告警已同步投递至 Webhook 和站内通知</span></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-6">
        <div class="container">
            <div class="row align-items-end mb-5"><div class="col-lg-7"><span class="text-uppercase text-primary text-sm fw-medium mb-2 d-block">一个中心，闭环处置</span><h2 class="h1 mb-0">从异常发生到团队响应，始终清晰可控。</h2></div><div class="col-lg-5"><p class="text-muted fs-lg mb-0">集中管理来源、告警级别、通知渠道与投递结果，让服务异常不再被淹没在日志里。</p></div></div>
            <div class="row g-4">
                <div class="col-md-4 d-flex"><div class="card h-100 w-100 shadow-sm border-0"><div class="card-body p-4"><div class="landing-feature mb-4"><i data-lucide="radio-tower"></i></div><h3 class="h4">统一接入</h3><p class="text-muted mb-0">为每个业务应用创建独立 API Key，通过标准 HTTP API 上报结构化告警与上下文。</p></div></div></div>
                <div class="col-md-4 d-flex"><div class="card h-100 w-100 shadow-sm border-0"><div class="card-body p-4"><div class="landing-feature mb-4"><i data-lucide="layers-3"></i></div><h3 class="h4">分级路由</h3><p class="text-muted mb-0">按 sev1 至 sev4 配置独立推送渠道，确保最紧急的问题获得最高优先级响应。</p></div></div></div>
                <div class="col-md-4 d-flex"><div class="card h-100 w-100 shadow-sm border-0"><div class="card-body p-4"><div class="landing-feature mb-4"><i data-lucide="route"></i></div><h3 class="h4">可靠投递</h3><p class="text-muted mb-0">集中追踪每次通知投递状态，在失败时快速定位问题，避免重要信息悄然丢失。</p></div></div></div>
            </div>
        </div>
    </section>

    <section class="py-6 bg-light border-top border-bottom">
        <div class="container">
            <div class="text-center mb-5"><span class="text-uppercase text-primary text-sm fw-medium mb-2 d-block">可视化工作流</span><h2 class="h1">三步构建可靠的告警通道</h2><p class="text-muted fs-lg mx-auto" style="max-width: 42rem;">从接入到投递，所有配置都在控制台中完成，无需在多个系统间切换。</p></div>
            <div class="row g-4">
                <div class="col-lg-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body p-4"><span class="badge bg-primary-subtle text-primary mb-4">01</span><div class="mb-3 text-primary"><i data-lucide="app-window" style="width: 42px; height: 42px;"></i></div><h3 class="h4">创建接入应用</h3><p class="text-muted mb-3">为服务签发专属 API Key，隔离来源并精确管理上报权限。</p><a asp-controller="Alerts" asp-action="Applications" class="btn btn-sm btn-outline-primary">管理接入应用 <i data-lucide="arrow-right" class="align-middle"></i></a></div></div></div>
                <div class="col-lg-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body p-4"><span class="badge bg-primary-subtle text-primary mb-4">02</span><div class="mb-3 text-primary"><i data-lucide="message-square-more" style="width: 42px; height: 42px;"></i></div><h3 class="h4">上报与查看告警</h3><p class="text-muted mb-3">记录标题、严重级别、发生时间和上下文；重复上报自动幂等处理。</p><a asp-controller="Alerts" asp-action="Index" class="btn btn-sm btn-outline-primary">查看告警列表 <i data-lucide="arrow-right" class="align-middle"></i></a></div></div></div>
                <div class="col-lg-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body p-4"><span class="badge bg-primary-subtle text-primary mb-4">03</span><div class="mb-3 text-primary"><i data-lucide="bell-ring" style="width: 42px; height: 42px;"></i></div><h3 class="h4">配置推送渠道</h3><p class="text-muted mb-3">使用 Webhook、邮件和站内通知建立适合团队的响应路径。</p><a asp-controller="Push" asp-action="Index" class="btn btn-sm btn-outline-primary">打开推送中心 <i data-lucide="arrow-right" class="align-middle"></i></a></div></div></div>
            </div>
        </div>
    </section>

    <section class="py-6">
        <div class="container"><div class="row align-items-center g-5"><div class="col-lg-5"><span class="text-uppercase text-primary text-sm fw-medium mb-2 d-block">为响应而设计</span><h2 class="h1 mb-3">重要告警，不该被淹没在日志里。</h2><p class="text-muted fs-lg mb-4">AlertCenter 将来源、严重级别、推送配置和交付结果关联在一起，帮助团队快速评估影响并决定下一步。</p><a asp-controller="Alerts" asp-action="GettingStarted" class="btn btn-primary btn-pill"><i data-lucide="book-open" class="align-middle me-1"></i>查看接入指南</a></div><div class="col-lg-7"><div class="card shadow-sm border-0"><div class="card-body p-0"><div class="p-4 border-bottom d-flex justify-content-between align-items-center"><div><h3 class="h5 mb-1">告警概览</h3><span class="text-muted small">按严重级别快速定位</span></div><i data-lucide="activity" class="text-primary"></i></div><div class="row g-0"><div class="col-sm-6 border-end"><div class="p-4"><div class="d-flex justify-content-between align-items-center mb-3"><span class="text-muted">严重 / 错误</span><span class="badge text-bg-danger">需要处理</span></div><div class="d-flex gap-2"><div class="alert-center-bar bg-danger" style="width: 88%;"></div><div class="alert-center-bar bg-warning" style="width: 54%;"></div></div></div></div><div class="col-sm-6"><div class="p-4"><div class="d-flex justify-content-between align-items-center mb-3"><span class="text-muted">信息 / 通知</span><span class="badge text-bg-primary">已同步</span></div><div class="d-flex gap-2"><div class="alert-center-bar bg-primary" style="width: 72%;"></div><div class="alert-center-bar bg-secondary" style="width: 42%;"></div></div></div></div></div><div class="p-4 bg-light"><div class="d-flex align-items-center gap-3"><div class="rounded-circle bg-success-subtle text-success p-2"><i data-lucide="send"></i></div><div><strong class="d-block">投递记录全程可追踪</strong><span class="text-muted small">了解每一个渠道的成功、等待或失败状态。</span></div></div></div></div></div></div></div></div>
    </section>

    <section class="py-6 text-bg-dark alert-center-cta"><div class="container text-center"><span class="badge badge-subtle-primary p-2 mb-3">立即开始</span><h2 class="display-5 fw-bold text-white mb-3">让团队更早发现问题，更快恢复服务。</h2><p class="text-white-50 fs-lg mb-4 mx-auto" style="max-width: 42rem;">创建第一个接入应用，发送第一条告警，建立属于你的可靠通知闭环。</p><div class="d-flex justify-content-center flex-wrap gap-3"><a asp-controller="Alerts" asp-action="GettingStarted" class="btn btn-primary btn-lg btn-pill"><i data-lucide="rocket" class="align-middle me-1"></i>开始接入</a><a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-light btn-lg btn-pill"><i data-lucide="layout-dashboard" class="align-middle me-1"></i>进入控制台</a></div></div></section>
</main>

<vc:marketing-footer></vc:marketing-footer>

@section scripts {
    <script>
        window.addEventListener('load', function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            })
        });
    </script>
}
