@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/styles/site.css" />
    <link rel="stylesheet" href="~/styles/marketing.css" />
}

<vc:marketing-navbar></vc:marketing-navbar>

<main class="alert-center-home">
    <section class="landing-intro text-bg-dark pt-5 pt-lg-6 pb-5 pb-lg-7">
        <div class="landing-intro-content container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <div class="d-flex flex-wrap gap-2 mb-4">
                        <span class="badge badge-subtle-primary p-2"><i data-lucide="shield-check" class="align-middle me-1"></i>@Localizer["Enterprise-grade alerts"]</span>
                        <span class="badge badge-subtle-primary p-2"><i data-lucide="send" class="align-middle me-1"></i>@Localizer["Multi-channel Push"]</span>
                        <span class="badge badge-subtle-primary p-2"><i data-lucide="container" class="align-middle me-1"></i>@Localizer["Private deployment"]</span>
                    </div>
                    <h1 id="main-slogan" class="display-3 fw-bold text-white mb-4">@Localizer["Let every critical alert"]<br /><span class="text-primary">@Localizer["Reach the right person promptly."]</span></h1>
                    <p class="lead text-white-50 mb-4">@Localizer["AlertCenter centrally receives, classifies, and reliably delivers alerts for business systems. Connect all services with a single API to keep your team informed of the real-time production status."]</p>
                    <div class="d-flex flex-wrap gap-3">
                        <a asp-controller="Alerts" asp-action="GettingStarted" class="btn btn-primary btn-lg btn-pill"><i data-lucide="rocket" class="align-middle me-1"></i>@Localizer["Start Integration"]</a>
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-light btn-lg btn-pill"><i data-lucide="layout-dashboard" class="align-middle me-1"></i>@Localizer["Enter Console"]</a>
                    </div>
                    <div class="d-flex flex-wrap gap-4 mt-5 text-white-50 small">
                        <span><i data-lucide="check-circle-2" class="align-middle text-success me-1"></i>@Localizer["Persistent alert storage"]</span>
                        <span><i data-lucide="check-circle-2" class="align-middle text-success me-1"></i>@Localizer["Route by severity level"]</span>
                        <span><i data-lucide="check-circle-2" class="align-middle text-success me-1"></i>@Localizer["Open source and self-hostable"]</span>
                    </div>
                </div>
                <div class="col-lg-6 d-none d-lg-block">
                    <div class="alert-center-preview card border-0 shadow-lg">
                        <div class="card-header d-flex align-items-center justify-content-between px-4 py-3">
                            <div class="d-flex align-items-center gap-2"><span class="alert-center-status-dot"></span><span class="fw-semibold">@Localizer["Real-time Alert Stream"]</span></div>
                            <span class="badge bg-success-subtle text-success">@Localizer["System normal"]</span>
                        </div>
                        <div class="card-body p-3">
                            <div class="alert-center-message alert-center-message-critical"><div class="alert-center-message-icon"><i data-lucide="siren"></i></div><div class="flex-grow-1"><div class="d-flex justify-content-between gap-3"><strong>@Localizer["Payment service response timeout"]</strong><span>@Localizer["Just now"]</span></div><p class="mb-0">@Localizer["Order Service · trace-7e9a"]</p></div></div>
                            <div class="alert-center-message alert-center-message-warning"><div class="alert-center-message-icon"><i data-lucide="triangle-alert"></i></div><div class="flex-grow-1"><div class="d-flex justify-content-between gap-3"><strong>@Localizer["Queue backlog approaching threshold"]</strong><span>@Localizer["2 minutes ago"]</span></div><p class="mb-0">@Localizer["Message Center · 8,420 pending"]</p></div></div>
                            <div class="alert-center-message alert-center-message-info"><div class="alert-center-message-icon"><i data-lucide="circle-check-big"></i></div><div class="flex-grow-1"><div class="d-flex justify-content-between gap-3"><strong>@Localizer["Database backup completed"]</strong><span>@Localizer["8 minutes ago"]</span></div><p class="mb-0">@Localizer["Infrastructure · backup-2026-09-14"]</p></div></div>
                        </div>
                        <div class="card-footer bg-transparent text-center py-3"><span class="text-muted small">@Localizer["Alert synchronously delivered to Webhook and in-app notification"]</span></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-6">
        <div class="container">
            <div class="row align-items-end mb-5"><div class="col-lg-7"><span class="text-uppercase text-primary text-sm fw-medium mb-2 d-block">@Localizer["One Center, Closed-Loop Handling"]</span><h2 class="h1 mb-0">@Localizer["From exception occurrence to team response, always clear and controllable."]</h2></div><div class="col-lg-5"><p class="text-muted fs-lg mb-0">@Localizer["Centrally manage sources, alert levels, notification channels, and delivery results so service anomalies are not buried in logs."]</p></div></div>
            <div class="row g-4">
                <div class="col-md-4 d-flex"><div class="card h-100 w-100 shadow-sm border-0"><div class="card-body p-4"><div class="landing-feature mb-4"><i data-lucide="radio-tower"></i></div><h3 class="h4">@Localizer["Unified intake"]</h3><p class="text-muted mb-0">@Localizer["Create independent API Keys for each business application to report structured alerts and context via standard HTTP APIs."]</p></div></div></div>
                <div class="col-md-4 d-flex"><div class="card h-100 w-100 shadow-sm border-0"><div class="card-body p-4"><div class="landing-feature mb-4"><i data-lucide="layers-3"></i></div><h3 class="h4">@Localizer["Tiered Routing"]</h3><p class="text-muted mb-0">@Localizer["Configure independent push channels for sev0 to sev4 to ensure the most urgent issues receive the highest priority response."]</p></div></div></div>
                <div class="col-md-4 d-flex"><div class="card h-100 w-100 shadow-sm border-0"><div class="card-body p-4"><div class="landing-feature mb-4"><i data-lucide="route"></i></div><h3 class="h4">@Localizer["Reliable delivery"]</h3><p class="text-muted mb-0">@Localizer["Centrally track each notification delivery status to quickly locate issues upon failure and prevent important information from being silently lost."]</p></div></div></div>
            </div>
        </div>
    </section>

    <section class="py-6 bg-light border-top border-bottom">
        <div class="container">
            <div class="text-center mb-5"><span class="text-uppercase text-primary text-sm fw-medium mb-2 d-block">@Localizer["Visual workflow"]</span><h2 class="h1">@Localizer["Build a Reliable Alert Channel in Three Steps"]</h2><p class="text-muted fs-lg mx-auto" style="max-width: 42rem;">@Localizer["From ingestion to delivery, all configurations are completed in the console, eliminating the need to switch between multiple systems."]</p></div>
            <div class="row g-4">
                <div class="col-lg-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body p-4"><span class="badge bg-primary-subtle text-primary mb-4">01</span><div class="mb-3 text-primary"><i data-lucide="app-window" style="width: 42px; height: 42px;"></i></div><h3 class="h4">@Localizer["Create Integration App"]</h3><p class="text-muted mb-3">@Localizer["Issue dedicated API Keys for services to isolate sources and precisely manage reporting permissions."]</p><a asp-controller="Alerts" asp-action="Applications" class="btn btn-sm btn-outline-primary">@Localizer["Manage integrated applications"] <i data-lucide="arrow-right" class="align-middle"></i></a></div></div></div>
                <div class="col-lg-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body p-4"><span class="badge bg-primary-subtle text-primary mb-4">02</span><div class="mb-3 text-primary"><i data-lucide="message-square-more" style="width: 42px; height: 42px;"></i></div><h3 class="h4">@Localizer["Report and View Alerts"]</h3><p class="text-muted mb-3">@Localizer["Record title, severity, occurrence time, and context; duplicate reports are handled idempotently."]</p><a asp-controller="Alerts" asp-action="Index" class="btn btn-sm btn-outline-primary">@Localizer["View alert list"] <i data-lucide="arrow-right" class="align-middle"></i></a></div></div></div>
                <div class="col-lg-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body p-4"><span class="badge bg-primary-subtle text-primary mb-4">03</span><div class="mb-3 text-primary"><i data-lucide="bell-ring" style="width: 42px; height: 42px;"></i></div><h3 class="h4">@Localizer["Configure Push Channel"]</h3><p class="text-muted mb-3">@Localizer["Establish a response path suitable for your team using Webhooks, emails, and in-app notifications."]</p><a asp-controller="Push" asp-action="Index" class="btn btn-sm btn-outline-primary">@Localizer["Open Push Center"] <i data-lucide="arrow-right" class="align-middle"></i></a></div></div></div>
            </div>
        </div>
    </section>

    <section class="py-6">
        <div class="container"><div class="row align-items-center g-5"><div class="col-lg-5"><span class="text-uppercase text-primary text-sm fw-medium mb-2 d-block">@Localizer["Designed for response"]</span><h2 class="h1 mb-3">@Localizer["Critical alerts should not be buried in logs."]</h2><p class="text-muted fs-lg mb-4">@Localizer["AlertCenter correlates sources, severity levels, push configurations, and delivery results to help teams quickly assess impact and decide on next steps."]</p><a asp-controller="Alerts" asp-action="GettingStarted" class="btn btn-primary btn-pill"><i data-lucide="book-open" class="align-middle me-1"></i>@Localizer["View integration guide"]</a></div><div class="col-lg-7"><div class="card shadow-sm border-0"><div class="card-body p-0"><div class="p-4 border-bottom d-flex justify-content-between align-items-center"><div><h3 class="h5 mb-1">@Localizer["Alert overview"]</h3><span class="text-muted small">@Localizer["Quickly locate by severity level"]</span></div><i data-lucide="activity" class="text-primary"></i></div><div class="row g-0"><div class="col-sm-6 border-end"><div class="p-4"><div class="d-flex justify-content-between align-items-center mb-3"><span class="text-muted">@Localizer["Critical / Error"]</span><span class="badge text-bg-danger">@Localizer["Action Required"]</span></div><div class="d-flex gap-2"><div class="alert-center-bar bg-danger" style="width: 88%;"></div><div class="alert-center-bar bg-warning" style="width: 54%;"></div></div></div></div><div class="col-sm-6"><div class="p-4"><div class="d-flex justify-content-between align-items-center mb-3"><span class="text-muted">@Localizer["Info / Notification"]</span><span class="badge text-bg-primary">@Localizer["Synced"]</span></div><div class="d-flex gap-2"><div class="alert-center-bar bg-primary" style="width: 72%;"></div><div class="alert-center-bar bg-secondary" style="width: 42%;"></div></div></div></div></div><div class="p-4 bg-light"><div class="d-flex align-items-center gap-3"><div class="rounded-circle bg-success-subtle text-success p-2"><i data-lucide="send"></i></div><div><strong class="d-block">@Localizer["Delivery records are fully traceable"]</strong><span class="text-muted small">@Localizer["Track the success, pending, or failure status of every channel."]</span></div></div></div></div></div></div></div></div>
    </section>

    <section class="py-6 text-bg-dark alert-center-cta"><div class="container text-center"><span class="badge badge-subtle-primary p-2 mb-3">@Localizer["Start now"]</span><h2 class="display-5 fw-bold text-white mb-3">@Localizer["Help your team detect issues earlier and restore services faster."]</h2><p class="text-white-50 fs-lg mb-4 mx-auto" style="max-width: 42rem;">@Localizer["Create your first integration app, send your first alert, and establish your reliable notification loop."]</p><div class="d-flex justify-content-center flex-wrap gap-3"><a asp-controller="Alerts" asp-action="GettingStarted" class="btn btn-primary btn-lg btn-pill"><i data-lucide="rocket" class="align-middle me-1"></i>@Localizer["Start Integration"]</a><a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-light btn-lg btn-pill"><i data-lucide="layout-dashboard" class="align-middle me-1"></i>@Localizer["Enter Console"]</a></div></div></section>
</main>

<vc:marketing-footer></vc:marketing-footer>

@section scripts {
    <script src="~/scripts/home.js" asp-append-version="true" defer></script>
}
