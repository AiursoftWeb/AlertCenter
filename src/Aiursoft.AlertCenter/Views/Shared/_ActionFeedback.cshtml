<script id="alertcenter-localization" type="application/json">@Html.Raw(JsonSerializer.Serialize(messages))</script>
<div class="modal fade" id="action-feedback" tabindex="-1" aria-labelledby="action-feedback-title" aria-describedby="action-feedback-message" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="action-feedback-title">@Localizer["Action not completed"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
            </div>
            <div class="modal-body">
                <p id="action-feedback-message" class="mb-0 text-break" style="white-space: pre-line;"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary d-none" id="action-feedback-refresh">@Localizer["Refresh page"]</button>
                <button type="button" class="btn btn-primary" id="action-feedback-return" data-bs-dismiss="modal">@Localizer["Back to Edit"]</button>
            </div>
        </div>
    </div>
</div>
<script src="~/scripts/action-feedback.js" asp-append-version="true" defer></script>
