@using System.Globalization
@model (DateTime Time, string Zone)
@{
    var utc = DateTime.SpecifyKind(Model.Time, DateTimeKind.Utc);
    var zone = TimeZoneInfo.FindSystemTimeZoneById(Model.Zone);
    var local = TimeZoneInfo.ConvertTime(new DateTimeOffset(utc), zone);
    var currentYear = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, zone).Year;
    var shortFormat = local.Year == currentYear ? "MM-dd HH:mm" : "yyyy-MM-dd HH:mm";
}
<time datetime="@utc.ToString("O", CultureInfo.InvariantCulture)" data-oncall-time data-zone="@Model.Zone" title="@local.ToString("yyyy-MM-dd HH:mm zzz", CultureInfo.InvariantCulture) (@Model.Zone)"><span>@local.ToString(shortFormat, CultureInfo.InvariantCulture)</span><span class="d-none text-muted ms-1" aria-hidden="true"><i data-lucide="globe" class="align-middle" width="12" height="12"></i></span></time>
