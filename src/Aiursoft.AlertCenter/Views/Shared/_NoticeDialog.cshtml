@model Aiursoft.AlertCenter.Models.NoticeDialogViewModel
<button type="button" class="btn btn-outline-secondary mb-3" data-bs-toggle="modal" data-bs-target="#@Model.Id">
    <i class="align-middle me-1" data-lucide="info" aria-hidden="true"></i> @Model.Title
</button>
<div data-open-on-load="@(Model.OpenOnLoad ? "true" : null)" class="modal fade" id="@Model.Id" tabindex="-1" aria-labelledby="@(Model.Id)-title" aria-describedby="@(Model.Id)-message" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="@(Model.Id)-title">@Model.Title</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
            </div>
            <div class="modal-body">
                <p id="@(Model.Id)-message" class="mb-0">@Model.Message</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">@Localizer["Close"]</button>
            </div>
        </div>
    </div>
</div>
<script src="~/scripts/notice-dialog.js" asp-append-version="true" defer></script>
