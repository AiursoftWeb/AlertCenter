@model Aiursoft.AlertCenter.Views.Shared.Components.MarketingNavbar.MarketingNavbarViewModel

<nav class="navbar navbar-expand-md navbar-dark bg-dark landing-navbar">
    <div class="container">
        <a class="navbar-brand landing-brand text-white" href="/">
            <img src="@Model.LogoUrl" alt="logo" style="width: 24px; height: 24px;" />
            @Model.ProjectName
        </a>
        <ul class="navbar-nav ms-auto">
            <li class="nav-item d-none d-md-inline-block">
                <a asp-controller="Alerts" asp-action="GettingStarted" class="nav-link active text-lg px-lg-3">@Localizer["Integration Guide"]</a>
            </li>
            <li class="nav-item d-none d-md-inline-block">
                <a asp-controller="Alerts" asp-action="Applications" class="nav-link active text-lg px-lg-3">@Localizer["Applications"]</a>
            </li>
            <li class="nav-item d-none d-md-inline-block">
                <a asp-controller="Push" asp-action="Index" class="nav-link active text-lg px-lg-3">@Localizer["Notifications"]</a>
            </li>
        </ul>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-lg btn-primary btn-pill my-2 my-sm-0 ms-3">
            <i class="align-middle" data-lucide="layout-dashboard"></i> @Localizer["Enter Console"]
        </a>
        <a href="https://github.com/aiursoftweb/alertCenter" target="_blank" rel="noreferrer" class="btn btn-lg btn-outline-light btn-pill my-2 my-sm-0 ms-3">
            <i class="fa-brands fa-github me-1"></i> GitHub
        </a>
    </div>
</nav>
