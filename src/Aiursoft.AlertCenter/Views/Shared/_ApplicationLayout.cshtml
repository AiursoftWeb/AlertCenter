@{
    // ReSharper disable once Razor.LayoutNotResolved
    Layout = "~/Layout/UiStackLayout.cshtml";
}
<partial name="_ActionFeedback" />
@RenderBody()
@section styles {
    @await RenderSectionAsync("styles", required: false)
}
@section scripts {
    <script src="~/scripts/oncall-personal.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("scripts", required: false)
}
