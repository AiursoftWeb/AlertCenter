@model Aiursoft.AlertCenter.Models.AlertsViewModel
@section styles {
    <style>
        #delete-application, #delete-application * {
            -webkit-user-select: text;
            user-select: text;
        }
    </style>
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div><h1 class="h3 mb-1">接入应用</h1><p class="text-muted mb-0">为业务系统创建独立密钥，管理消息上报权限。</p></div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="GettingStarted" class="btn btn-primary"><i class="align-middle me-1" data-lucide="book-open" aria-hidden="true"></i>接入指南</a>
        <a asp-action="Index" class="btn btn-outline-primary"><i class="align-middle me-1" data-lucide="inbox" aria-hidden="true"></i>查看消息</a>
    </div>
</div>
@if (Model.ApiKey != null)
{
    <section class="card" aria-labelledby="api-key-heading">
        <div class="card-header d-flex align-items-center gap-3">
            <div class="stat flex-shrink-0"><i data-lucide="key-round" aria-hidden="true"></i></div>
            <div>
                <h2 id="api-key-heading" class="card-title mb-1">@(Model.ApiKeyWasReset ? "API Key 已重置" : "应用已创建")</h2>
                <p class="text-muted mb-0">@(Model.ApiKeyWasReset ? "旧密钥已立即失效，请保存新密钥并更新所有上报客户端。应用启停状态保持不变。" : "保存接入密钥，即可开始上报告警。")</p>
            </div>
        </div>
        <div class="card-body pt-0">
            <label for="api-key" class="form-label">API Key</label>
            <div class="input-group">
                <input id="api-key" class="form-control font-monospace" readonly value="@Model.ApiKey" aria-describedby="api-key-hint" spellcheck="false" />
                <button type="button" class="btn btn-primary" id="copy-key">
                    <i class="align-middle me-1" data-lucide="copy" aria-hidden="true"></i>复制密钥
                </button>
            </div>
            <div class="d-flex flex-wrap justify-content-between gap-2 mt-2">
                <small id="api-key-hint" class="text-muted">密钥仅显示一次，请在刷新或离开此页面前妥善保存。<a asp-action="GettingStarted">查看接入指南，发送第一条消息</a></small>
                <small id="copy-status" class="text-primary" role="status"></small>
            </div>
        </div>
    </section>
}
@if (Model.IsAdministrator)
{
<div class="card">
    <div class="card-header"><h2 class="card-title mb-0"><i class="align-middle me-2" data-lucide="plus-circle" aria-hidden="true"></i>创建应用</h2></div>
    <div class="card-body pt-0">
    <form asp-action="CreateApplication" method="post">
        <label for="name" class="form-label">应用名称</label>
        <div class="row g-2">
            <div class="col-sm"><input id="name" name="Name" required maxlength="100" placeholder="例如：订单服务" class="form-control" aria-describedby="name-hint" /></div>
            <div class="col-sm-auto"><button class="btn btn-primary w-100" type="submit">创建应用</button></div>
        </div>
        <small id="name-hint" class="text-muted d-block mt-2">使用容易识别的名称，便于在告警中区分来源。</small>
        <div asp-validation-summary="All" class="text-danger mt-2"></div>
    </form>
</div></div>
}
<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="card-title mb-0">已接入应用</h2><span class="badge bg-secondary">@Model.Applications.Count</span>
    </div>
    <div class="card-body border-bottom">
        <form asp-action="Applications" method="get" class="row g-2 align-items-end">
            <div class="col-md-6 col-lg-5"><label for="application-keyword" class="form-label">查找应用</label><input id="application-keyword" name="keyword" value="@Model.ApplicationSearchKeyword" maxlength="100" class="form-control" placeholder="按应用名称搜索" autocomplete="off" /></div>
            <div class="col-md-auto d-flex gap-2"><button type="submit" class="btn btn-primary">查找</button>@if (Model.ApplicationSearchKeyword != null) { <a asp-action="Applications" class="btn btn-outline-secondary">清除</a> }</div>
        </form>
    </div>
    @if (Model.Applications.Count == 0)
    {
        <div class="card-body text-center py-4">
            <div class="stat mx-auto mb-3"><i data-lucide="app-window" aria-hidden="true"></i></div>
            <h3 class="h5">@(Model.ApplicationSearchKeyword == null ? "还没有接入应用" : "没有找到匹配的应用")</h3><p class="text-muted mb-0">@(Model.ApplicationSearchKeyword == null ? "在上方创建应用，获取专属 API Key。" : "请修改搜索关键词，或清除搜索后查看全部应用。")</p>
        </div>
    }
    else
    {
    <div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th class="ps-4">名称</th><th>应用 ID</th><th>状态</th><th class="text-end pe-4">操作</th></tr></thead><tbody>
    @foreach (var application in Model.Applications)
    {
        <tr><td class="ps-4 fw-semibold">@application.Name</td><td><code class="text-muted">@application.Id</code></td><td><span class="badge @(application.IsEnabled ? "bg-success" : "bg-secondary")">@(application.IsEnabled ? "已启用" : "已停用")</span></td><td class="text-end pe-4">
            <div class="d-flex justify-content-end gap-2">
                @if (Model.ManageableApplicationIds.Contains(application.Id))
                {
                    <a asp-controller="Push" asp-action="Bindings" asp-route-id="@application.Id" class="btn btn-sm btn-outline-primary text-nowrap">推送设置</a>
                    <form asp-action="SetEnabled" method="post"><input type="hidden" name="id" value="@application.Id" /><input type="hidden" name="enabled" value="@((!application.IsEnabled).ToString().ToLowerInvariant())" /><button class="btn btn-sm btn-outline-secondary text-nowrap" type="submit">@(application.IsEnabled ? "停用" : "启用")</button></form>
                    <button type="button" class="btn btn-sm btn-outline-warning text-nowrap" data-bs-toggle="modal" data-bs-target="#reset-api-key" data-application-id="@application.Id" data-application-name="@application.Name">重置密钥</button>
                    <button type="button" class="btn btn-sm btn-outline-danger text-nowrap" data-bs-toggle="modal" data-bs-target="#delete-application" data-application-id="@application.Id" data-application-name="@application.Name">删除</button>
                }
                @if (Model.IsAdministrator) { <a asp-action="Access" asp-route-id="@application.Id" class="btn btn-sm btn-outline-secondary text-nowrap">访问权限</a> }
            </div>
        </td></tr>
    }
    </tbody>
</table></div>
    }
</div>
<div class="modal fade" id="reset-api-key" tabindex="-1" aria-labelledby="reset-api-key-title" aria-describedby="reset-api-key-description" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="ResetApiKey" method="post" class="modal-content" id="reset-api-key-form">
            <div class="modal-header">
                <h2 class="modal-title h5" id="reset-api-key-title">重置 API Key</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button>
            </div>
            <div class="modal-body">
                <p>确定重置应用 <strong id="reset-api-key-name" class="text-break"></strong> 的 API Key？</p>
                <p id="reset-api-key-description" class="text-danger">旧密钥将立即失效，所有上报客户端都需要更新。新密钥仅显示一次，请及时保存。</p>
                <p class="mb-0">应用 ID、历史消息、推送配置和启停状态保持不变，不会重新发送历史消息。</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                <input type="hidden" id="reset-api-key-id" name="id" />
                <button type="submit" class="btn btn-warning" id="confirm-reset-api-key" disabled>确认重置密钥</button>
            </div>
        </form>
    </div>
</div>
<script>
    (() => {
        const modal = document.getElementById('reset-api-key');
        const form = document.getElementById('reset-api-key-form');
        const applicationId = document.getElementById('reset-api-key-id');
        const applicationName = document.getElementById('reset-api-key-name');
        const submit = document.getElementById('confirm-reset-api-key');
        modal.addEventListener('show.bs.modal', event => {
            applicationId.value = event.relatedTarget?.dataset.applicationId ?? '';
            applicationName.textContent = event.relatedTarget?.dataset.applicationName ?? '';
            submit.disabled = !applicationId.value;
        });
        form.addEventListener('submit', event => {
            if (!applicationId.value || submit.disabled) {
                event.preventDefault();
                return;
            }
            submit.disabled = true;
        });
    })();
</script>
<div class="modal fade" id="delete-application" tabindex="-1" aria-labelledby="delete-application-title" aria-describedby="delete-application-description" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="DeleteApplication" method="post" class="modal-content" id="delete-application-form">
            <div class="modal-header">
                <h2 class="modal-title h5" id="delete-application-title">删除接入应用</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button>
            </div>
            <div class="modal-body">
                <p>确定删除应用 <strong id="delete-application-name" class="text-break"></strong>？</p>
                <p id="delete-application-description" class="text-danger">该应用的全部历史告警、关联投递记录和站内通知将一并删除，API Key 将立即失效。此操作无法恢复。</p>
                <label for="delete-application-confirmation" class="form-label">请输入应用名称以确认删除</label>
                <input id="delete-application-confirmation" name="confirmationName" class="form-control" required maxlength="100" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="delete-application-confirmation-hint" />
                <small id="delete-application-confirmation-hint" class="text-muted d-block mt-2">名称必须完全一致（区分大小写）。可选中并复制上方的应用名称。</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                <input type="hidden" id="delete-application-id" name="id" />
                <button type="submit" class="btn btn-danger" id="confirm-delete-application" disabled>删除应用及历史告警</button>
            </div>
        </form>
    </div>
</div>
<script>
    (() => {
        const modal = document.getElementById('delete-application');
        const form = document.getElementById('delete-application-form');
        const applicationId = document.getElementById('delete-application-id');
        const applicationName = document.getElementById('delete-application-name');
        const confirmation = document.getElementById('delete-application-confirmation');
        const submit = document.getElementById('confirm-delete-application');
        const updateConfirmation = () => {
            const matches = Boolean(applicationId.value) && confirmation.value.length > 0 &&
                confirmation.value === applicationName.textContent;
            confirmation.setCustomValidity(matches ? '' : '请输入完全一致的应用名称以确认删除。');
            submit.disabled = !matches;
            return matches;
        };
        modal.addEventListener('show.bs.modal', event => {
            applicationId.value = event.relatedTarget?.dataset.applicationId ?? '';
            applicationName.textContent = event.relatedTarget?.dataset.applicationName ?? '';
            confirmation.value = '';
            updateConfirmation();
        });
        modal.addEventListener('shown.bs.modal', () => confirmation.focus());
        confirmation.addEventListener('input', updateConfirmation);
        form.addEventListener('submit', event => {
            if (!updateConfirmation()) {
                event.preventDefault();
                confirmation.reportValidity();
            }
        });
    })();
</script>
@if (Model.ApiKey != null)
{
    <script>
        document.getElementById('copy-key').addEventListener('click', async function () {
            const input = document.getElementById('api-key');
            try {
                await navigator.clipboard.writeText(input.value);
                document.getElementById('copy-status').textContent = '已复制';
            } catch {
                input.select();
                document.getElementById('copy-status').textContent = '请按 Ctrl+C 复制选中的密钥';
            }
        });
    </script>
}
