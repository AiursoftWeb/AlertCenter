@model Aiursoft.AlertCenter.Models.AlertsViewModel

@section styles {
    <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" />
    <style>
        #delete-application, #delete-application * {
            -webkit-user-select: text;
            user-select: text;
        }
    </style>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Applications"]</h1>
        <p class="text-muted mb-0">@Localizer["Distribute independent API credentials for business services and manage reporting permissions and push routing."]</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="GettingStarted" class="btn btn-outline-primary">
            <i class="align-middle me-1" data-lucide="book-open" aria-hidden="true"></i>@Localizer["Integration Guide"]
        </a>
        <a asp-action="Index" class="btn btn-primary">
            <i class="align-middle me-1" data-lucide="inbox" aria-hidden="true"></i>@Localizer["View all alerts"]
        </a>
    </div>
</div>

<!-- High-Priority API Key One-Time Reveal Banner -->
@if (Model.ApiKey != null)
{
    <section class="card border-warning mb-4 shadow-sm" aria-labelledby="api-key-heading">
        <div class="card-header bg-warning-subtle d-flex align-items-center gap-3 py-3">
            <div class="ac-stat-icon icon-warning">
                <i data-lucide="key-round" aria-hidden="true"></i>
            </div>
            <div>
                <h2 id="api-key-heading" class="card-title text-warning-emphasis mb-1">
                    @(Model.ApiKeyWasReset ? @Localizer["API Key has been reset"].Value : @Localizer["New application created"].Value)
                </h2>
                <p class="text-warning-emphasis small mb-0">
                    @(Model.ApiKeyWasReset
                        ? @Localizer["The old key has been invalidated immediately. All reporting clients must be updated. The new key is displayed only once; please save it now."].Value
                        : @Localizer["Credentials are displayed only once after this operation. The original key cannot be viewed again after refreshing or leaving this page."].Value)
                </p>
            </div>
        </div>
        <div class="card-body">
            <label for="api-key" class="form-label fw-semibold">@Localizer["Application Access Credentials (API Key)"]</label>
            <div class="input-group mb-2">
                <span class="input-group-text bg-body-tertiary text-muted font-monospace"><i data-lucide="lock" class="align-middle"></i></span>
                <input id="api-key" class="form-control font-monospace fs-6" readonly value="@Model.ApiKey" aria-describedby="api-key-hint" spellcheck="false" />
                <button type="button" class="btn btn-primary" id="copy-key">
                    <i class="align-middle me-1" data-lucide="copy" aria-hidden="true"></i>@Localizer["Copy API key"]
                </button>
            </div>
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <small id="api-key-hint" class="text-muted">
                    @Localizer["Please store the key securely in environment variables or a key service."]<a asp-action="GettingStarted" class="fw-medium">@Localizer["View integration guide to send the first test message "]&rarr;</a>
                </small>
                <small id="copy-status" class="text-success fw-semibold" role="status"></small>
            </div>
        </div>
    </section>
}

<!-- Create Application Card (Admin Only) -->
@if (Model.CanManageApplications)
{
    <div class="card mb-4">
        <div class="card-header">
            <h2 class="card-title mb-0">
                <i class="align-middle me-2 text-primary" data-lucide="plus-circle" aria-hidden="true"></i>@Localizer["Create new integration app"]
            </h2>
        </div>
        <div class="card-body pt-0">
            <form asp-action="CreateApplication" method="post" data-action-feedback>
                <label for="name" class="form-label small fw-medium">@Localizer["Application Name"]</label>
                <div class="row g-2">
                    <div class="col-sm">
                        <div class="input-group">
                            <span class="input-group-text bg-transparent text-muted"><i data-lucide="app-window" class="align-middle"></i></span>
                            <input id="name" name="Name" value="@Model.ApplicationInput.Name" required maxlength="100" placeholder="@Localizer["Example: Order payment service, User Center, Edge Gateway…"]" class="form-control" aria-describedby="name-hint" />
                        </div>
                    </div>
                    <div class="col-sm">
                        <label for="create-oncall-group" class="visually-hidden">@Localizer["On-call group (optional)"]</label>
                        <select id="create-oncall-group" name="OnCallGroupId" class="form-select" aria-describedby="oncall-group-hint">
                            <option value="">@Localizer["Do not bind on-call group"]</option>
                            @foreach (var group in Model.OnCallGroups)
                            {
                                <option value="@group.Id" selected="@(Model.ApplicationInput.OnCallGroupId == group.Id)">@group.Name (@group.TimeZoneId)</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-auto">
                        <button class="btn btn-primary w-100" type="submit">
                            <i class="align-middle me-1" data-lucide="plus"></i>@Localizer["Create Application"]
                        </button>
                    </div>
                </div>
                <small id="name-hint" class="text-muted d-block mt-2">@Localizer["Use a concise and clear business system name; the system will automatically generate the corresponding prefix ID and random Secret."]</small>
                <small id="oncall-group-hint" class="text-muted d-block mt-1">@Localizer["On-call group is optional; if bound, the on-duty engineer is automatically notified by email, and the on-call group configuration address is CC'd. Custom push channels can still be configured independently."]</small>
                <div asp-validation-summary="All" class="text-danger mt-2"></div>
            </form>
        </div>
    </div>
}

<!-- Applications Table Card -->
<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-2">
            <h2 class="card-title mb-0">@Localizer["App connected"]</h2>
            <span class="badge bg-secondary-subtle text-secondary border">@Model.Applications.Count @Localizer["applications"]</span>
        </div>
    </div>
    <div class="card-body border-bottom py-3">
        <form asp-action="Applications" method="get" class="row g-2 align-items-end">
            <div class="col-md-6 col-lg-5">
                <label for="application-keyword" class="form-label small fw-medium">@Localizer["Find application"]</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent text-muted"><i data-lucide="search" class="align-middle"></i></span>
                    <input id="application-keyword" name="keyword" value="@Model.ApplicationSearchKeyword" maxlength="100" class="form-control" placeholder="@Localizer["Filter by application name..."]" autocomplete="off" />
                </div>
            </div>
            <div class="col-md-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="align-middle me-1" data-lucide="search"></i>@Localizer["Find"]
                </button>
                @if (Model.ApplicationSearchKeyword != null)
                {
                    <a asp-action="Applications" class="btn btn-outline-secondary">
                        <i class="align-middle me-1" data-lucide="rotate-ccw"></i>@Localizer["Clear"]
                    </a>
                }
            </div>
        </form>
    </div>

    @if (Model.Applications.Count == 0)
    {
        <div class="card-body ac-empty-state">
            <div class="ac-empty-icon">
                <i data-lucide="app-window" aria-hidden="true"></i>
            </div>
            <h3 class="h5">@(Model.ApplicationSearchKeyword == null ? @Localizer["No connected apps yet"].Value : @Localizer["No matching applications found"].Value)</h3>
            <p class="text-muted mb-0">
                @(Model.ApplicationSearchKeyword == null ? @Localizer["Create a business app above and issue a dedicated API Key."].Value : @Localizer["Adjust search keywords or clear the search to view all apps."].Value)
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">@Localizer["App information"]</th>
                        <th>@Localizer["App ID"]</th>
                        <th>@Localizer["On-call group"]</th>
                        <th>@Localizer["Running Status"]</th>
                        <th class="text-end pe-4">@Localizer["Action"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var application in Model.Applications)
                {
                    var initial = string.IsNullOrWhiteSpace(application.Name) ? "A" : application.Name.Substring(0, 1).ToUpperInvariant();
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-3">
                                <span class="ac-app-avatar">@initial</span>
                                <div>
                                    <strong class="d-block text-break">@application.Name</strong>
                                    <small class="text-muted">@Localizer["Created on"]: @application.CreatedAtUtc.ToString("yyyy-MM-dd")</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <code class="text-muted font-monospace small">@application.Id</code>
                        </td>
                        <td>
                            @if (application.OnCallGroup != null)
                            {
                                <a asp-controller="OnCall" asp-action="GroupDetails" asp-route-id="@application.OnCallGroupId">@application.OnCallGroup.Name</a>
                            }
                            else
                            {
                                <span class="text-muted">@Localizer["Unbound"]</span>
                            }
                        </td>
                        <td>
                            @if (application.IsEnabled)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <span class="ac-status-dot dot-success ac-pulse"></span>@Localizer["Enabled"]
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">
                                    <span class="ac-status-dot dot-muted"></span>@Localizer["Disabled"]
                                </span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-flex justify-content-end align-items-center flex-wrap gap-2">
                                <a asp-action="Index" asp-route-applicationId="@application.Id" class="btn btn-sm btn-primary text-nowrap">
                                    <i class="align-middle me-1" data-lucide="list"></i>@Localizer["View alert"]
                                </a>
                                @if (Model.ManageableApplicationIds.Contains(application.Id))
                                {
                                    <a asp-action="OnCall" asp-route-id="@application.Id" class="btn btn-sm btn-outline-primary text-nowrap">
                                        <i class="align-middle me-1" data-lucide="calendar-clock"></i>@Localizer["On-call settings"]
                                    </a>
                                    <a asp-controller="Push" asp-action="Bindings" asp-route-id="@application.Id" class="btn btn-sm btn-outline-primary text-nowrap">
                                        <i class="align-middle me-1" data-lucide="sliders"></i>@Localizer["Push Settings"]
                                    </a>
                                    <form asp-action="SetEnabled" method="post" data-action-feedback class="d-inline">
                                        <input type="hidden" name="id" value="@application.Id" />
                                        <input type="hidden" name="enabled" value="@((!application.IsEnabled).ToString().ToLowerInvariant())" />
                                        <button class="btn btn-sm btn-outline-secondary text-nowrap" type="submit">
                                            @(application.IsEnabled ? @Localizer["Disable"].Value : @Localizer["Enable"].Value)
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-outline-warning text-nowrap" data-bs-toggle="modal" data-bs-target="#reset-api-key" data-application-id="@application.Id" data-application-name="@application.Name">
                                        <i class="align-middle me-1" data-lucide="key"></i>@Localizer["Reset Key"]
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger text-nowrap" data-bs-toggle="modal" data-bs-target="#delete-application" data-application-id="@application.Id" data-application-name="@application.Name">
                                        <i class="align-middle me-1" data-lucide="trash-2"></i>@Localizer["Delete"]
                                    </button>
                                }
                                @if (Model.CanManageApplications)
                                {
                                    <a asp-action="Access" asp-route-id="@application.Id" class="btn btn-sm btn-outline-secondary text-nowrap">
                                        <i class="align-middle me-1" data-lucide="shield"></i>@Localizer["Permissions"]
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Reset API Key Modal -->
<div class="modal fade" id="reset-api-key" tabindex="-1" aria-labelledby="reset-api-key-title" aria-describedby="reset-api-key-description" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="ResetApiKey" method="post" data-action-feedback class="modal-content" id="reset-api-key-form">
            <div class="modal-header">
                <h2 class="modal-title h5 d-flex align-items-center gap-2" id="reset-api-key-title">
                    <i class="align-middle text-warning" data-lucide="key"></i>@Localizer["Reset API Key"]
                </h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
            </div>
            <div class="modal-body">
                <p>@Localizer["Confirm as application"] <strong id="reset-api-key-name" class="text-break"></strong> @Localizer["Reset integration key?"]</p>
                <div class="alert alert-warning small" id="reset-api-key-description" role="alert">
                    <div class="alert-icon">
                        <i class="align-middle" data-lucide="alert-triangle" aria-hidden="true"></i>
                    </div>
                    <div class="alert-message">@Localizer["The old key will become invalid immediately. All reporting clients must be updated. The new key is displayed only once on this page."]</div>
                </div>
                <p class="small text-muted mb-0">@Localizer["App ID, historical alert records, push channel bindings, and enable/disable status remain unchanged."]</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <input type="hidden" id="reset-api-key-id" name="id" />
                <button type="submit" class="btn btn-warning" id="confirm-reset-api-key" disabled>@Localizer["Confirm key reset"]</button>
            </div>
        </form>
    </div>
</div>
<script src="~/scripts/alerts-applications.js" asp-append-version="true" defer></script>

<!-- Delete Application Modal -->
<div class="modal fade" id="delete-application" tabindex="-1" aria-labelledby="delete-application-title" aria-describedby="delete-application-description" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="DeleteApplication" method="post" data-action-feedback class="modal-content" id="delete-application-form">
            <div class="modal-header">
                <h2 class="modal-title h5 d-flex align-items-center gap-2" id="delete-application-title">
                    <i class="align-middle text-danger" data-lucide="trash-2"></i>@Localizer["Delete integrated application"]
                </h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
            </div>
            <div class="modal-body">
                <p>@Localizer["Confirm app deletion"] <strong id="delete-application-name" class="text-break"></strong>？</p>
                <div class="alert alert-danger small mb-3" id="delete-application-description" role="alert">
                    <div class="alert-icon">
                        <i class="align-middle" data-lucide="alert-octagon" aria-hidden="true"></i>
                    </div>
                    <div class="alert-message">@Localizer["This action is irreversible! All historical alerts, associated delivery records, and in-site notifications for this application will be deleted, and the API Key will be immediately invalidated."]</div>
                </div>
                <label for="delete-application-confirmation" class="form-label small fw-medium">
                    @Localizer["Enter the app name to confirm deletion:"]
                </label>
                <input id="delete-application-confirmation" name="confirmationName" class="form-control" required maxlength="100" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="delete-application-confirmation-hint" />
                <small id="delete-application-confirmation-hint" class="text-muted d-block mt-2">@Localizer["The name must match exactly (case-sensitive)."]</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <input type="hidden" id="delete-application-id" name="id" />
                <button type="submit" class="btn btn-danger" id="confirm-delete-application" disabled>@Localizer["Confirm app and all data deletion"]</button>
            </div>
        </form>
    </div>
</div>
