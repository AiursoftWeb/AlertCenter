@model Aiursoft.AlertCenter.Models.AlertsViewModel
@using Newtonsoft.Json.Linq

@section styles {
    <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" />
}

@{
    var message = Model.Message!;
    var badgeClass = message.Level switch
    {
        "sev0" => "ac-badge-sev0",
        "sev1" => "ac-badge-sev1",
        "sev2" => "ac-badge-sev2",
        "sev3" => "ac-badge-sev3",
        _ => "ac-badge-sev4"
    };

    var latency = message.ReceivedAtUtc - message.OccurredAtUtc;
    var latencyText = latency.TotalSeconds >= 0
        ? (latency.TotalSeconds < 1 ? $"{latency.TotalMilliseconds:F0}ms" : $"{latency.TotalSeconds:F1}s")
        : "—";

    string formattedJson = @Localizer["None"].Value;
    if (!string.IsNullOrWhiteSpace(message.ContextJson))
    {
        try
        {
            formattedJson = JToken.Parse(message.ContextJson).ToString(Newtonsoft.Json.Formatting.Indented);
        }
        catch
        {
            formattedJson = message.ContextJson;
        }
    }
}

<!-- Top Action Bar -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="align-middle me-1" data-lucide="arrow-left" aria-hidden="true"></i>@Localizer["Back to Message List"]
    </a>
    @if (message.Incident != null)
    {
        <a asp-controller="Incidents" asp-action="Details" asp-route-id="@message.Incident.Id" class="btn btn-outline-primary">
            <i class="align-middle me-1" data-lucide="siren" aria-hidden="true"></i>@Localizer["View linked incident"]
        </a>
    }
</div>

<!-- Alert Headline Banner -->
<div class="card mb-4 border-start border-4 @(message.Level == "sev0" || message.Level == "sev1" ? "border-danger" : message.Level == "sev2" ? "border-warning" : "border-primary")">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <span class="badge @badgeClass text-uppercase fs-6">@message.Level</span>
            <span class="badge bg-secondary-subtle text-secondary border">@message.Application.Name</span>
            @if (message.IsArchived)
            {
                <span class="badge bg-secondary-subtle text-secondary border">
                    <i class="align-middle me-1" data-lucide="archive"></i>@Localizer["Archived"]
                </span>
            }
            <span class="text-muted small ms-auto">
                <i class="align-middle me-1" data-lucide="clock"></i>@Localizer["Transfer latency"]: @latencyText
            </span>
        </div>
        <h1 class="h3 mb-1 text-break fw-bold">@message.Title</h1>
        <p class="text-muted small mb-0">@Localizer["Received at"]: @message.ReceivedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC · Report ID: <code class="text-muted">@message.ReportId</code></p>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Content and Context -->
    <div class="col-lg-8">
        <!-- Message Content Card -->
        <section class="card mb-4" aria-labelledby="content-heading">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 id="content-heading" class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="align-left" aria-hidden="true"></i>@Localizer["Alert body"]
                </h2>
                @if (!string.IsNullOrWhiteSpace(message.Content))
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="copy-content-btn">
                        <i class="align-middle me-1" data-lucide="copy"></i>@Localizer["Copy Body"]
                    </button>
                }
            </div>
            <div class="card-body pt-0">
                <div class="ac-prose" id="message-content-text">@(string.IsNullOrWhiteSpace(message.Content) ? @Localizer["(This alert does not contain detailed body content)"].Value : message.Content)</div>
            </div>
        </section>

        <!-- Business Context JSON Card -->
        <section class="card" aria-labelledby="context-heading">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 id="context-heading" class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="braces" aria-hidden="true"></i>@Localizer["Business Context"]
                </h2>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-secondary-subtle text-secondary">JSON Object</span>
                    @if (message.ContextJson != null)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="copy-json-btn">
                            <i class="align-middle me-1" data-lucide="copy"></i>@Localizer["Copy JSON"]
                        </button>
                    }
                </div>
            </div>
            <div class="card-body pt-0">
                <div class="ac-code-container">
                    <div class="ac-code-header">
                        <span>Payload Context</span>
                        <span class="text-muted small">@(message.ContextJson != null ? $"{message.ContextJson.Length} bytes" : "empty")</span>
                    </div>
                    <pre class="ac-code-pre" id="context-json-code"><code>@formattedJson</code></pre>
                </div>
            </div>
        </section>
    </div>

    <!-- Right Column: Metadata Sidebar -->
    <div class="col-lg-4">
        <section class="card mb-4" aria-labelledby="meta-heading">
            <div class="card-header">
                <h2 id="meta-heading" class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="info" aria-hidden="true"></i>@Localizer["Event metadata"]
                </h2>
            </div>
            <div class="card-body pt-0">
                <dl class="mb-0">
                    <dt class="text-muted small fw-medium mb-1">@Localizer["Source application"]</dt>
                    <dd class="mb-3 d-flex align-items-center justify-content-between">
                        <span class="fw-semibold">@message.Application.Name</span>
                        <a asp-action="Index" asp-route-applicationId="@message.ApplicationId" class="small text-primary text-decoration-none">
                            @Localizer["View all alerts for this application"] <i class="align-middle" data-lucide="chevron-right"></i>
                        </a>
                    </dd>

                    <dt class="text-muted small fw-medium mb-1">@Localizer["Business Occurrence Time (Occurred)"]</dt>
                    <dd class="mb-3">
                        <i class="align-middle me-1 text-muted" data-lucide="calendar"></i>@message.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC
                    </dd>

                    <dt class="text-muted small fw-medium mb-1">@Localizer["Center Received Time (Received)"]</dt>
                    <dd class="mb-3">
                        <i class="align-middle me-1 text-muted" data-lucide="clock"></i>@message.ReceivedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC
                    </dd>

                    <dt class="text-muted small fw-medium mb-1">@Localizer["Transmission latency (Latency)"]</dt>
                    <dd class="mb-3">
                        <span class="badge bg-body-secondary text-body border">@latencyText</span>
                    </dd>

                    <dt class="text-muted small fw-medium mb-1">@Localizer["Archive Status"]</dt>
                    <dd class="mb-3">
                        @if (message.IsArchived)
                        {
                            <span class="badge bg-secondary-subtle text-secondary border">@Localizer["Automatically archived (related incident in progress)"]</span>
                        }
                        else
                        {
                            <span class="badge bg-success-subtle text-success border">@Localizer["Active"]</span>
                        }
                    </dd>

                    @if (message.IncidentKey != null)
                    {
                        <dt class="text-muted small fw-medium mb-1">Incident Key</dt>
                        <dd class="mb-3 text-break">
                            <code class="p-1 rounded bg-body-tertiary">@message.IncidentKey</code>
                        </dd>
                    }

                    <dt class="text-muted small fw-medium mb-1">@Localizer["Report ID (Idempotency Key)"]</dt>
                    <dd class="mb-0 text-break d-flex align-items-center justify-content-between">
                        <code class="small text-muted font-monospace" id="report-id-val">@message.ReportId</code>
                        <button type="button" class="btn btn-sm btn-link text-muted p-0 ms-2" id="copy-report-id" title="@Localizer["Copy Report ID"]">
                            <i class="align-middle" data-lucide="copy"></i>
                        </button>
                    </dd>
                </dl>
            </div>
        </section>

        <!-- Push Routing Quick Link -->
        @if (Model.ManageableApplicationIds.Contains(message.ApplicationId))
        {
            <div class="card">
                <div class="card-body">
                    <h3 class="h6 mb-2">@Localizer["Application Push Settings"]</h3>
                    <p class="small text-muted mb-3">@Localizer["Associate push channels with this application or configure delivery targets for different severity levels."]</p>
                    <a asp-controller="Push" asp-action="Bindings" asp-route-id="@message.ApplicationId" class="btn btn-outline-primary btn-sm w-100">
                        <i class="align-middle me-1" data-lucide="sliders"></i>@Localizer["Configure push channels for this application"]
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@section scripts {
    <script>{
        const messages = JSON.parse(document.getElementById('alertcenter-localization')?.textContent || '{}');
        function setupCopy(buttonId, textSelector, isCodeTag = false) {
            const btn = document.getElementById(buttonId);
            if (!btn) return;
            btn.addEventListener('click', async function () {
                const el = document.querySelector(textSelector);
                if (!el) return;
                const text = isCodeTag ? el.innerText : el.textContent;
                try {
                    await navigator.clipboard.writeText(text);
                    const original = this.innerHTML;
                    this.innerHTML = '<i class="align-middle me-1" data-lucide="check"></i>';
                    this.appendChild(document.createTextNode(messages["Copied"] ?? "Copied"));
                    setTimeout(() => {

                        this.innerHTML = original;
                        if (window.lucide) lucide.createIcons({ nodes: [this] });
                    }, 2000);
                } catch {
                    // ignore
                }
            });
        }

        setupCopy('copy-content-btn', '#message-content-text');
        setupCopy('copy-json-btn', '#context-json-code', true);
        setupCopy('copy-report-id', '#report-id-val');
    }</script>
}
