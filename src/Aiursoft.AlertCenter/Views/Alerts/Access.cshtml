@model Aiursoft.AlertCenter.Models.ApplicationAccessViewModel

@section styles {
    <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" />
}

@{
    var accessCount = Model.UserAccesses.Count + Model.RoleAccesses.Count;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <div class="ac-stat-icon icon-primary" style="width: 36px; height: 36px;">
                <i data-lucide="shield-check" aria-hidden="true"></i>
            </div>
            <h1 class="h3 mb-0">@Localizer["Application Access Permissions"]</h1>
        </div>
        <p class="text-muted mb-0">@Model.Application.Name · @Localizer["Precisely control view and management permissions for team members and roles."]</p>
    </div>
    <a asp-action="Applications" class="btn btn-outline-secondary">
        <i class="align-middle me-1" data-lucide="arrow-left" aria-hidden="true"></i>@Localizer["Back to Connected Apps"]
    </a>
</div>

<div class="alert alert-info mb-4" role="alert">
    <div class="alert-icon">
        <i class="align-middle" data-lucide="info" aria-hidden="true"></i>
    </div>
    <div class="alert-message">
        <strong>@Localizer["System Administrators have full management permissions for all applications by default."]</strong>
        <div class="small mt-1">@Localizer["Role-based authorization automatically applies to all members of that role. If a user has both direct and role-based authorization, the system prioritizes the highest permission, which is 'Manageable'."]</div>
    </div>
</div>

<form asp-action="SaveAccess" method="post" data-action-feedback id="application-access-form">
    <input type="hidden" name="applicationId" value="@Model.Application.Id" />

    <!-- Add Permission Section -->
    <section class="card mb-4" aria-labelledby="add-access-heading">
        <div class="card-header">
            <h2 id="add-access-heading" class="card-title mb-0">
                <i class="align-middle me-2 text-primary" data-lucide="user-plus" aria-hidden="true"></i>@Localizer["Grant New Permissions"]
            </h2>
        </div>
        <div class="card-body pt-0">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-medium d-block">@Localizer["Authorization Type"]</label>
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="access-kind" id="access-role" value="role" checked />
                        <label class="btn btn-outline-primary" for="access-role">
                            <i class="align-middle me-1" data-lucide="users" aria-hidden="true"></i>@Localizer["Role group"]
                        </label>
                        <input type="radio" class="btn-check" name="access-kind" id="access-user" value="user" />
                        <label class="btn btn-outline-primary" for="access-user">
                            <i class="align-middle me-1" data-lucide="user" aria-hidden="true"></i>@Localizer["Specify User"]
                        </label>
                    </div>
                </div>

                <div class="col-md-5">
                    <label for="access-role-select" class="form-label small fw-medium" id="access-subject-label">@Localizer["Select Role"]</label>
                    <select id="access-role-select" class="form-select">
                        <option value="">@Localizer["Select role..."]</option>
                        @foreach (var role in Model.Roles)
                        {
                            <option value="@role.Value">@role.Text</option>
                        }
                    </select>
                    <select id="access-user-select" class="form-select d-none">
                        <option value="">@Localizer["Select user..."]</option>
                        @foreach (var user in Model.Users)
                        {
                            <option value="@user.Value">@user.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label for="access-level" class="form-label small fw-medium">@Localizer["Permission level"]</label>
                    <select id="access-level" class="form-select">
                        <option value="view">@Localizer["View only (View)"]</option>
                        <option value="manage">@Localizer["Manageable (Manage)"]</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="button" id="add-access" class="btn btn-primary w-100">
                        <i class="align-middle me-1" data-lucide="plus" aria-hidden="true"></i>@Localizer["Add authorization"]
                    </button>
                </div>
            </div>
            <p class="form-text text-muted mb-0 mt-3 small">
                <i class="align-middle me-1" data-lucide="shield"></i><strong>@Localizer["View only"]</strong>@Localizer[": Allows browsing alert messages, related incidents, and delivery records for this application;"]<strong>@Localizer["Manageable"]</strong>@Localizer[": Additionally allows modifying push bindings, resetting keys, and handling incidents."]
            </p>
        </div>
    </section>

    <!-- Granted Permissions List -->
    <section class="card" aria-labelledby="granted-heading">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 id="granted-heading" class="card-title mb-0">
                <i class="align-middle me-2 text-primary" data-lucide="shield" aria-hidden="true"></i>@Localizer["Permissions granted"]
            </h2>
            <span id="access-count" class="badge bg-secondary-subtle text-secondary border">@accessCount</span>
        </div>
        <div class="card-body pt-0">
            <div id="access-empty" class="ac-empty-state py-4 @(accessCount > 0 ? "d-none" : "")">
                <div class="ac-empty-icon" style="width: 48px; height: 48px;">
                    <i data-lucide="users" aria-hidden="true"></i>
                </div>
                <h3 class="h6 text-muted">@Localizer["No additional access permissions have been granted to regular users or roles yet"]</h3>
                <p class="text-muted small mb-0">@Localizer["Only system administrators can access this application."]</p>
            </div>

            <div id="access-list" class="list-group list-group-flush">
                @foreach (var access in Model.RoleAccesses)
                {
                    <div class="list-group-item d-flex align-items-center justify-content-between gap-3 px-0 py-3" data-kind="role" data-id="@access.RoleId">
                        <div class="d-flex align-items-center gap-3 min-w-0">
                            <div class="ac-stat-icon icon-primary" style="width: 40px; height: 40px;">
                                <i data-lucide="users" aria-hidden="true"></i>
                            </div>
                            <div class="text-truncate">
                                <strong class="d-block text-truncate">@access.Role.Name</strong>
                                <small class="text-muted">@Localizer["Role group · All members in the group automatically inherit permissions"]</small>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(access.CanManage ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border")">
                                @(access.CanManage ? @Localizer["Manageable"].Value : @Localizer["View only"].Value)
                            </span>
                            <input type="hidden" name="@(access.CanManage ? "manageRoleIds" : "viewRoleIds")" value="@access.RoleId" />
                            <button type="button" class="btn btn-sm btn-outline-danger remove-access" title="@Localizer["Remove permission"]">
                                <i class="align-middle" data-lucide="x" aria-hidden="true"></i>
                                <span class="visually-hidden">@Localizer["Remove "]@access.Role.Name</span>
                            </button>
                        </div>
                    </div>
                }

                @foreach (var access in Model.UserAccesses)
                {
                    <div class="list-group-item d-flex align-items-center justify-content-between gap-3 px-0 py-3" data-kind="user" data-id="@access.UserId">
                        <div class="d-flex align-items-center gap-3 min-w-0">
                            <div class="ac-stat-icon icon-indigo" style="width: 40px; height: 40px;">
                                <i data-lucide="user" aria-hidden="true"></i>
                            </div>
                            <div class="text-truncate">
                                <strong class="d-block text-truncate">@access.User.DisplayName</strong>
                                <small class="text-muted">@access.User.UserName · @Localizer["Specify Individual User"]</small>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(access.CanManage ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border")">
                                @(access.CanManage ? @Localizer["Manageable"].Value : @Localizer["View only"].Value)
                            </span>
                            <input type="hidden" name="@(access.CanManage ? "manageUserIds" : "viewUserIds")" value="@access.UserId" />
                            <button type="button" class="btn btn-sm btn-outline-danger remove-access" title="@Localizer["Remove permission"]">
                                <i class="align-middle" data-lucide="x" aria-hidden="true"></i>
                                <span class="visually-hidden">@Localizer["Remove "]@access.User.DisplayName</span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="card-footer bg-transparent d-flex justify-content-end gap-2">
            <a asp-action="Applications" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
            <button class="btn btn-primary" type="submit">
                <i class="align-middle me-1" data-lucide="save" aria-hidden="true"></i>@Localizer["Save permission changes"]
            </button>
        </div>
    </section>
</form>

@section scripts {
<script>{
    const messages = JSON.parse(document.getElementById('alertcenter-localization')?.textContent || '{}');

    document.addEventListener('DOMContentLoaded', () => {
        const roleType = document.getElementById('access-role');
        const userType = document.getElementById('access-user');
        const roleSelect = document.getElementById('access-role-select');
        const userSelect = document.getElementById('access-user-select');
        const subjectLabel = document.getElementById('access-subject-label');
        const level = document.getElementById('access-level');
        const list = document.getElementById('access-list');
        const empty = document.getElementById('access-empty');
        const count = document.getElementById('access-count');

        function selectedKind() { return roleType.checked ? 'role' : 'user'; }
        function updateSubject() {
            const isRole = selectedKind() === 'role';
            roleSelect.classList.toggle('d-none', !isRole);
            userSelect.classList.toggle('d-none', isRole);
            subjectLabel.textContent = isRole ? (messages["Select Role"] ?? "Select Role") : (messages["Select User"] ?? "Select User");
        }
        function updateEmpty() {
            const total = list.children.length;
            empty.classList.toggle('d-none', total > 0);
            count.textContent = total;
        }

        roleType.addEventListener('change', updateSubject);
        userType.addEventListener('change', updateSubject);

        document.getElementById('add-access').addEventListener('click', () => {
            const kind = selectedKind();
            const select = kind === 'role' ? roleSelect : userSelect;
            const option = select.options[select.selectedIndex];
            if (!option.value) {
                select.focus();
                return;
            }

            const existing = list.querySelector(`[data-kind="${kind}"][data-id="${CSS.escape(option.value)}"]`);
            if (existing) {
                existing.querySelector('.remove-access').click();
            }

            const manage = level.value === 'manage';
            const item = document.createElement('div');
            item.className = 'list-group-item d-flex align-items-center justify-content-between gap-3 px-0 py-3';
            item.dataset.kind = kind;
            item.dataset.id = option.value;

            const iconClass = kind === 'role' ? 'icon-primary' : 'icon-indigo';
            const iconName = kind === 'role' ? 'users' : 'user';
            const subtitle = kind === 'role' ? (messages["Role group · All members in the group automatically inherit permissions"] ?? "Role group · All members in the group automatically inherit permissions") : (messages["Specify Individual User"] ?? "Specify Individual User");
            const badgeClass = manage ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-secondary-subtle text-secondary border';
            const badgeText = manage ? (messages["Manageable"] ?? "Manageable") : (messages["View only"] ?? "View only");
            const fieldName = manage ? (kind === 'role' ? 'manageRoleIds' : 'manageUserIds') : (kind === 'role' ? 'viewRoleIds' : 'viewUserIds');

            item.innerHTML = `
                <div class="d-flex align-items-center gap-3 min-w-0">
                    <div class="ac-stat-icon ${iconClass}" style="width: 40px; height: 40px;">
                        <i data-lucide="${iconName}" aria-hidden="true"></i>
                    </div>
                    <div class="text-truncate">
                        <strong class="d-block text-truncate"></strong>
                        <small class="text-muted"></small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge ${badgeClass}"></span>
                    <input type="hidden" name="${fieldName}" value="" />
                    <button type="button" class="btn btn-sm btn-outline-danger remove-access" title="">
                        <i class="align-middle" data-lucide="x" aria-hidden="true"></i>
                        <span class="visually-hidden"></span>
                    </button>
                </div>`;

            item.querySelector('small').textContent = subtitle;
            item.querySelector('.badge').textContent = badgeText;
            item.querySelector('input').value = option.value;
            const removeButton = item.querySelector('.remove-access');
            removeButton.title = messages["Remove"] ?? "Remove";
            removeButton.querySelector('span').textContent = messages["Remove"] ?? "Remove";

            item.querySelector('strong').textContent = option.textContent;
            list.appendChild(item);
            select.value = '';

            if (window.lucide) {
                lucide.createIcons({ nodes: [item] });
            }
            updateEmpty();
        });

        list.addEventListener('click', event => {
            const button = event.target.closest('.remove-access');
            if (!button) return;
            button.closest('.list-group-item').remove();
            updateEmpty();
        });
    });

}</script>
}
