@model Aiursoft.AlertCenter.Models.PushViewModel
@using Aiursoft.AlertCenter.Models
@{
    ViewData["Title"] = string.Format(@Localizer["{0} - Push Routing Settings"].Value, Model.Application!.Name);
    var levels = new[]
    {
        (Field: nameof(ApplicationPushBindingsRequest.Sev0ChannelIds), Level: "sev0", Label: @Localizer["Critical (P0)"].Value, BadgeClass: "ac-badge-sev0", Selected: Model.Bindings.Sev0ChannelIds.ToHashSet()),
        (Field: nameof(ApplicationPushBindingsRequest.Sev1ChannelIds), Level: "sev1", Label: @Localizer["Major (P1)"].Value, BadgeClass: "ac-badge-sev1", Selected: Model.Bindings.Sev1ChannelIds.ToHashSet()),
        (Field: nameof(ApplicationPushBindingsRequest.Sev2ChannelIds), Level: "sev2", Label: @Localizer["Error (P2)"].Value, BadgeClass: "ac-badge-sev2", Selected: Model.Bindings.Sev2ChannelIds.ToHashSet()),
        (Field: nameof(ApplicationPushBindingsRequest.Sev3ChannelIds), Level: "sev3", Label: @Localizer["Warning (P3)"].Value, BadgeClass: "ac-badge-sev3", Selected: Model.Bindings.Sev3ChannelIds.ToHashSet()),
        (Field: nameof(ApplicationPushBindingsRequest.Sev4ChannelIds), Level: "sev4", Label: @Localizer["Info (P4)"].Value, BadgeClass: "ac-badge-sev4", Selected: Model.Bindings.Sev4ChannelIds.ToHashSet())
    };
}
@section styles {
    <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" />
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="ac-app-avatar" style="width: 44px; height: 44px; font-size: 1.1rem;">
            @(Model.Application.Name.Length > 0 ? Model.Application.Name[0].ToString().ToUpper() : "A")
        </div>
        <div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="h3 mb-0">@Localizer["Application Push Routing"]</h1>
                <span class="badge bg-secondary-subtle text-secondary font-monospace small">@Model.Application.Name</span>
            </div>
            <p class="text-muted mb-0 small">@Localizer["Precisely match receiving channels by incident level · Matrix Routing Engine"]</p>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Applications" asp-action="Applications" class="btn btn-outline-secondary">
            <i class="align-middle me-1" data-lucide="arrow-left" aria-hidden="true"></i>@Localizer["Back to Connected Apps"]
        </a>
    </div>
</div>

@if (Model.Application.OnCallGroup is { } group)
{
    <section class="card border-primary mb-4" aria-labelledby="oncall-mail-heading">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 id="oncall-mail-heading" class="card-title mb-0">@Localizer["Built-in On-call Email"]</h2>
            <span class="badge bg-primary">@Localizer["Auto-enabled · Cannot be disabled individually"]</span>
        </div>
        <div class="card-body">
            <p>@Localizer["On-call group:"]<a asp-controller="OnCall" asp-action="GroupDetails" asp-route-id="@group.Id">@group.Name</a></p>
            <p class="mb-1"><strong>To：</strong>@Localizer["System registered email addresses of all on-duty engineers (OCE) at the time of notification;"]<strong>CC：</strong>@Localizer["CC addresses configured for the on-call group."]</p>
            <p class="small text-muted mb-0">@Localizer["Applies to sev0–sev4; no channel selection required. The channels below provide independent supplementary notifications for each new incident."]</p>
        </div>
    </section>
}

<form asp-action="SaveBindings" method="post" data-action-feedback>
    <input type="hidden" name="id" value="@Model.Application.Id" />

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">
            <div>
                <h2 class="card-title h5 mb-0">@Localizer["Custom channel-to-severity match matrix"]</h2>
                <small id="binding-hint" class="text-muted">@Localizer["Multiple supplementary channels can be selected per level; unchecked items only indicate no custom notifications will be sent, without affecting built-in on-call emails. Strict exact matching is applied, with no automatic expansion to higher or lower levels."]</small>
            </div>
            <span class="badge bg-light text-dark border">@Localizer["Total "]@Model.Channels.Count @Localizer["available channels"]</span>
        </div>

        <div class="card-body p-0">
            @if (Model.Channels.Count == 0)
            {
                <div class="ac-empty-state">
                    <div class="ac-empty-icon">
                        <i data-lucide="send" aria-hidden="true"></i>
                    </div>
                    <h3 class="h5 mb-2">@Localizer["No push channels configured yet"]</h3>
                    <p class="text-muted mb-4" style="max-width: 24rem; margin-inline: auto;">
                        @Localizer["You can create Webhook, email, or in-app notification channels as needed for supplementation. Applications bound to on-call groups will send built-in on-call emails even without custom channels."]
                    </p>
                    <p class="text-muted mb-0">@Localizer["Please contact the push channel administrator to grant channel binding permissions."]</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 ac-matrix-table" aria-describedby="binding-hint">
                        <thead>
                            <tr class="table-light">
                                <th scope="col" class="ps-4 py-3" style="min-width: 240px;">
                                    <span class="text-uppercase text-muted small fw-semibold">@Localizer["Push Channel and Type"]</span>
                                </th>
                                @foreach (var level in levels)
                                {
                                    <th scope="col" class="text-center py-3" style="min-width: 140px;">
                                        <div class="d-inline-flex flex-column align-items-center">
                                            <span class="badge @level.BadgeClass px-3 py-1 mb-1 font-monospace">@level.Level</span>
                                            <span class="small text-muted fw-semibold">@level.Label</span>
                                        </div>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var channel in Model.Channels)
                            {
                                var type = Model.ChannelTypes.FirstOrDefault(item => item.Key == channel.Type);
                                var icon = channel.Type switch
                                {
                                    "webhook" => "webhook",
                                    "email" => "mail",
                                    "inapp" => "bell",
                                    _ => "send"
                                };
                                <tr>
                                    <th scope="row" class="ps-4 py-3 fw-normal">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-3 p-2 bg-light border text-primary">
                                                <i data-lucide="@icon" style="width: 20px; height: 20px;" aria-hidden="true"></i>
                                            </div>
                                            <div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <strong class="text-break">@channel.Name</strong>
                                                    @if (channel.IsEnabled)
                                                    {
                                                        <span class="ac-status-dot dot-success" title="@Localizer["Enabled"]"></span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle small py-0">@Localizer["Disabled"]</span>
                                                    }
                                                </div>
                                                <small class="text-muted">
                                                    @(type?.Name ?? channel.Type)
                                                    @if (!channel.IsEnabled)
                                                    {
                                                        <span class="text-danger-subtle">@Localizer["· Disabled, not dispatching"]</span>
                                                    }
                                                </small>
                                            </div>
                                        </div>
                                    </th>
                                    @foreach (var level in levels)
                                    {
                                        var isChecked = level.Selected.Contains(channel.Id);
                                        <td class="text-center ac-matrix-cell py-3">
                                            <label class="d-flex align-items-center justify-content-center p-2 rounded cursor-pointer" for="channel-@channel.Id-@level.Level">
                                                <input type="checkbox"
                                                       class="form-check-input ac-matrix-check m-0"
                                                       id="channel-@channel.Id-@level.Level"
                                                       name="@level.Field"
                                                       value="@channel.Id"
                                                       checked="@isChecked" />
                                                <span class="visually-hidden">@channel.Name · @level.Level @level.Label</span>
                                            </label>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card-footer bg-light p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2 text-muted small">
                        <i data-lucide="info" class="text-primary" style="width: 18px; height: 18px;" aria-hidden="true"></i>
                        <span>@Localizer["Applies only to new incidents after saving. If a channel is disabled, routing is retained but new incidents will be skipped."]</span>
                    </div>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="align-middle me-1" data-lucide="save" aria-hidden="true"></i>@Localizer["Save routing configuration"]
                    </button>
                </div>
            }
        </div>
    </div>
</form>
