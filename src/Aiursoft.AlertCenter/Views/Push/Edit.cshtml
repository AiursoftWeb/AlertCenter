@model Aiursoft.AlertCenter.Models.PushChannelEditViewModel

@section styles {
    <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" />
}

@{
    var selectedType = Model.ChannelTypes.FirstOrDefault(type => type.Key == Model.Type);
    var bindingAccessCount = Model.SelectedBindingUsers.Count + Model.SelectedBindingRoles.Count;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">@(Model.Id.HasValue ? @Localizer["Edit push channel"].Value : @Localizer["Add push channel"].Value)</h1>
        <p class="text-muted mb-0">@(Model.Id.HasValue ? string.Format(@Localizer["Modifying delivery parameters for channel \"{0}\"."].Value, Model.Name) : @Localizer["Select a notification channel type and configure the recipient address or target recipients."].Value)</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="align-middle me-1" data-lucide="arrow-left" aria-hidden="true"></i>@Localizer["Back to Channel List"]
    </a>
</div>

@if (!Model.Id.HasValue)
{
    <h2 class="h5 mb-3 fw-semibold">@Localizer["1. Select channel type"]</h2>
    <div class="row g-3 mb-4">
    @foreach (var type in Model.ChannelTypes)
    {
        var isSelected = Model.Type == type.Key;
        var iconClass = type.Key switch
        {
            "webhook" => "icon-success",
            "email" => "icon-warning",
            "inapp" => "icon-primary",
            _ => "icon-indigo"
        };
        <div class="col-md-6 col-xl-4 d-flex">
            <a asp-action="Create" asp-route-type="@type.Key" class="card ac-channel-card flex-fill text-decoration-none @(isSelected ? "selected" : "")" aria-current="@(isSelected ? "true" : "false")">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="ac-stat-icon @iconClass">
                            <i data-lucide="@type.Icon" aria-hidden="true"></i>
                        </div>
                        <div>
                            <h3 class="h5 mb-0 fw-semibold text-body">@type.Name</h3>
                            <span class="badge bg-secondary-subtle text-secondary font-monospace small">@type.Key</span>
                        </div>
                    </div>
                    <p class="text-muted small mb-0" style="line-height: 1.5;">@type.Description</p>
                </div>
            </a>
        </div>
    }
    </div>
}

@if (selectedType != null)
{
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="align-middle text-primary" data-lucide="@selectedType.Icon" aria-hidden="true"></i>
                    <h2 class="card-title mb-0">@selectedType.Name @Localizer["Configuration details"]</h2>
                </div>
                <div class="card-body pt-0">
                    <form asp-action="Save" method="post" data-action-feedback id="push-channel-form">
                        <input asp-for="Id" type="hidden" />
                        <input asp-for="Type" type="hidden" />
                        <div class="alert alert-danger small mb-3 @(ViewData.ModelState.IsValid ? "d-none" : "")" role="alert">
                            <div asp-validation-summary="All" class="alert-message"></div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label small fw-medium">@Localizer["Channel name"]</label>
                            <input asp-for="Name" required maxlength="100" class="form-control" placeholder="@Localizer["Example: Production on-call team, Feishu alert bot, Ops Webhook…"]" />
                            <div class="form-text text-muted small">@Localizer["Used to quickly identify application push levels and records."]</div>
                        </div>

                        @if (selectedType.RequiresEndpoint)
                        {
                            <div class="mb-4">
                                <label asp-for="Endpoint" class="form-label small fw-medium">@Localizer["Webhook Receiver URL"]</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent text-muted"><i data-lucide="link" class="align-middle"></i></span>
                                    <input asp-for="Endpoint" type="url" required maxlength="2048" class="form-control" placeholder="https://example.com/api/alert-webhook" aria-describedby="endpoint-hint" />
                                </div>
                                <small class="text-muted d-block mt-2" id="endpoint-hint">@Localizer["The receiver must support HTTP POST JSON. A 2xx response is considered a successful delivery. The system request timeout is 10 seconds, and cross-origin redirects are not followed."]</small>
                            </div>

                            <div class="card border bg-body-tertiary mb-4">
                                <div class="card-header bg-transparent py-2">
                                    <h3 class="h6 mb-0 text-muted"><i class="align-middle me-1" data-lucide="file-json"></i>@Localizer["Default request format description"]</h3>
                                </div>
                                <div class="card-body py-2">
                                    <dl class="row small mb-2">
                                        <dt class="col-sm-3">Method</dt>
                                        <dd class="col-sm-9"><code>POST</code></dd>
                                        <dt class="col-sm-3">Headers</dt>
                                        <dd class="col-sm-9 mb-0"><code>Content-Type: application/json</code><br /><code>Idempotency-Key: &lt;deliveryId&gt;</code></dd>
                                    </dl>
                                    <div class="ac-code-container mb-2">
                                        <pre class="ac-code-pre py-2 small"><code>{
  "deliveryId": "&lt;GUID&gt;",
  "messageId": "&lt;GUID or null&gt;",
  "title": "Alert title",
  "content": "Alert body or null",
  "level": "sev0 | sev1 | sev2 | sev3 | sev4",
  "occurredAtUtc": "2026-09-17T08:30:00.0000000Z",
  "context": { ... }
}</code></pre>
                                    </div>
                                    <p class="small text-muted mb-0">@Localizer["Each delivery task has a unique fixed"] <code>deliveryId</code>@Localizer[", can be used on the receiving end with"] <code>Idempotency-Key</code> @Localizer["Idempotent deduplication."]</p>
                                </div>
                            </div>

                            <details class="card border mb-4">
                                <summary class="card-header bg-transparent py-2" style="cursor: pointer;">
                                    <span class="h6 mb-0 fw-semibold text-primary"><i class="align-middle me-1" data-lucide="settings-2"></i>@Localizer["Advanced Custom Request (Custom headers and templates)"]</span>
                                </summary>
                                <div class="card-body">
                                    <p class="text-muted small">@Localizer["If left blank, the system sends standard JSON by default. Custom headers are encrypted and persisted;"]<code>Content-Type</code> @Localizer["and"] <code>Idempotency-Key</code> @Localizer["Cannot overwrite."]</p>

                                    <div class="mb-3">
                                        <label asp-for="WebhookHeadersJson" class="form-label small fw-medium">@Localizer["Extra Request Headers (JSON object)"]</label>
                                        <textarea asp-for="WebhookHeadersJson" class="form-control font-monospace" rows="3" maxlength="8000" spellcheck="false" placeholder="{&#10;  &quot;Authorization&quot;: &quot;Bearer &lt;token&gt;&quot;,&#10;  &quot;X-Custom-Header&quot;: &quot;alert-center&quot;&#10;}"></textarea>
                                        <small class="text-muted">@Localizer["Header name max 128 characters; value must be a valid string."]</small>
                                    </div>

                                    <div>
                                        <label asp-for="WebhookPayloadTemplate" class="form-label small fw-medium">@Localizer["Request Body Template (JSON Template)"]</label>
                                        <div class="d-flex flex-wrap gap-1 mb-2">
                                            <span class="small text-muted align-self-center me-1">@Localizer["Click to insert placeholder:"]</span>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1 font-monospace" data-insert-placeholder="{{title}}">{{title}}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1 font-monospace" data-insert-placeholder="{{level}}">{{level}}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1 font-monospace" data-insert-placeholder="{{content}}">{{content}}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1 font-monospace" data-insert-placeholder="{{context}}">{{context}}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1 font-monospace" data-insert-placeholder="{{deliveryId}}">{{deliveryId}}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1 font-monospace" data-insert-placeholder="{{occurredAtUtc}}">{{occurredAtUtc}}</button>
                                        </div>
                                        <textarea asp-for="WebhookPayloadTemplate" id="webhook-payload-template" class="form-control font-monospace" rows="8" maxlength="16000" spellcheck="false" placeholder="{&#10;  &quot;msgtype&quot;: &quot;text&quot;,&#10;  &quot;text&quot;: {&#10;    &quot;content&quot;: &quot;[{{level}}] {{title}}\n{{content}}&quot;&#10;  }&#10;}"></textarea>
                                        <small class="text-muted d-block mt-2">@Localizer["Placeholders must be the sole value of a JSON string."]<code>{{context}}</code> @Localizer["Will parse and preserve the original object types."]</small>
                                    </div>
                                </div>
                            </details>
                        }
                        else if (Model.Type == "email")
                        {
                            <div class="alert alert-info small mb-3" role="alert">
                                <div class="alert-icon">
                                    <i class="align-middle" data-lucide="info" aria-hidden="true"></i>
                                </div>
                                <div class="alert-message text-break">
                                    <strong>@Localizer["Global SMTP mail service"]</strong>@Localizer[": The system uniformly uses the global Email service configuration. Please use"] <code>Email__Password</code> @Localizer["Environment variables provide authentication credentials."]
                                </div>
                            </div>
                            <div class="mb-4">
                                <label asp-for="EmailRecipient" class="form-label small fw-medium">@Localizer["Recipient email"]</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent text-muted"><i data-lucide="mail" class="align-middle" aria-hidden="true"></i></span>
                                    <input asp-for="EmailRecipient" type="email" required maxlength="320" class="form-control font-monospace" placeholder="oncall-team@example.com" aria-describedby="email-recipient-hint" />
                                </div>
                                <small class="text-muted d-block mt-2" id="email-recipient-hint">@Localizer["Emails will be sent directly to this email address."]</small>
                            </div>

                            <div class="card border mb-4" aria-labelledby="email-cc-heading">
                                <div class="card-header bg-transparent py-2">
                                    <h3 id="email-cc-heading" class="h6 mb-0 fw-semibold"><i class="align-middle me-1 text-primary" data-lucide="users-round" aria-hidden="true"></i>@Localizer["CC List"]</h3>
                                </div>
                                <div class="card-body">
                                    <label asp-for="EmailCcRecipients" class="form-label small fw-medium">@Localizer["Batch enter CC emails"]</label>
                                    <textarea asp-for="EmailCcRecipients" id="email-cc-input" class="form-control font-monospace" rows="4" maxlength="8000" spellcheck="false" placeholder="manager@example.com&#10;incident-team@example.com" aria-describedby="email-cc-hint"></textarea>
                                    <small class="text-muted d-block mt-2" id="email-cc-hint">@Localizer["One email address per line; English commas or semicolons are also supported, up to 50 CC recipients."]</small>
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" id="parse-email-cc">
                                            <i class="align-middle me-1" data-lucide="list-checks" aria-hidden="true"></i>@Localizer["Parse as list"]
                                        </button>
                                        <div class="input-group input-group-sm" style="max-width: 22rem;">
                                            <input id="add-email-cc" type="email" maxlength="320" class="form-control font-monospace" placeholder="@Localizer["Add an email address"]" aria-label="@Localizer["Add a CC email address"]" />
                                            <button type="button" class="btn btn-primary" id="add-email-cc-button"><i class="align-middle me-1" data-lucide="plus" aria-hidden="true"></i>@Localizer["Add"]</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body border-top pt-3">
                                    <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                                        <span class="small fw-medium">@Localizer["Parsed CC recipients"]</span>
                                        <span id="email-cc-count" class="badge bg-secondary-subtle text-secondary border">0</span>
                                    </div>
                                    <p id="email-cc-empty" class="text-muted small mb-0">@Localizer["No CC recipients added yet."]</p>
                                    <div id="email-cc-list" class="d-flex flex-wrap gap-2" aria-live="polite"></div>
                                    <span asp-validation-for="EmailCcRecipients" class="text-danger small d-block mt-2"></span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info small mb-3" role="alert">
                                <div class="alert-icon">
                                    <i class="align-middle" data-lucide="info" aria-hidden="true"></i>
                                </div>
                                <div class="alert-message">
                                    <strong>@Localizer["In-app notification scope"]</strong>@Localizer[": Supports binding multiple users and user groups (roles) simultaneously. The system automatically deduplicates, ensuring each member receives only one unread notification."]
                                </div>
                            </div>
                        }

                        @if (Model.Type == "inapp")
                        {
                            <div class="card border mb-4">
                                <div class="card-header bg-transparent py-2">
                                    <h3 class="h6 mb-0 fw-semibold"><i class="align-middle me-1 text-primary" data-lucide="user-plus"></i>@Localizer["Add recipients and user groups"]</h3>
                                </div>
                                <div class="card-body">
                                    <div class="btn-group w-100 mb-3" role="group" aria-label="@Localizer["Recipient Type"]">
                                        <input type="radio" class="btn-check" name="recipientType" id="recipient-type-role" value="role" checked />
                                        <label class="btn btn-outline-primary" for="recipient-type-role">
                                            <i class="align-middle me-1" data-lucide="users" aria-hidden="true"></i>@Localizer["User Group (Role)"]
                                        </label>
                                        <input type="radio" class="btn-check" name="recipientType" id="recipient-type-user" value="user" />
                                        <label class="btn btn-outline-primary" for="recipient-type-user">
                                            <i class="align-middle me-1" data-lucide="user" aria-hidden="true"></i>@Localizer["Specify User (User)"]
                                        </label>
                                    </div>

                                    <div id="recipient-role-selection">
                                        <label for="recipient-role-select" class="form-label small fw-medium">@Localizer["Select User Group"]</label>
                                        <div class="input-group">
                                            <select id="recipient-role-select" class="form-select">
                                                <option value="">@Localizer["Select user group..."]</option>
                                                @foreach (var role in Model.AvailableRoles)
                                                {
                                                    <option value="@role.Value">@role.Text</option>
                                                }
                                            </select>
                                            <button type="button" class="btn btn-primary" id="add-role-recipient">
                                                <i class="align-middle me-1" data-lucide="plus" aria-hidden="true"></i>@Localizer["Add"]
                                            </button>
                                        </div>
                                    </div>

                                    <div id="recipient-user-selection" class="d-none">
                                        <label for="recipient-user-search" class="form-label small fw-medium">@Localizer["Search Users"]</label>
                                        <div class="position-relative">
                                            <div class="input-group">
                                                <span class="input-group-text bg-transparent text-muted"><i data-lucide="search" class="align-middle"></i></span>
                                                <input id="recipient-user-search" data-search-url="@Url.Action("SearchRecipients", "Push")" type="search" class="form-control" placeholder="@Localizer["Search by username or display name..."]" autocomplete="off" aria-autocomplete="list" aria-controls="recipient-user-results" />
                                                <button type="button" class="btn btn-primary" id="add-user-recipient" disabled>
                                                    <i class="align-middle me-1" data-lucide="plus" aria-hidden="true"></i>@Localizer["Add"]
                                                </button>
                                            </div>
                                            <div id="recipient-user-results" class="position-absolute w-100 bg-white border rounded shadow-sm d-none" role="listbox" style="z-index: 1000; max-height: 280px; overflow-y: auto;"></div>
                                        </div>
                                        <div id="selected-user-preview" class="card border-primary-subtle mt-3 d-none">
                                            <div class="card-body d-flex align-items-center gap-3 py-2">
                                                <span id="selected-user-avatar" class="d-inline-flex align-items-center justify-content-center flex-shrink-0 rounded-circle bg-primary-subtle text-primary fw-semibold" style="width: 36px; height: 36px;"></span>
                                                <div class="flex-grow-1 min-w-0">
                                                    <strong id="selected-user-name" class="d-block text-truncate small"></strong>
                                                    <small id="selected-user-username" class="d-block text-muted text-truncate"></small>
                                                    <small id="selected-user-id" class="d-none"></small>
                                                </div>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle flex-shrink-0">@Localizer["To be added"]</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="card border mb-4">
                                <div class="card-header bg-transparent d-flex align-items-center justify-content-between py-2">
                                    <h3 class="h6 mb-0 fw-semibold"><i class="align-middle me-1 text-primary" data-lucide="users"></i>@Localizer["Selected recipient list"]</h3>
                                    <span class="text-muted small">@Localizer["Click the button on the right to remove"]</span>
                                </div>
                                <div class="card-body pt-2">
                                    <p id="recipients-empty" class="text-muted mb-0 py-3 text-center @(Model.SelectedUsers.Count + Model.SelectedRoles.Count > 0 ? "d-none" : "")">
                                        @Localizer["No recipients added yet. Please select role groups or specify users above."]
                                    </p>
                                    <div id="recipient-list" class="list-group list-group-flush">
                                        @foreach (var user in Model.SelectedUsers)
                                        {
                                            <div class="list-group-item d-flex align-items-center justify-content-between gap-3 px-0 py-2" data-recipient-kind="user">
                                                <div class="d-flex align-items-center gap-2 min-w-0">
                                                    <div class="ac-stat-icon icon-indigo" style="width: 32px; height: 32px; font-size: 1rem;">
                                                        <i data-lucide="user" aria-hidden="true"></i>
                                                    </div>
                                                    <div class="text-truncate">
                                                        <strong class="d-block text-truncate small">@user.Name</strong>
                                                        <small class="text-muted font-monospace">@user.UserName</small>
                                                    </div>
                                                </div>
                                                <input type="hidden" name="RecipientUserIds" value="@user.Id" />
                                                <button type="button" class="btn btn-sm btn-outline-danger remove-recipient" title="@(string.Format(@Localizer["Remove {0}"].Value, user.Name))">
                                                    <i class="align-middle" data-lucide="x" aria-hidden="true"></i>
                                                    <span class="visually-hidden">@Localizer["Remove "]@user.Name</span>
                                                </button>
                                            </div>
                                        }
                                        @foreach (var role in Model.SelectedRoles)
                                        {
                                            <div class="list-group-item d-flex align-items-center justify-content-between gap-3 px-0 py-2" data-recipient-kind="role">
                                                <div class="d-flex align-items-center gap-2 min-w-0">
                                                    <div class="ac-stat-icon icon-primary" style="width: 32px; height: 32px; font-size: 1rem;">
                                                        <i data-lucide="users" aria-hidden="true"></i>
                                                    </div>
                                                    <div class="text-truncate">
                                                        <strong class="text-truncate small">@role.Name</strong>
                                                        <small class="text-muted d-block">@Localizer["Role group"]</small>
                                                    </div>
                                                </div>
                                                <input type="hidden" name="RecipientRoleIds" value="@role.Id" />
                                                <button type="button" class="btn btn-sm btn-outline-danger remove-recipient" title="@(string.Format(@Localizer["Remove {0}"].Value, role.Name))">
                                                    <i class="align-middle" data-lucide="x" aria-hidden="true"></i>
                                                    <span class="visually-hidden">@Localizer["Remove "]@role.Name</span>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                    <small class="text-muted d-block mt-2">@Localizer["Add at least one user or user group; no notifications are sent if a group has no members."]</small>
                                </div>
                            </div>
                        }

                        <section class="card border mb-4" aria-labelledby="binding-access-heading">
                            <div class="card-header bg-transparent d-flex align-items-center justify-content-between py-2">
                                <h3 id="binding-access-heading" class="h6 mb-0 fw-semibold"><i class="align-middle me-1 text-primary" data-lucide="link"></i>@Localizer["Application Binding Authorization"]</h3>
                                <span id="binding-access-count" class="badge bg-secondary-subtle text-secondary border">@bindingAccessCount</span>
                            </div>
                            <div class="card-body">
                                <p class="text-muted small">@Localizer["Only the following users or user group members can view and bind this channel in their managed applications. This permission does not grant access to recipients, Webhooks, or test configuration."]</p>
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-3">
                                        <label class="form-label small fw-medium d-block">@Localizer["Authorization Type"]</label>
                                        <div class="btn-group w-100" role="group">
                                            <input type="radio" class="btn-check" name="binding-access-kind" id="binding-access-role" value="role" checked />
                                            <label class="btn btn-outline-primary" for="binding-access-role"><i class="align-middle me-1" data-lucide="users" aria-hidden="true"></i>@Localizer["User Group"]</label>
                                            <input type="radio" class="btn-check" name="binding-access-kind" id="binding-access-user" value="user" />
                                            <label class="btn btn-outline-primary" for="binding-access-user"><i class="align-middle me-1" data-lucide="user" aria-hidden="true"></i>@Localizer["Specify User"]</label>
                                        </div>
                                    </div>
                                    <div class="col-md-7">
                                        <label for="binding-access-role-select" class="form-label small fw-medium" id="binding-access-subject-label">@Localizer["Select User Group"]</label>
                                        <select id="binding-access-role-select" class="form-select">
                                            <option value="">@Localizer["Select user group..."]</option>
                                            @foreach (var role in Model.AvailableRoles)
                                            {
                                                <option value="@role.Value">@role.Text</option>
                                            }
                                        </select>
                                        <select id="binding-access-user-select" class="form-select d-none">
                                            <option value="">@Localizer["Select user..."]</option>
                                            @foreach (var user in Model.AvailableUsers)
                                            {
                                                <option value="@user.Value">@user.Text</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" id="add-binding-access" class="btn btn-primary w-100"><i class="align-middle me-1" data-lucide="plus" aria-hidden="true"></i>@Localizer["Add"]</button>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body border-top pt-0">
                                <div id="binding-access-empty" class="ac-empty-state py-4 @(bindingAccessCount > 0 ? "d-none" : "")">
                                    <div class="ac-empty-icon" style="width: 48px; height: 48px;"><i data-lucide="link" aria-hidden="true"></i></div>
                                    <h4 class="h6 text-muted">@Localizer["Application binding permissions have not been granted yet"]</h4>
                                    <p class="text-muted small mb-0">@Localizer["Aside from push channel administrators, no users can currently bind this channel."]</p>
                                </div>
                                <div id="binding-access-list" class="list-group list-group-flush">
                                    @foreach (var role in Model.SelectedBindingRoles)
                                    {
                                        <div class="list-group-item d-flex align-items-center justify-content-between gap-3 px-0 py-3" data-kind="role" data-id="@role.Id">
                                            <div class="d-flex align-items-center gap-3 min-w-0">
                                                <div class="ac-stat-icon icon-primary" style="width: 40px; height: 40px;"><i data-lucide="users" aria-hidden="true"></i></div>
                                                <div class="text-truncate"><strong class="d-block text-truncate">@role.Name</strong><small class="text-muted">@Localizer["User Group · Members dynamically inherit bound permissions"]</small></div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2"><input type="hidden" name="BindingRoleIds" value="@role.Id" /><button type="button" class="btn btn-sm btn-outline-danger remove-binding-access" title="@Localizer["Remove permission"]"><i class="align-middle" data-lucide="x" aria-hidden="true"></i><span class="visually-hidden">@Localizer["Remove "]@role.Name</span></button></div>
                                        </div>
                                    }
                                    @foreach (var user in Model.SelectedBindingUsers)
                                    {
                                        <div class="list-group-item d-flex align-items-center justify-content-between gap-3 px-0 py-3" data-kind="user" data-id="@user.Id">
                                            <div class="d-flex align-items-center gap-3 min-w-0">
                                                <div class="ac-stat-icon icon-indigo" style="width: 40px; height: 40px;"><i data-lucide="user" aria-hidden="true"></i></div>
                                                <div class="text-truncate"><strong class="d-block text-truncate">@user.Name</strong><small class="text-muted">@user.UserName · @Localizer["Specify Individual User"]</small></div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2"><input type="hidden" name="BindingUserIds" value="@user.Id" /><button type="button" class="btn btn-sm btn-outline-danger remove-binding-access" title="@Localizer["Remove permission"]"><i class="align-middle" data-lucide="x" aria-hidden="true"></i><span class="visually-hidden">@Localizer["Remove "]@user.Name</span></button></div>
                                        </div>
                                    }
                                </div>
                                <span asp-validation-for="BindingUserIds" class="text-danger small"></span>
                                <span asp-validation-for="BindingRoleIds" class="text-danger small"></span>
                            </div>
                        </section>

                        <div class="form-check form-switch mb-4">
                            <input asp-for="IsEnabled" class="form-check-input" />
                            <label asp-for="IsEnabled" class="form-check-label fw-medium">@Localizer["Enable this push channel now"]</label>
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" type="submit">
                                <i class="align-middle me-1" data-lucide="save"></i>@Localizer["Save channel configuration"]
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section scripts {
    <script src="~/scripts/push-edit.js" asp-append-version="true" defer></script>
}
