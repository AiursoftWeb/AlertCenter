@model Aiursoft.AlertCenter.Models.PushChannelEditViewModel

@section styles {
    <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" />
}

@{
    var selectedType = Model.ChannelTypes.FirstOrDefault(type => type.Key == Model.Type);
    var bindingAccessCount = Model.SelectedBindingUsers.Count + Model.SelectedBindingRoles.Count;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">@(Model.Id.HasValue ? "编辑推送渠道" : "添加推送渠道")</h1>
        <p class="text-muted mb-0">@(Model.Id.HasValue ? $"正在修改渠道“{Model.Name}”的投递参数。" : "选择一种通知渠道类型，并配置接收端地址或目标收件人。")</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="align-middle me-1" data-lucide="arrow-left" aria-hidden="true"></i>返回渠道列表
    </a>
</div>

@if (!Model.Id.HasValue)
{
    <h2 class="h5 mb-3 fw-semibold">1. 选择渠道类型</h2>
    <div class="row g-3 mb-4">
    @foreach (var type in Model.ChannelTypes)
    {
        var isSelected = Model.Type == type.Key;
        var iconClass = type.Key switch
        {
            "webhook" => "icon-success",
            "email" => "icon-warning",
            "inapp" => "icon-primary",
            _ => "icon-indigo"
        };
        <div class="col-md-6 col-xl-4 d-flex">
            <a asp-action="Create" asp-route-type="@type.Key" class="card ac-channel-card flex-fill text-decoration-none @(isSelected ? "selected" : "")" aria-current="@(isSelected ? "true" : "false")">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="ac-stat-icon @iconClass">
                            <i data-lucide="@type.Icon" aria-hidden="true"></i>
                        </div>
                        <div>
                            <h3 class="h5 mb-0 fw-semibold text-body">@type.Name</h3>
                            <span class="badge bg-secondary-subtle text-secondary font-monospace small">@type.Key</span>
                        </div>
                    </div>
                    <p class="text-muted small mb-0" style="line-height: 1.5;">@type.Description</p>
                </div>
            </a>
        </div>
    }
    </div>
}

@if (selectedType != null)
{
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="align-middle text-primary" data-lucide="@selectedType.Icon" aria-hidden="true"></i>
                    <h2 class="card-title mb-0">@selectedType.Name 配置详情</h2>
                </div>
                <div class="card-body pt-0">
                    <form asp-action="Save" method="post" data-action-feedback id="push-channel-form">
                        <input asp-for="Id" type="hidden" />
                        <input asp-for="Type" type="hidden" />
                        <div asp-validation-summary="All" class="alert alert-danger py-2 px-3 small mb-3 @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label small fw-medium">渠道名称</label>
                            <input asp-for="Name" required maxlength="100" class="form-control" placeholder="例如：生产值班组、飞书告警机器人、Ops Webhook…" />
                            <div class="form-text text-muted small">用于在应用推送分级和记录中快速辨识。</div>
                        </div>

                        @if (selectedType.RequiresEndpoint)
                        {
                            <div class="mb-4">
                                <label asp-for="Endpoint" class="form-label small fw-medium">Webhook 接收地址 (URL)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent text-muted"><i data-lucide="link" class="align-middle"></i></span>
                                    <input asp-for="Endpoint" type="url" required maxlength="2048" class="form-control" placeholder="https://example.com/api/alert-webhook" aria-describedby="endpoint-hint" />
                                </div>
                                <small class="text-muted d-block mt-2" id="endpoint-hint">接收端需支持 HTTP POST JSON，返回 2xx 视为投递成功。系统请求超时为 10 秒，不跟随跨域重定向。</small>
                            </div>

                            <div class="card border bg-body-tertiary mb-4">
                                <div class="card-header bg-transparent py-2">
                                    <h3 class="h6 mb-0 text-muted"><i class="align-middle me-1" data-lucide="file-json"></i>默认请求格式说明</h3>
                                </div>
                                <div class="card-body py-2">
                                    <dl class="row small mb-2">
                                        <dt class="col-sm-3">Method</dt>
                                        <dd class="col-sm-9"><code>POST</code></dd>
                                        <dt class="col-sm-3">Headers</dt>
                                        <dd class="col-sm-9 mb-0"><code>Content-Type: application/json</code><br /><code>Idempotency-Key: &lt;deliveryId&gt;</code></dd>
                                    </dl>
                                    <div class="ac-code-container mb-2">
                                        <pre class="ac-code-pre py-2 small"><code>{
  "deliveryId": "&lt;GUID&gt;",
  "messageId": "&lt;GUID 或 null&gt;",
  "title": "告警标题",
  "content": "告警正文或 null",
  "level": "sev0 | sev1 | sev2 | sev3 | sev4",
  "occurredAtUtc": "2026-09-17T08:30:00.0000000Z",
  "context": { ... }
}</code></pre>
                                    </div>
                                    <p class="small text-muted mb-0">每次投递任务拥有唯一固定 <code>deliveryId</code>，可在接收端使用 <code>Idempotency-Key</code> 幂等去重。</p>
                                </div>
                            </div>

                            <details class="card border mb-4">
                                <summary class="card-header bg-transparent py-2" style="cursor: pointer;">
                                    <span class="h6 mb-0 fw-semibold text-primary"><i class="align-middle me-1" data-lucide="settings-2"></i>高级自定义请求（自定义请求头与模板）</span>
                                </summary>
                                <div class="card-body">
                                    <p class="text-muted small">留空时系统默认发送标准 JSON。自定义请求头将加密持久化；<code>Content-Type</code> 与 <code>Idempotency-Key</code> 不可覆盖。</p>
                                    
                                    <div class="mb-3">
                                        <label asp-for="WebhookHeadersJson" class="form-label small fw-medium">额外请求头 (JSON 对象)</label>
                                        <textarea asp-for="WebhookHeadersJson" class="form-control font-monospace" rows="3" maxlength="8000" spellcheck="false" placeholder="{&#10;  &quot;Authorization&quot;: &quot;Bearer &lt;token&gt;&quot;,&#10;  &quot;X-Custom-Header&quot;: &quot;alert-center&quot;&#10;}"></textarea>
                                        <small class="text-muted">请求头名称最长 128 字符，值须为合法字符串。</small>
                                    </div>

                                    <div>
                                        <label asp-for="WebhookPayloadTemplate" class="form-label small fw-medium">请求体模板 (JSON 模板)</label>
                                        <div class="d-flex flex-wrap gap-1 mb-2">
                                            <span class="small text-muted align-self-center me-1">点击插入占位符:</span>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1 font-monospace" onclick="insertPlaceholder('{{title}}')">{{title}}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1 font-monospace" onclick="insertPlaceholder('{{level}}')">{{level}}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1 font-monospace" onclick="insertPlaceholder('{{content}}')">{{content}}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1 font-monospace" onclick="insertPlaceholder('{{context}}')">{{context}}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1 font-monospace" onclick="insertPlaceholder('{{deliveryId}}')">{{deliveryId}}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1 font-monospace" onclick="insertPlaceholder('{{occurredAtUtc}}')">{{occurredAtUtc}}</button>
                                        </div>
                                        <textarea asp-for="WebhookPayloadTemplate" id="webhook-payload-template" class="form-control font-monospace" rows="8" maxlength="16000" spellcheck="false" placeholder="{&#10;  &quot;msgtype&quot;: &quot;text&quot;,&#10;  &quot;text&quot;: {&#10;    &quot;content&quot;: &quot;[{{level}}] {{title}}\n{{content}}&quot;&#10;  }&#10;}"></textarea>
                                        <small class="text-muted d-block mt-2">占位符必须单独作为 JSON 字符串的值。<code>{{context}}</code> 将解析并保留原始对象类型。</small>
                                    </div>
                                </div>
                            </details>
                        }
                        else if (Model.Type == "email")
                        {
                            <div class="alert alert-info py-2 px-3 small mb-3">
                                <i class="align-middle me-1" data-lucide="info"></i>
                                <strong>全局 SMTP 邮件服务</strong>：系统统一使用全局 Email 服务配置。请通过 <code>Email__Password</code> 环境变量提供认证凭据。
                            </div>
                            <div class="mb-4">
                                <label asp-for="EmailRecipient" class="form-label small fw-medium">收件人邮箱</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent text-muted"><i data-lucide="mail" class="align-middle" aria-hidden="true"></i></span>
                                    <input asp-for="EmailRecipient" type="email" required maxlength="320" class="form-control font-monospace" placeholder="oncall-team@example.com" aria-describedby="email-recipient-hint" />
                                </div>
                                <small class="text-muted d-block mt-2" id="email-recipient-hint">邮件会直接发送给此邮箱地址。</small>
                            </div>

                            <div class="card border mb-4" aria-labelledby="email-cc-heading">
                                <div class="card-header bg-transparent py-2">
                                    <h3 id="email-cc-heading" class="h6 mb-0 fw-semibold"><i class="align-middle me-1 text-primary" data-lucide="users-round" aria-hidden="true"></i>抄送列表</h3>
                                </div>
                                <div class="card-body">
                                    <label asp-for="EmailCcRecipients" class="form-label small fw-medium">批量输入抄送邮箱</label>
                                    <textarea asp-for="EmailCcRecipients" id="email-cc-input" class="form-control font-monospace" rows="4" maxlength="8000" spellcheck="false" placeholder="manager@example.com&#10;incident-team@example.com" aria-describedby="email-cc-hint"></textarea>
                                    <small class="text-muted d-block mt-2" id="email-cc-hint">每行一个邮箱地址，也支持使用英文逗号或分号分隔，最多支持 50 个抄送人。</small>
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" id="parse-email-cc">
                                            <i class="align-middle me-1" data-lucide="list-checks" aria-hidden="true"></i>解析为列表
                                        </button>
                                        <div class="input-group input-group-sm" style="max-width: 22rem;">
                                            <input id="add-email-cc" type="email" maxlength="320" class="form-control font-monospace" placeholder="补充一个邮箱地址" aria-label="补充一个抄送邮箱地址" />
                                            <button type="button" class="btn btn-primary" id="add-email-cc-button"><i class="align-middle me-1" data-lucide="plus" aria-hidden="true"></i>添加</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body border-top pt-3">
                                    <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                                        <span class="small fw-medium">已解析的抄送人</span>
                                        <span id="email-cc-count" class="badge bg-secondary-subtle text-secondary border">0</span>
                                    </div>
                                    <p id="email-cc-empty" class="text-muted small mb-0">尚未添加抄送人。</p>
                                    <div id="email-cc-list" class="d-flex flex-wrap gap-2" aria-live="polite"></div>
                                    <span asp-validation-for="EmailCcRecipients" class="text-danger small d-block mt-2"></span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info py-2 px-3 small mb-3">
                                <i class="align-middle me-1" data-lucide="info"></i>
                                <strong>站内通知范围</strong>：支持同时绑定多个用户与用户组（角色）。系统自动去重，每位成员仅产生一条待读通知。
                            </div>
                        }

                        @if (Model.Type == "inapp")
                        {
                            <div class="card border mb-4">
                                <div class="card-header bg-transparent py-2">
                                    <h3 class="h6 mb-0 fw-semibold"><i class="align-middle me-1 text-primary" data-lucide="user-plus"></i>添加接收人与用户组</h3>
                                </div>
                                <div class="card-body">
                                    <div class="btn-group w-100 mb-3" role="group" aria-label="接收人类型">
                                        <input type="radio" class="btn-check" name="recipientType" id="recipient-type-role" value="role" checked />
                                        <label class="btn btn-outline-primary" for="recipient-type-role">
                                            <i class="align-middle me-1" data-lucide="users" aria-hidden="true"></i>用户组 (Role)
                                        </label>
                                        <input type="radio" class="btn-check" name="recipientType" id="recipient-type-user" value="user" />
                                        <label class="btn btn-outline-primary" for="recipient-type-user">
                                            <i class="align-middle me-1" data-lucide="user" aria-hidden="true"></i>指定用户 (User)
                                        </label>
                                    </div>

                                    <div id="recipient-role-selection">
                                        <label for="recipient-role-select" class="form-label small fw-medium">选择用户组</label>
                                        <div class="input-group">
                                            <select id="recipient-role-select" class="form-select">
                                                <option value="">请选择用户组…</option>
                                                @foreach (var role in Model.AvailableRoles)
                                                {
                                                    <option value="@role.Value">@role.Text</option>
                                                }
                                            </select>
                                            <button type="button" class="btn btn-primary" id="add-role-recipient">
                                                <i class="align-middle me-1" data-lucide="plus" aria-hidden="true"></i>添加
                                            </button>
                                        </div>
                                    </div>

                                    <div id="recipient-user-selection" class="d-none">
                                        <label for="recipient-user-search" class="form-label small fw-medium">搜索用户</label>
                                        <div class="position-relative">
                                            <div class="input-group">
                                                <span class="input-group-text bg-transparent text-muted"><i data-lucide="search" class="align-middle"></i></span>
                                                <input id="recipient-user-search" type="search" class="form-control" placeholder="输入用户名或显示名称搜索…" autocomplete="off" aria-autocomplete="list" aria-controls="recipient-user-results" />
                                                <button type="button" class="btn btn-primary" id="add-user-recipient" disabled>
                                                    <i class="align-middle me-1" data-lucide="plus" aria-hidden="true"></i>添加
                                                </button>
                                            </div>
                                            <div id="recipient-user-results" class="position-absolute w-100 bg-white border rounded shadow-sm d-none" role="listbox" style="z-index: 1000; max-height: 280px; overflow-y: auto;"></div>
                                        </div>
                                        <div id="selected-user-preview" class="card border-primary-subtle mt-3 d-none">
                                            <div class="card-body d-flex align-items-center gap-3 py-2">
                                                <span id="selected-user-avatar" class="d-inline-flex align-items-center justify-content-center flex-shrink-0 rounded-circle bg-primary-subtle text-primary fw-semibold" style="width: 36px; height: 36px;"></span>
                                                <div class="flex-grow-1 min-w-0">
                                                    <strong id="selected-user-name" class="d-block text-truncate small"></strong>
                                                    <small id="selected-user-username" class="d-block text-muted text-truncate"></small>
                                                    <small id="selected-user-id" class="d-none"></small>
                                                </div>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle flex-shrink-0">待添加</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="card border mb-4">
                                <div class="card-header bg-transparent d-flex align-items-center justify-content-between py-2">
                                    <h3 class="h6 mb-0 fw-semibold"><i class="align-middle me-1 text-primary" data-lucide="users"></i>已选接收人列表</h3>
                                    <span class="text-muted small">点击右侧按钮可移除</span>
                                </div>
                                <div class="card-body pt-2">
                                    <p id="recipients-empty" class="text-muted mb-0 py-3 text-center @(Model.SelectedUsers.Count + Model.SelectedRoles.Count > 0 ? "d-none" : "")">
                                        尚未添加接收人。请在上方选择角色组或指定用户。
                                    </p>
                                    <div id="recipient-list" class="list-group list-group-flush">
                                        @foreach (var user in Model.SelectedUsers)
                                        {
                                            <div class="list-group-item d-flex align-items-center justify-content-between gap-3 px-0 py-2" data-recipient-kind="user">
                                                <div class="d-flex align-items-center gap-2 min-w-0">
                                                    <div class="ac-stat-icon icon-indigo" style="width: 32px; height: 32px; font-size: 1rem;">
                                                        <i data-lucide="user" aria-hidden="true"></i>
                                                    </div>
                                                    <div class="text-truncate">
                                                        <strong class="d-block text-truncate small">@user.Name</strong>
                                                        <small class="text-muted font-monospace">@user.UserName</small>
                                                    </div>
                                                </div>
                                                <input type="hidden" name="RecipientUserIds" value="@user.Id" />
                                                <button type="button" class="btn btn-sm btn-outline-danger remove-recipient" title="移除 @user.Name">
                                                    <i class="align-middle" data-lucide="x" aria-hidden="true"></i>
                                                    <span class="visually-hidden">移除 @user.Name</span>
                                                </button>
                                            </div>
                                        }
                                        @foreach (var role in Model.SelectedRoles)
                                        {
                                            <div class="list-group-item d-flex align-items-center justify-content-between gap-3 px-0 py-2" data-recipient-kind="role">
                                                <div class="d-flex align-items-center gap-2 min-w-0">
                                                    <div class="ac-stat-icon icon-primary" style="width: 32px; height: 32px; font-size: 1rem;">
                                                        <i data-lucide="users" aria-hidden="true"></i>
                                                    </div>
                                                    <div class="text-truncate">
                                                        <strong class="text-truncate small">@role.Name</strong>
                                                        <small class="text-muted d-block">角色组</small>
                                                    </div>
                                                </div>
                                                <input type="hidden" name="RecipientRoleIds" value="@role.Id" />
                                                <button type="button" class="btn btn-sm btn-outline-danger remove-recipient" title="移除 @role.Name">
                                                    <i class="align-middle" data-lucide="x" aria-hidden="true"></i>
                                                    <span class="visually-hidden">移除 @role.Name</span>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                    <small class="text-muted d-block mt-2">请至少添加一个用户或用户组；组内无成员时不会产生通知。</small>
                                </div>
                            </div>
                        }

                        <section class="card border mb-4" aria-labelledby="binding-access-heading">
                            <div class="card-header bg-transparent d-flex align-items-center justify-content-between py-2">
                                <h3 id="binding-access-heading" class="h6 mb-0 fw-semibold"><i class="align-middle me-1 text-primary" data-lucide="link"></i>应用绑定授权</h3>
                                <span id="binding-access-count" class="badge bg-secondary-subtle text-secondary border">@bindingAccessCount</span>
                            </div>
                            <div class="card-body">
                                <p class="text-muted small">仅下列用户或用户组成员可在其可管理的应用中看到并绑定此渠道。该授权不提供收件人、Webhook 或测试配置访问权。</p>
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-3">
                                        <label class="form-label small fw-medium d-block">授权类型</label>
                                        <div class="btn-group w-100" role="group">
                                            <input type="radio" class="btn-check" name="binding-access-kind" id="binding-access-role" value="role" checked />
                                            <label class="btn btn-outline-primary" for="binding-access-role"><i class="align-middle me-1" data-lucide="users" aria-hidden="true"></i>用户组</label>
                                            <input type="radio" class="btn-check" name="binding-access-kind" id="binding-access-user" value="user" />
                                            <label class="btn btn-outline-primary" for="binding-access-user"><i class="align-middle me-1" data-lucide="user" aria-hidden="true"></i>指定用户</label>
                                        </div>
                                    </div>
                                    <div class="col-md-7">
                                        <label for="binding-access-role-select" class="form-label small fw-medium" id="binding-access-subject-label">选择用户组</label>
                                        <select id="binding-access-role-select" class="form-select">
                                            <option value="">请选择用户组…</option>
                                            @foreach (var role in Model.AvailableRoles)
                                            {
                                                <option value="@role.Value">@role.Text</option>
                                            }
                                        </select>
                                        <select id="binding-access-user-select" class="form-select d-none">
                                            <option value="">请选择用户…</option>
                                            @foreach (var user in Model.AvailableUsers)
                                            {
                                                <option value="@user.Value">@user.Text</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" id="add-binding-access" class="btn btn-primary w-100"><i class="align-middle me-1" data-lucide="plus" aria-hidden="true"></i>添加</button>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body border-top pt-0">
                                <div id="binding-access-empty" class="ac-empty-state py-4 @(bindingAccessCount > 0 ? "d-none" : "")">
                                    <div class="ac-empty-icon" style="width: 48px; height: 48px;"><i data-lucide="link" aria-hidden="true"></i></div>
                                    <h4 class="h6 text-muted">尚未授予应用绑定权限</h4>
                                    <p class="text-muted small mb-0">除推送渠道管理员外，当前没有用户可以绑定此渠道。</p>
                                </div>
                                <div id="binding-access-list" class="list-group list-group-flush">
                                    @foreach (var role in Model.SelectedBindingRoles)
                                    {
                                        <div class="list-group-item d-flex align-items-center justify-content-between gap-3 px-0 py-3" data-kind="role" data-id="@role.Id">
                                            <div class="d-flex align-items-center gap-3 min-w-0">
                                                <div class="ac-stat-icon icon-primary" style="width: 40px; height: 40px;"><i data-lucide="users" aria-hidden="true"></i></div>
                                                <div class="text-truncate"><strong class="d-block text-truncate">@role.Name</strong><small class="text-muted">用户组 · 成员动态继承绑定权限</small></div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2"><input type="hidden" name="BindingRoleIds" value="@role.Id" /><button type="button" class="btn btn-sm btn-outline-danger remove-binding-access" title="移除权限"><i class="align-middle" data-lucide="x" aria-hidden="true"></i><span class="visually-hidden">移除 @role.Name</span></button></div>
                                        </div>
                                    }
                                    @foreach (var user in Model.SelectedBindingUsers)
                                    {
                                        <div class="list-group-item d-flex align-items-center justify-content-between gap-3 px-0 py-3" data-kind="user" data-id="@user.Id">
                                            <div class="d-flex align-items-center gap-3 min-w-0">
                                                <div class="ac-stat-icon icon-indigo" style="width: 40px; height: 40px;"><i data-lucide="user" aria-hidden="true"></i></div>
                                                <div class="text-truncate"><strong class="d-block text-truncate">@user.Name</strong><small class="text-muted">@user.UserName · 指定个人用户</small></div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2"><input type="hidden" name="BindingUserIds" value="@user.Id" /><button type="button" class="btn btn-sm btn-outline-danger remove-binding-access" title="移除权限"><i class="align-middle" data-lucide="x" aria-hidden="true"></i><span class="visually-hidden">移除 @user.Name</span></button></div>
                                        </div>
                                    }
                                </div>
                                <span asp-validation-for="BindingUserIds" class="text-danger small"></span>
                                <span asp-validation-for="BindingRoleIds" class="text-danger small"></span>
                            </div>
                        </section>

                        <div class="form-check form-switch mb-4">
                            <input asp-for="IsEnabled" class="form-check-input" />
                            <label asp-for="IsEnabled" class="form-check-label fw-medium">立即启用该推送渠道</label>
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" type="submit">
                                <i class="align-middle me-1" data-lucide="save"></i>保存渠道配置
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<script>
    function insertPlaceholder(tag) {
        const textarea = document.getElementById('webhook-payload-template');
        if (!textarea) return;
        const start = textarea.selectionStart;
        const end = textarea.selectionEnd;
        const text = textarea.value;
        textarea.value = text.substring(0, start) + tag + text.substring(end);
        textarea.focus();
        textarea.selectionStart = textarea.selectionEnd = start + tag.length;
    }
</script>

@section scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const bindingRoleType = document.getElementById('binding-access-role');
            const bindingUserType = document.getElementById('binding-access-user');
            const bindingRoleSelect = document.getElementById('binding-access-role-select');
            const bindingUserSelect = document.getElementById('binding-access-user-select');
            const bindingSubjectLabel = document.getElementById('binding-access-subject-label');
            const bindingList = document.getElementById('binding-access-list');
            const bindingEmpty = document.getElementById('binding-access-empty');
            const bindingCount = document.getElementById('binding-access-count');

            function selectedBindingKind() { return bindingRoleType.checked ? 'role' : 'user'; }
            function updateBindingSubject() {
                const isRole = selectedBindingKind() === 'role';
                bindingRoleSelect.classList.toggle('d-none', !isRole);
                bindingUserSelect.classList.toggle('d-none', isRole);
                bindingSubjectLabel.textContent = isRole ? '选择用户组' : '选择用户';
            }
            function updateBindingEmptyState() {
                const count = bindingList.children.length;
                bindingEmpty.classList.toggle('d-none', count > 0);
                bindingCount.textContent = count;
            }
            function createBindingIcon(name, iconClass) {
                const icon = document.createElement('i');
                icon.dataset.lucide = name;
                icon.className = `align-middle ${iconClass}`;
                icon.setAttribute('aria-hidden', 'true');
                return icon;
            }

            bindingRoleType.addEventListener('change', updateBindingSubject);
            bindingUserType.addEventListener('change', updateBindingSubject);
            document.getElementById('add-binding-access').addEventListener('click', function () {
                const kind = selectedBindingKind();
                const select = kind === 'role' ? bindingRoleSelect : bindingUserSelect;
                const option = select.options[select.selectedIndex];
                if (!option.value) {
                    select.focus();
                    return;
                }
                const existing = Array.from(bindingList.children).find(item => item.dataset.kind === kind && item.dataset.id === option.value);
                if (existing) existing.remove();

                const item = document.createElement('div');
                item.className = 'list-group-item d-flex align-items-center justify-content-between gap-3 px-0 py-3';
                item.dataset.kind = kind;
                item.dataset.id = option.value;
                const details = document.createElement('div');
                details.className = 'd-flex align-items-center gap-3 min-w-0';
                const iconContainer = document.createElement('div');
                iconContainer.className = `ac-stat-icon ${kind === 'role' ? 'icon-primary' : 'icon-indigo'}`;
                iconContainer.style.width = '40px';
                iconContainer.style.height = '40px';
                iconContainer.appendChild(createBindingIcon(kind === 'role' ? 'users' : 'user', ''));
                const text = document.createElement('div');
                text.className = 'text-truncate';
                const name = document.createElement('strong');
                name.className = 'd-block text-truncate';
                name.textContent = option.textContent;
                const subtitle = document.createElement('small');
                subtitle.className = 'text-muted';
                subtitle.textContent = kind === 'role' ? '用户组 · 成员动态继承绑定权限' : '指定个人用户';
                text.append(name, subtitle);
                details.append(iconContainer, text);
                const controls = document.createElement('div');
                controls.className = 'd-flex align-items-center gap-2';
                const hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = kind === 'role' ? 'BindingRoleIds' : 'BindingUserIds';
                hidden.value = option.value;
                const remove = document.createElement('button');
                remove.type = 'button';
                remove.className = 'btn btn-sm btn-outline-danger remove-binding-access';
                remove.title = '移除权限';
                remove.setAttribute('aria-label', `移除 ${option.textContent}`);
                remove.appendChild(createBindingIcon('x', 'align-middle'));
                controls.append(hidden, remove);
                item.append(details, controls);
                bindingList.appendChild(item);
                select.value = '';
                if (window.lucide) lucide.createIcons({ nodes: [item] });
                updateBindingEmptyState();
            });
            bindingList.addEventListener('click', function (event) {
                const button = event.target.closest('.remove-binding-access');
                if (!button) return;
                button.closest('.list-group-item').remove();
                updateBindingEmptyState();
            });

@if (Model.Type == "email")
{
<text>
            const emailCcInput = document.getElementById('email-cc-input');
            const parseEmailCcButton = document.getElementById('parse-email-cc');
            const addEmailCcInput = document.getElementById('add-email-cc');
            const addEmailCcButton = document.getElementById('add-email-cc-button');
            const emailCcList = document.getElementById('email-cc-list');
            const emailCcEmpty = document.getElementById('email-cc-empty');
            const emailCcCount = document.getElementById('email-cc-count');

            function normalizeEmail(address) {
                const trimmed = address.trim();
                if (!trimmed || trimmed.length > 320 || /[\r\n,;]/.test(trimmed)) return null;
                const input = document.createElement('input');
                input.type = 'email';
                input.value = trimmed;
                return input.checkValidity() ? trimmed : null;
            }

            function ccAddresses() {
                return emailCcInput.value.split(/[;,\r\n]+/).map(address => address.trim()).filter(Boolean);
            }

            function renderCcAddresses(addresses) {
                const uniqueAddresses = [...new Map(addresses.map(address => [address.toLowerCase(), address])).values()];
                emailCcInput.value = uniqueAddresses.join('\n');
                emailCcList.replaceChildren();
                uniqueAddresses.forEach(function (address) {
                    const badge = document.createElement('span');
                    badge.className = 'badge text-bg-light border d-inline-flex align-items-center gap-1 py-2 ps-2';
                    const text = document.createElement('span');
                    text.className = 'font-monospace fw-normal';
                    text.textContent = address;
                    const remove = document.createElement('button');
                    remove.type = 'button';
                    remove.className = 'btn-close btn-close-sm';
                    remove.setAttribute('aria-label', `移除 ${address}`);
                    remove.addEventListener('click', function () {
                        renderCcAddresses(ccAddresses().filter(item => item.toLowerCase() !== address.toLowerCase()));
                    });
                    badge.append(text, remove);
                    emailCcList.appendChild(badge);
                });
                emailCcEmpty.classList.toggle('d-none', uniqueAddresses.length > 0);
                emailCcCount.textContent = uniqueAddresses.length;
            }

            function parseCcAddresses() {
                const addresses = ccAddresses();
                if (addresses.some(address => !normalizeEmail(address))) {
                    emailCcInput.setCustomValidity('请检查抄送邮箱格式。');
                    emailCcInput.reportValidity();
                    return;
                }
                emailCcInput.setCustomValidity('');
                renderCcAddresses(addresses);
            }

            parseEmailCcButton.addEventListener('click', parseCcAddresses);
            addEmailCcButton.addEventListener('click', function () {
                const address = normalizeEmail(addEmailCcInput.value);
                if (!address) {
                    addEmailCcInput.focus();
                    return;
                }
                renderCcAddresses([...ccAddresses(), address]);
                addEmailCcInput.value = '';
            });
            addEmailCcInput.addEventListener('keydown', function (event) {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    addEmailCcButton.click();
                }
            });
            emailCcInput.addEventListener('blur', parseCcAddresses);
            parseCcAddresses();
</text>
}

@if (Model.Type == "inapp")
{
<text>
            const roleType = document.getElementById('recipient-type-role');
            const userType = document.getElementById('recipient-type-user');
            const roleSelection = document.getElementById('recipient-role-selection');
            const userSelection = document.getElementById('recipient-user-selection');
            const roleSelect = document.getElementById('recipient-role-select');
            const addRoleButton = document.getElementById('add-role-recipient');
            const userSearch = document.getElementById('recipient-user-search');
            const addUserButton = document.getElementById('add-user-recipient');
            const userResults = document.getElementById('recipient-user-results');
            const selectedUserPreview = document.getElementById('selected-user-preview');
            const selectedUserAvatar = document.getElementById('selected-user-avatar');
            const selectedUserName = document.getElementById('selected-user-name');
            const selectedUserUsername = document.getElementById('selected-user-username');
            const selectedUserId = document.getElementById('selected-user-id');
            const recipientList = document.getElementById('recipient-list');
            const recipientsEmpty = document.getElementById('recipients-empty');
            let selectedUser;
            const searchUrl = '@Url.Action("SearchRecipients", "Push")';
            let searchTimeout;
            let searchRequest = 0;

            function updateEmptyState() {
                recipientsEmpty.classList.toggle('d-none', recipientList.children.length > 0);
            }

            function hasRecipient(kind, id) {
                return Array.from(recipientList.querySelectorAll('input')).some(input => input.name === (kind === 'user' ? 'RecipientUserIds' : 'RecipientRoleIds') && input.value === id);
            }

            function createIcon(name, className) {
                const icon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                icon.setAttribute('class', 'lucide ' + className);
                icon.setAttribute('width', '18');
                icon.setAttribute('height', '18');
                icon.setAttribute('viewBox', '0 0 24 24');
                icon.setAttribute('fill', 'none');
                icon.setAttribute('stroke', 'currentColor');
                icon.setAttribute('stroke-width', '2');
                icon.setAttribute('stroke-linecap', 'round');
                icon.setAttribute('stroke-linejoin', 'round');
                icon.setAttribute('aria-hidden', 'true');
                const paths = name === 'user'
                    ? ['M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2', 'M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8']
                    : name === 'users'
                        ? ['M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2', 'M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8', 'M22 21v-2a4 4 0 0 0-3-3.87', 'M16 3.13a4 4 0 0 1 0 7.75']
                        : ['M18 6 6 18', 'm6 6 12 12'];
                paths.forEach(pathData => {
                    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                    path.setAttribute('d', pathData);
                    icon.appendChild(path);
                });
                return icon;
            }

            function addRecipient(kind, id, name, userName) {
                if (!id || hasRecipient(kind, id)) return false;
                const item = document.createElement('div');
                item.className = 'list-group-item d-flex align-items-center justify-content-between gap-3 px-0 py-2';
                item.dataset.recipientKind = kind;

                const details = document.createElement('div');
                details.className = 'd-flex align-items-center gap-2 min-w-0';
                details.appendChild(createIcon(kind === 'user' ? 'user' : 'users', kind === 'user' ? 'align-middle text-info' : 'align-middle text-primary'));
                const text = document.createElement('div');
                text.className = 'text-truncate';
                const title = document.createElement(kind === 'user' ? 'strong' : 'span');
                title.className = kind === 'user' ? 'd-block text-truncate small' : 'fw-bold text-truncate small';
                title.textContent = name;
                text.appendChild(title);
                if (userName) {
                    const subtitle = document.createElement('small');
                    subtitle.className = 'text-muted font-monospace';
                    subtitle.textContent = userName;
                    text.appendChild(subtitle);
                }
                details.appendChild(text);
                item.appendChild(details);

                const hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = kind === 'user' ? 'RecipientUserIds' : 'RecipientRoleIds';
                hidden.value = id;
                item.appendChild(hidden);
                const remove = document.createElement('button');
                remove.type = 'button';
                remove.className = 'btn btn-sm btn-outline-danger remove-recipient';
                remove.setAttribute('aria-label', '移除 ' + name);
                remove.appendChild(createIcon('x', 'align-middle'));
                item.appendChild(remove);
                recipientList.appendChild(item);
                updateEmptyState();
                return true;
            }

            function showRoleSelection() {
                roleSelection.classList.remove('d-none');
                userSelection.classList.add('d-none');
                searchRequest++;
                userResults.classList.add('d-none');
            }

            function showUserSelection() {
                userSelection.classList.remove('d-none');
                roleSelection.classList.add('d-none');
                userSearch.focus();
            }

            roleType.addEventListener('change', showRoleSelection);
            userType.addEventListener('change', showUserSelection);
            addRoleButton.addEventListener('click', function () {
                const option = roleSelect.options[roleSelect.selectedIndex];
                if (!option.value) {
                    roleSelect.focus();
                    return;
                }
                if (addRecipient('role', option.value, option.textContent)) roleSelect.value = '';
            });
            addUserButton.addEventListener('click', function () {
                if (!selectedUser) {
                    userSearch.focus();
                    return;
                }
                if (addRecipient('user', selectedUser.id, selectedUser.displayName, selectedUser.userName)) {
                    userSearch.value = '';
                    clearSelectedUser();
                }
            });
            recipientList.addEventListener('click', function (event) {
                const button = event.target.closest('.remove-recipient');
                if (!button) return;
                button.closest('.list-group-item').remove();
                updateEmptyState();
            });

            function clearSelectedUser() {
                selectedUser = undefined;
                addUserButton.disabled = true;
                selectedUserPreview.classList.add('d-none');
            }

            function selectUser(user) {
                selectedUser = user;
                addUserButton.disabled = hasRecipient('user', user.id);
                userSearch.value = '';
                selectedUserAvatar.textContent = Array.from(user.displayName.trim())[0] || '?';
                selectedUserName.textContent = user.displayName;
                selectedUserUsername.textContent = user.userName;
                selectedUserId.textContent = 'ID: ' + user.id;
                selectedUserPreview.classList.remove('d-none');
                clearResults();
            }

            function clearResults() {
                userResults.innerHTML = '';
                userResults.classList.add('d-none');
            }

            function appendUserResult(user) {
                const result = document.createElement('button');
                result.type = 'button';
                result.className = 'list-group-item list-group-item-action d-flex align-items-center gap-3 px-3 py-2 text-start';
                result.setAttribute('role', 'option');
                result.setAttribute('aria-label', '选择用户 ' + user.displayName);

                const avatar = document.createElement('span');
                avatar.className = 'd-inline-flex align-items-center justify-content-center flex-shrink-0 rounded-circle bg-primary-subtle text-primary fw-semibold';
                avatar.style.width = '36px';
                avatar.style.height = '36px';
                avatar.textContent = Array.from(user.displayName.trim())[0] || '?';

                const details = document.createElement('span');
                details.className = 'flex-grow-1 min-w-0';
                const name = document.createElement('strong');
                name.className = 'd-block text-truncate small';
                name.textContent = user.displayName;
                const username = document.createElement('small');
                username.className = 'd-block text-muted text-truncate font-monospace';
                username.textContent = user.userName;
                details.append(name, username);

                const select = document.createElement('span');
                select.className = 'badge bg-primary-subtle text-primary border border-primary-subtle flex-shrink-0';
                select.textContent = '选择';
                result.append(avatar, details, select);
                result.addEventListener('click', function () {
                    selectUser(user);
                });
                userResults.appendChild(result);
            }

            userSearch.addEventListener('input', function () {
                clearSelectedUser();
                const query = userSearch.value.trim();
                clearTimeout(searchTimeout);
                if (!query) {
                    clearResults();
                    return;
                }
                searchTimeout = setTimeout(async function () {
                    const request = ++searchRequest;
                    try {
                        const response = await fetch(searchUrl + '?query=' + encodeURIComponent(query));
                        if (!response.ok || request !== searchRequest) return;
                        const data = await response.json();
                        userResults.innerHTML = '';
                        if (data.users.length === 0) {
                            const empty = document.createElement('div');
                            empty.className = 'p-3 text-muted small text-center';
                            empty.textContent = '没有找到匹配的用户。';
                            userResults.appendChild(empty);
                        } else {
                            data.users.forEach(appendUserResult);
                        }
                        userResults.classList.remove('d-none');
                    } catch {
                        if (request === searchRequest) clearResults();
                    }
                }, 250);
            });
            userSearch.addEventListener('keydown', function (event) {
                if (event.key === 'Enter') event.preventDefault();
            });
            document.addEventListener('click', function (event) {
                if (!userSearch.contains(event.target) && !userResults.contains(event.target)) clearResults();
            });
</text>
}
            });
    </script>
}
