@model Aiursoft.AlertCenter.Models.PushViewModel

@section styles {
    <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" />
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">推送中心</h1>
        <p class="text-muted mb-0">管理通知投递渠道，按严重级别将告警精准投递给责任人和外部系统。</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Alerts" asp-action="Applications" class="btn btn-outline-secondary">
            <i class="align-middle me-1" data-lucide="sliders"></i>应用分级关联
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="align-middle me-1" data-lucide="plus" aria-hidden="true"></i>添加新渠道
        </a>
    </div>
</div>

<!-- Channel Types Showcase Cards -->
<div class="row g-3 mb-4">
@foreach (var type in Model.ChannelTypes)
{
    var iconClass = type.Key switch
    {
        "webhook" => "icon-success",
        "email" => "icon-warning",
        "inapp" => "icon-primary",
        _ => "icon-indigo"
    };
    <div class="col-md-6 col-xl-4 d-flex">
        <div class="card ac-stat-card flex-fill mb-0">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="ac-stat-icon @iconClass">
                                <i data-lucide="@type.Icon" aria-hidden="true"></i>
                            </div>
                            <div>
                                <h2 class="h5 mb-0 fw-semibold">@type.Name</h2>
                                <span class="badge bg-secondary-subtle text-secondary font-monospace small">@type.Key</span>
                            </div>
                        </div>
                    </div>
                    <p class="text-muted small mb-4" style="line-height: 1.5;">@type.Description</p>
                </div>
                <div>
                    <a asp-action="Create" asp-route-type="@type.Key" class="btn btn-outline-primary btn-sm w-100">
                        <i class="align-middle me-1" data-lucide="plus"></i>配置 @type.Name
                    </a>
                </div>
            </div>
        </div>
    </div>
}
</div>

<!-- Configured Channels Card -->
<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-2">
            <h2 class="card-title mb-0">已配置推送渠道</h2>
            <span class="badge bg-secondary-subtle text-secondary border">@Model.Channels.Count 个渠道</span>
        </div>
        <a asp-action="Records" class="btn btn-sm btn-outline-secondary">
            <i class="align-middle me-1" data-lucide="history"></i>查看全部投递记录
        </a>
    </div>

    @if (Model.Channels.Count == 0)
    {
        <div class="card-body ac-empty-state">
            <div class="ac-empty-icon">
                <i data-lucide="send" aria-hidden="true"></i>
            </div>
            <h3 class="h5">还没有配置推送渠道</h3>
            <p class="text-muted mb-4">选择上方的渠道类型（如 Webhook、站内通知或邮件），配置后即可在接入应用中关联。</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="align-middle me-1" data-lucide="plus"></i>添加首个渠道
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">渠道名称</th>
                        <th>通道类型</th>
                        <th>当前状态</th>
                        <th class="text-end pe-4">操作</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var channel in Model.Channels)
                {
                    var type = Model.ChannelTypes.FirstOrDefault(item => item.Key == channel.Type);
                    var iconName = type?.Icon ?? "plug";
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-2">
                                <a asp-action="Edit" asp-route-id="@channel.Id" class="fw-semibold text-decoration-none text-break">
                                    @channel.Name
                                </a>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(channel.Endpoint))
                            {
                                <small class="text-muted text-truncate font-monospace d-block" style="max-width: 24rem;">
                                    @channel.Endpoint
                                </small>
                            }
                        </td>
                        <td>
                            <span class="badge bg-body-secondary text-body border">
                                <i class="align-middle me-1" data-lucide="@iconName" aria-hidden="true"></i>@(type?.Name ?? channel.Type)
                            </span>
                        </td>
                        <td>
                            @if (channel.IsEnabled)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <span class="ac-status-dot dot-success ac-pulse"></span>已启用
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">
                                    <span class="ac-status-dot dot-muted"></span>已停用
                                </span>
                            }
                        </td>
                        <td class="pe-4 text-end">
                            <div class="d-flex justify-content-end align-items-center flex-wrap gap-2">
                                <button type="button" class="btn btn-sm btn-primary" disabled="@(!channel.IsEnabled)" title="发送测试消息并查看投递结果" data-bs-toggle="modal" data-bs-target="#test-channel" data-channel-id="@channel.Id" data-channel-name="@channel.Name">
                                    <i class="align-middle me-1" data-lucide="send"></i>测试
                                </button>
                                <a asp-action="Edit" asp-route-id="@channel.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="align-middle me-1" data-lucide="edit-3"></i>编辑
                                </a>
                                <a asp-action="Records" asp-route-channelId="@channel.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="align-middle me-1" data-lucide="history"></i>记录
                                </a>
                                <form asp-action="SetEnabled" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@channel.Id" />
                                    <input type="hidden" name="enabled" value="@((!channel.IsEnabled).ToString().ToLowerInvariant())" />
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">
                                        @(channel.IsEnabled ? "停用" : "启用")
                                    </button>
                                </form>
                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#delete-channel" data-channel-id="@channel.Id" data-channel-name="@channel.Name">
                                    <i class="align-middle me-1" data-lucide="trash-2"></i>删除
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Test Channel Modal -->
<div class="modal fade" id="test-channel" tabindex="-1" aria-labelledby="test-channel-title" aria-describedby="test-channel-description" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5 d-flex align-items-center gap-2" id="test-channel-title">
                    <i class="align-middle text-primary" data-lucide="send"></i>发送测试消息
                </h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button>
            </div>
            <form asp-action="Test" method="post">
                <div class="modal-body">
                    <p>确定向渠道 <strong id="test-channel-name" class="text-break"></strong> 发送测试通知？</p>
                    <div class="mb-0">
                        <label for="test-channel-content" class="form-label small fw-medium">测试消息内容</label>
                        <textarea id="test-channel-content" name="content" class="form-control" rows="4" maxlength="4000" required aria-describedby="test-channel-description">@Aiursoft.AlertCenter.Entities.PushDelivery.DefaultTestContent</textarea>
                        <p id="test-channel-description" class="form-text text-muted mb-0 mt-2 small">
                            系统将立即创建投递任务并调用对应的通道适配器，执行完毕后跳转至投递详情页查看结果。
                        </p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                    <input id="test-channel-id" name="id" type="hidden" />
                    <button id="test-channel-confirm" class="btn btn-primary" disabled>
                        <i class="align-middle me-1" data-lucide="send"></i>立即发送测试
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Channel Modal -->
<div class="modal fade" id="delete-channel" tabindex="-1" aria-labelledby="delete-channel-title" aria-describedby="delete-channel-description" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5 d-flex align-items-center gap-2" id="delete-channel-title">
                    <i class="align-middle text-danger" data-lucide="trash-2"></i>删除推送渠道
                </h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button>
            </div>
            <div class="modal-body">
                <p>确定删除推送渠道 <strong id="delete-channel-name" class="text-break"></strong>？</p>
                <div class="alert alert-danger py-2 px-3 small mb-0" id="delete-channel-description">
                    <i class="align-middle me-1" data-lucide="alert-octagon"></i>关联的应用推送配置、历史投递记录和对应的站内通知将一并删除，此操作无法恢复。
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                <form asp-action="Delete" method="post" class="d-inline">
                    <input id="delete-channel-id" name="id" type="hidden" />
                    <button id="delete-channel-confirm" class="btn btn-danger" disabled>
                        <i class="align-middle me-1" data-lucide="trash-2"></i>确认删除
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    document.getElementById('test-channel').addEventListener('show.bs.modal', function (event) {
        document.getElementById('test-channel-name').textContent = event.relatedTarget?.dataset.channelName ?? '';
        document.getElementById('test-channel-id').value = event.relatedTarget?.dataset.channelId ?? '';
        const content = document.getElementById('test-channel-content');
        content.value = content.defaultValue;
        document.getElementById('test-channel-confirm').disabled = !event.relatedTarget?.dataset.channelId;
    });

    document.getElementById('delete-channel').addEventListener('show.bs.modal', function (event) {
        document.getElementById('delete-channel-name').textContent = event.relatedTarget?.dataset.channelName ?? '';
        document.getElementById('delete-channel-id').value = event.relatedTarget?.dataset.channelId ?? '';
        document.getElementById('delete-channel-confirm').disabled = !event.relatedTarget?.dataset.channelId;
    });
</script>
}
