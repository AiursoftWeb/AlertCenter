@model Aiursoft.AlertCenter.Models.PushViewModel

@section styles {
    <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" />
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Notifications"]</h1>
        <p class="text-muted mb-0">@Localizer["Manage notification delivery channels to deliver alerts to responsible parties and external systems accurately based on severity levels."]</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Alerts" asp-action="Applications" class="btn btn-outline-secondary">
            <i class="align-middle me-1" data-lucide="sliders"></i>@Localizer["Application Tier Association"]
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="align-middle me-1" data-lucide="plus" aria-hidden="true"></i>@Localizer["Add new channel"]
        </a>
    </div>
</div>

<!-- Channel Types Showcase Cards -->
<div class="row g-3 mb-4">
@foreach (var type in Model.ChannelTypes)
{
    var iconClass = type.Key switch
    {
        "webhook" => "icon-success",
        "email" => "icon-warning",
        "inapp" => "icon-primary",
        _ => "icon-indigo"
    };
    <div class="col-md-6 col-xl-4 d-flex">
        <div class="card ac-stat-card flex-fill mb-0">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="ac-stat-icon @iconClass">
                                <i data-lucide="@type.Icon" aria-hidden="true"></i>
                            </div>
                            <div>
                                <h2 class="h5 mb-0 fw-semibold">@type.Name</h2>
                                <span class="badge bg-secondary-subtle text-secondary font-monospace small">@type.Key</span>
                            </div>
                        </div>
                    </div>
                    <p class="text-muted small mb-4" style="line-height: 1.5;">@type.Description</p>
                </div>
                <div>
                    <a asp-action="Create" asp-route-type="@type.Key" class="btn btn-outline-primary btn-sm w-100">
                        <i class="align-middle me-1" data-lucide="plus"></i>@Localizer["Configure "]@type.Name
                    </a>
                </div>
            </div>
        </div>
    </div>
}
</div>

<!-- Configured Channels Card -->
<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-2">
            <h2 class="card-title mb-0">@Localizer["Push channel configured"]</h2>
            <span class="badge bg-secondary-subtle text-secondary border">@Model.Channels.Count @Localizer["channels"]</span>
        </div>
        <a asp-action="Records" class="btn btn-sm btn-outline-secondary">
            <i class="align-middle me-1" data-lucide="history"></i>@Localizer["View all delivery records"]
        </a>
    </div>

    @if (Model.Channels.Count == 0)
    {
        <div class="card-body ac-empty-state">
            <div class="ac-empty-icon">
                <i data-lucide="send" aria-hidden="true"></i>
            </div>
            <h3 class="h5">@Localizer["No push channels configured yet"]</h3>
            <p class="text-muted mb-4">@Localizer["Select the channel type above (e.g., Webhook, in-app notification, or email) and configure it to associate with the integrated application."]</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="align-middle me-1" data-lucide="plus"></i>@Localizer["Add first channel"]
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">@Localizer["Channel name"]</th>
                        <th>@Localizer["Channel Type"]</th>
                        <th>@Localizer["Current Status"]</th>
                        <th class="text-end pe-4">@Localizer["Action"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var channel in Model.Channels)
                {
                    var type = Model.ChannelTypes.FirstOrDefault(item => item.Key == channel.Type);
                    var iconName = type?.Icon ?? "plug";
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-2">
                                <a asp-action="Edit" asp-route-id="@channel.Id" class="fw-semibold text-decoration-none text-break">
                                    @channel.Name
                                </a>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(channel.Endpoint))
                            {
                                <small class="text-muted text-truncate font-monospace d-block" style="max-width: 24rem;">
                                    @channel.Endpoint
                                </small>
                            }
                        </td>
                        <td>
                            <span class="badge bg-body-secondary text-body border">
                                <i class="align-middle me-1" data-lucide="@iconName" aria-hidden="true"></i>@(type?.Name ?? channel.Type)
                            </span>
                        </td>
                        <td>
                            @if (channel.IsEnabled)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <span class="ac-status-dot dot-success ac-pulse"></span>@Localizer["Enabled"]
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">
                                    <span class="ac-status-dot dot-muted"></span>@Localizer["Disabled"]
                                </span>
                            }
                        </td>
                        <td class="pe-4 text-end">
                            <div class="d-flex justify-content-end align-items-center flex-wrap gap-2">
                                <button type="button" class="btn btn-sm btn-primary" disabled="@(!channel.IsEnabled)" title="@Localizer["Send test message and view delivery result"]" data-bs-toggle="modal" data-bs-target="#test-channel" data-channel-id="@channel.Id" data-channel-name="@channel.Name">
                                    <i class="align-middle me-1" data-lucide="send"></i>@Localizer["Test"]
                                </button>
                                <a asp-action="Edit" asp-route-id="@channel.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="align-middle me-1" data-lucide="edit-3"></i>@Localizer["Edit"]
                                </a>
                                <a asp-action="Records" asp-route-channelId="@channel.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="align-middle me-1" data-lucide="history"></i>@Localizer["Log"]
                                </a>
                                <form asp-action="SetEnabled" method="post" data-action-feedback class="d-inline">
                                    <input type="hidden" name="id" value="@channel.Id" />
                                    <input type="hidden" name="enabled" value="@((!channel.IsEnabled).ToString().ToLowerInvariant())" />
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">
                                        @(channel.IsEnabled ? @Localizer["Disable"].Value : @Localizer["Enable"].Value)
                                    </button>
                                </form>
                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#delete-channel" data-channel-id="@channel.Id" data-channel-name="@channel.Name">
                                    <i class="align-middle me-1" data-lucide="trash-2"></i>@Localizer["Delete"]
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Test Channel Modal -->
<div class="modal fade" id="test-channel" tabindex="-1" aria-labelledby="test-channel-title" aria-describedby="test-channel-description" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5 d-flex align-items-center gap-2" id="test-channel-title">
                    <i class="align-middle text-primary" data-lucide="send"></i>@Localizer["Send test message"]
                </h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
            </div>
            <form asp-action="Test" method="post" data-action-feedback>
                <div class="modal-body">
                    <p>@Localizer["Confirm sending to channel"] <strong id="test-channel-name" class="text-break"></strong> @Localizer["Send test notification?"]</p>
                    <div class="mb-0">
                        <label for="test-channel-content" class="form-label small fw-medium">@Localizer["Test message content"]</label>
                        <textarea id="test-channel-content" name="content" class="form-control" rows="4" maxlength="4000" required aria-describedby="test-channel-description">@Localizer["This is a test message for the push channel."].Value</textarea>
                        <p id="test-channel-description" class="form-text text-muted mb-0 mt-2 small">
                            @Localizer["The system will immediately create a delivery task and invoke the corresponding channel adapter. After execution, you will be redirected to the delivery details page to view the results."]
                        </p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <input id="test-channel-id" name="id" type="hidden" />
                    <button id="test-channel-confirm" class="btn btn-primary" disabled>
                        <i class="align-middle me-1" data-lucide="send"></i>@Localizer["Send test now"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Channel Modal -->
<div class="modal fade" id="delete-channel" tabindex="-1" aria-labelledby="delete-channel-title" aria-describedby="delete-channel-description" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5 d-flex align-items-center gap-2" id="delete-channel-title">
                    <i class="align-middle text-danger" data-lucide="trash-2"></i>@Localizer["Delete push channel"]
                </h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
            </div>
            <div class="modal-body">
                <p>@Localizer["Confirm push channel deletion"] <strong id="delete-channel-name" class="text-break"></strong>？</p>
                <div class="alert alert-danger small mb-0" id="delete-channel-description" role="alert">
                    <div class="alert-icon">
                        <i class="align-middle" data-lucide="alert-octagon" aria-hidden="true"></i>
                    </div>
                    <div class="alert-message">@Localizer["Linked application push configurations, historical delivery records, and corresponding in-app notifications will be deleted. This action cannot be undone."]</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <form asp-action="Delete" method="post" data-action-feedback class="d-inline">
                    <input id="delete-channel-id" name="id" type="hidden" />
                    <button id="delete-channel-confirm" class="btn btn-danger" disabled>
                        <i class="align-middle me-1" data-lucide="trash-2"></i>@Localizer["Confirm deletion"]
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    document.getElementById('test-channel').addEventListener('show.bs.modal', function (event) {
        if (!event.relatedTarget) return;
        document.getElementById('test-channel-name').textContent = event.relatedTarget?.dataset.channelName ?? '';
        document.getElementById('test-channel-id').value = event.relatedTarget?.dataset.channelId ?? '';
        const content = document.getElementById('test-channel-content');
        content.value = content.defaultValue;
        document.getElementById('test-channel-confirm').disabled = !event.relatedTarget?.dataset.channelId;
    });

    document.getElementById('delete-channel').addEventListener('show.bs.modal', function (event) {
        if (!event.relatedTarget) return;
        document.getElementById('delete-channel-name').textContent = event.relatedTarget?.dataset.channelName ?? '';
        document.getElementById('delete-channel-id').value = event.relatedTarget?.dataset.channelId ?? '';
        document.getElementById('delete-channel-confirm').disabled = !event.relatedTarget?.dataset.channelId;
    });
</script>
}
