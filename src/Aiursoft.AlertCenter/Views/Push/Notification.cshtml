@model Aiursoft.AlertCenter.Models.PushViewModel
@{
    var notification = Model.Notifications.Single();
    var message = notification.Delivery.Incident;
    ViewData["Title"] = string.Format(@Localizer["Notification details - {0}"].Value, message?.Title ?? @Localizer["Channel test notification"].Value);
    var isUnread = notification.ReadAtUtc == null;
    var levelBadge = message?.Level switch
    {
        "sev0" => "ac-badge-sev0",
        "sev1" => "ac-badge-sev1",
        "sev2" => "ac-badge-sev2",
        "sev3" => "ac-badge-sev3",
        "sev4" => "ac-badge-sev4",
        _ => null
    };
}
@section styles {
    <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" />
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Inbox" class="btn btn-outline-secondary">
            <i class="align-middle me-1" data-lucide="arrow-left" aria-hidden="true"></i>@Localizer["Back to In-App Notifications"]
        </a>
        @if (isUnread)
        {
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@Localizer["Unread notifications"]</span>
        }
        else
        {
            <span class="badge bg-light text-muted border">@Localizer["Read"]</span>
        }
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (isUnread)
        {
            <form asp-action="MarkRead" asp-route-returnToNotification="true" method="post" data-action-feedback>
                <input type="hidden" name="id" value="@notification.Id" />
                <button class="btn btn-outline-primary">
                    <i class="align-middle me-1" data-lucide="check" aria-hidden="true"></i>@Localizer["Mark as read"]
                </button>
            </form>
        }
        @if (message != null)
        {
            <a asp-controller="Incidents" asp-action="Details" asp-route-id="@message.Id" class="btn btn-outline-secondary">
                <i class="align-middle me-1" data-lucide="external-link" aria-hidden="true"></i>@Localizer["View original incident"]
            </a>
        }
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-transparent py-4 border-bottom">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            @if (levelBadge != null)
            {
                <span class="badge @levelBadge font-monospace">@message!.Level</span>
            }
            @if (message != null)
            {
                <span class="badge bg-secondary-subtle text-secondary font-monospace">@message.Application.Name</span>
            }
            <span class="text-muted small ms-auto font-monospace">
                <i data-lucide="clock" style="width: 13px; height: 13px;" class="align-middle me-1" aria-hidden="true"></i>
                @notification.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC
            </span>
        </div>
        <h1 class="h3 mb-1 text-break">@(message?.Title ?? @Localizer["Channel test notification"].Value)</h1>
        <small class="text-muted">
            @(notification.Delivery.Channel != null ? string.Format(@Localizer["Dispatched via in-app notification channel {0}"].Value, notification.Delivery.Channel.Name) : @Localizer["In-app notification dispatch"].Value)
            @if (notification.ReadAtUtc != null)
            {
                <span> · @Localizer["At "]@notification.ReadAtUtc.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC @Localizer["Read"]</span>
            }
        </small>
    </div>
    <div class="card-body py-4">
        <h2 class="h6 text-uppercase text-muted fw-semibold mb-3">@Localizer["Notification Body Content"]</h2>
        @{
            var body = message == null ? notification.Delivery.TestContent ?? @Localizer["This is a test message for the push channel."].Value : message.Content;
        }
        <div class="ac-prose">@(string.IsNullOrWhiteSpace(body) ? @Localizer["No body content"].Value : body)</div>
    </div>
</div>

@if (message?.ContextJson != null)
{
    <div id="notification-copy-feedback" role="status" aria-live="polite" aria-atomic="true"></div>
    <div class="card shadow-sm border-0 mb-4">
        <div class="ac-code-container">
            <div class="ac-code-header">
                <div class="d-flex align-items-center gap-2">
                    <i data-lucide="braces" style="width: 14px; height: 14px;" class="text-primary" aria-hidden="true"></i>
                    <span class="fw-semibold">@Localizer["Business Context (Context JSON)"]</span>
                </div>
                <button type="button" class="ac-copy-btn" data-copy-target="notification-context-code" data-copy-feedback="notification-copy-feedback">
                    <i data-lucide="copy" style="width: 12px; height: 12px;" aria-hidden="true"></i>@Localizer["Copy JSON"]
                </button>
            </div>
            <pre class="ac-code-pre"><code id="notification-context-code">@message.ContextJson</code></pre>
        </div>
    </div>
}

@section scripts {
    <script src="~/scripts/clipboard.js" asp-append-version="true"></script>
}
