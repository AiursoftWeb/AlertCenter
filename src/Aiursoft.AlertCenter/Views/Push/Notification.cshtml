@model Aiursoft.AlertCenter.Models.PushViewModel
@{
    var notification = Model.Notifications.Single();
    var message = notification.Delivery.Message;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <a asp-action="Inbox" class="btn btn-outline-secondary"><i class="align-middle me-1" data-lucide="arrow-left" aria-hidden="true"></i>返回站内通知</a>
    @if (notification.ReadAtUtc == null)
    {
        <form asp-action="MarkRead" asp-route-returnToNotification="true" method="post">
            <input type="hidden" name="id" value="@notification.Id" />
            <button class="btn btn-outline-primary">标为已读</button>
        </form>
    }
    else
    {
        <span class="text-muted">已读</span>
    }
</div>
<h1 class="h3 text-break">@(message?.Title ?? "渠道测试通知")</h1>
@if (message != null) { <p class="text-muted">@message.Application.Name · @message.Level</p> }
<div class="card"><div class="card-body text-break" style="white-space: pre-wrap;">@(message == null ? "这是一条推送渠道测试消息。" : message.Content ?? "无")</div></div>
@if (message?.ContextJson != null) { <div class="card"><div class="card-header">业务上下文</div><div class="card-body"><pre><code>@message.ContextJson</code></pre></div></div> }
