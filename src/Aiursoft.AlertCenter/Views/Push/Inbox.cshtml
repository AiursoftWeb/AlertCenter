@model Aiursoft.AlertCenter.Models.PushViewModel
@using System.Globalization
@{
    ViewData["Title"] = @Localizer["In-app notification inbox"].Value;
    var filter = Model.InboxFilter;
    var routes = filter.ToRouteValues();
    var hasFilters = filter.Keyword != null || filter.ApplicationId.HasValue || filter.ChannelId.HasValue ||
        filter.Level != null || filter.FromDate.HasValue || filter.ToDate.HasValue;
}
@section styles {
    <link rel="stylesheet" href="~/styles/inbox.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" />
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h1 class="h3 mb-0">@Localizer["In-app notification inbox"]</h1>
            @if (Model.UnreadCount > 0)
            {
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1">
                    <span class="ac-status-dot dot-info"></span>@Model.UnreadCount @Localizer["Unread"]
                </span>
            }
            else
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1">
                    <i data-lucide="check" style="width: 12px; height: 12px;" class="align-middle me-1" aria-hidden="true"></i>@Localizer["All read"]
                </span>
            }
        </div>
        <p class="text-muted mb-0 small">@Localizer["Personal Incident and Notification Center · Independent Read Status Tracking"]</p>
    </div>
    <div class="text-sm-end">
        <form asp-action="MarkAllRead" asp-all-route-data="routes" method="post" data-action-feedback>
            <button class="btn btn-outline-primary" disabled="@(Model.UnreadCount == 0 || !ViewData.ModelState.IsValid)" aria-describedby="mark-all-hint">
                <i class="align-middle me-1" data-lucide="check-check" aria-hidden="true"></i>@Localizer["Mark all my notifications as read"]
            </button>
        </form>
        <small id="mark-all-hint" class="text-muted d-block mt-1">@Localizer["Process all my unread notifications, regardless of current filters and pagination."]</small>
    </div>
</div>

<!-- Status Tabs Bar -->
<div class="d-flex flex-wrap gap-2 mb-3" aria-label="@Localizer["Notification Read Status"]">
    @foreach (var status in new[] { (Value: "unread", Label: @Localizer["Show unread only"].Value), (Value: "all", Label: @Localizer["All notifications"].Value), (Value: "read", Label: @Localizer["Show read only"].Value) })
    {
        var statusRoutes = filter.ToRouteValues(1);
        statusRoutes["readStatus"] = status.Value;
        var selected = filter.ReadStatus == status.Value;
        <a id="inbox-status-@status.Value"
           asp-action="Inbox"
           asp-all-route-data="statusRoutes"
           class="btn @(selected ? "btn-primary" : "btn-outline-secondary")"
           aria-current="@(selected ? "page" : null)">@status.Label</a>
    }
</div>

<!-- Filter Card -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="Inbox" method="get" class="row g-3 align-items-end" id="inbox-filters">
            <div class="col-md-6 col-xl-4">
                <label for="filter-keyword" class="form-label small text-muted mb-1">@Localizer["Keyword Search"]</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i data-lucide="search" style="width: 15px; height: 15px;" aria-hidden="true"></i></span>
                    <input id="filter-keyword" name="keyword" value="@filter.Keyword" maxlength="200" class="form-control" placeholder="@Localizer["Search title or body..."]" />
                </div>
            </div>
            <div class="col-sm-6 col-xl-2">
                <label for="filter-read-status" class="form-label small text-muted mb-1">@Localizer["Read Status"]</label>
                <select id="filter-read-status" name="readStatus" class="form-select">
                    <option value="unread" selected="@(filter.ReadStatus == "unread")">@Localizer["Unread notifications"]</option>
                    <option value="read" selected="@(filter.ReadStatus == "read")">@Localizer["Read notification"]</option>
                    <option value="all" selected="@(filter.ReadStatus == "all")">@Localizer["All notifications"]</option>
                </select>
            </div>
            <div class="col-sm-6 col-xl-3">
                <label for="filter-application" class="form-label small text-muted mb-1">@Localizer["Source application"]</label>
                <select id="filter-application" name="applicationId" class="form-select">
                    <option value="">@Localizer["All applications"]</option>
                    @if (filter.ApplicationId.HasValue && Model.Applications.All(application => application.Id != filter.ApplicationId.Value))
                    {
                        <option value="@filter.ApplicationId" selected>@Localizer["No notifications for the selected application"]</option>
                    }
                    @foreach (var application in Model.Applications)
                    {
                        <option value="@application.Id" selected="@(filter.ApplicationId == application.Id)">@application.Name</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-xl-3">
                <label for="filter-level" class="form-label small text-muted mb-1">@Localizer["Incident severity"]</label>
                <select id="filter-level" name="level" class="form-select">
                    <option value="">@Localizer["All severities (including test)"]</option>
                    <option value="sev0" selected="@(filter.Level == "sev0")">@Localizer["sev0 · Critical (P0)"]</option>
                    <option value="sev1" selected="@(filter.Level == "sev1")">@Localizer["sev1 · Major (P1)"]</option>
                    <option value="sev2" selected="@(filter.Level == "sev2")">@Localizer["sev2 · Error (P2)"]</option>
                    <option value="sev3" selected="@(filter.Level == "sev3")">@Localizer["sev3 · Warning (P3)"]</option>
                    <option value="sev4" selected="@(filter.Level == "sev4")">@Localizer["sev4 · Info (P4)"]</option>
                </select>
            </div>
            <div class="col-sm-6 col-xl-4">
                <label for="filter-channel" class="form-label small text-muted mb-1">@Localizer["Notification Channel"]</label>
                <select id="filter-channel" name="channelId" class="form-select">
                    <option value="">@Localizer["All channels"]</option>
                    @if (filter.ChannelId.HasValue && Model.Channels.All(channel => channel.Id != filter.ChannelId.Value))
                    {
                        <option value="@filter.ChannelId" selected>@Localizer["No notifications for the selected channel."]</option>
                    }
                    @foreach (var channel in Model.Channels)
                    {
                        <option value="@channel.Id" selected="@(filter.ChannelId == channel.Id)">@channel.Name</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-xl-3">
                <label for="filter-from-date" class="form-label small text-muted mb-1">@Localizer["Reception Start Date (UTC)"]</label>
                <input id="filter-from-date" name="fromDate" type="date" value="@(filter.FromDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" class="form-control" />
            </div>
            <div class="col-sm-6 col-xl-3">
                <label for="filter-to-date" class="form-label small text-muted mb-1">@Localizer["Reception End Date (UTC, inclusive)"]</label>
                <input id="filter-to-date" name="toDate" type="date" value="@(filter.ToDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" class="form-control" />
            </div>
            <div class="col-xl-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="align-middle me-1" data-lucide="search" aria-hidden="true"></i>@Localizer["Search"]
                </button>
                <a asp-action="Inbox" class="btn btn-outline-secondary text-nowrap" title="@Localizer["Reset Search Criteria"]">
                    <i data-lucide="rotate-ccw" style="width: 15px; height: 15px;" aria-hidden="true"></i>
                </a>
            </div>
            <div asp-validation-summary="All" class="text-danger mb-0 small"></div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center gap-2 mb-3">
    <small class="text-muted">@Localizer["Sorted by receipt time (descending) · 20 items per page"]</small>
    <a asp-action="Inbox" asp-all-route-data="routes" class="btn btn-sm btn-outline-secondary">
        <i class="align-middle me-1" data-lucide="refresh-cw" aria-hidden="true"></i>@Localizer["Refresh notifications"]
    </a>
</div>

<!-- Notifications Card -->
<div class="card shadow-sm border-0">
    @if (Model.Notifications.Count == 0)
    {
        <div class="ac-empty-state">
            <div class="ac-empty-icon">
                <i data-lucide="bell-off" aria-hidden="true"></i>
            </div>
            <h2 class="h5 mb-2">@(!ViewData.ModelState.IsValid ? @Localizer["Please correct the filter conditions."].Value : hasFilters || Model.Page > 1 ? @Localizer["No notifications under the current filter or page"].Value : filter.ReadStatus == "unread" ? @Localizer["No unread notifications"].Value : filter.ReadStatus == "read" ? @Localizer["No read notifications"].Value : @Localizer["No notifications yet"].Value)</h2>
            <p class="text-muted mb-3" style="max-width: 24rem; margin-inline: auto;">
                @(hasFilters ? @Localizer["Adjust filters or reset to view other notifications."].Value : @Localizer["When the system generates incidents bound to the in-site channel, they are pushed directly to your personal inbox."].Value)
            </p>
            @if (hasFilters)
            {
                <a asp-action="Inbox" class="btn btn-outline-secondary btn-sm">@Localizer["Clear all filters"]</a>
            }
        </div>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var notification in Model.Notifications)
            {
                var message = notification.Delivery.Incident;
                var isUnread = notification.ReadAtUtc == null;
                var levelClass = message?.Level switch
                {
                    "sev0" => "ac-row-sev0",
                    "sev1" => "ac-row-sev1",
                    "sev2" => "ac-row-sev2",
                    "sev3" => "ac-row-sev3",
                    "sev4" => "ac-row-sev4",
                    _ => ""
                };
                var levelBadgeClass = message?.Level switch
                {
                    "sev0" => "ac-badge-sev0",
                    "sev1" => "ac-badge-sev1",
                    "sev2" => "ac-badge-sev2",
                    "sev3" => "ac-badge-sev3",
                    _ => "ac-badge-sev4"
                };

                <div class="list-group-item p-4 inbox-notification ac-inbox-item @levelClass @(isUnread ? "is-unread" : "")">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                        <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
                            @if (isUnread)
                            {
                                <span class="badge bg-primary px-2 py-0.5 small flex-shrink-0">@Localizer["Unread"]</span>
                            }
                            @if (message != null)
                            {
                                <span class="badge @levelBadgeClass font-monospace flex-shrink-0">@message.Level</span>
                            }
                            <h2 class="h5 mb-0 inbox-notification-title text-break">
                                @(message?.Title ?? @Localizer["Channel test notification"].Value)
                            </h2>
                        </div>
                        <small class="text-muted text-nowrap font-monospace small">
                            <i data-lucide="clock" style="width: 12px; height: 12px;" class="align-middle me-1" aria-hidden="true"></i>
                            @notification.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC
                        </small>
                    </div>

                    @if (message != null)
                    {
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-light text-secondary border small inbox-notification-channel">
                                <i data-lucide="layers" style="width: 12px; height: 12px;" class="me-1" aria-hidden="true"></i>@message.Application.Name
                            </span>
                        </div>
                    }

                    <p class="text-muted mb-3 inbox-notification-preview font-monospace small" style="line-height: 1.6;">@(message == null ? notification.Delivery.TestContent ?? @Localizer["This is a test message for the push channel."].Value : message.Content)</p>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-2 border-top">
                        <small class="text-muted inbox-notification-channel d-flex align-items-center gap-1">
                            <i data-lucide="bell" style="width: 13px; height: 13px;" aria-hidden="true"></i>
                            <span>@Localizer["Channel"]: @notification.Delivery.Channel?.Name</span>
                        </small>
                        <div class="d-flex flex-wrap align-items-center gap-2 flex-shrink-0">
                            <a asp-action="Notification" asp-route-id="@notification.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="align-middle me-1" data-lucide="eye" aria-hidden="true"></i>@Localizer["View details"]
                            </a>
                            @if (isUnread)
                            {
                                <form asp-action="MarkRead" asp-all-route-data="routes" method="post" data-action-feedback class="d-inline">
                                    <input type="hidden" name="id" value="@notification.Id" />
                                    <button class="btn btn-sm btn-outline-primary">
                                        <i class="align-middle me-1" data-lucide="check" aria-hidden="true"></i>@Localizer["Mark as read"]
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border small align-self-center py-1.5 px-2">
                                    <i data-lucide="check-check" style="width: 12px; height: 12px;" class="me-1" aria-hidden="true"></i>@Localizer["Read"]
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (ViewData.ModelState.IsValid && (Model.Notifications.Count > 0 || Model.Page > 1))
    {
        <div class="card-footer bg-light border-top p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <small class="text-muted">@Localizer["Currently displaying page"] <span class="fw-semibold text-dark">@Model.Page</span> @Localizer["Page"]</small>
            <nav class="d-flex flex-wrap align-items-center gap-2" aria-label="@Localizer["In-app notification pagination"]">
                @if (Model.Page > 1)
                {
                    <a asp-action="Inbox" asp-all-route-data="filter.ToRouteValues(Model.Page - 1)" class="btn btn-sm btn-outline-secondary">@Localizer["Previous Page"]</a>
                }
                <form id="inbox-page-jump-form" asp-action="Inbox" asp-all-route-data="filter.ToRouteValues(1)" method="get" class="d-flex align-items-center gap-1">
                    <label for="inbox-page-jump" class="visually-hidden">@Localizer["Jump to page number"]</label>
                    <span class="small text-muted">@Localizer["Go to"]</span>
                    <input id="inbox-page-jump" name="page" type="number" value="@Model.Page" min="1" max="1000000" step="1" class="form-control form-control-sm text-center" style="width: 4.5rem" required />
                    <span class="small text-muted">@Localizer["Page"]</span>
                    <button type="submit" class="btn btn-sm btn-outline-secondary">@Localizer["Jump"]</button>
                </form>
                @if (Model.HasNextPage)
                {
                    <a asp-action="Inbox" asp-all-route-data="filter.ToRouteValues(Model.Page + 1)" class="btn btn-sm btn-outline-primary">@Localizer["Next Page"]</a>
                }
            </nav>
        </div>
    }
</div>
