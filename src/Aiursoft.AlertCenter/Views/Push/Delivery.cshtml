@using Aiursoft.WebTools
@model Aiursoft.AlertCenter.Models.PushViewModel
@using Aiursoft.AlertCenter.Entities
@{
    var delivery = Model.Delivery!;
    var incidentEvent = delivery.IncidentEvent;
    var level = delivery.Incident?.Level ?? incidentEvent?.NewLevel;
    ViewData["Title"] = string.Format(@Localizer["Delivery details - {0}"].Value, delivery.Incident?.Title ?? incidentEvent?.Incident.Title ?? @Localizer["Channel test"].Value);
    var snapshot = delivery.OnCallEmail;
    var typeKey = snapshot != null ? "email" : delivery.Channel?.Type;
    var channelType = Model.ChannelTypes.FirstOrDefault(type => type.Key == typeKey);
    var channelEnabled = snapshot != null || delivery.Channel?.IsEnabled == true;
    var canRetry = channelEnabled && (snapshot == null || (snapshot.ValidationError == null && snapshot.Recipients.Count > 0));
    var latency = delivery.CompletedAtUtc.HasValue && delivery.AttemptedAtUtc.HasValue
        ? (delivery.CompletedAtUtc.Value - delivery.AttemptedAtUtc.Value).TotalMilliseconds
        : (double?)null;
}
@section styles {
    <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" />
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Records" class="btn btn-outline-secondary">
            <i class="align-middle me-1" data-lucide="arrow-left" aria-hidden="true"></i>@Localizer["Back to Push Records"]
        </a>
        <div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="h3 mb-0">@Localizer["Delivery Details"]</h1>
                <partial name="_DeliveryStatus" model="delivery.Status" />
            </div>
            <p class="text-muted mb-0 small">@Localizer["Delivery ID:"] <code class="text-secondary">@delivery.Id</code></p>
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (delivery.IncidentId.HasValue)
        {
            <a asp-controller="Incidents" asp-action="Details" asp-route-id="@delivery.IncidentId" class="btn btn-outline-secondary">
                <i class="align-middle me-1" data-lucide="external-link" aria-hidden="true"></i>@Localizer["View original incident"]
            </a>
        }
        @if (incidentEvent != null)
        {
            <a asp-controller="Incidents" asp-action="Details" asp-route-id="@incidentEvent.IncidentId" class="btn btn-outline-secondary">@Localizer["View reopened incident"]</a>
        }
        @if (typeKey == "inapp" && delivery.Status == PushDelivery.Succeeded)
        {
            <a asp-action="Inbox" class="btn btn-outline-primary">
                <i class="align-middle me-1" data-lucide="inbox" aria-hidden="true"></i>@Localizer["View in-app notifications"]
            </a>
        }
    </div>
</div>

<!-- Status Callouts -->
@if (delivery.Status == PushDelivery.Failed)
{
    <div class="alert alert-danger mb-4" role="alert">
        <div class="alert-icon d-flex align-items-center">
            <i data-lucide="alert-triangle" aria-hidden="true"></i>
        </div>
        <div class="alert-message">
            <h2 class="h5 alert-heading mb-1">@Localizer["Delivery Failed"]</h2>
            <div class="text-break font-monospace small mb-2">@delivery.Error</div>
            <p class="small mb-0">@(snapshot != null ? @Localizer["On-call email retries always use the OCE and CC snapshots from when the message was enqueued and do not redirect to the current on-call personnel. Retries are not available if no valid snapshot exists."].Value : @Localizer["Redelivery will use the latest channel configuration."].Value) @Localizer["Target may have already received it upon timeout or interruption. Please verify before retrying."]</p>
            @if (Model.CanRetryDelivery)
            {
                <div class="mt-3">
                    <form asp-action="Retry" method="post" data-action-feedback class="d-inline">
                        <input type="hidden" name="id" value="@delivery.Id" />
                        <button class="btn btn-danger" disabled="@(!canRetry)">
                            <i class="align-middle me-1" data-lucide="refresh-cw" aria-hidden="true"></i>@Localizer["Redeliver"]
                        </button>
                    </form>
                    @if (!canRetry)
                    {
                        <small class="d-block mt-1">@(snapshot != null ? @Localizer["Invalid recipient snapshot. Cannot resend old incidents."].Value : @Localizer["Please enable the target channel first."].Value)</small>
                    }
                </div>
            }
        </div>
    </div>
}
else if (delivery.Status == PushDelivery.Succeeded)
{
    <div class="alert alert-success mb-4" role="status">
        <div class="alert-icon d-flex align-items-center">
            <i data-lucide="check-circle-2" aria-hidden="true"></i>
        </div>
        <div class="alert-message d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">
            <div>
                <strong class="d-block">@Localizer["Delivery completed successfully"]</strong>
                <small>
                    @Localizer["Duration"]: @(latency.HasValue ? $"{latency.Value:N0} ms" : @Localizer["Complete immediately"].Value) · @Localizer["Attempts"]: @delivery.Attempts
                </small>
            </div>
            <div class="small font-monospace">
                @Localizer["Completed at "]<span data-utc-time="@delivery.CompletedAtUtc?.ToHtmlDateTime()">@(delivery.CompletedAtUtc == null ? "—" : "")</span>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-primary mb-4" role="status">
        <div class="alert-icon d-flex align-items-center">
            <div class="spinner-border spinner-border-sm" aria-hidden="true"></div>
        </div>
        <div class="alert-message d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3">
            <div>
                <strong class="d-block">@Localizer["Dispatching deliveries in the background"]</strong>
                <small>@Localizer["Async task is queued. Please refresh status later."]</small>
            </div>
            <a asp-action="Delivery" asp-route-id="@delivery.Id" class="btn btn-sm btn-primary flex-shrink-0">
                <i class="align-middle me-1" data-lucide="refresh-cw" aria-hidden="true"></i>@Localizer["Refresh status"]
            </a>
        </div>
    </div>
}

<div class="row g-4">
    <!-- Left Column: Payload & Execution Lifecycle -->
    <div class="col-lg-8">
        <!-- Message Payload Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">
                <h2 class="card-title h5 mb-0">
                    <i data-lucide="message-square" style="width: 18px; height: 18px;" class="text-primary me-2" aria-hidden="true"></i>
                    @Localizer["Delivery Content"]
                </h2>
                @if (level != null)
                {
                    var levelBadge = level switch
                    {
                        "sev0" => "ac-badge-sev0",
                        "sev1" => "ac-badge-sev1",
                        "sev2" => "ac-badge-sev2",
                        "sev3" => "ac-badge-sev3",
                        _ => "ac-badge-sev4"
                    };
                    <span class="badge @levelBadge font-monospace">@level</span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary">@Localizer["Manual Test Message"]</span>
                }
            </div>
            <div class="card-body">
                <h3 class="h5 mb-3 text-break">@(delivery.Incident?.Title ?? (incidentEvent != null ? (incidentEvent.Type switch
                                                {
                                                    IncidentTimelineEntry.Mitigated => string.Format(Localizer["Incident mitigated: {0}"].Value, incidentEvent.Incident.Title),
                                                    IncidentTimelineEntry.Resolved => string.Format(Localizer["Incident resolved: {0}"].Value, incidentEvent.Incident.Title),
                                                    _ => incidentEvent.Incident.Title
                                                }) : @Localizer["Channel test notification"].Value))</h3>
                @{
                    var payload = delivery.Incident?.Content ?? (incidentEvent != null ? incidentEvent.Note : delivery.Incident == null ? delivery.TestContent ?? @Localizer["This is a test message for the push channel."].Value : null);
                }
                <div class="ac-prose">@(string.IsNullOrWhiteSpace(payload) ? @Localizer["No body content"].Value : payload)</div>
            </div>
        </div>

        <!-- Timeline Lifecycle Card -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-transparent py-3">
                <h2 class="card-title h5 mb-0">
                    <i data-lucide="clock" style="width: 18px; height: 18px;" class="text-primary me-2" aria-hidden="true"></i>
                    @Localizer["Dispatch timeline"]
                </h2>
            </div>
            <div class="card-body">
                <div class="ac-timeline">
                    <!-- Step 1: Created -->
                    <div class="ac-timeline-item">
                        <div class="ac-timeline-badge">
                            <i data-lucide="plus" style="width: 16px; height: 16px;" class="text-muted" aria-hidden="true"></i>
                        </div>
                        <div class="ac-timeline-content">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong>@Localizer["Delivery task created"]</strong>
                                <small class="text-muted font-monospace"><span data-utc-time="@delivery.CreatedAtUtc.ToHtmlDateTime()"></span></small>
                            </div>
                            <small class="text-muted d-block mt-1">@Localizer["Enter Delivery Queue"]</small>
                        </div>
                    </div>

                    <!-- Step 2: Attempted -->
                    <div class="ac-timeline-item">
                        <div class="ac-timeline-badge">
                            <i data-lucide="send" style="width: 16px; height: 16px;" class="text-primary" aria-hidden="true"></i>
                        </div>
                        <div class="ac-timeline-content">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong>@Localizer["Initiate dispatch request"]</strong>
                                <small class="text-muted font-monospace"><span data-utc-time="@delivery.AttemptedAtUtc?.ToHtmlDateTime()">@(delivery.AttemptedAtUtc == null ? Localizer["Pending dispatch"].Value : "")</span></small>
                            </div>
                            <small class="text-muted d-block mt-1">@Localizer["Total attempts: "]@delivery.Attempts @Localizer["times"]</small>
                        </div>
                    </div>

                    <!-- Step 3: Finished -->
                    <div class="ac-timeline-item">
                        <div class="ac-timeline-badge @(delivery.Status == PushDelivery.Succeeded ? "badge-resolved" : delivery.Status == PushDelivery.Failed ? "badge-triggered" : "")">
                            @if (delivery.Status == PushDelivery.Succeeded)
                            {
                                <i data-lucide="check" style="width: 16px; height: 16px;" class="text-success" aria-hidden="true"></i>
                            }
                            else if (delivery.Status == PushDelivery.Failed)
                            {
                                <i data-lucide="x" style="width: 16px; height: 16px;" class="text-danger" aria-hidden="true"></i>
                            }
                            else
                            {
                                <i data-lucide="loader" style="width: 16px; height: 16px;" class="text-primary" aria-hidden="true"></i>
                            }
                        </div>
                        <div class="ac-timeline-content">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong>
                                    @(delivery.Status == PushDelivery.Succeeded ? @Localizer["Delivery completed successfully"].Value : delivery.Status == PushDelivery.Failed ? @Localizer["Delivery failed permanently"].Value : @Localizer["Running..."].Value)
                                </strong>
                                <small class="text-muted font-monospace"><span data-utc-time="@delivery.CompletedAtUtc?.ToHtmlDateTime()">@(delivery.CompletedAtUtc == null ? Localizer["Incomplete"].Value : "")</span></small>
                            </div>
                            @if (delivery.Status == PushDelivery.Failed && !string.IsNullOrEmpty(delivery.Error))
                            {
                                <div class="text-danger small mt-1 font-monospace text-break">@delivery.Error</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Meta & Channel Card -->
    <div class="col-lg-4">
        <!-- Channel Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent py-3">
                <h2 class="card-title h5 mb-0">@Localizer["Target Channel"]</h2>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-3 p-2 bg-light border text-primary">
                        <i data-lucide="@(typeKey == "webhook" ? "webhook" : typeKey == "email" ? "mail" : "bell")" style="width: 22px; height: 22px;" aria-hidden="true"></i>
                    </div>
                    <div>
                        <h3 class="h6 mb-0">@(snapshot != null ? string.Format(@Localizer["Built-in On-call Email · {0}"].Value, snapshot.GroupName) : delivery.Channel?.Name)</h3>
                        <small class="text-muted">@(snapshot != null ? @Localizer["Built-in system · Cannot be disabled individually"].Value : channelType?.Name ?? typeKey)</small>
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 border-top">
                    <span class="text-muted small">@Localizer["Channel enabled status"]</span>
                    @if (channelEnabled)
                    {
                        <span class="badge bg-success-subtle text-success">@Localizer["Enabled"]</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger">@Localizer["Disabled"]</span>
                    }
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 border-top">
                    <span class="text-muted small">@Localizer["Source integrated application"]</span>
                    <span class="fw-semibold small">@(delivery.Incident?.Application.Name ?? incidentEvent?.Incident.Application.Name ?? @Localizer["Manual Test"].Value)</span>
                </div>
                @if (snapshot != null)
                {
                    <div class="border-top pt-3 small">
                        <p class="mb-1">@Localizer["Snapshot time"]: <span data-utc-time="@snapshot.NotificationAtUtc.ToHtmlDateTime()"></span></p>
                        <p class="mb-1">@Localizer["Shift: "]<span data-utc-time="@snapshot.StartsAtUtc?.ToHtmlDateTime()"></span> — <span data-utc-time="@snapshot.EndsAtUtc?.ToHtmlDateTime()"></span></p>
                        <p class="mb-1">OCE：@string.Join("、", snapshot.Recipients.Select(recipient => recipient.DisplayName))</p>
                        @if (Model.CanManagePush)
                        {
                            <p class="mb-1 text-break">To：@string.Join("; ", snapshot.Recipients.Select(recipient => recipient.Email).Distinct(StringComparer.OrdinalIgnoreCase))</p>
                            <p class="mb-0 text-break">CC：@(string.IsNullOrWhiteSpace(snapshot.CcRecipients) ? @Localizer["None"].Value : snapshot.CcRecipients)</p>
                        }
                    </div>
                }
                @if (Model.CanManagePush && delivery.Channel != null)
                {
                    <div class="mt-3">
                        <a asp-action="Edit" asp-route-id="@delivery.Channel.Id" class="btn btn-outline-secondary btn-sm w-100">
                            <i class="align-middle me-1" data-lucide="sliders" aria-hidden="true"></i>@Localizer["View or modify channel configuration"]
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Task Metadata Card -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-transparent py-3">
                <h2 class="card-title h5 mb-0">@Localizer["Task metadata"]</h2>
            </div>
            <div class="card-body p-0">
                <div id="delivery-copy-feedback" class="px-3" role="status" aria-live="polite" aria-atomic="true"></div>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted">@Localizer["Delivery ID"]</span>
                        <div class="d-flex align-items-center gap-1">
                            <code class="text-break">@delivery.Id.ToString().Substring(0, 8)...</code>
                            <button type="button" class="btn btn-sm btn-link p-0 text-muted" data-copy-text="@delivery.Id" data-copy-feedback="delivery-copy-feedback" title="@Localizer["Copy Full ID"]" aria-label="@Localizer["Copy Full Delivery ID"]">
                                <i data-lucide="copy" style="width: 14px; height: 14px;" aria-hidden="true"></i>
                            </button>
                        </div>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted">@Localizer["Dispatch attempts"]</span>
                        <span class="badge bg-secondary-subtle text-secondary font-monospace">@delivery.Attempts @Localizer["times"]</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted">@Localizer["Creation Time"]</span>
                        <span class="font-monospace"><span data-utc-time="@delivery.CreatedAtUtc.ToHtmlDateTime()"></span></span>
                    </li>
                    @if (delivery.CompletedAtUtc.HasValue)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted">@Localizer["Completion Time"]</span>
                            <span class="font-monospace"><span data-utc-time="@delivery.CompletedAtUtc.Value.ToHtmlDateTime()"></span></span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/scripts/clipboard.js" asp-append-version="true"></script>
}
