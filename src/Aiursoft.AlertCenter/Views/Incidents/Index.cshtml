@using Aiursoft.WebTools
@model Aiursoft.AlertCenter.Models.IncidentsViewModel
@using Aiursoft.AlertCenter.Entities
@using System.Globalization
@{
    ViewData["Title"] = Model.Filter.OnlyMine ? @Localizer["My incidents"].Value : @Localizer["Incident Handling Center"].Value;
    var listAction = Model.Filter.OnlyMine ? "Mine" : "Index";
    var filter = Model.Filter;
    var hasFilters = filter.Keyword != null || filter.ApplicationId.HasValue || filter.Status != "all" || filter.Level != null ||
        filter.FromDate.HasValue || filter.ToDate.HasValue || filter.Acknowledged.HasValue;

    (string PillClass, string Icon, string Text) StatusInfo(string status) => status switch
    {
        Incident.New => ("ac-status-pill-failed", "alert-triangle", @Localizer["Unmitigated"].Value),
        Incident.Mitigated => ("ac-status-pill-sending", "shield-check", @Localizer["Mitigated"].Value),
        Incident.Resolved => ("ac-status-pill-succeeded", "check-circle-2", @Localizer["Resolved"].Value),
        _ => ("ac-status-pill-pending", "circle-help", status)
    };
}
@section styles {
    <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" />
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 @(filter.OnlyMine ? "card border-primary shadow-sm p-4" : "")">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h1 class="h3 mb-0">
                @if (filter.OnlyMine) { <i data-lucide="user-check" class="text-primary me-2" aria-hidden="true"></i> }@(filter.OnlyMine ? @Localizer["My incidents"].Value : @Localizer["Incidents and emergency response"].Value)</h1>
            @if (Model.ActiveCount > 0)
            {
                <span class="badge bg-danger text-white px-2.5 py-1.5 d-inline-flex align-items-center gap-1.5">
                    <span class="ac-status-dot dot-danger ac-pulse-danger"></span>
                    <span>@string.Format(@Localizer["{0} ongoing incidents across accessible applications"].Value, Model.ActiveCount)</span>
                </span>
            }
            else
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 d-inline-flex align-items-center gap-1.5">
                    <span class="ac-status-dot dot-success ac-pulse"></span>
                    <span>@Localizer["No unresolved incidents in this queue"]</span>
                </span>
            }
        </div>
        <p class="text-muted mb-0 small">@(filter.OnlyMine ? @Localizer["These incidents belong to you because you were the last person to acknowledge them. Only applications you can access are included."].Value : @Localizer["Each report creates an independent incident. Acknowledge and assign, mitigate, resolve, and track progress here."].Value)</p>
    </div>
</div>

<!-- Quick Status Filter Chips -->
<div class="ac-filter-chips mb-3">
    <a asp-action="@listAction" asp-route-status="all" class="ac-chip @(filter.Status == "all" || string.IsNullOrEmpty(filter.Status) ? "active" : "")">
        <i data-lucide="layers" style="width: 14px; height: 14px;" aria-hidden="true"></i>
        <span>@Localizer["All incidents"]</span>
    </a>
    <a asp-action="@listAction" asp-route-status="new" class="ac-chip @(filter.Status == Incident.New ? "active" : "")">
        <i data-lucide="alert-triangle" style="width: 14px; height: 14px;" class="text-danger" aria-hidden="true"></i>
        <span>@Localizer["Unmitigated"]</span>
    </a>
    <a asp-action="@listAction" asp-route-acknowledged="true" class="ac-chip @(filter.Acknowledged == true ? "active" : "")">
        <i data-lucide="user-check" style="width: 14px; height: 14px;" class="text-warning" aria-hidden="true"></i>
        <span>@Localizer["Acknowledged"]</span>
    </a>
    <a asp-action="@listAction" asp-route-status="mitigated" class="ac-chip @(filter.Status == Incident.Mitigated ? "active" : "")">
        <i data-lucide="shield-check" style="width: 14px; height: 14px;" class="text-primary" aria-hidden="true"></i>
        <span>@Localizer["Mitigated"]</span>
    </a>
    <a asp-action="@listAction" asp-route-status="resolved" class="ac-chip @(filter.Status == Incident.Resolved ? "active" : "")">
        <i data-lucide="check-circle-2" style="width: 14px; height: 14px;" class="text-success" aria-hidden="true"></i>
        <span>@Localizer["Resolved"]</span>
    </a>
</div>

<!-- Search & Filter Card -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="@listAction" method="get" class="row g-3 align-items-end">
            <div class="col-md-6 col-xl-4">
                <label for="incident-keyword" class="form-label small text-muted mb-1">@Localizer["Keyword Search"]</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i data-lucide="search" style="width: 15px; height: 15px;" aria-hidden="true"></i></span>
                    <input id="incident-keyword" name="keyword" value="@filter.Keyword" class="form-control" maxlength="200" placeholder="@Localizer["Search incident titles, content, or applications..."]" />
                </div>
            </div>
            <div class="col-sm-6 col-xl-2">
                <label for="incident-application" class="form-label small text-muted mb-1">@Localizer["Source application"]</label>
                <select id="incident-application" name="applicationId" class="form-select">
                    <option value="">@Localizer["All applications"]</option>
                    @if (filter.ApplicationId.HasValue && Model.Applications.All(application => application.Id != filter.ApplicationId.Value))
                    {
                        <option value="@filter.ApplicationId" selected>@Localizer["The selected application is inaccessible"]</option>
                    }
                    @foreach (var application in Model.Applications)
                    {
                        <option value="@application.Id" selected="@(filter.ApplicationId == application.Id)">@application.Name</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-xl-2">
                <label for="incident-status" class="form-label small text-muted mb-1">@Localizer["Incident status"]</label>
                <select id="incident-status" name="status" class="form-select">
                    <option value="all" selected="@(filter.Status == "all")">@Localizer["All statuses"]</option>
                    <option value="new" selected="@(filter.Status == Incident.New)">@Localizer["Unmitigated"]</option>
                    <option value="mitigated" selected="@(filter.Status == Incident.Mitigated)">@Localizer["Mitigated (Mitigated)"]</option>
                    <option value="resolved" selected="@(filter.Status == Incident.Resolved)">@Localizer["Resolved (Resolved)"]</option>
                </select>
            </div>
            <div class="col-sm-6 col-xl-2">
                <label for="incident-acknowledged" class="form-label small text-muted mb-1">@Localizer["Acknowledgement"]</label>
                <select id="incident-acknowledged" name="acknowledged" class="form-select">
                    <option value="">@Localizer["All acknowledgements"]</option>
                    <option value="true" selected="@(filter.Acknowledged == true)">@Localizer["Acknowledged"]</option>
                    <option value="false" selected="@(filter.Acknowledged == false)">@Localizer["Not acknowledged"]</option>
                </select>
            </div>
            <div class="col-sm-6 col-xl-2">
                <label for="incident-level" class="form-label small text-muted mb-1">@Localizer["Incident severity"]</label>
                <select id="incident-level" name="level" class="form-select">
                    <option value="">@Localizer["All severities"]</option>
                    <option value="sev0" selected="@(filter.Level == "sev0")">= @Localizer["sev0 · Critical (P0)"]</option>
                    <option value="sev1" selected="@(filter.Level == "sev1")">= @Localizer["sev1 · Major (P1)"]</option>
                    <option value="lte-sev1" selected="@(filter.Level == "lte-sev1")">≤ @Localizer["sev1 · Major (P1)"]</option>
                    <option value="sev2" selected="@(filter.Level == "sev2")">= @Localizer["sev2 · Error (P2)"]</option>
                    <option value="lte-sev2" selected="@(filter.Level == "lte-sev2")">≤ @Localizer["sev2 · Error (P2)"]</option>
                    <option value="sev3" selected="@(filter.Level == "sev3")">= @Localizer["sev3 · Warning (P3)"]</option>
                    <option value="lte-sev3" selected="@(filter.Level == "lte-sev3")">≤ @Localizer["sev3 · Warning (P3)"]</option>
                    <option value="sev4" selected="@(filter.Level == "sev4")">= @Localizer["sev4 · Info (P4)"]</option>
                    <option value="lte-sev4" selected="@(filter.Level == "lte-sev4")">≤ @Localizer["sev4 · Info (P4)"]</option>
                </select>
            </div>
            <div class="col-sm-6 col-xl-3">
                <label for="incident-from-date" class="form-label small text-muted mb-1">@Localizer["Received from (UTC)"]</label>
                <input id="incident-from-date" name="fromDate" type="date" value="@(filter.FromDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" class="form-control" />
            </div>
            <div class="col-sm-6 col-xl-3">
                <label for="incident-to-date" class="form-label small text-muted mb-1">@Localizer["Received through (UTC, inclusive)"]</label>
                <input id="incident-to-date" name="toDate" type="date" value="@(filter.ToDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" class="form-control" />
            </div>
            <div class="col-xl-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="align-middle me-1" data-lucide="filter" aria-hidden="true"></i>@Localizer["Search"]
                </button>
                @if (hasFilters)
                {
                    <a asp-action="@listAction" class="btn btn-outline-secondary" title="@Localizer["Reset Filters"]">
                        <i data-lucide="rotate-ccw" style="width: 15px; height: 15px;" aria-hidden="true"></i>
                    </a>
                }
            </div>
            <div asp-validation-summary="All" class="text-danger mb-0 small"></div>
        </form>
    </div>
</div>

<!-- Incidents List Card -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">
        <h2 class="card-title h5 mb-0">@Localizer["Incident log list"]</h2>
        <span class="badge bg-light text-secondary border">@string.Format(@Localizer["{0} incidents on this page"].Value, Model.Incidents.Count)</span>
    </div>

    @if (Model.Incidents.Count == 0)
    {
        <div class="ac-empty-state">
            <div class="ac-empty-icon text-success">
                <i data-lucide="shield-check" aria-hidden="true"></i>
            </div>
            <h2 class="h5 mb-2">@(!ViewData.ModelState.IsValid ? @Localizer["Please correct the filter conditions."].Value : hasFilters ? @Localizer["No matching incidents"].Value : filter.OnlyMine ? @Localizer["You have no assigned incidents"].Value : @Localizer["No incident records yet"].Value)</h2>
            <p class="text-muted mb-3" style="max-width: 26rem; margin-inline: auto;">
                @(hasFilters ? @Localizer["Adjust filter conditions or reset to view all records."].Value : @Localizer["Each new incident automatically creates or associates an incident; confirm, record progress, and resolve issues here."].Value)
            </p>
            @if (hasFilters)
            {
                <a asp-action="@listAction" class="btn btn-outline-secondary btn-sm">@Localizer["Clear all filters"]</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3" style="min-width: 120px;">@Localizer["Status"]</th>
                        <th class="py-3" style="min-width: 260px;">@Localizer["Incident"]</th>
                        <th class="py-3">@Localizer["Source application"]</th>
                        <th class="py-3" style="min-width: 140px;">@Localizer["Owner (last ACK)"]</th>
                        <th class="py-3" style="min-width: 160px;">@Localizer["Original on-call OCE"]</th>
                        <th class="pe-4 py-3 text-end" style="min-width: 160px;">@Localizer["Received at"]</th>
                        <th class="py-3 text-center" style="width: 80px;">@Localizer["Enter"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var incident in Model.Incidents)
                    {
                        var status = StatusInfo(incident.Status);
                        var levelBadge = incident.Level switch
                        {
                            "sev0" => "ac-badge-sev0",
                            "sev1" => "ac-badge-sev1",
                            "sev2" => "ac-badge-sev2",
                            "sev3" => "ac-badge-sev3",
                            _ => "ac-badge-sev4"
                        };
                        var rowBorder = incident.Status switch
                        {
                            Incident.New => "border-start border-3 border-danger",
                            Incident.Mitigated => "border-start border-3 border-info",
                            _ => ""
                        };

                        <tr class="@rowBorder">
                            <td class="ps-4 py-3">
                                <span class="ac-status-pill @status.PillClass">
                                    <i data-lucide="@status.Icon" style="width: 13px; height: 13px;" aria-hidden="true"></i>
                                    <span>@status.Text</span>
                                </span>
                                <span class="badge bg-secondary-subtle text-secondary" data-acknowledged="@(incident.IsAcknowledged ? "true" : "false")">
                                    @(incident.IsAcknowledged ? @Localizer["Acknowledged"].Value : @Localizer["Not acknowledged"].Value)
                                </span>
                            </td>
                            <td class="py-3" style="max-width: 300px;">
                                <a asp-action="Details" asp-route-id="@incident.Id" class="fw-semibold text-decoration-none text-break d-block">
                                    @incident.Title
                                </a>
                                <small class="text-muted d-flex align-items-center gap-1.5 mt-0.5 text-break">
                                    <span class="badge @levelBadge font-monospace py-0 px-1.5" style="font-size: 0.725rem;">@incident.Level</span>
                                    <span class="text-truncate">@incident.Content</span>
                                </small>
                            </td>
                            <td class="py-3">
                                <span class="badge bg-secondary-subtle text-secondary font-monospace">@incident.Application.Name</span>
                            </td>
                            <td class="py-3 text-break fw-semibold" data-incident-owner="@incident.Id">
                                @(incident.IsAcknowledged ? incident.Owner?.DisplayName ?? incident.OwnerDisplayName : null)
                            </td>
                            <td class="py-3 text-break" data-incident-oce="@incident.Id">
                                @if (Model.OriginalOceNames.TryGetValue(incident.Id, out var originalOce))
                                {
                                    @(string.IsNullOrWhiteSpace(originalOce) ? @Localizer["No on-call OCE"].Value : originalOce)
                                }
                                else
                                {
                                    <span class="text-muted">@Localizer["Not recorded"]</span>
                                }
                            </td>
                            <td class="pe-4 py-3 text-end text-nowrap text-muted small font-monospace">
                                <span data-utc-time="@incident.ReceivedAtUtc.ToHtmlDateTime()"></span>
                            </td>
                            <td class="py-3 text-center">
                                <a asp-action="Details" asp-route-id="@incident.Id" class="btn btn-sm btn-outline-primary" title="@Localizer["Enter Response War Room"]">
                                    <i data-lucide="chevron-right" style="width: 15px; height: 15px;" aria-hidden="true"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.Incidents.Count > 0 || Model.Filter.Page > 1)
{
    <nav aria-label="@Localizer["Incident pages"]" class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3">
        @if (Model.Filter.Page > 1)
        {
            <a asp-action="@listAction" asp-all-route-data="Model.Filter.ToRouteValues(Model.Filter.Page - 1)" class="btn btn-outline-secondary">@Localizer["Previous page"]</a>
        }
        else
        {
            <span class="btn btn-outline-secondary disabled" aria-disabled="true">@Localizer["Previous page"]</span>
        }
        <span class="text-muted small" aria-current="page">@string.Format(@Localizer["Page {0}"].Value, Model.Filter.Page)</span>
        @if (Model.HasNextPage)
        {
            <a asp-action="@listAction" asp-all-route-data="Model.Filter.ToRouteValues(Model.Filter.Page + 1)" class="btn btn-outline-secondary">@Localizer["Next page"]</a>
        }
        else
        {
            <span class="btn btn-outline-secondary disabled" aria-disabled="true">@Localizer["Next page"]</span>
        }
    </nav>
}
