@model Aiursoft.AlertCenter.Models.IncidentsViewModel
@using Aiursoft.AlertCenter.Entities
@{
    var incident = Model.Incident!;
    ViewData["Title"] = string.Format(@Localizer["Incident War Room - {0}"].Value, incident.Title);
    var (statusPill, statusIcon, statusText, bannerClass) = incident.Status switch
    {
        Incident.New => ("ac-status-pill-failed", "alert-triangle", @Localizer["Pending Response (New)"].Value, "ac-incident-banner-triggered"),
        Incident.Acked => ("ac-status-pill-sending", "user-check", @Localizer["Acknowledged (Acked)"].Value, "ac-incident-banner-acknowledged"),
        Incident.Mitigated => ("ac-status-pill-sending", "shield-check", @Localizer["Mitigated (Mitigated)"].Value, "ac-incident-banner-acknowledged"),
        Incident.Resolved => ("ac-status-pill-succeeded", "check-circle-2", @Localizer["Resolved (Resolved)"].Value, "ac-incident-banner-resolved"),
        _ => ("ac-status-pill-pending", "circle-help", incident.Status, "")
    };
    var isActive = incident.Status != Incident.Resolved;
    var canChangeLevel = Model.CanManage && (incident.Status == Incident.New || incident.Status == Incident.Acked || incident.Status == Incident.Mitigated);
    var canReopen = Model.CanManage && (incident.Status == Incident.Mitigated || incident.Status == Incident.Resolved);

    string StatusText(string? status) => status switch
    {
        Incident.New => @Localizer["Pending Response"].Value,
        Incident.Acked => @Localizer["Acknowledged"].Value,
        Incident.Mitigated => @Localizer["Mitigated"].Value,
        Incident.Resolved => @Localizer["Resolved"].Value,
        _ => status ?? @Localizer["Not set"].Value
    };

    (string Icon, string BadgeClass, string Text) EntryStyle(string type) => type switch
    {
        IncidentTimelineEntry.Created => ("alert-triangle", "badge-triggered", @Localizer["Auto-create incident"].Value),
        IncidentTimelineEntry.Acked => ("user-check", "badge-acknowledged", @Localizer["Confirm and claim incident"].Value),
        IncidentTimelineEntry.OwnershipChanged => ("user-round-check", "badge-acknowledged", @Localizer["Take Over Incident"].Value),
        IncidentTimelineEntry.Mitigated => ("shield-check", "badge-acknowledged", @Localizer["Mitigate incident"].Value),
        IncidentTimelineEntry.Resolved => ("check-circle", "badge-resolved", @Localizer["Resolve incident"].Value),
        IncidentTimelineEntry.Reopened => ("rotate-ccw", "badge-triggered", @Localizer["Reopen Incident"].Value),
        IncidentTimelineEntry.LevelChanged => ("sliders-horizontal", "badge-updated", @Localizer["Adjust Incident Severity"].Value),
        IncidentTimelineEntry.Updated => ("message-square", "badge-updated", @Localizer["Progress"].Value),
        _ => ("activity", "badge-updated", @Localizer["Incident event"].Value)
    };
}
@section styles {
    <link rel="stylesheet" href="~/styles/alertcenter.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/node_modules/@@fontsource/cascadia-code/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/styles/incident-comments.css" asp-append-version="true" />
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="align-middle me-1" data-lucide="arrow-left" aria-hidden="true"></i>@Localizer["Back to Incident List"]
    </a>
    <div class="d-flex align-items-center gap-2">
        <span class="text-muted small font-monospace">
            <i data-lucide="clock" style="width: 13px; height: 13px;" class="align-middle me-1" aria-hidden="true"></i>
            @Localizer["Auto-created at "]@incident.ReceivedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC
        </span>
    </div>
</div>

<div asp-validation-summary="All" class="text-danger mb-3 small"></div>

<!-- Incident Hero War Room Banner -->
<div class="ac-incident-banner @bannerClass shadow-sm mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-4">
        <div class="min-w-0">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <span class="ac-status-pill @statusPill">
                    <i data-lucide="@statusIcon" style="width: 14px; height: 14px;" aria-hidden="true"></i>
                    <span>@statusText</span>
                </span>
                <span class="badge bg-secondary-subtle text-secondary font-monospace">@incident.Application.Name</span>
                <span class="badge @(incident.Level == "sev0" ? "ac-badge-sev0" : incident.Level == "sev1" ? "ac-badge-sev1" : incident.Level == "sev2" ? "ac-badge-sev2" : incident.Level == "sev3" ? "ac-badge-sev3" : "ac-badge-sev4") font-monospace">@incident.Level</span>
            </div>
            <h1 class="h3 mb-2 text-break fw-bold">@incident.Title</h1>
            <p class="text-muted small mb-2 text-break">@Localizer["Incident owner:"]<strong>@(incident.Owner?.DisplayName ?? incident.OwnerDisplayName ?? @Localizer["Unassigned"].Value)</strong></p>

        </div>

        <!-- War Room Action Forms -->
        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (Model.CanManage && incident.Status == Incident.New)
            {
                <form asp-action="Acknowledge" method="post" data-action-feedback class="d-flex flex-wrap gap-2">
                    <input type="hidden" name="incidentId" value="@incident.Id" />
                    <input type="hidden" name="version" value="@incident.Version" />
                    <input name="note" maxlength="4000" class="form-control form-control-sm" style="max-width: 18rem;" placeholder="@Localizer["Confirmation note (optional)"]" aria-label="@Localizer["Confirmation note (optional)"]" />
                    <button type="submit" class="btn btn-sm btn-warning text-nowrap">
                        <i class="align-middle me-1" data-lucide="user-check" aria-hidden="true"></i>@Localizer["Confirm and claim"]
                    </button>
                </form>
            }
            @if (Model.CanManage && incident.Status == Incident.Acked)
            {
                <form asp-action="TakeOwnership" method="post" data-action-feedback class="d-flex flex-wrap gap-2">
                    <input type="hidden" name="incidentId" value="@incident.Id" />
                    <input type="hidden" name="version" value="@incident.Version" />
                    <input name="note" maxlength="4000" class="form-control form-control-sm" style="max-width: 18rem;" placeholder="@Localizer["Take Over Notes (Optional)"]" aria-label="@Localizer["Take Over Notes (Optional)"]" />
                    <button type="submit" class="btn btn-sm btn-outline-warning text-nowrap">
                        <i class="align-middle me-1" data-lucide="user-round-check" aria-hidden="true"></i>@Localizer["Take Over Incident"]
                    </button>
                </form>
                <button class="btn btn-sm btn-primary text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#mitigate-incident">
                    <i class="align-middle me-1" data-lucide="shield-check" aria-hidden="true"></i>@Localizer["Mitigate incident"]
                </button>
            }
            @if (Model.CanManage && incident.Status == Incident.Mitigated)
            {
                <button class="btn btn-sm btn-success text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#resolve-incident">
                    <i class="align-middle me-1" data-lucide="check-circle" aria-hidden="true"></i>@Localizer["Resolve incident"]
                </button>
            }
            @if (canChangeLevel)
            {
                <button class="btn btn-sm btn-outline-primary text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#change-incident-level">
                    <i class="align-middle me-1" data-lucide="sliders-horizontal" aria-hidden="true"></i>@Localizer["Adjust Severity"]
                </button>
            }
            @if (canReopen)
            {
                <button class="btn btn-sm btn-outline-danger text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#reopen-incident">
                    <i class="align-middle me-1" data-lucide="rotate-ccw" aria-hidden="true"></i>@Localizer["Reopen Incident"]
                </button>
            }
            @if (!isActive)
            {
                <span class="badge bg-success text-white px-3 py-2 d-inline-flex align-items-center gap-1.5">
                    <i data-lucide="check-circle-2" style="width: 15px; height: 15px;" aria-hidden="true"></i>
                    <span>@Localizer["Fixed and closed"]</span>
                </span>
            }
        </div>
    </div>
</div>

<!-- Progress Update Entry (Only for active incidents & managers) -->
@if (Model.CanManage && isActive)
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent py-3">
            <h2 class="card-title h6 mb-0 d-flex align-items-center gap-2">
                <i data-lucide="edit-3" style="width: 16px; height: 16px;" class="text-primary" aria-hidden="true"></i>
                <span>@Localizer["Log investigation and handling progress"]</span>
            </h2>
        </div>
        <div class="card-body pt-0">
            <form asp-action="AddNote" method="post" data-action-feedback class="d-flex flex-column gap-3">
                <input type="hidden" name="incidentId" value="@incident.Id" />
                <input type="hidden" name="version" value="@incident.Version" />
                <textarea class="form-control" name="note" maxlength="4000" rows="3" required placeholder="@Localizer["Record investigation clues, emergency mitigation measures, impact scope assessment, or system recovery progress in real-time..."]"></textarea>
                <div class="d-flex justify-content-end">
                    <button class="btn btn-outline-primary btn-sm px-4">
                        <i class="align-middle me-1" data-lucide="send" aria-hidden="true"></i>@Localizer["Publish progress"]
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<div class="row g-4">
    <!-- Left Column: Incident Timeline -->
    <div class="col-lg-8">
        <section class="card shadow-sm border-0">
            <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
                <h2 class="card-title h5 mb-0 d-flex align-items-center gap-2">
                    <i data-lucide="git-commit" style="width: 18px; height: 18px;" class="text-primary" aria-hidden="true"></i>
                    <span>@Localizer["Full-cycle handling timeline"]</span>
                </h2>
                <span class="badge bg-light text-secondary border">@Localizer["Total "]@Model.TimelineEntries.Count @Localizer["handling nodes"]</span>
            </div>
            <div class="card-body">
                <div class="ac-timeline">
                    @foreach (var entry in Model.TimelineEntries)
                    {
                        var entryStyle = EntryStyle(entry.Type);
                        <div class="ac-timeline-item">
                            <div class="ac-timeline-badge @entryStyle.BadgeClass">
                                <i data-lucide="@entryStyle.Icon" style="width: 15px; height: 15px;" aria-hidden="true"></i>
                            </div>
                            <div class="ac-timeline-content">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
                                    <div class="d-flex align-items-center gap-2">
                                        <strong class="text-dark">@entryStyle.Text</strong>
                                        <span class="badge bg-light text-secondary border small">@(entry.ActorName ?? entry.Actor?.DisplayName ?? (entry.Type == IncidentTimelineEntry.Created && entry.ActorId == null && entry.ActorIdSnapshot == null ? @Localizer["System"].Value : @Localizer["User deleted"].Value))</span>
                                    </div>
                                    <small class="text-muted font-monospace small">
                                        @entry.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC
                                    </small>
                                </div>
                                @if (entry.PreviousStatus != entry.NewStatus && (entry.PreviousStatus != null || entry.NewStatus != null))
                                {
                                    <div class="text-muted small mt-1">@Localizer["Status: "]@StatusText(entry.PreviousStatus) → @StatusText(entry.NewStatus)</div>
                                }
                                @if (entry.PreviousOwnerId != entry.NewOwnerId || entry.PreviousOwnerName != entry.NewOwnerName)
                                {
                                    <div class="text-muted small mt-1 text-break">@Localizer["Owner: "]@(entry.PreviousOwnerName ?? entry.PreviousOwnerId ?? @Localizer["Unassigned"].Value) → @(entry.NewOwnerName ?? entry.NewOwnerId ?? @Localizer["Unassigned"].Value)</div>
                                }
                                @if (entry.PreviousLevel != entry.NewLevel && (entry.PreviousLevel != null || entry.NewLevel != null))
                                {
                                    <div class="text-muted small mt-1">@Localizer["Severity: "]@(entry.PreviousLevel ?? @Localizer["Not set"].Value) → @(entry.NewLevel ?? @Localizer["Not set"].Value)</div>
                                }
                                @if (!string.IsNullOrEmpty(entry.Note))
                                {
                                    <div class="ac-prose ac-prose-note mt-2">@entry.Note</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    </div>

    <!-- Right Column: Report & Facts -->
    <div class="col-lg-4">
        <section class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent py-3">
                <h2 class="card-title h6 mb-0">@Localizer["Current On-Call OCE"]</h2>
            </div>
            <div class="card-body pt-0 small">
                @if (!string.IsNullOrEmpty(Model.CurrentOceError))
                {
                    <div class="alert alert-warning mb-0" role="alert">
                        <div class="alert-message text-break">@Localizer["Currently on call "]OCE @Localizer["Query failed: "]@Model.CurrentOceError</div>
                    </div>
                }
                else if (Model.CurrentOces.Count == 0)
                {
                    <p class="text-muted mb-0">@Localizer["No current on-call OCE."]</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var oce in Model.CurrentOces)
                        {
                            <li class="text-break mb-2">
                                <strong>@oce.DisplayName</strong>
                                @if (!string.IsNullOrEmpty(oce.Email))
                                {
                                    <span class="text-muted">（@oce.Email）</span>
                                }
                            </li>
                        }
                    </ul>
                }
                @if (incident.AcknowledgedAtUtc.HasValue || incident.MitigatedAtUtc.HasValue || incident.ResolvedAtUtc.HasValue)
                {
                    <dl class="mb-0 mt-3 pt-3 border-top text-muted">
                        @if (incident.AcknowledgedAtUtc.HasValue)
                        {
                            <dt>@Localizer["Confirmation time (UTC)"]</dt>
                            <dd class="font-monospace">@incident.AcknowledgedAtUtc.Value.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                        }
                        @if (incident.MitigatedAtUtc.HasValue)
                        {
                            <dt>@Localizer["Mitigation time (UTC)"]</dt>
                            <dd class="font-monospace">@incident.MitigatedAtUtc.Value.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                        }
                        @if (incident.ResolvedAtUtc.HasValue)
                        {
                            <dt>@Localizer["Resolution time (UTC)"]</dt>
                            <dd class="font-monospace">@incident.ResolvedAtUtc.Value.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                        }
                    </dl>
                }
            </div>
        </section>

        <section class="card shadow-sm border-0 mb-4">
            <div class="card-header"><h2 class="card-title h6 mb-0">@Localizer["Report information"]</h2></div>
            <div class="card-body">
                <dl>
                    <dt>@Localizer["Incident ID"]</dt><dd class="text-break">@incident.Id</dd>
                    <dt>@Localizer["Report ID"]</dt><dd class="text-break">@incident.ReportId</dd>
                    <dt>@Localizer["Occurred at (UTC)"]</dt><dd>@incident.OccurredAtUtc.ToString("O")</dd>
                    <dt>@Localizer["Received at (UTC)"]</dt><dd>@incident.ReceivedAtUtc.ToString("O")</dd>
                </dl>
                <div id="incident-copy-feedback" role="status" aria-live="polite" aria-atomic="true"></div>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-copy-target="incident-content" data-copy-feedback="incident-copy-feedback">@Localizer["Copy content"]</button>
                <p id="incident-content" class="text-break" style="white-space: pre-wrap">@incident.Content</p>
            </div>
        </section>

        <!-- Incident Quick Info -->
        <section class="card shadow-sm border-0">
            <div class="card-header bg-transparent py-3">
                <h2 class="card-title h6 mb-0">@Localizer["Response Mechanism Description"]</h2>
            </div>
            <div class="card-body small text-muted">
                <div class="d-flex align-items-start gap-2 mb-3">
                    <i data-lucide="shield-check" style="width: 18px; height: 18px;" class="text-primary flex-shrink-0 mt-0.5" aria-hidden="true"></i>
                    <div>
                        <strong class="text-dark d-block mb-0.5">@Localizer["Independent incidents"]</strong>
                        @Localizer["Every independent report creates a new incident. Acknowledging, mitigating or resolving this incident does not affect other incidents or their notifications."]
                    </div>
                </div>
                <div class="d-flex align-items-start gap-2">
                    <i data-lucide="rotate-ccw" style="width: 18px; height: 18px;" class="text-success flex-shrink-0 mt-0.5" aria-hidden="true"></i>
                    <div>
                        <strong class="text-dark d-block mb-0.5">@Localizer["Closed-loop Recovery"]</strong>
                        @Localizer["Record mitigation measures, then a resolution reason. Reopening this incident restores Pending Response, clears the assignee, and emails the current on-call OCE."]
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<section class="card shadow-sm border-0 mb-4" aria-labelledby="incident-context-heading">
    <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2 py-3">
        <h2 id="incident-context-heading" class="card-title h6 mb-0">@Localizer["Full context"] <span class="badge bg-secondary ms-2">JSON</span></h2>
        @if (!string.IsNullOrWhiteSpace(incident.ContextJson))
        {
            <button type="button" class="btn btn-sm btn-outline-secondary" data-copy-target="incident-context" data-copy-feedback="incident-copy-feedback">@Localizer["Copy JSON"]</button>
        }
    </div>
    <div class="card-body p-0">
        @if (string.IsNullOrWhiteSpace(incident.ContextJson))
        {
            <p class="text-muted p-4 mb-0">@Localizer["No additional context was reported."]</p>
        }
        else
        {
            <pre id="incident-context" class="ac-context-json m-0 p-4" tabindex="0" aria-labelledby="incident-context-heading"><code>@Model.FormattedContext</code></pre>
        }
    </div>
</section>

<partial name="_Comments" model="Model" />

@if (Model.CanManage && incident.Status == Incident.Acked)
{
    <div class="modal fade" id="mitigate-incident" tabindex="-1" aria-labelledby="mitigate-incident-title" aria-hidden="true">
        <div class="modal-dialog">
            <form asp-action="Mitigate" method="post" data-action-feedback class="modal-content border-0 shadow">
                <input type="hidden" name="incidentId" value="@incident.Id" />
                <input type="hidden" name="version" value="@incident.Version" />
                <div class="modal-header">
                    <h2 class="modal-title h5 mb-0" id="mitigate-incident-title">@Localizer["Mitigate incident"]</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">@Localizer["Record the mitigation measures taken. Resolve this incident after the fix is complete."]</p>
                    <label for="mitigate-note" class="form-label small text-muted">@Localizer["Mitigation reason (required)"]</label>
                    <textarea id="mitigate-note" name="note" maxlength="4000" rows="4" class="form-control" required placeholder="@Localizer["Describe mitigation measures, impact scope, and recovery status."]"></textarea>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@Localizer["Confirm incident mitigation"]</button>
                </div>
            </form>
        </div>
    </div>
}

@if (canChangeLevel)
{
    <div class="modal fade" id="change-incident-level" tabindex="-1" aria-labelledby="change-incident-level-title" aria-hidden="true">
        <div class="modal-dialog">
            <form asp-action="ChangeLevel" method="post" data-action-feedback class="modal-content border-0 shadow">
                <input type="hidden" name="incidentId" value="@incident.Id" />
                <input type="hidden" name="version" value="@incident.Version" />
                <div class="modal-header">
                    <h2 class="modal-title h5 mb-0" id="change-incident-level-title">@Localizer["Adjust Incident Severity"]</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">@Localizer["Adjust the severity of this incident and record the reason."]</p>
                    <label for="incident-new-level" class="form-label small text-muted">@Localizer["New level"]</label>
                    <select id="incident-new-level" name="level" class="form-select mb-3" required>
                        <option value="sev0" selected="@(incident.Level == "sev0")">@Localizer["sev0 · Critical (P0)"]</option>
                        <option value="sev1" selected="@(incident.Level == "sev1")">@Localizer["sev1 · Major (P1)"]</option>
                        <option value="sev2" selected="@(incident.Level == "sev2")">@Localizer["sev2 · Error (P2)"]</option>
                        <option value="sev3" selected="@(incident.Level == "sev3")">@Localizer["sev3 · Warning (P3)"]</option>
                        <option value="sev4" selected="@(incident.Level == "sev4")">@Localizer["sev4 · Info (P4)"]</option>
                    </select>
                    <label for="change-level-note" class="form-label small text-muted">@Localizer["Reason for adjustment (required)"]</label>
                    <textarea id="change-level-note" name="note" maxlength="4000" rows="4" class="form-control" required placeholder="@Localizer["Describe the impact changes and the basis for severity adjustments."]"></textarea>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@Localizer["Confirm severity adjustment"]</button>
                </div>
            </form>
        </div>
    </div>
}

@if (canReopen)
{
    <div class="modal fade" id="reopen-incident" tabindex="-1" aria-labelledby="reopen-incident-title" aria-hidden="true">
        <div class="modal-dialog">
            <form asp-action="Reopen" method="post" data-action-feedback class="modal-content border-0 shadow">
                <input type="hidden" name="incidentId" value="@incident.Id" />
                <input type="hidden" name="version" value="@incident.Version" />
                <div class="modal-header">
                    <h2 class="modal-title h5 mb-0" id="reopen-incident-title">@Localizer["Reopen Incident"]</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">@Localizer["Reopening restores the \"Pending Response\" status and clears the assignee, and emails the current on-call OCE. The incident must be re-acknowledged and claimed."]</p>
                    <label for="reopen-note" class="form-label small text-muted">@Localizer["Reopen Notes (Optional)"]</label>
                    <textarea id="reopen-note" name="note" maxlength="4000" rows="4" class="form-control" placeholder="@Localizer["Example: Monitoring detected the same failure again, re-investigation required."]"></textarea>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-danger">@Localizer["Confirm incident re-opening"]</button>
                </div>
            </form>
        </div>
    </div>
}

<!-- Modal: Resolve Incident -->
@if (Model.CanManage && incident.Status == Incident.Mitigated)
{
    <div class="modal fade" id="resolve-incident" tabindex="-1" aria-labelledby="resolve-incident-title" aria-hidden="true">
        <div class="modal-dialog">
            <form asp-action="Resolve" method="post" data-action-feedback class="modal-content border-0 shadow">
                <input type="hidden" name="incidentId" value="@incident.Id" />
                <input type="hidden" name="version" value="@incident.Version" />
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-success-subtle text-success p-1.5">
                            <i data-lucide="check-circle" style="width: 18px; height: 18px;" aria-hidden="true"></i>
                        </div>
                        <h2 class="modal-title h5 mb-0" id="resolve-incident-title">@Localizer["Resolve incident"]</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        @Localizer["Resolving this incident completes its workflow. Other incidents are handled independently."]
                    </p>
                    <label for="resolve-note" class="form-label small text-muted">@Localizer["Resolution reason (required)"]</label>
                    <textarea id="resolve-note" name="note" maxlength="4000" rows="4" class="form-control" required placeholder="@Localizer["Example: Core database connection pool restored, service responses normal, load test passed."]"></textarea>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-success">
                        <i class="align-middle me-1" data-lucide="check" aria-hidden="true"></i>@Localizer["Confirm incident resolution"]
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script src="~/scripts/clipboard.js" asp-append-version="true"></script>
    <script src="~/scripts/markdown-config.js" asp-append-version="true"></script>
    <script src="~/node_modules/mathjax/es5/tex-mml-chtml.js" asp-append-version="true"></script>
    <script src="~/node_modules/mermaid/dist/mermaid.min.js" asp-append-version="true"></script>
    <script src="~/node_modules/@@highlightjs/cdn-assets/highlight.min.js" asp-append-version="true"></script>
    <script src="~/node_modules/@@aiursoft/uistack-markdown-ui/dist/index.global.js" asp-append-version="true"></script>
    <script src="~/node_modules/monaco-editor/min/vs/loader.js" asp-append-version="true"></script>
    <script defer src="~/scripts/incident-comments.js" asp-append-version="true"></script>
}

@if (Model.CanDelete && Model.Incident != null)
{
    <div class="card mt-4"><div class="card-header"><h5 class="card-title">@Localizer["Permanently Delete Incident"]</h5></div><div class="card-body">
        <p>@Localizer["This permanently deletes the incident and its history. Enter its exact title to confirm."]</p>
        <form asp-action="Delete" method="post"><input type="hidden" name="id" value="@Model.Incident.Id" /><input type="hidden" name="version" value="@Model.Incident.Version" /><label for="delete-title" class="form-label">@Localizer["Incident title"]</label><input id="delete-title" name="confirmationTitle" class="form-control mb-3" required /><button type="submit" class="btn btn-danger">@Localizer["Permanently Delete"]</button></form>
    </div></div>
}
