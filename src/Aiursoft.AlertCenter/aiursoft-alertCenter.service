[Unit]
Description=Aiursoft AlertCenter Web Application
After=network.target

[Service]
WorkingDirectory=/usr/share/aiursoft-alertCenter
ExecStart=/usr/bin/dotnet /usr/share/aiursoft-alertCenter/Aiursoft.AlertCenter.dll --urls http://*:5000
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=aiursoft-alertCenter
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=HOME=/var/lib/aiursoft-alertCenter

[Install]
WantedBy=multi-user.target
