<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Aiursoft.AlertCenter</AssemblyName>
    <RootNamespace>Aiursoft.AlertCenter</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Aiursoft.AlertCenter.Tests"></InternalsVisibleTo>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aiursoft.AiurProtocol.Server" Version="10.0.39" />
    <PackageReference Include="Aiursoft.ClickhouseLoggerProvider" Version="10.0.28" />
    <PackageReference Include="Aiursoft.DbTools.Switchable" Version="10.0.30" />
    <PackageReference Include="Aiursoft.Scanner" Version="10.0.15" />
    <PackageReference Include="Aiursoft.UiStack" Version="10.0.32" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aiursoft.Canon.ScheduledTasks" Version="10.0.18" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aiursoft.AlertCenter.SDK\Aiursoft.AlertCenter.SDK.csproj" />
    <ProjectReference Include="..\Aiursoft.AlertCenter.InMemory\Aiursoft.AlertCenter.InMemory.csproj" />
    <ProjectReference Include="..\Aiursoft.AlertCenter.MySql\Aiursoft.AlertCenter.MySql.csproj" />
    <ProjectReference Include="..\Aiursoft.AlertCenter.Sqlite\Aiursoft.AlertCenter.Sqlite.csproj" />
  </ItemGroup>
</Project>
